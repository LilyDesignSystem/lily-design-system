{
  "name": "@lilydesignsystem/nunjucks-markdown-editor",
  "version": "0.1.0",
  "engines": {
    "node": ">=26"
  },
  "description": "Lily Design System Nunjucks Markdown editor: a textarea with a toolbar of rich-text buttons that write Markdown, rendered by a macro and driven by a small client script. Headless, no CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./template": "./dist/markdown-editor.njk"
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "bash build.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "nunjucks": "^3.2.4",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "nunjucks",
    "markdown",
    "editor",
    "textarea",
    "toolbar"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system.git",
    "directory": "lily-design-system-nunjucks-markdown-editor"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

{#
  MarkdownEditor macro — a <textarea> with a toolbar of buttons that write
  Markdown into it. The value is plain text, so it submits with the form and
  works without JavaScript (the buttons simply do nothing until the client
  script runs; the text is still editable).

  HTML tag: <div> (root), <div role="toolbar">, <button>, <textarea>
  CSS class: markdown-editor
  Companion runtime: markdown-editor.client.js

  Params (single `opts` object):
    label         — string, required. Accessible name of the textarea.
    toolbarLabel  — string, required. Accessible name of the toolbar.
    labels        — object, required. Accessible name per tool:
                    heading, bold, italic, strikethrough, code, link, quote,
                    bulletList, numberedList. A tool with no name is not rendered.
    tools         — array of tool ids, default all nine, in this order.
    headingLevel  — 1 to 6, default 2.
    value         — string, the initial text.
    name, id, rows, placeholder — passed to the textarea.
    disabled, readonly, required — booleans.
    classes       — string, appended to `markdown-editor`.
    attributes    — object, extra attributes on the root.

  Usage:
    {% from "markdown-editor.njk" import markdownEditor %}
    {{ markdownEditor({ label: "Message", toolbarLabel: "Formatting", name: "body",
                        labels: { bold: "Bold", italic: "Italic" } }) }}
#}
{%- set _icons = {
  heading: "M3 3v10M13 3v10M3 8h10",
  bold: "M4.5 3h4a2.5 2.5 0 0 1 0 5h-4zM4.5 8h5a2.5 2.5 0 0 1 0 5h-5z",
  italic: "M10 3H6.5M9.5 13H6M9 3 7 13",
  strikethrough: "M2.5 8h11M10.5 5.2C10 4 9 3.5 8 3.5c-1.5 0-2.5.8-2.5 2 0 1 .6 1.6 2.5 2M6 11c.4.9 1.2 1.5 2.2 1.5 1.5 0 2.5-.8 2.5-2",
  code: "M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5",
  link: "M6.5 9.5a2.5 2.5 0 0 0 3.5 0l2-2a2.5 2.5 0 0 0-3.5-3.5l-.7.7M9.5 6.5a2.5 2.5 0 0 0-3.5 0l-2 2a2.5 2.5 0 0 0 3.5 3.5l.7-.7",
  quote: "M3 4v8M6.5 5h7M6.5 8h7M6.5 11h5",
  bulletList: "M6 4h8M6 8h8M6 12h8M2.5 4h.01M2.5 8h.01M2.5 12h.01",
  numberedList: "M7 4h7M7 8h7M7 12h7M2.5 3 3.5 2.5V6M2.5 9.5c.5-1 2-.8 2 .2 0 .8-1.5 1.3-2 2.3h2"
} -%}
{%- macro markdownEditor(opts) -%}
{%- set o = opts | default({}) -%}
{%- set tools = o.tools | default(["heading", "bold", "italic", "strikethrough", "code", "link", "quote", "bulletList", "numberedList"]) -%}
{%- set labels = o.labels | default({}) -%}
{%- set textareaId = o.id | default("markdown-editor") -%}
<div class="markdown-editor{% if o.classes %} {{ o.classes }}{% endif %}" data-lily-markdown-editor data-heading-level="{{ o.headingLevel | default(2) }}"
  {%- if o.attributes %}{% for k, v in o.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}>
  <div class="markdown-editor-toolbar" role="toolbar" aria-orientation="horizontal" aria-label="{{ o.toolbarLabel }}" aria-controls="{{ textareaId }}">
    {%- set first = true -%}
    {%- for tool in tools %}{% if labels[tool] %}
    <button class="markdown-editor-button" type="button" data-tool="{{ tool }}" aria-label="{{ labels[tool] }}" tabindex="{{ 0 if first else -1 }}"{% if o.disabled %} disabled{% endif %}{% if o.readonly %} aria-disabled="true"{% endif %}>
      <svg class="markdown-editor-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="1.05rem" height="1.05rem"><path d="{{ _icons[tool] }}"></path></svg>
    </button>
    {%- set first = false -%}
    {% endif %}{% endfor %}
  </div>
  <textarea class="markdown-editor-textarea" id="{{ textareaId }}" aria-label="{{ o.label }}"
    {%- if o.name %} name="{{ o.name }}"{% endif %}
    {%- if o.rows %} rows="{{ o.rows }}"{% endif %}
    {%- if o.placeholder %} placeholder="{{ o.placeholder }}"{% endif %}
    {%- if o.disabled %} disabled{% endif %}
    {%- if o.readonly %} readonly{% endif %}
    {%- if o.required %} required{% endif %}>{{ o.value }}</textarea>
</div>
{%- endmacro -%}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "types": [],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "index.ts",
    "shims.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "examples",
    "docs",
    "dist",
    "node_modules"
  ]
}

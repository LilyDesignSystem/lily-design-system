{
  "name": "@lilydesignsystem/nunjucks-filter",
  "version": "0.1.0",
  "engines": {
    "node": ">=26"
  },
  "description": "Lily Design System Nunjucks filter: a headless filter builder (conditions and groups over text, number, date, choice and yes/no fields; and / or / not) that outputs JSON, SQL, MongoDB, OData or a predicate; a macro plus filter-builder.client.js. Headless, no CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./template": "./dist/filter-builder.njk"
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "bash build.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "jsdom": "^30.1.2",
    "nunjucks": "^3.2.4",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "nunjucks",
    "filter",
    "query-builder",
    "sql",
    "mongodb",
    "odata"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system.git",
    "directory": "lily-design-system-nunjucks-filter"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

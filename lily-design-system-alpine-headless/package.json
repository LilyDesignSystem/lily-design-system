{
  "name": "@lilydesignsystem/alpine-headless",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "description": "Lily Design System Alpine.js headless components (509 of 571): annotated semantic-HTML snippets with ARIA, class hooks and Alpine directives, plus a small Alpine plugin that owns the keyboard and state behaviour. Zero CSS. Targets WCAG 2.2 AAA.",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "scripts": {
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "alpinejs": "^3.14.0"
  },
  "devDependencies": {
    "@storybook/html-vite": "^10.6.2",
    "alpinejs": "^3.15.0",
    "jsdom": "^27.0.0",
    "storybook": "^10.6.2",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  },
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system.git",
    "directory": "lily-design-system-alpine-headless"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./plugin": "./lily-alpine.js",
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lily-alpine.js",
    "components/*.html",
    "index.md",
    "README.md"
  ]
}

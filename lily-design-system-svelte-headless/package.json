{
  "name": "@lilydesignsystem/svelte-headless",
  "version": "0.12.0",
  "engines": {
    "node": ">=26"
  },
  "description": "A comprehensive headless Svelte 5 component library with 473 accessible, unstyled core components for building design systems. Targets WCAG 2.2 AAA.",
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "test": "vitest run",
    "benchmark:render": "vitest run --config vitest.render-bench.config.ts",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.check.json --fail-on-warnings"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system.git",
    "directory": "lily-design-system-svelte-headless"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "headless",
    "svelte",
    "components",
    "accessibility",
    "wcag"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  },
  "homepage": "https://lilydesignsystem.com/",
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.11",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "^5.1.0",
    "fast-check": "4.10.2",
    "jsdom": "^31.0.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tinybench": "6.2.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "aria-query": "^5.3.2"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}

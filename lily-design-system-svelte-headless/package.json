{
  "name": "lily-design-system-svelte-headless",
  "version": "0.3.1",
  "engines": {
    "node": "=26"
  },
  "description": "A comprehensive headless Svelte 5 component library with 491 accessible, unstyled components for building design systems. Targets WCAG 2.2 AAA.",
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-svelte-headless.git"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "headless",
    "svelte",
    "components",
    "accessibility",
    "wcag"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  },
  "homepage": "https://lilydesignsystem.github.io/",
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/ui": "^4.0.18",
    "jsdom": "^30.0.0",
    "svelte": "^5.56.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "aria-query": "^5.3.1"
  },
  "pnpm": {
    "overrides": {
      "cookie@<0.7.0": ">=0.7.0",
      "@sveltejs/kit@>=2.49.0 <=2.52.1": ">=2.52.2",
      "devalue@<=5.6.2": ">=5.6.3",
      "svelte@<=5.51.4": ">=5.51.5",
      "svelte@>=5.39.3 <5.51.5": ">=5.51.5",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "@sveltejs/kit@>=2.49.0 <=2.53.2": ">=2.53.3",
      "svelte@<=5.53.4": ">=5.53.5",
      "devalue@<5.6.4": ">=5.6.4",
      "devalue@<=5.6.3": ">=5.6.4",
      "flatted@<3.4.0": ">=3.4.0",
      "undici@>=7.0.0 <7.24.0": ">=7.24.0",
      "undici@>=7.17.0 <7.24.0": ">=7.24.0"
    }
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}

@namespace LilyDesignSystem.Blazor.Helpers

@*
    ThemePicker — Blazor helper component.
    Single source of truth: spec/index.md (§1–§9).

    Renders an icon button that opens a dropdown listbox of available
    themes (WAI-ARIA APG listbox pattern). On every selection it
    (1) swaps the href of a managed <link> in <head>, (2) sets
    data-theme on <html>, (3) optionally persists to localStorage, and
    (4) invokes OnChange / ValueChanged.

    All DOM writes happen through IJSRuntime inside OnAfterRenderAsync,
    so the component is SSR / prerender safe.
*@

<div class="@RootClass"
     @onfocusout="OnRootFocusOutAsync"
     @attributes="AdditionalAttributes">

    @* Preserves form participation; the listbox itself is not a form control. *@
    <input type="hidden" name="@Name" value="@Value" />

    <button type="button"
            class="theme-picker-button"
            @ref="_buttonElement"
            aria-label="@Label"
            aria-haspopup="listbox"
            aria-expanded="@(_open ? "true" : "false")"
            aria-controls="@ListId"
            @onclick="OnButtonClickAsync"
            @onkeydown="OnButtonKeyDownAsync">
        @if (ChildContent is not null)
        {
            @ChildContent(BuildContext())
        }
        else
        {
            @* The icon is decorative: the accessible name is the button's
               aria-label, never the icon itself. Bundled SVG, not a
               Unicode character (reversed 2026-09-16). *@
            <svg class="theme-picker-icon" viewBox="0 0 16 16" aria-hidden="true"
                 fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round"
                 width="1.05rem" height="1.05rem">
                <circle cx="8" cy="8" r="6" />
                <path d="M8 2a6 6 0 0 1 0 12z" fill="currentColor" stroke="none" />
            </svg>
        }
    </button>

    @* mousedown default is suppressed so clicking an option does not blur
       the listbox before the click handler runs. *@
    <ul class="theme-picker-list"
        id="@ListId"
        role="listbox"
        aria-label="@Label"
        aria-activedescendant="@ActiveDescendantId"
        tabindex="-1"
        hidden="@(!_open)"
        @ref="_listElement"
        @onkeydown="OnListKeyDownAsync"
        @onmousedown:preventDefault="true">
        @for (var i = 0; i < Themes.Count; i++)
        {
            var index = i;
            var theme = Themes[index];
            <li class="theme-picker-option"
                id="@OptionId(index)"
                role="option"
                aria-selected="@(theme == Value ? "true" : "false")"
                data-active="@(index == _activeIndex ? "" : null)"
                @onclick="() => ChooseAsync(index)">@LabelFor(theme)</li>
        }
    </ul>
</div>

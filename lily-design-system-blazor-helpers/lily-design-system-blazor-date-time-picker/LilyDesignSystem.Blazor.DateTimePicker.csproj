<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LilyDesignSystem.Blazor.Helpers</RootNamespace>
    <AssemblyName>LilyDesignSystem.Blazor.DateTimePicker</AssemblyName>
    <PackageId>LilyDesignSystem.Blazor.DateTimePicker</PackageId>
    <Version>0.1.0</Version>
    <Authors>Joel Parker Henderson</Authors>
    <Description>Lily Design System Blazor date and time picker: a typeable text field paired with an APG date-picker dialog. Headless, SSR-safe, no CSS.</Description>
    <PackageProjectUrl>https://lilydesignsystem.github.io/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LilyDesignSystem/lily-design-system-blazor-helpers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>lily;design-system;blazor;headless;accessibility;wcag;aria;a11y</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- NuGet renders this on the package page. README.md is a symlink to
       index.md, matching the convention every Lily subproject uses;
       PackagePath puts it at the package root, where PackageReadmeFile
       expects to find it. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Tests, examples, and docs are not part of the published package. -->
  <ItemGroup>
    <Compile Remove="**/*Tests.cs" />
    <Compile Remove="examples/**/*.cs" />
    <Content Remove="examples/**" />
    <Content Remove="docs/**" />
    <None Remove="examples/**" />
    <None Remove="docs/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

  <!-- The helper test project exercises internal static helpers
       (e.g. NowProvider, BuildInstallFocusTrapScript) directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LilyDesignSystem.Blazor.Helpers.Tests" />
  </ItemGroup>

</Project>

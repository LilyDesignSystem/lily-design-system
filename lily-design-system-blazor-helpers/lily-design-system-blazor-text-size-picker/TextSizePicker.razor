@namespace LilyDesignSystem.Blazor.Helpers
@using LilyBlazorHeadless.Components

@*
    TextSizePicker — Blazor helper component.
    Single source of truth: spec/index.md (§1–§9).

    Renders an icon button that opens a dropdown listbox of available
    text sizes (WAI-ARIA APG listbox pattern). On every selection it
    (1) sets data-text-size on <html>, (2) optionally persists to
    localStorage, and (3) invokes OnChange / ValueChanged.

    All DOM writes happen through IJSRuntime inside OnAfterRenderAsync,
    so the component is SSR / prerender safe.
*@

<div class="@RootClass"
     @onfocusout="OnRootFocusOutAsync"
     @attributes="AdditionalAttributes">

    @* Preserves form participation; the listbox itself is not a form control. *@
    <input type="hidden" name="@Name" value="@Value" />

    <IconButton @ref="_buttonComponent"
                Label="@Label"
                BaseCssClass="text-size-picker-button"
                aria-haspopup="listbox"
                aria-expanded="@(_open ? "true" : "false")"
                aria-controls="@ListId"
                @onclick="OnButtonClickAsync"
                @onkeydown="OnButtonKeyDownAsync">
        @if (ChildContent is not null)
        {
            @ChildContent(BuildContext())
        }
        else
        {
            @* The icon is decorative: the accessible name is the button's
               aria-label, never the icon itself. Bundled SVG, not a
               Unicode character (reversed 2026-09-16). *@
            <svg class="text-size-picker-icon" viewBox="0 0 16 16" aria-hidden="true"
                 fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round"
                 width="1.05rem" height="1.05rem">
                <path d="M4 13 7.2 3h1.6L12 13M5.4 9.5h5.2" />
            </svg>
        }
    </IconButton>

    <Listbox @ref="_listComponent"
             Label="@Label"
             BaseCssClass="text-size-picker-list"
             id="@ListId"
             Navigation="active-descendant"
             Clamp="true"
             Typeahead="true"
             PageSize="10"
             OptionCount="@Sizes.Count"
             OptionId="@OptionId"
             OptionLabel="@(i => LabelFor(Sizes[i]))"
             @bind-ActiveIndex="_activeIndex"
             hidden="@(!_open)"
             OnActivate="ChooseAsync"
             OnEscape="@(() => CloseList())"
             OnTabOut="@(() => CloseList(false))">
        @for (var i = 0; i < Sizes.Count; i++)
        {
            var index = i;
            var size = Sizes[index];
            <li class="text-size-picker-option"
                id="@OptionId(index)"
                role="option"
                aria-selected="@(size == Value ? "true" : "false")"
                data-active="@(index == _activeIndex ? "" : null)"
                @onclick="() => ChooseAsync(index)">@LabelFor(size)</li>
        }
    </Listbox>
</div>

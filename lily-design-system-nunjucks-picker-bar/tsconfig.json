{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@lilydesignsystem/nunjucks-time-zone-picker": [
        "../lily-design-system-nunjucks-time-zone-picker/time-zone-picker.client.js"
      ]
    }
  },
  "include": ["*.ts", "*.js"],
  "exclude": ["node_modules", "dist"]
}

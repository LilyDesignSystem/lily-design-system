{
  "name": "@lilydesignsystem/web-components-headless-identifiers",
  "version": "0.3.0",
  "engines": {
    "node": ">=26"
  },
  "description": "Headless, accessible, unstyled Web Components components for national personal identifiers (188: an input and a view for each of 94 identifier types across 50+ countries), the add-on to @lilydesignsystem/web-components-headless.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solid": {
      "types": "./solid.d.ts"
    }
  },
  "files": [
    "dist",
    "solid.d.ts",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@storybook/web-components-vite": "^10.6.5",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/ui": "^5.0.5",
    "axe-core": "4.13.0",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "web-components",
    "custom-elements",
    "headless",
    "accessibility",
    "wcag",
    "aria",
    "a11y",
    "national-identifier",
    "healthcare"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system.git",
    "directory": "lily-design-system-web-components-headless-identifiers"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

{
  "name": "@lilydesignsystem/vue-picker-bar",
  "version": "0.3.0",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System Vue 3 picker bar: composes link-picker (optional), search-picker, theme-picker, locale-picker, text-size-picker, and share-picker into one page-header row. Headless, SSR-safe, no CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lilydesignsystem/vue-link-picker": "^0.1.0",
    "@lilydesignsystem/vue-search-picker": "^0.1.0",
    "@lilydesignsystem/vue-theme-picker": "^0.2.0",
    "@lilydesignsystem/vue-locale-picker": "^0.2.0",
    "@lilydesignsystem/vue-text-size-picker": "^0.2.0",
    "@lilydesignsystem/vue-share-picker": "^0.2.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "vue",
    "picker",
    "picker-bar",
    "search",
    "theme",
    "locale",
    "text-size",
    "share"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system.git",
    "directory": "lily-design-system-vue-picker-bar"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

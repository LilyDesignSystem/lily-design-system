#!/usr/bin/env node
// bin/check-web-components-live — tasks.md P50-T28: a Web Components element shows a change to its attributes.
//
// An element that reads its attributes once, in connectedCallback, keeps showing the first value after the host changes it: a
// view of a patient's value can go stale with nothing to say so (HC-C16). Every element in the Web Components headless catalog
// must observe its attributes (static observedAttributes), or be listed in bin/check-web-components-live.allow.json with a
// reason. A listed element that observes them now fails too, so the list can only shrink.
//
// Two reasons are expected: "upgrades in place" (the element replaces itself with a native element, such as an <li>, so there is
// nothing left to follow a change; the consumer changes the native element or replaces it), and "not yet sorted" (the backlog of
// P50-T28). The check finds an element that observes nothing; it does not prove each documented attribute is observed.
//
// Usage: bin/check-web-components-live [--quiet]
//        bin/check-web-components-live --baseline   print an allow-list for the current gaps (edit the reasons!)

const fs = require("fs");
const path = require("path");

const top = path.join(__dirname, "..");
const dir = path.join(top, "lily-design-system-web-components-headless", "components");
const quiet = process.argv.includes("--quiet");
const allowFile = path.join(__dirname, "check-web-components-live.allow.json");
const allow = fs.existsSync(allowFile) ? JSON.parse(fs.readFileSync(allowFile, "utf-8")) : {};

const gaps = {};
let elements = 0;
for (const name of fs.readdirSync(dir).sort()) {
  if (!name.endsWith(".ts") || /\.(test|stories)\.ts$/.test(name)) continue;
  const source = fs.readFileSync(path.join(dir, name), "utf-8");
  if (!/\bextends\s+\w+/.test(source) || !/\bclass\s+\w+/.test(source)) continue;
  elements += 1;
  if (/\bobservedAttributes\b/.test(source)) continue;
  gaps[name.replace(/\.ts$/, "")] = /\bthis\.replaceWith\(/.test(source) ? "upgrades in place" : "not yet sorted";
}

if (process.argv.includes("--baseline")) {
  console.log(JSON.stringify(gaps, null, 2));
  process.exit(0);
}

let failures = 0;
for (const slug of Object.keys(gaps))
  if (!(slug in allow)) {
    failures += 1;
    console.log(`FAIL ${slug}: observes no attribute, so a change to one is never shown; observe them, or list it with a reason`);
  }
for (const slug of Object.keys(allow))
  if (!(slug in gaps)) {
    failures += 1;
    console.log(`FAIL stale allow-list entry (it observes its attributes now, or is gone): ${slug}`);
  }
if (failures) {
  console.log(`\n${failures} problem(s). See bin/check-web-components-live.allow.json.`);
  process.exit(1);
}
if (!quiet) {
  const count = (reason) => Object.values(gaps).filter((r) => r.startsWith(reason)).length;
  console.log(
    `web components live: ${elements} elements, ${elements - Object.keys(gaps).length} observe their attributes, ${count("upgrades in place")} upgrade in place, ${count("not yet sorted")} not yet sorted`,
  );
}

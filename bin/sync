#!/bin/sh
set -euf
top="$(git rev-parse --show-toplevel)"

"$top/bin/list-implementations" |
while read -r implementation; do
    # Helpers catalogs keep their own AGENTS/ (conventions, testing, ssr,
    # shared principles) rather than the canonical root AGENTS/ set.
    case "$implementation" in
        *-helpers) continue ;;
    esac
    rsync -av "$top/AGENTS/" "$top/$implementation/AGENTS/"
done

# The reference themes are canonical at the repo root; the example apps
# serve them as static assets so the theme-picker helper can swap the
# managed <link> href at runtime (spec/theme, plan P3). rsync, not
# symlinks, for the same subtree reason as AGENTS/.
for themes_dest in \
    "$top/lily-design-system-svelte-sveltekit-examples/static/themes" \
    "$top/lily-design-system-react-next-examples/public/themes" \
    "$top/lily-design-system-vue-nuxt-examples/public/themes" \
    "$top/lily-design-system-angular-examples/public/themes" \
    "$top/lily-design-system-blazor-web-examples/src/LilyBlazorWebExamples/wwwroot/themes" \
    "$top/lily-design-system-html-css-js-examples/pages/themes" \
    "$top/lily-design-system-nunjucks-eleventy-examples/src/themes"
do
    mkdir -p "$themes_dest"
    rsync -a --delete "$top/themes/" "$themes_dest/"
done

# The docs site loads the same themes at runtime (static/assets/themes/, via
# SitePreferences.svelte's themesUrl). Copy only the *.css files: the
# directory also holds its own README.md, which --delete must not remove
# (excluded files are protected from --delete).
mkdir -p "$top/lilydesignsystem.github.io/static/assets/themes"
rsync -a --delete --include='*.css' --exclude='*' "$top/themes/" "$top/lilydesignsystem.github.io/static/assets/themes/"

# The site's /news and /roadmap routes render the canonical NEWS.md and
# plan.md at build time (vite ?raw import + marked). Copy them into the
# site's content dir so the standalone github.io subtree builds alone.
mkdir -p "$top/lilydesignsystem.github.io/src/lib/content"
cp "$top/NEWS.md" "$top/lilydesignsystem.github.io/src/lib/content/NEWS.md"
cp "$top/plan.md" "$top/lilydesignsystem.github.io/src/lib/content/plan.md"

# The html example app vendors the picker custom elements (built dist)
# the same way it vendors everything else: as copied files.
#
# Each built picker imports html-headless's ListboxController by bare
# package specifier, which a static page with no import map cannot
# resolve -- the module fails to load and no picker ever registers. So
# vendor listbox-controller.js alongside the pickers and rewrite the
# bare import to that sibling file.
mkdir -p "$top/lily-design-system-html-css-js-examples/pages/assets/js"
cp "$top/lily-design-system-html-headless/components/listbox-controller.js" \
    "$top/lily-design-system-html-css-js-examples/pages/assets/js/listbox-controller.js"
for picker in theme-picker locale-picker text-size-picker; do
    src="$top/lily-design-system-html-helpers/lily-design-system-html-$picker/dist/index.js"
    if [ -f "$src" ]; then
        sed 's#"@lilydesignsystem/html-headless/components/listbox-controller.js"#"./listbox-controller.js"#' \
            "$src" > "$top/lily-design-system-html-css-js-examples/pages/assets/js/$picker.js"
    fi
done

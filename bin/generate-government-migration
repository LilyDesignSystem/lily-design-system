#!/usr/bin/env node
// Generate the government-design-system-to-Lily mapping table and reject target slugs absent from the catalog.
// Usage: bin/generate-government-migration [--check]
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const { execFileSync } = require("node:child_process");
const top = path.resolve(__dirname, "..");
const check = process.argv.includes("--check");
const read = (relative) => fs.readFileSync(path.join(top, relative), "utf8");
const catalog = new Set(
    read("components-categories.tsv")
        .trim()
        .split("\n")
        .map((line) => line.split("\t")[0]),
);
const SOURCE = "docs/migrating/government-design-system.tsv";
const lines = read(SOURCE).trim().split("\n");
if (lines.shift() !== "Government design system component\tLily slugs\tWhat changes") {
    throw new Error(`${SOURCE} has an unexpected header`);
}
const rows = lines.map((line, index) => {
    const cells = line.split("\t");
    if (cells.length !== 3 || cells.some((cell) => !cell.trim())) {
        throw new Error(`${SOURCE}:${index + 2}: expected three non-empty tab-separated cells`);
    }
    const slugs = cells[1].split(";");
    for (const slug of slugs) {
        if (!catalog.has(slug)) throw new Error(`${SOURCE}:${index + 2}: unknown Lily slug: ${slug}`);
    }
    return { from: cells[0], slugs, note: cells[2] };
});

const markdown = [
    "<!-- Generated by bin/generate-government-migration; do not edit this region. -->",
    "| Government design system component | Lily component | What changes |",
    "| --- | --- | --- |",
    ...rows.map(
        ({ from, slugs, note }) =>
            `| ${from.replace(/\|/g, "\\|")} | ${slugs.map((slug) => `[\`${slug}\`](../../components/${slug}/index.md)`).join(", ")} | ${note.replace(/\|/g, "\\|")} |`,
    ),
].join("\n");

function update(relative, generated) {
    const file = path.join(top, relative);
    const source = fs.readFileSync(file, "utf8");
    const pattern = /<!-- government-mapping:start -->[\s\S]*?<!-- government-mapping:end -->/;
    if (!pattern.test(source)) throw new Error(`${relative}: missing government mapping markers`);
    const replaced = source.replace(
        pattern,
        `<!-- government-mapping:start -->\n${generated}\n<!-- government-mapping:end -->`,
    );
    const next = execFileSync(path.join(top, "node_modules/.bin/prettier"), ["--stdin-filepath", relative], {
        cwd: top,
        input: replaced,
        encoding: "utf8",
    });
    if (next === source) return false;
    if (check) console.error(`out of date: ${relative}`);
    else fs.writeFileSync(file, next);
    return true;
}

const changed = [update("docs/migrating/government-design-system.md", markdown)].filter(Boolean).length;
if (check && changed) process.exit(1);
console.log(
    changed
        ? `generate-government-migration: wrote ${changed} file`
        : `generate-government-migration: up to date (${rows.length} mappings)`,
);

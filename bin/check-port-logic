#!/usr/bin/env node
// bin/check-port-logic — P23-T16 stage 7: no Angular or Blazor stub where Svelte has behaviour.
//
// A stub passes its tests, because a test that checks only the class name passes on a stub: that is how 100-odd Angular and
// Blazor components came to render a root and nothing else (tasks.md P23-T16). For each component whose Svelte reference has
// an interaction signal, this asks whether the port has any logic at all. A port with none fails, unless
// bin/check-port-logic.allow.json names it with a reason. A listed port that has logic now also fails, so the list can only
// shrink.
//
// It finds a port with NO logic. It does not prove a port with some logic is complete: one handler passes.
//
// A second pass (tasks.md P25-T15) compares props: every prop a Svelte component declares must exist in its Angular port, as an
// input, a model, an output, or for a Snippet prop a named <ng-content select>. Left out: `class`, `children` and `ref`,
// which every port handles its own way, and a native DOM event such as `onclick`, which the consumer binds as (click) on the
// host. A prop with a reason not to port it goes in the same allow-list, as `angular prop {slug}.{prop}`.
//
// Usage: bin/check-port-logic [--quiet]
//        bin/check-port-logic --baseline   print an allow-list for the current gaps (edit the reasons!)

const fs = require("fs");
const path = require("path");

const top = path.join(__dirname, "..");
const quiet = process.argv.includes("--quiet");
const baselineMode = process.argv.includes("--baseline");
const allow = JSON.parse(fs.readFileSync(path.join(__dirname, "check-port-logic.allow.json"), "utf-8"));

const read = (...parts) => {
  const file = path.join(top, ...parts);
  return fs.existsSync(file) ? fs.readFileSync(file, "utf-8") : "";
};

// Svelte: a handler of its own, a two-way or element binding, or code that runs against the DOM. Left out: `$derived` and plain
// functions (a component that only computes a value from its props has nothing a port could be missing), the development name
// warning, and an `onclick` prop handed straight to a native element, which both ports pass through as the consumer's listener.
const SVELTE = /\bon[a-z]+=\{|\bfunction on[a-z]+\(|\bbind:(?!this)|\$bindable\(|\$effect\(|\bonMount\(|\buse:\w+/;

const ANGULAR = [
  /\(\w+(?:\.\w+)?\)="/, // template listener
  /"\(\w+(?:\.\w+)?\)"\s*:/, // host listener
  /\[\(\w+\)\]="/, // two-way binding to an inner component
  /\[lily\w+\]="/, // a behaviour directive
  /@HostListener/,
  /\b(?:model|output|signal)\s*[<(]/,
  /\b(?:effect|afterNextRender|afterRenderEffect|afterRender)\(/,
  /\baddEventListener\(/,
  /\battach\w+\(/, // a behaviour module the catalogs share
];

const BLAZOR = [
  /@on\w+/,
  /@bind/,
  /\bEventCallback\b/,
  /\bJSInvokable\b/,
  /\bIJSRuntime\b/,
  /@inherits\s+\w+/,
  /\bOnAfterRender(?:Async)?\b/,
  /\bOnParametersSet(?:Async)?\b/, // reacting to a parameter change, such as a counter waiting for typing to pause
];

// An effect whose body only calls development warnings (warnMissingName, warnMissingProp), each perhaps behind an `if`, is
// not behaviour: Angular raises the same warnings in ngOnInit, and Blazor has none.
const dropWarningEffects = (s) => {
  let out = s;
  for (let start = out.indexOf("$effect(() => {"); start !== -1; start = out.indexOf("$effect(() => {", start + 1)) {
    let depth = 0;
    let end = -1;
    for (let i = out.indexOf("{", start); i < out.length; i += 1) {
      if (out[i] === "{") depth += 1;
      else if (out[i] === "}" && --depth === 0) {
        end = i;
        break;
      }
    }
    if (end === -1) break;
    const body = out.slice(out.indexOf("{", start) + 1, end);
    const rest = body
      .replace(/warnMissing\w+\((?:[^()]|\([^()]*\))*\);?/g, "")
      .replace(/\bif\s*\((?:[^()]|\([^()]*\))*\)/g, "")
      .trim();
    if (rest === "") {
      const close = out.slice(end).match(/^\}\s*\);?/);
      out = out.slice(0, start) + out.slice(end + (close ? close[0].length : 1));
    }
  }
  return out;
};

const svelteCode = (s) =>
  dropWarningEffects(
    s
      .replace(/^\s*\/\/.*$/gm, "")
      .replace(/<!--[\s\S]*?-->/g, "")
      .replace(/\$effect\(\(\)\s*=>\s*warnMissingName\([^;]*?\),?\s*\);/g, ""),
  );
// Line comments go before block comments: a "/*" inside one (`"image/*"`) would otherwise hide the code after it.
const tsCode = (s) => s.replace(/^\s*\/\/.*$/gm, "").replace(/\/\*[\s\S]*?\*\//g, "");
const razorCode = (s) => s.replace(/@\*[\s\S]*?\*@/g, "").replace(/^\s*\/\/.*$/gm, "");

// The top-level pieces of a destructuring pattern or a type literal, ignoring the separators inside brackets and strings.
const topLevel = (body) => {
  const parts = [];
  let depth = 0;
  let current = "";
  let quote = "";
  for (const [i, c] of [...body].entries()) {
    if (quote) {
      if (c === quote) quote = "";
    } else if (`"'\``.includes(c)) quote = c;
    else if ("({[".includes(c)) depth += 1;
    else if (")}]".includes(c)) depth -= 1;
    else if (c === "<") depth += 1;
    else if (c === ">" && body[i - 1] !== "=") depth -= 1;
    if ((c === "," || c === ";") && depth === 0 && !quote) {
      parts.push(current);
      current = "";
    } else current += c;
  }
  parts.push(current);
  return parts.map((part) => part.trim()).filter(Boolean);
};

const svelteProps = (source) => {
  const code = source.replace(/^\s*\/\/.*$/gm, "").replace(/\/\*[\s\S]*?\*\//g, "");
  const match = code.match(/let\s*\{([\s\S]*?)\}\s*:\s*(?:\{([\s\S]*?)\}|\w+)\s*=\s*\$props\(\)/);
  if (!match) return [];
  const types = {};
  for (const part of topLevel(match[2] ?? "")) {
    const type = part.match(/^(\w+)\??\s*:\s*([\s\S]*)$/);
    if (type) types[type[1]] = type[2];
  }
  return topLevel(match[1])
    .filter((part) => !part.startsWith("..."))
    .map((part) => part.match(/^\w+/)?.[0])
    .filter(Boolean)
    .map((name) => ({ name, type: types[name] ?? "" }));
};

const NATIVE_EVENTS = new Set(
  "click dblclick input change submit reset toggle focus blur keydown keyup pointerdown pointerup scroll".split(" "),
);

// An `onThing` callback is an Angular output named `thing`, or by Angular's convention for a past event `thinged`, or the
// `thingChange` a model() declares.
const hasProp = (prop, ported, angular) => {
  if (ported.has(prop.name)) return true;
  const event = prop.name.match(/^on([A-Za-z]+)$/)?.[1];
  if (event) {
    if (NATIVE_EVENTS.has(event)) return true;
    const stem = event[0].toLowerCase() + event.slice(1);
    const lower = [...ported].map((name) => name.toLowerCase());
    const base = stem.toLowerCase();
    if (lower.some((name) => [base, `${base}d`, `${base}ed`, `${base}led`, `${base.replace(/change$/, "")}`].includes(name)))
      return true;
  }
  if (prop.type.includes("Snippet")) {
    const kebab = prop.name.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`);
    if (angular.includes(`select="[${kebab}]"`) || angular.includes(`select="[${prop.name}]"`)) return true;
  }
  return false;
};

const ALWAYS_PORTED = new Set(["class", "children", "ref"]);

const rows = read("components.tsv")
  .split("\n")
  .filter(Boolean)
  .map((line) => line.split("\t"));

const baseline = {};
const gaps = new Set();
let compared = 0;
for (const [slug, name] of rows) {
  const svelte = svelteCode(read("lily-design-system-svelte-headless/components", name, `${name}.svelte`));
  if (!SVELTE.test(svelte)) continue;
  compared += 1;
  const ports = [
    ["angular", tsCode(read("lily-design-system-angular-headless/components", `${name}.ts`)), ANGULAR],
    ["blazor", razorCode(read("lily-design-system-blazor-headless/src/LilyBlazorHeadless/Components", `${name}.razor`)), BLAZOR],
  ];
  for (const [port, source, patterns] of ports) {
    if (patterns.some((p) => p.test(source))) continue;
    const key = `${port} ${slug}`;
    gaps.add(key);
    baseline[key] = "TODO: reason";
  }
}

let propsCompared = 0;
for (const [slug, name] of rows) {
  const angular = tsCode(read("lily-design-system-angular-headless/components", `${name}.ts`));
  const ported = new Set(
    [...angular.matchAll(/\b(\w+)\s*=\s*(?:input|model|output)(?:\.required)?\s*[<(]/g)].map((match) => match[1]),
  );
  for (const prop of svelteProps(read("lily-design-system-svelte-headless/components", name, `${name}.svelte`))) {
    if (ALWAYS_PORTED.has(prop.name)) continue;
    propsCompared += 1;
    if (hasProp(prop, ported, angular)) continue;
    const key = `angular prop ${slug}.${prop.name}`;
    gaps.add(key);
    baseline[key] = "Not ported yet (tasks.md P25-T15).";
  }
}

if (baselineMode) {
  console.log(JSON.stringify(baseline, null, 2));
  process.exit(0);
}

let failures = 0;
for (const key of gaps) {
  if (allow[key]) continue;
  console.log(`FAIL ${key}: ${key.includes(" prop ") ? "Svelte has this prop, this port does not" : "Svelte has behaviour, this port has no logic"}`);
  failures += 1;
}
for (const key of Object.keys(allow)) {
  if (gaps.has(key)) continue;
  console.log(`FAIL stale allow-list entry (this port has logic now): ${key}`);
  failures += 1;
}
if (failures) {
  console.log(`\n${failures} problem(s). Port it, or list it with a reason in bin/check-port-logic.allow.json.`);
  process.exit(1);
}
if (!quiet)
  console.log(
    `port logic: ${compared} components with behaviour in Svelte, ${propsCompared} Svelte props compared, ${gaps.size} allow-listed, no unlisted gaps`,
  );

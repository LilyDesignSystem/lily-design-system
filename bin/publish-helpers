#!/bin/sh
# Publish the Lily Design System helper packages.
#
#   - npm packages: the svelte / react / vue / angular / html / nunjucks
#     the `*-picker` helpers in each catalog. The globs are
#     deliberately broad — every loop guards on package.json / dist / *.csproj
#     existing — so a new helper is picked up without editing this script.
#   - NuGet packages: the Blazor helpers.
#
# Usage:
#   bin/publish-helpers --dry-run     # validate tarballs/packs, publish nothing
#   bin/publish-helpers --nuget-only  # publish only the 5 Blazor packages (real)
#   bin/publish-helpers --nuget-only --dry-run  # same, dry-run
#   bin/publish-helpers               # publish everything for real
#
# Requirements for a real publish:
#   - npm:   `npm login` (or NPM_TOKEN in ~/.npmrc) with rights to the
#            `lily-design-system-*` package names.
#   - NuGet: NUGET_API_KEY env var with push rights to nuget.org.
#
# Note: the npm helper packages ship their source (`main` -> ./index.ts),
# matching the catalog convention; consumers compile the source via their
# own bundler.
#
# --nuget-only mirrors bin/publish-headless's flag and exists for the same
# reason: the npm and NuGet lines don't release together, and `set -eu`
# means the first already-published npm version would otherwise abort the
# script before the NuGet section ever runs.
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DRY=""
NUGET_ONLY=""
ONLY=""
prev=""
for arg in "$@"; do
  case "$prev" in --only) ONLY="$arg"; prev=""; continue ;; esac
  case "$arg" in
    --dry-run) DRY="--dry-run" ;;
    --nuget-only) NUGET_ONLY="1" ;;
    --only) prev="--only" ;;
  esac
done
# --only <dir> restricts the run to one helper package, named by its
# top-level directory (e.g. --only lily-design-system-svelte-theme-picker
# or --only lily-design-system-blazor-theme-picker), so a first release of
# one package does not re-run every other. The Blazor/NuGet section runs
# only when no --only is given, or when it names a Blazor helper package.
only_matches() { [ -z "$ONLY" ] || [ "$(basename "$1")" = "$ONLY" ]; }

# Every npm helper package's prepublishOnly runs its CATALOG's build
# (tsup / ng-packagr), which needs that catalog's devDependencies. The
# publish workflow installs none of them, so on 2026-09-03 a real CI
# run failed every package with `sh: 1: tsup: not found` — and the
# status bug above turned that into a green job. Install from the
# committed lockfile before touching a catalog, here rather than in the
# workflow, so the local and CI paths cannot drift apart.
ensure_installed() {
  catalog="$1"
  if [ ! -d "$catalog/node_modules" ]; then
    echo "--> installing $(basename "$catalog") devDependencies (frozen lockfile)"
    ( cd "$catalog" && pnpm install --frozen-lockfile )
  fi
}

# `npm publish` (dry-run or real) contacts the registry and refuses
# outright ("You cannot publish over the previously published versions")
# when the local version is already published there. That is the
# expected, non-fatal outcome for every package that has already shipped
# at its current version — a release run is idempotent, exactly as the
# NuGet section below is via `--skip-duplicate`. Left unhandled, `set -eu`
# turns that refusal into a hard abort on the FIRST already-published
# package the loop reaches, so every later package — including a
# brand-new, never-published one — is never reached at all (found
# 2026-09-03 in dry-run mode, plan P7-T19; the same abort would have hit
# a real run of a mixed catalog, so the tolerance applies in both modes
# since 2026-09-03). Every other failure (bad manifest, auth error,
# network error, missing dist, ...) still aborts the script for real.
# `status` MUST be captured inside the failure branch. Captured after
# the `if` statement instead, $? is the status of the `if` compound —
# which is 0 when the condition fails and no else-branch runs — so
# every failure was silently returned as success. That masked a real
# CI failure on 2026-09-03: every package's prepublishOnly build
# failed, the loop carried on, and the workflow went green while
# publishing nothing. Found by verifying against the registry, not
# the job status.
publish_npm_package() {
  dir="$1"
  if output="$(cd "$dir" && npm publish --access public $DRY 2>&1)"; then
    printf '%s\n' "$output"
    return 0
  else
    status=$?
    printf '%s\n' "$output"
    if printf '%s' "$output" | grep -q "You cannot publish over the previously published versions"; then
      echo "    (already published at this version -- skipped, same as NuGet --skip-duplicate)"
      return 0
    fi
    echo "    publish FAILED (exit $status) -- aborting; this is not the already-published case" >&2
    return "$status"
  fi
}

if [ -z "$NUGET_ONLY" ]; then
  echo "== npm helper packages =="
  # Top-level helper packages (the catalogs dissolved into one subproject
  # per package, Svelte first, 2026-10-10): each is its own pnpm root, so
  # install and publish it in place (its `prepublishOnly` runs its own
  # build). --only names the package directory itself.
  for d in $(for fw in svelte react vue html web-components nunjucks; do "$ROOT/bin/list-helper-packages" "$fw"; done); do
    d="$ROOT/$d"
    [ -f "$d/package.json" ] || continue
    only_matches "$d" || continue
    ensure_installed "$d"
    echo "--> $(basename "$d")"
    publish_npm_package "$d"
  done

  # Angular: ng-packagr writes the publishable package.json INTO dist/, so
  # each package is built first (in dependency order) and published from its
  # dist/. Its own package.json's prepublishOnly refuses a publish from the
  # source directory, which ships no compiled code.
  for d in $("$ROOT/bin/list-helper-packages" angular); do
    d="$ROOT/$d"
    only_matches "$d" || continue
    ensure_installed "$d"
    echo "--> $(basename "$d") (ng-packagr, from dist/)"
    pnpm -C "$d" build
    publish_npm_package "$d/dist"
  done
fi

# The Blazor NuGet section runs when no --only is given, or when --only
# names one of the Blazor helper packages (one top-level subproject each).
BLAZOR_PACKAGES="$("$ROOT/bin/list-helper-packages" blazor)"
if [ -n "$ONLY" ] && ! printf '%s\n' "$BLAZOR_PACKAGES" | grep -qx -- "$ONLY"; then
  echo "(--only $ONLY: skipping the Blazor NuGet section)"
  exit 0
fi
echo "== Blazor NuGet packages =="
NUPKG_OUT="$ROOT/dist-nuget"
# Clean first. The push loop below publishes every .nupkg in this
# directory, so stale artefacts from an earlier run — including ones
# built under package names that have since been renamed away — would be
# pushed to nuget.org and claim those names irreversibly.
rm -rf "$NUPKG_OUT"
mkdir -p "$NUPKG_OUT"
for d in $BLAZOR_PACKAGES; do
  only_matches "$ROOT/$d" || continue
  for proj in "$ROOT/$d"/*.csproj; do
    [ -f "$proj" ] || continue
    echo "--> pack $(basename "$proj")"
    dotnet pack "$proj" -c Release -o "$NUPKG_OUT"
  done
done
if [ -z "$DRY" ]; then
  : "${NUGET_API_KEY:?set NUGET_API_KEY to push to nuget.org}"
  for pkg in "$NUPKG_OUT"/*.nupkg; do
    echo "--> push $(basename "$pkg")"
    dotnet nuget push "$pkg" --source https://api.nuget.org/v3/index.json --api-key "$NUGET_API_KEY" --skip-duplicate
  done
else
  echo "(dry run: packed .nupkg into $NUPKG_OUT, did not push)"
fi

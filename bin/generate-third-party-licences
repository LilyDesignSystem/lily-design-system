#!/usr/bin/env node
// bin/generate-third-party-licences — what each published package depends on, and the licences (tasks.md P50-T18).
//
// Reads every published npm package.json (`@lilydesignsystem/*`, not private: dependencies, peerDependencies and
// optionalDependencies outside @lilydesignsystem) and every packable .csproj (one with a <PackageId>: its
// PackageReferences), and writes docs/third-party-licences.md from them and docs/third-party-licences.tsv, the record of
// each dependency's licence and when it was verified against its registry. It fails when a dependency has no row in the
// TSV, when a licence is not one of ALLOWED (permissive licences that ask only for notice), and when a row names a
// dependency nothing uses. Lily bundles none of these: a package manager installs each under its own licence.
//
// Usage:
//   bin/generate-third-party-licences           write docs/third-party-licences.md
//   bin/generate-third-party-licences --check   exit 1 if a rule fails or the file is out of date (bin/test runs this)
"use strict";

const fs = require("node:fs");
const path = require("node:path");

const top = path.resolve(__dirname, "..");
const OUT = "docs/third-party-licences.md";
const TSV = "docs/third-party-licences.tsv";
const ALLOWED = new Set(["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "0BSD"]);
const read = (p) => fs.readFileSync(path.join(top, p), "utf-8");

const used = new Map(); // "ecosystem\tpackage" -> Set of Lily packages
const add = (eco, dep, by) => {
    const key = `${eco}\t${dep}`;
    if (!used.has(key)) used.set(key, new Set());
    used.get(key).add(by);
};
let npmCount = 0;
let nugetCount = 0;
const subprojects = fs.readdirSync(top).filter((d) => d.startsWith("lily-design-system-")).sort();
for (const sub of subprojects) {
    const pj = path.join(sub, "package.json");
    if (fs.existsSync(path.join(top, pj))) {
        const p = JSON.parse(read(pj));
        if (!p.private && String(p.name || "").startsWith("@lilydesignsystem/")) {
            npmCount++;
            for (const kind of ["dependencies", "peerDependencies", "optionalDependencies"])
                for (const dep of Object.keys(p[kind] || {}))
                    if (!dep.startsWith("@lilydesignsystem/")) add("npm", dep, p.name);
        }
    }
    const walk = (dir) => {
        for (const e of fs.readdirSync(path.join(top, dir), { withFileTypes: true })) {
            if (["bin", "obj", "node_modules", "dist", ".svelte-kit"].includes(e.name)) continue;
            const rel = path.join(dir, e.name);
            if (e.isDirectory()) walk(rel);
            else if (e.name.endsWith(".csproj")) {
                const t = read(rel);
                const id = /<PackageId>([^<]+)<\/PackageId>/.exec(t);
                if (!id) continue;
                nugetCount++;
                for (const m of t.matchAll(/<PackageReference\s+Include="([^"]+)"/g)) add("nuget", m[1], id[1]);
            }
        }
    };
    walk(sub);
}

const rows = read(TSV)
    .trim()
    .split("\n")
    .slice(1)
    .map((l) => l.split("\t"));
const record = new Map(rows.map(([eco, pkg, licence, verified, note]) => [`${eco}\t${pkg}`, { licence, verified, note }]));

const problems = [];
for (const key of used.keys()) {
    const r = record.get(key);
    if (!r) problems.push(`${key.replace("\t", " ")}: no row in ${TSV}; add its licence and the date you checked it`);
    else if (!ALLOWED.has(r.licence))
        problems.push(`${key.replace("\t", " ")}: licence ${r.licence} is not one of ${[...ALLOWED].join(", ")}; decide before depending on it`);
}
for (const key of record.keys())
    if (!used.has(key)) problems.push(`${TSV}: ${key.replace("\t", " ")} is used by no published package; remove the row`);

const users = (set) => {
    const list = [...set].sort();
    return list.length > 6 ? `${list.length} packages, from \`${list[0]}\` to \`${list.at(-1)}\`` : list.map((n) => `\`${n}\``).join(", ");
};
const lines = [
    "# Third-party licences",
    "",
    `_Generated by \`bin/generate-third-party-licences\` from the ${npmCount} published npm packages, the ${nugetCount} NuGet packages and`,
    `[third-party-licences.tsv](third-party-licences.tsv); do not edit. Lily bundles none of these: the consumer's package manager`,
    "installs each under its own licence. A dependency is allowed when its licence is one of " +
        [...ALLOWED].map((l) => `\`${l}\``).join(", ") +
        "._",
    "",
    "| Ecosystem | Package | Licence | Verified | Used by | Note |",
    "| --- | --- | --- | --- | --- | --- |",
    ...[...used.keys()].sort().map((key) => {
        const [eco, pkg] = key.split("\t");
        const r = record.get(key) || { licence: "?", verified: "", note: "" };
        return `| ${eco} | \`${pkg}\` | ${r.licence} | ${r.verified} | ${users(used.get(key))} | ${r.note} |`;
    }),
    "",
];
const text = lines.join("\n");

if (problems.length) {
    for (const p of problems) console.error("FAIL " + p);
    process.exit(1);
}
if (process.argv.includes("--check")) {
    const current = fs.existsSync(path.join(top, OUT)) ? read(OUT) : "";
    if (current !== text) {
        console.error(`${OUT} is stale; run bin/generate-third-party-licences`);
        process.exit(1);
    }
    console.log(`generate-third-party-licences: ${used.size} third-party dependencies, all allowed: OK`);
} else {
    fs.writeFileSync(path.join(top, OUT), text);
    console.log(`wrote ${OUT} (${used.size} third-party dependencies)`);
}

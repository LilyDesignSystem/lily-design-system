#!/usr/bin/env python3
"""bin/sync-maui-core — one C# source for the pure logic Blazor and .NET MAUI share.

The Blazor headless library holds Lily's pure C# modules (clinical formatting, the IPS sections, the record-list
state, the wheel-picker keys and their small types). They depend on nothing but the base class library, so the
.NET MAUI core library, LilyDesignSystem.Maui.Core, takes a copy of each with its namespace changed
(LilyBlazorHeadless.Components to LilyDesignSystem.Maui.Core). Blazor is the one source (spec/dotnet-maui).

Usage:
  bin/sync-maui-core          write every differing copy
  bin/sync-maui-core --check  report drift and exit 1 (wired into bin/test)

Edit the Blazor file, then run this script; never edit the MAUI copy.
"""
import sys
from pathlib import Path

top = Path(__file__).resolve().parent.parent
source = top / "lily-design-system-blazor-headless/src/LilyBlazorHeadless/Components"
target = top / "lily-design-system-maui/src/LilyDesignSystem.Maui.Core/Shared"
FILES = [
    "ClinicalFormat.cs",
    "ClinicalTypes.cs",
    "IpsSections.cs",
    "ObservationRange.cs",
    "QuantityUnit.cs",
    "RecordListState.cs",
    "WheelPickerKeys.cs",
    "WheelPickerOption.cs",
]
HEADER = "// Generated by bin/sync-maui-core from lily-design-system-blazor-headless/src/LilyBlazorHeadless/Components/{name}; edit that file.\n"

check = "--check" in sys.argv[1:]
drift = []
for name in FILES:
    text = (source / name).read_text(encoding="utf-8")
    if "namespace LilyBlazorHeadless.Components;" not in text:
        sys.exit(f"sync-maui-core: {name} has no 'namespace LilyBlazorHeadless.Components;' to rewrite")
    if "Microsoft.AspNetCore" in text:
        sys.exit(f"sync-maui-core: {name} uses ASP.NET Core and cannot be shared")
    wanted = HEADER.format(name=name) + text.replace(
        "namespace LilyBlazorHeadless.Components;", "namespace LilyDesignSystem.Maui.Core;"
    )
    path = target / name
    current = path.read_text(encoding="utf-8") if path.exists() else None
    if current == wanted:
        continue
    drift.append(name)
    if not check:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(wanted, encoding="utf-8")
        print(f"synced: {path.relative_to(top)}")

if check and drift:
    for name in drift:
        print(f"    drift: lily-design-system-maui/src/LilyDesignSystem.Maui.Core/Shared/{name}")
    print(f"    {len(drift)} file(s) differ from Blazor; run bin/sync-maui-core")
    sys.exit(1)
print(f"sync-maui-core: {len(FILES)} files, {'drift ' + str(len(drift)) if drift else 'current'}")

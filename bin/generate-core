#!/usr/bin/env node
// bin/generate-core — tasks.md P16-T2 and P16-T7 (spec/competitive-position items 2 and 7).
//
// Builds the "Lily Core" tier from evidence found in the tree, and the documents that publish it:
//
//   spec/competitive-position/core.json                    the data: candidates, per-criterion evidence, Core members
//   docs/core.md                                           the same, readable, with every evidence path linked
//   docs/accessibility-conformance-report.md               a self-assessed ACR (VPAT 2.5 WCAG edition) for the candidates
//   lilydesignsystem.github.io/src/routes/quality/+page.svelte   the site's /quality page
//
// A component is a Core *candidate* when it is in the CANDIDATES list below (enumerated from
// docs/audit-readiness.md tier 1). It is a Core *member* only when all three entry criteria hold:
//
//   (a) keyboard and ARIA-state tests in all eight libraries (svelte, react, vue, angular, html,
//       web-components, nunjucks, blazor). Heuristic, per library, over the component's own test
//       file(s): the file sends a key event (KEY_RE / BLAZOR_KEY_RE) AND has a line that names an
//       aria-* attribute together with an assertion or query (ARIA_LINE_RE + ASSERT_RE), or the file
//       runs a pattern tester (PATTERN_RE), which does both from shared/pattern-contracts.json. The key
//       half is waived only when the component's components/<slug>/AGENTS.md "## Keyboard" section
//       says "No keyboard interactions", and in Blazor when the component has no key handler or
//       .razor.js of its own: its keys are the browser's, or a shared module's, and bUnit runs no
//       browser. The ARIA half is waived when "## ARIA" says the native element needs none. File-level, not test-level: the key event and the ARIA
//       assertion may be in different tests, and a skipped test still counts. It is a floor, not proof.
//   (b) e2e in Chromium, Firefox and WebKit: some Playwright spec that covers the component (its
//       e2e/components/<slug>.spec.ts, or another spec naming its route or class hook) runs in a
//       playwright.config.* project for that browser, and that project's testMatch selects the spec;
//       all three browsers needed. A project with a testMatch runs only those specs (2026-11-06).
//   (c) its row of docs/screen-reader-matrix.md filled, with a pass or minor mark, in all six
//       combination columns (MATRIX_COLUMNS). An empty cell, a fail, or no row at all fails (c).
//
// No evidence is invented: every status is computed from files, and a cell that is not observed is "missing".
//
//   bin/generate-core                      write the four outputs
//   bin/generate-core --check              exit 1 if an output is stale, or if a component recorded as
//                                          Core in core.json no longer meets every criterion
//   bin/generate-core --allow-demotion     write even though a recorded Core member lost evidence
//
// The report date in the ACR and core.json is kept unless something else in the output changes.

const fs = require("fs");
const path = require("path");

const top = process.env.LILY_ROOT || path.join(__dirname, "..");
const abs = (p) => path.resolve(top, p);
const exists = (p) => fs.existsSync(abs(p));
const read = (p) => fs.readFileSync(abs(p), "utf8");
const check = process.argv.includes("--check");
const allowDemotion = process.argv.includes("--allow-demotion");
const today = new Date().toISOString().slice(0, 10);
const REPO = "https://github.com/LilyDesignSystem/lily-design-system/blob/main/";

const OUT = {
  json: process.env.LILY_CORE_JSON || "spec/competitive-position/core.json",
  md: "docs/core.md",
  acr: "docs/accessibility-conformance-report.md",
  page: "lilydesignsystem.github.io/src/routes/quality/+page.svelte",
};

// ---------- the candidates (docs/audit-readiness.md tier 1, enumerated) ----------

// group: the tier-1 phrase it comes from. helper: a separate helper package, not a catalog component.
// row: its row number in docs/screen-reader-matrix.md, or null when the matrix has no row for it.
const CANDIDATES = [
  ["form", "form family", 11],
  ["field", "form family", 11],
  ["label", "form family", 21],
  ["hint", "form family", 22],
  ["error-message", "form family", 23],
  ["error-summary", "form family", 11],
  ["fieldset", "form family", 24],
  ["button", "form family", 25],
  ["text-input", "form family", 12],
  ["email-input", "form family", 26],
  ["password-input", "form family", 27],
  ["number-input", "form family", 28],
  ["text-area-input", "form family", 29],
  ["date-input", "form family", 15],
  ["select", "form family", 13],
  ["checkbox-input", "form family", 14],
  ["checkbox-group", "form family", 30],
  ["radio-input", "form family", 14],
  ["radio-group", "form family", 31],
  ["net-promoter-score-picker", "form family", 20],
  ["theme-picker", "helper packages", 1, true],
  ["locale-picker", "helper packages", 2, true],
  ["text-size-picker", "helper packages", 32, true],
  ["share-picker", "helper packages", 4, true],
  ["date-time-picker", "helper packages", 3, true],
  ["dialog", "dialogs", 5],
  ["alert-dialog", "dialogs", 6],
  ["tab-bar", "tabs", 7],
  ["tab-bar-button", "tabs", 33],
  ["tab-panel", "tabs", 34],
  ["menu", "menus", 9],
  ["menu-bar", "menus", 35],
  ["dropdown-menu", "menus", 36],
  ["context-menu", "menus", 37],
  ["accordion-nav", "accordion", 8],
  ["tree-nav", "navigation", 10],
  ["breadcrumb-nav", "navigation", 18],
  ["pagination-nav", "pagination", 17],
  ["data-table", "tables with sorting", 16],
  ["skip-link", "skip link", 19],
].map(([slug, group, row, helper]) => ({ slug, group, row, helper: !!helper }));

const NAMES = Object.fromEntries(
  read("components.tsv")
    .split("\n")
    .filter((l) => l.trim())
    .map((l) => l.split("\t").slice(0, 2))
);
const pascal = (slug) => NAMES[slug] || slug.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join("");

// ---------- (a) keyboard and ARIA-state tests ----------

const LIBRARIES = ["svelte", "react", "vue", "angular", "html", "web-components", "nunjucks", "blazor"];
const LIBRARY_LABEL = {
  svelte: "Svelte", react: "React", vue: "Vue", angular: "Angular", html: "HTML",
  "web-components": "Web Components", nunjucks: "Nunjucks", blazor: "Blazor",
};

// Key events as each runner sends them: DOM KeyboardEvent, Testing Library fireEvent/user-event, Vue Test Utils
// trigger, Angular triggerEventHandler, WebdriverIO browser.keys, Playwright press.
const KEY_RE = /new (?:window\.)?KeyboardEvent\(|fireEvent\.key(?:Down|Up|Press)\b|\.keyboard\(|browser\.keys\(|\.trigger\(\s*["'`]key(?:down|up|press)|triggerEventHandler\(\s*["'`]key(?:down|up|press)|\.press\(\s*["'`]|\.tab\(\s*\)/;
const BLAZOR_KEY_RE = /\.KeyDown\(|\.KeyUp\(|\.KeyPress\(|new KeyboardEventArgs/;
// A pattern tester run (spec/testing#pattern-testers) sends real keys and asserts ARIA state, so it counts as both.
const PATTERN_RE = /\brunPattern\(|\bPatternTester\.Run\(/;
const ARIA_LINE_RE = /aria-[a-z]+|["'`]role["'`]|\brole=/;
const ASSERT_RE = /expect\(|Assert\.|assert\.|getAttribute\(|GetAttribute\(|toHaveAttribute\(|hasAttribute\(|attributes\(|querySelector|\.Find\(|FindAll\(/;

function walkTests(dir, acc = []) {
  if (!exists(dir)) return acc;
  for (const e of fs.readdirSync(abs(dir), { withFileTypes: true })) {
    if (["node_modules", "dist", "obj", "bin", ".svelte-kit", "e2e", "build"].includes(e.name)) continue;
    const rel = `${dir}/${e.name}`;
    if (e.isDirectory()) walkTests(rel, acc);
    else if (/\.(test|spec)\.(ts|tsx|js|mjs)$|Tests\.cs$/.test(e.name)) acc.push(rel);
  }
  return acc.sort();
}

function siblingTests(dir, re) {
  if (!exists(dir)) return [];
  return fs.readdirSync(abs(dir)).filter((f) => re.test(f)).sort().map((f) => `${dir}/${f}`);
}
const esc = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

function testFiles(c, lib) {
  if (c.helper) return walkTests(`lily-design-system-${lib}-${c.slug}`);
  const N = esc(pascal(c.slug));
  const s = esc(c.slug);
  const base = `lily-design-system-${lib}-headless`;
  switch (lib) {
    case "svelte": return siblingTests(`${base}/components/${pascal(c.slug)}`, /\.test\.ts$/);
    case "react": return siblingTests(`${base}/components`, new RegExp(`^${N}(\\.[\\w-]+)?\\.test\\.tsx$`));
    case "vue": return siblingTests(`${base}/components`, new RegExp(`^${N}(\\.[\\w-]+)?\\.test\\.ts$`));
    case "angular": return siblingTests(`${base}/components`, new RegExp(`^${N}(\\.[\\w-]+)?\\.spec\\.ts$`));
    case "html": return siblingTests(`${base}/components`, new RegExp(`^${s}(\\.[\\w-]+)?\\.test\\.js$`));
    case "web-components": return siblingTests(`${base}/components`, new RegExp(`^${s}(\\.[\\w-]+)?\\.test\\.ts$`));
    case "nunjucks": return siblingTests(`${base}/components/${c.slug}`, /\.test\.js$/);
    case "blazor": return [
      ...siblingTests(`${base}/tests/LilyBlazorHeadless.Tests/Components`, new RegExp(`^${N}Tests\\.cs$`)),
      // Keys live in {Name}.razor.js, which bUnit cannot run: tests/js drives them under jsdom.
      ...siblingTests(`${base}/tests/js`, new RegExp(`^${s}(\\.[\\w-]+)?\\.test\\.mjs$`)),
    ];
  }
  return [];
}

function keyboardContract(c) {
  if (c.helper) return "keys"; // hand-rolled listbox / disclosure / dialog patterns
  const p = `components/${c.slug}/AGENTS.md`;
  if (!exists(p)) return "keys";
  const m = read(p).match(/^## Keyboard\n([\s\S]*?)(?=^## |(?![\s\S]))/m);
  return m && /No keyboard interactions/i.test(m[1]) ? "none" : "keys";
}

// The contract says the native element carries all of it, as for <label>, <fieldset> and <a href>.
function ariaContract(c) {
  if (c.helper) return "aria";
  const p = `components/${c.slug}/AGENTS.md`;
  if (!exists(p)) return "aria";
  const m = read(p).match(/^## ARIA\n([\s\S]*?)(?=^## |(?![\s\S]))/m);
  return m && /No (additional|custom|explicit) ARIA/i.test(m[1]) ? "none" : "aria";
}

// bUnit's KeyDown needs a handler on the element and runs no browser, so a component with none has no key to send.
function noBlazorKeyHandler(c) {
  if (c.helper) return false;
  const base = `lily-design-system-blazor-headless/src/LilyBlazorHeadless/Components/${pascal(c.slug)}.razor`;
  return exists(base) && !exists(`${base}.js`) && !/@onkey/.test(read(base));
}

// Nunjucks ships these as a bare native <dialog>, with no script: the consumer opens it, and Escape and the Tab trap
// are the browser's, which jsdom does not run.
const MARKUP_ONLY_DIALOGS = new Set(["dialog", "alert-dialog"]);

function criterionA(c) {
  const contract = keyboardContract(c);
  const aria = ariaContract(c);
  const libs = {};
  for (const lib of LIBRARIES) {
    const files = testFiles(c, lib);
    let keyFile = null, ariaFile = null;
    for (const f of files) {
      const src = read(f);
      if (!keyFile && ((lib === "blazor" && !f.endsWith(".mjs") ? BLAZOR_KEY_RE : KEY_RE).test(src) || PATTERN_RE.test(src))) keyFile = f;
      if (!ariaFile && (PATTERN_RE.test(src) || src.split("\n").some((l) => ARIA_LINE_RE.test(l) && ASSERT_RE.test(l)))) ariaFile = f;
    }
    const browserKeys = !keyFile && ((lib === "blazor" && noBlazorKeyHandler(c)) || (lib === "nunjucks" && MARKUP_ONLY_DIALOGS.has(c.slug)));
    const keyOk = contract === "none" || !!keyFile || browserKeys;
    const ariaOk = aria === "none" || !!ariaFile;
    libs[lib] = {
      status: files.length === 0 ? "no test file" : keyOk && ariaOk ? "met" : !keyOk && !ariaOk ? "no key event, no ARIA assertion" : !keyOk ? "no key event" : "no ARIA assertion",
      met: files.length > 0 && keyOk && ariaOk,
      testFiles: files,
      keyEvent: contract === "none" ? "not required (AGENTS.md: no keyboard interactions)" : browserKeys ? "not sendable (no key handler in the component, and the test runner runs no browser)" : keyFile,
      ariaAssertion: ariaFile || (aria === "none" ? "not required (AGENTS.md: native semantics, no ARIA)" : null),
    };
  }
  const metCount = LIBRARIES.filter((l) => libs[l].met).length;
  return { met: metCount === LIBRARIES.length, metCount, keyboardContract: contract, libraries: libs };
}

// ---------- (b) e2e in Chromium, Firefox and WebKit ----------

const E2E_APPS = [
  "lily-design-system-svelte-sveltekit-examples",
  "lily-design-system-react-next-examples",
  "lily-design-system-vue-nuxt-examples",
  "lily-design-system-angular-examples",
  "lily-design-system-html-css-js-examples",
  "lily-design-system-nunjucks-eleventy-examples",
  "lily-design-system-blazor-web-examples",
  "lily-design-system-alpine-examples",
  "lilydesignsystem.github.io",
];
const BROWSERS = ["chromium", "firefox", "webkit"];

function appBrowsers(app) {
  const cfg = ["playwright.config.ts", "playwright.config.js", "playwright.config.mjs"].map((f) => `${app}/${f}`).find(exists);
  if (!cfg) return { config: null, browsers: [] };
  const src = read(cfg);
  const found = new Set();
  for (const m of src.matchAll(/name:\s*["'](chromium|firefox|webkit)["']/g)) found.add(m[1]);
  if (/devices\[\s*["']Desktop Chrome/.test(src)) found.add("chromium");
  if (/devices\[\s*["']Desktop Firefox/.test(src)) found.add("firefox");
  if (/devices\[\s*["']Desktop Safari/.test(src)) found.add("webkit");
  for (const m of src.matchAll(/browserName:\s*["'](chromium|firefox|webkit)["']/g)) found.add(m[1]);
  // A project may run only some specs: its testMatch, a regex literal or a const holding one, is kept per browser.
  const only = {};
  for (const line of src.split("\n")) {
    const b = BROWSERS.find((x) => new RegExp(`name:\\s*["']${x}["']`).test(line));
    const m = b && line.match(/testMatch:\s*(\/.+\/|\w+)/);
    if (!m) continue;
    const lit = m[1].startsWith("/") ? m[1] : (src.match(new RegExp(`const ${m[1]}\\s*=\\s*(\\/.+\\/)[a-z]*;`)) || [])[1];
    if (!lit) throw new Error(`${cfg}: cannot read testMatch for ${b}`);
    only[b] = new RegExp(lit.slice(1, -1));
  }
  return { config: cfg, browsers: BROWSERS.filter((b) => found.has(b)), only };
}

function specFiles(dir, acc = []) {
  if (!exists(dir)) return acc;
  for (const e of fs.readdirSync(abs(dir), { withFileTypes: true })) {
    const rel = `${dir}/${e.name}`;
    if (e.isDirectory()) { if (!e.name.endsWith("-snapshots")) specFiles(rel, acc); }
    else if (/\.spec\.(ts|js)$/.test(e.name)) acc.push(rel);
  }
  return acc.sort();
}

const APP_INFO = E2E_APPS.filter(exists).map((app) => {
  const dir = app === "lilydesignsystem.github.io" ? `${app}/tests` : `${app}/e2e`;
  return { app, ...appBrowsers(app), specs: specFiles(dir).map((f) => ({ file: f, src: read(f) })) };
});

function criterionB(c) {
  const s = esc(c.slug);
  // Helper slugs are distinctive (theme-picker, ...) and the app shells mount them without a route, so any
  // hyphen-aware mention counts; a catalog slug (form, menu, select) must appear as a route or a class hook.
  const mention = c.helper
    ? new RegExp(`(?<![\\w-])${s}(?![\\w-])`)
    : new RegExp(`/components/${s}(?![\\w-])|["'\` >]\\.${s}(?![\\w-])`);
  const specs = [];
  for (const a of APP_INFO) {
    for (const sp of a.specs) {
      const own = path.basename(sp.file) === `${c.slug}.spec.ts` || path.basename(sp.file) === `${c.slug}.spec.js`;
      if (own || mention.test(sp.src)) {
        specs.push({ spec: sp.file, config: a.config, browsers: a.browsers.filter((b) => !a.only[b] || a.only[b].test(sp.file)) });
      }
    }
  }
  const covered = BROWSERS.filter((b) => specs.some((x) => x.browsers.includes(b)));
  return { met: covered.length === BROWSERS.length, browsers: covered, specs };
}

// ---------- (c) the screen-reader matrix ----------

const MATRIX = "docs/screen-reader-matrix.md";
const MATRIX_COLUMNS = [
  "NVDA + Firefox",
  "NVDA + Chrome",
  "JAWS + Chrome",
  "VoiceOver + Safari (macOS)",
  "VoiceOver (iOS)",
  "TalkBack + Chrome (Android)",
];

function parseMatrix() {
  const src = read(MATRIX);
  const sec = src.match(/^## The candidates\n([\s\S]*?)(?=^## )/m);
  if (!sec) throw new Error(`${MATRIX}: no "## The candidates" section`);
  const lines = sec[1].split("\n").filter((l) => l.startsWith("|"));
  const cells = (l) => l.trim().replace(/^\||\|$/g, "").split("|").map((x) => x.trim());
  const head = cells(lines[0]);
  const missing = MATRIX_COLUMNS.filter((col) => !head.includes(col));
  if (missing.length) throw new Error(`${MATRIX}: missing column(s): ${missing.join(", ")}`);
  const rows = {};
  for (const l of lines.slice(2)) {
    const r = cells(l);
    const n = parseInt(r[0], 10);
    if (!n) continue;
    rows[n] = { label: r[1], cells: Object.fromEntries(MATRIX_COLUMNS.map((col) => [col, r[head.indexOf(col)] || ""])) };
  }
  return rows;
}
const MATRIX_ROWS = parseMatrix();

// A filled cell holds pass (#N) or minor (#N); a fail is recorded but does not meet (c).
const cellResult = (v) => (!v ? "empty" : /^pass\b/i.test(v) ? "pass" : /^minor\b/i.test(v) ? "minor" : /^fail\b/i.test(v) ? "fail" : "unrecognised");

function criterionC(c) {
  if (c.row === null || !MATRIX_ROWS[c.row]) {
    return { met: false, row: null, filled: 0, cells: {}, note: "no row in the matrix" };
  }
  const row = MATRIX_ROWS[c.row];
  const cells = Object.fromEntries(MATRIX_COLUMNS.map((col) => [col, { value: row.cells[col], result: cellResult(row.cells[col]) }]));
  const filled = MATRIX_COLUMNS.filter((col) => ["pass", "minor"].includes(cells[col].result)).length;
  return { met: filled === MATRIX_COLUMNS.length, row: c.row, rowLabel: row.label, filled, cells };
}

// ---------- assemble ----------

const candidates = CANDIDATES.map((c) => {
  const a = criterionA(c), b = criterionB(c), cc = criterionC(c);
  return { slug: c.slug, group: c.group, helper: c.helper, keyboard: a, e2e: b, screenReader: cc, core: a.met && b.met && cc.met };
});
const core = candidates.filter((c) => c.core).map((c) => c.slug);

const counts = {
  candidates: candidates.length,
  keyboard: candidates.filter((c) => c.keyboard.met).length,
  e2e: candidates.filter((c) => c.e2e.met).length,
  screenReader: candidates.filter((c) => c.screenReader.met).length,
  core: core.length,
  keyboardPerLibrary: Object.fromEntries(LIBRARIES.map((l) => [l, candidates.filter((c) => c.keyboard.libraries[l].met).length])),
  matrixRows: candidates.filter((c) => c.screenReader.row !== null).length,
  matrixCellsFilled: Object.values(MATRIX_ROWS).reduce((n, r) => n + MATRIX_COLUMNS.filter((col) => r.cells[col]).length, 0),
  matrixCells: Object.keys(MATRIX_ROWS).length * MATRIX_COLUMNS.length,
  e2eBrowsersRun: BROWSERS.filter((b) => APP_INFO.some((a) => a.browsers.includes(b))),
};

// ---------- the Core-loss gate ----------

let previous = null;
if (exists(OUT.json)) {
  try { previous = JSON.parse(read(OUT.json)); } catch (e) { previous = null; }
}
const lost = [];
for (const slug of (previous && previous.core) || []) {
  const c = candidates.find((x) => x.slug === slug);
  if (!c) { lost.push(`${slug}: recorded as Core but no longer a candidate`); continue; }
  const why = [];
  if (!c.keyboard.met) why.push(`(a) keyboard/ARIA tests in ${c.keyboard.metCount} of 8 libraries (${LIBRARIES.filter((l) => !c.keyboard.libraries[l].met).join(", ")} missing)`);
  if (!c.e2e.met) why.push(`(b) e2e browsers: ${browserList(c.e2e.browsers)}`);
  if (!c.screenReader.met) why.push(`(c) screen-reader cells filled: ${c.screenReader.filled} of ${MATRIX_COLUMNS.length}`);
  if (why.length) lost.push(`${slug}: in Core but lost evidence: ${why.join("; ")}`);
}

// ---------- renderers ----------

const BROWSER_LABEL = { chromium: "Chromium", firefox: "Firefox", webkit: "WebKit" };
const browserList = (bs) => bs.map((b) => BROWSER_LABEL[b]).join(", ") || "none";

// Why no candidate is in Core, from the counts (so the sentence changes when the evidence does).
function whyNone() {
  const r = [];
  if (counts.matrixCellsFilled === 0) r.push("the screen-reader matrix has no recorded results, so criterion (c) fails for every candidate");
  else if (counts.screenReader === 0) r.push("no candidate has a full screen-reader row, so criterion (c) fails for every candidate");
  const unrun = BROWSERS.filter((b) => !counts.e2eBrowsersRun.includes(b));
  if (unrun.length) r.push(`no e2e suite runs in ${unrun.map((b) => BROWSER_LABEL[b]).join(" or ")}, so criterion (b) fails for every candidate`);
  else if (counts.e2e === 0) r.push("no candidate has e2e coverage in all three browsers");
  if (counts.keyboard === 0) r.push("no candidate has keyboard and ARIA-state tests in all eight libraries");
  return r.length ? r.join("; and ") : "each candidate lacks at least one criterion";
}
const cap = (s) => s[0].toUpperCase() + s.slice(1);

const yes = (b) => (b ? "met" : "not met");
const relFromDocs = (p) => `../${p}`;
const link = (p) => `[${p}](${relFromDocs(p)})`;

function renderJson(date) {
  return JSON.stringify({
    $comment: "Generated by bin/generate-core from the tree; do not edit. Core lists only components meeting all three criteria.",
    reportDate: date,
    criteria: {
      a: "keyboard and ARIA-state tests in all eight libraries (heuristic: a test file sends a key event and asserts an aria-* attribute; the key half is waived when AGENTS.md declares no keyboard interactions, in Blazor when the component has no key handler of its own, since bUnit runs no browser, and for the bare native dialogs in Nunjucks; the ARIA half is waived when AGENTS.md says the native element needs none)",
      b: "e2e coverage in Chromium, Firefox and WebKit (a covering Playwright spec in an app whose config runs that browser)",
      c: `screen-reader matrix row filled with pass or minor in all of: ${MATRIX_COLUMNS.join("; ")}`,
    },
    libraries: LIBRARIES,
    matrixColumns: MATRIX_COLUMNS,
    e2eApps: APP_INFO.map((a) => ({ app: a.app, config: a.config, browsers: a.browsers })),
    counts,
    core,
    candidates: candidates.map((c) => ({
      ...c,
      e2e: { ...c.e2e, specs: c.e2e.specs.map((s) => s.spec) },
    })),
  }, null, 2) + "\n";
}

function renderCoreMd(date) {
  const L = [];
  L.push("# Lily Core — candidates and evidence");
  L.push("");
  L.push(`_Generated by \`bin/generate-core\` from the tree on ${date}; do not edit. Data: [core.json](../spec/competitive-position/core.json). Plan: [spec/competitive-position](../spec/competitive-position/index.md) item 2._`);
  L.push("");
  L.push(`**Core members: ${core.length ? core.join(", ") : "none"}.**${core.length ? "" : ` No component meets all three entry criteria yet: ${whyNone()}.`}`);
  L.push("");
  L.push("## Entry criteria");
  L.push("");
  L.push("A candidate enters Core only when all three hold:");
  L.push("");
  L.push("- **(a) Keyboard and ARIA-state tests in all eight libraries** (" + LIBRARIES.map((l) => LIBRARY_LABEL[l]).join(", ") + "). Heuristic: the component's own test file(s) in that library send a key event (a `KeyboardEvent`, `fireEvent.keyDown`, `user.keyboard`, `trigger(\"keydown\")`, `browser.keys`, Playwright `press`, or bUnit `KeyDown`) **and** contain a line that names an `aria-*` attribute together with an assertion or query. In Blazor the key half is also waived for a component with no key handler or `.razor.js` of its own, because bUnit runs no browser, and for Nunjucks `dialog` and `alert-dialog`, which are bare native dialogs with no script. The ARIA half is waived when `AGENTS.md` says the native element needs none. The key half is waived when the component's `AGENTS.md` says it has no keyboard interactions. File level, not test level, so it is a floor, not proof.");
  L.push("- **(b) e2e in Chromium, Firefox and WebKit.** A Playwright spec that covers the component (its `e2e/components/<slug>.spec.ts`, or a spec naming its route or class hook) runs in an app whose config has a project for each browser.");
  L.push(`- **(c) Its row of the [screen-reader matrix](screen-reader-matrix.md) filled** with \`pass\` or \`minor\` in all six combinations: ${MATRIX_COLUMNS.join(", ")}. An empty cell, a \`fail\`, or no row fails (c).`);
  L.push("");
  L.push("## Counts");
  L.push("");
  L.push("| Criterion | Candidates meeting it |");
  L.push("| --- | --- |");
  L.push(`| (a) keyboard and ARIA-state tests, all eight libraries | ${counts.keyboard} of ${counts.candidates} |`);
  L.push(`| (b) e2e in Chromium, Firefox and WebKit | ${counts.e2e} of ${counts.candidates} |`);
  L.push(`| (c) screen-reader row filled, six combinations | ${counts.screenReader} of ${counts.candidates} |`);
  L.push(`| All three (Core) | ${counts.core} of ${counts.candidates} |`);
  L.push("");
  L.push("Per library, candidates meeting (a): " + LIBRARIES.map((l) => `${LIBRARY_LABEL[l]} ${counts.keyboardPerLibrary[l]}`).join(", ") + ".");
  L.push("");
  L.push(`Browsers any e2e app runs: ${browserList(counts.e2eBrowsersRun)}. Screen-reader matrix cells with any result: ${counts.matrixCellsFilled} of ${counts.matrixCells}. Candidates with a matrix row: ${counts.matrixRows} of ${counts.candidates}.`);
  L.push("");
  L.push("## Candidates");
  L.push("");
  L.push("| Candidate | Group | (a) libraries met | (b) browsers | (c) cells filled | Core |");
  L.push("| --- | --- | --- | --- | --- | --- |");
  for (const c of candidates) {
    L.push(`| [${c.slug}](#${c.slug}) | ${c.group} | ${c.keyboard.metCount} of 8 | ${browserList(c.e2e.browsers)} | ${c.screenReader.row === null ? "no row" : `${c.screenReader.filled} of 6 (row ${c.screenReader.row})`} | ${c.core ? "yes" : "no"} |`);
  }
  L.push("");
  L.push("## Evidence per candidate");
  for (const c of candidates) {
    L.push("");
    L.push(`### ${c.slug}`);
    L.push("");
    L.push(`${c.helper ? "Helper package" : "Catalog component"}; keyboard contract: ${c.keyboard.keyboardContract === "none" ? "none declared in AGENTS.md" : "keys named"}.`);
    L.push("");
    L.push(`- (a) ${yes(c.keyboard.met)}, ${c.keyboard.metCount} of 8 libraries:`);
    for (const l of LIBRARIES) {
      const e = c.keyboard.libraries[l];
      const files = e.testFiles.length ? e.testFiles.map(link).join(", ") : "no test file found";
      L.push(`  - ${LIBRARY_LABEL[l]}: ${e.status}. ${files}`);
    }
    L.push(`- (b) ${yes(c.e2e.met)}; browsers: ${browserList(c.e2e.browsers)}; ${c.e2e.specs.length} covering spec(s)${c.e2e.specs.length ? ":" : "."}`);
    for (const s of c.e2e.specs) L.push(`  - ${link(s.spec)} (${s.browsers.length ? browserList(s.browsers) : "no browser project found"})`);
    if (c.screenReader.row === null) {
      L.push("- (c) not met: the matrix has no row for this component.");
    } else {
      L.push(`- (c) ${yes(c.screenReader.met)}: [row ${c.screenReader.row}](screen-reader-matrix.md#the-candidates) (${c.screenReader.rowLabel}), ${c.screenReader.filled} of 6 cells with pass or minor.`);
    }
  }
  L.push("");
  L.push("---");
  L.push("");
  L.push("Lily™ and Lily Design System™ are trademarks.");
  return L.join("\n") + "\n";
}


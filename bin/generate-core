    ["2.3.1", "Three Flashes or Below Threshold"], ["2.4.1", "Bypass Blocks"], ["2.4.2", "Page Titled"], ["2.4.3", "Focus Order"],
    ["2.4.4", "Link Purpose (In Context)"], ["2.5.1", "Pointer Gestures"], ["2.5.2", "Pointer Cancellation"], ["2.5.3", "Label in Name"],
    ["2.5.4", "Motion Actuation"], ["3.1.1", "Language of Page"], ["3.2.1", "On Focus"], ["3.2.2", "On Input"], ["3.2.6", "Consistent Help"],

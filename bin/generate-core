// Success criteria whose evidence this generator can read, and which evidence. A criterion is "Supports" only when
// EVERY candidate has all of its evidence kinds; "Does Not Support" / "Partially Supports" only from a recorded
// screen-reader `fail`; otherwise "Not Evaluated", with any partial automated evidence named in the remarks.
const SC_EVIDENCE = {
  "2.1.1": ["a"],
  "2.1.2": ["a"],
  "1.3.1": ["c"],
  "4.1.2": ["a", "c"],
};
// Media criteria: none of the candidates renders audio or video (by inspection of the candidate list).
const NOT_APPLICABLE = new Set(["1.2.1", "1.2.2", "1.2.3", "1.2.4", "1.2.5", "1.2.6", "1.2.7", "1.2.8", "1.2.9", "1.4.2", "1.4.7"]);
const MEDIA_REMARK = "None of the candidate components plays audio or video, so this criterion does not apply to them. Assessed by inspection of the candidate list, not by a test.";

const has = (c, kind) => (kind === "a" ? c.keyboard.met : kind === "c" ? c.screenReader.met : false);

// The W3C "Understanding" page slug: "Contrast (Minimum)" -> "contrast-minimum".
const understanding = (name) => name.toLowerCase().replace(/[(),]/g, "").trim().replace(/\s+/g, "-");

function acrRow(id, name) {
  if (NOT_APPLICABLE.has(id)) return { level: "Not Applicable", remarks: MEDIA_REMARK };
  const kinds = SC_EVIDENCE[id];
  if (!kinds) return { level: "Not Evaluated", remarks: "Not evaluated. No test or matrix entry in this repository evaluates this criterion for the candidates." };
  const all = candidates.every((c) => kinds.every((k) => has(c, k)));
  const fails = kinds.includes("c") ? candidates.filter((c) => Object.values(c.screenReader.cells || {}).some((x) => x.result === "fail")) : [];
  const parts = [];
  if (kinds.includes("a")) parts.push(`keyboard and ARIA-state tests in all eight libraries for ${counts.keyboard} of ${counts.candidates} candidates ([evidence](core.md#candidates))`);
  if (kinds.includes("c")) parts.push(`screen-reader matrix rows filled for ${counts.screenReader} of ${counts.candidates} candidates ([matrix](screen-reader-matrix.md#the-candidates))`);
  if (all) return { level: "Supports", remarks: `Every candidate has: ${parts.join("; ")}.` };
  if (fails.length) {
    return {
      level: fails.length === candidates.length ? "Does Not Support" : "Partially Supports",
      remarks: `Recorded screen-reader failures for ${fails.map((c) => `[${c.slug}](core.md#${c.slug})`).join(", ")} ([matrix](screen-reader-matrix.md#the-candidates)). Automated evidence: ${parts.join("; ")}.`,
    };
  }
  return { level: "Not Evaluated", remarks: `Not evaluated. Partial automated evidence only, which is not an evaluation: ${parts.join("; ")}.` };
}

function renderAcr(date) {
  const L = [];
  const banner = `> **${LABEL}.** This report was written by the project about its own components, generated by \`bin/generate-core\` from the tests and the screen-reader matrix in this repository. No independent party has audited it.`;
  L.push("# Lily Design System™ Accessibility Conformance Report");
  L.push("");
  L.push("## WCAG Edition — VPAT® Version 2.5Rev (based on the ITI VPAT 2.5 WCAG template)");
  L.push("");
  L.push(banner);
  L.push("");
  L.push(`_Generated from [core.json](../spec/competitive-position/core.json); do not edit. Plan: [spec/competitive-position](../spec/competitive-position/index.md) item 7._`);
  L.push("");
  L.push("**Name of Product/Version:** Lily Design System headless component libraries (Svelte, React, Vue, Angular, HTML, Web Components, Nunjucks, Blazor) and the five helper packages, at the commit this report was generated from; each package's version is in its own manifest.");
  L.push("");
  L.push(`**Report Date:** ${date}`);
  L.push("");
  L.push("**Product Description:** Headless (unstyled) UI components with a shared contract per component (`components/<slug>/AGENTS.md`). This report covers only the Lily Core candidates listed below, not the whole catalog.");
  L.push("");
  L.push("**Contact Information:** <joel@joelparkerhenderson.com>, or an issue at <https://github.com/LilyDesignSystem/lily-design-system/>.");
  L.push("");
  L.push("**Notes:**");
  L.push("");
  L.push(`- ${LABEL}. Lily has never had a conformance audit; see the [accessibility statement](accessibility-statement.md).`);
  L.push(`- Scope: the ${counts.candidates} Core candidates: ${candidates.map((c) => c.slug).join(", ")}. Core members today: ${core.length ? core.join(", ") : "none"}. Evidence per candidate: [docs/core.md](core.md).`);
  L.push("- Headless components are evaluated as rendered by the example apps; colour, contrast, spacing and focus styling come from the consumer's theme, so criteria that depend on presentation hold only for the theme they were evaluated in.");
  L.push("- A cell reads \"Supports\" only when every candidate has the linked evidence for that criterion; it reads \"Partially Supports\" or \"Does Not Support\" only from a recorded screen-reader failure. Everything else reads \"Not Evaluated\", even where partial automated evidence exists, because automated tests evaluate a minority of any success criterion.");
  L.push("- WCAG 2.2 removed 4.1.1 Parsing as obsolete, so it is not reported.");
  L.push("");
  L.push("**Evaluation Methods Used:** Automated only, so far. Per-library unit suites (keyboard and ARIA-state tests, found by the heuristic in [docs/core.md](core.md#entry-criteria)); Playwright e2e in the example apps (Chromium only); an axe-core sweep of every component demo page in the SvelteKit app (`e2e/axe-catalog.spec.ts`, WCAG 2.0/2.1 A+AA and 2.2 AA rule sets), which is not used as evidence for any cell below because an axe pass shows the absence of the defects axe detects, not conformance. The [screen-reader matrix](screen-reader-matrix.md) has no results recorded.");
  L.push("");
  L.push("## Applicable Standards/Guidelines");
  L.push("");
  L.push("This report covers the degree of conformance for the following accessibility standard/guidelines:");
  L.push("");
  L.push("| Standard/Guideline | Included In Report |");
  L.push("| --- | --- |");
  L.push("| [Web Content Accessibility Guidelines 2.0](https://www.w3.org/TR/2008/REC-WCAG20-20081211) | No |");
  L.push("| [Web Content Accessibility Guidelines 2.1](https://www.w3.org/TR/WCAG21) | No |");
  L.push("| [Web Content Accessibility Guidelines 2.2](https://www.w3.org/TR/WCAG22) | Level A (Yes), Level AA (Yes), Level AAA (Yes) |");
  L.push("");
  L.push("## Terms");
  L.push("");
  L.push("The terms used in the Conformance Level information are defined as follows:");
  L.push("");
  L.push("- **Supports:** The functionality of the product has at least one method that meets the criterion without known defects or meets with equivalent facilitation.");
  L.push("- **Partially Supports:** Some functionality of the product does not meet the criterion.");
  L.push("- **Does Not Support:** The majority of product functionality does not meet the criterion.");
  L.push("- **Not Applicable:** The criterion is not relevant to the product.");
  L.push("- **Not Evaluated:** The product has not been evaluated against the criterion. This can only be used in WCAG Level AAA criteria. _Lily departs from the template here: it uses Not Evaluated at every level, because a self-assessment must not report a level it has not evaluated._");
  L.push("");
  L.push("## WCAG 2.2 Report");
  L.push("");
  L.push(banner);
  const tally = {};
  for (const [lvl, title] of [["A", "Table 1: Success Criteria, Level A"], ["AA", "Table 2: Success Criteria, Level AA"], ["AAA", "Table 3: Success Criteria, Level AAA"]]) {
    L.push("");
    L.push(`### ${title}`);
    L.push("");
    L.push(`_${title} — ${LABEL}._`);
    L.push("");
    L.push("| Criteria | Conformance Level | Remarks and Explanations |");
    L.push("| --- | --- | --- |");
    for (const [id, name] of WCAG[lvl]) {
      const r = acrRow(id, name);
      tally[r.level] = (tally[r.level] || 0) + 1;
      L.push(`| [${id} ${name}](https://www.w3.org/WAI/WCAG22/Understanding/${understanding(name)}.html) (Level ${lvl}) | ${r.level} | ${r.remarks} |`);
    }
  }
  L.push("");
  L.push("## Summary");
  L.push("");
  L.push(`_${LABEL}._ ` + ["Supports", "Partially Supports", "Does Not Support", "Not Applicable", "Not Evaluated"].map((k) => `${k}: ${tally[k] || 0}`).join("; ") + ".");
  L.push("");
  L.push("## Legal Disclaimer (Lily Design System)");
  L.push("");
  L.push("This report is a self-assessment published for information. It is not a certification, it is not the result of an independent audit, and it makes no claim of WCAG conformance. It describes the evidence in this repository at the report date and is regenerated whenever that evidence changes.");
  L.push("");
  L.push("“Voluntary Product Accessibility Template” and “VPAT” are registered service marks of the Information Technology Industry Council (ITI).");
  L.push("");
  L.push("---");
  L.push("");
  L.push("Lily™ and Lily Design System™ are trademarks.");
  return { text: L.join("\n") + "\n", tally };
}

// ---------- the /quality site page ----------

const h = (s) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

function renderPage() {
  const L = [];
  L.push("<svelte:head>");
  L.push("  <title>Quality — Lily Design System</title>");
  L.push('  <meta name="description" content="Lily Core: the components Lily is prepared to call proven, the evidence each must show, and where every candidate stands today. No component has met the criteria yet." />');
  L.push("</svelte:head>");
  L.push("");
  L.push("<!-- Generated by bin/generate-core from spec/competitive-position/core.json; do not edit. -->");
  L.push('<section class="page-intro">');
  L.push('  <h1 id="quality-title">Quality: Lily Core</h1>');
  L.push(`  <p class="page-intro-tagline">Lily Core is the set of components Lily is prepared to call proven. A component enters Core only when its evidence is in the repository. <strong>Today Core has ${core.length ? core.length + " member(s): " + h(core.join(", ")) : "no members"}.</strong> ${core.length ? "" : `No candidate meets the criteria yet: ${h(whyNone())}.`}</p>`);
  L.push("</section>");
  L.push("");
  L.push('<section class="prose">');
  L.push("  <h2>What Core means</h2>");
  L.push(`  <p>Core is drawn from the ${counts.candidates} interactive components an external audit would look at first: the form family, the five helper pickers, dialogs, tabs, menus, accordion, navigation, pagination, tables and the skip link. These are the candidates. A candidate becomes a member only when all three criteria below hold, and only Core members may be called proven.</p>`);
  L.push("  <h2>The criteria</h2>");
  L.push("  <ol>");
  L.push(`    <li><strong>Keyboard and ARIA-state tests in all eight libraries</strong> (${LIBRARIES.map((l) => LIBRARY_LABEL[l]).join(", ")}). A test file counts when it sends a key event and asserts an <code>aria-*</code> attribute; the key event is waived for a component whose contract names no keys.</li>`);
  L.push("    <li><strong>End-to-end tests in Chromium, Firefox and WebKit.</strong></li>");
  L.push(`    <li><strong>A filled screen-reader row</strong> with a pass or minor result for each of: ${MATRIX_COLUMNS.map(h).join(", ")}.</li>`);
  L.push("  </ol>");
  L.push("  <h2>Where the candidates stand</h2>");
  L.push(`  <p>Keyboard and ARIA-state tests in all eight libraries: ${counts.keyboard} of ${counts.candidates}. End-to-end in all three browsers: ${counts.e2e} of ${counts.candidates}. Screen-reader row filled: ${counts.screenReader} of ${counts.candidates}. All three: ${counts.core}.</p>`);
  const srWhy = counts.matrixCellsFilled === 0 ? ", because no one has yet run the components with a screen reader and recorded the result, and this project does not record results it has not observed" : "";
  const noRow = counts.matrixRows < counts.candidates ? ` ${counts.candidates - counts.matrixRows} candidates have no row in the matrix yet.` : "";
  L.push(`  <p>${core.length ? "Screen-reader evidence" : "Why none has met them"}: the <a href="https://github.com/LilyDesignSystem/lily-design-system/blob/main/docs/screen-reader-matrix.md">screen-reader matrix</a> has ${counts.matrixCellsFilled} of ${counts.matrixCells} cells filled${srWhy}.${noRow} The end-to-end suites run in ${h(browserList(counts.e2eBrowsersRun))}${counts.e2eBrowsersRun.length < BROWSERS.length ? " only" : ""}.</p>`);
  L.push("</section>");
  L.push("");
  L.push("<!-- svelte-ignore a11y_no_noninteractive_tabindex -->");
  L.push('<section class="section prose" style="margin: 0 auto; max-width: 64rem; overflow-x: auto;" aria-labelledby="quality-candidates" tabindex="0">');
  L.push('  <h2 id="quality-candidates">Candidates</h2>');
  L.push('  <table style="min-inline-size: 44rem;">');
  L.push("    <thead>");
  L.push("      <tr>");
  L.push("        <th>Candidate</th>");
  L.push("        <th>Keyboard and ARIA tests</th>");
  L.push("        <th>End-to-end browsers</th>");
  L.push("        <th>Screen-reader row</th>");
  L.push("        <th>Core</th>");
  L.push("      </tr>");
  L.push("    </thead>");
  L.push("    <tbody>");
  for (const c of candidates) {
    L.push("      <tr>");
    L.push(`        <td><a href="https://github.com/LilyDesignSystem/lily-design-system/blob/main/docs/core.md#${h(c.slug)}">${h(c.slug)}</a></td>`);
    L.push(`        <td>${c.keyboard.metCount} of 8 libraries</td>`);
    L.push(`        <td>${h(browserList(c.e2e.browsers))}</td>`);
    L.push(`        <td>${c.screenReader.row === null ? "no row yet" : `${c.screenReader.filled} of 6 filled`}</td>`);
    L.push(`        <td>${c.core ? "yes" : "no"}</td>`);
    L.push("      </tr>");
  }
  L.push("    </tbody>");
  L.push("  </table>");
  L.push("</section>");
  L.push("");
  L.push('<section class="prose">');
  L.push("  <h2>Read the evidence</h2>");
  L.push("  <ul>");
  L.push('    <li><a href="https://github.com/LilyDesignSystem/lily-design-system/blob/main/docs/core.md">docs/core.md</a>: every test file and spec behind each number above.</li>');
  L.push('    <li><a href="https://github.com/LilyDesignSystem/lily-design-system/blob/main/docs/accessibility-conformance-report.md">Accessibility conformance report</a>: VPAT 2.5, WCAG 2.2 edition, self-assessed and not an independent audit.</li>');
  L.push('    <li><a href="/accessibility/">Accessibility statement</a>: what is verified, and what is not verified by anything.</li>');
  L.push("  </ul>");
  L.push("  <p>The page is generated by the same script that checks the evidence, and the project's test run fails if a Core member loses any of it.</p>");
  L.push("</section>");
  return L.join("\n") + "\n";
}

// ---------- write or check ----------

const DATE_RE = /("reportDate": ")\d{4}-\d{2}-\d{2}|(\*\*Report Date:\*\* )\d{4}-\d{2}-\d{2}|(from the tree on )\d{4}-\d{2}-\d{2}/g;
const normalise = (s) => (s === null ? null : s.replace(DATE_RE, (m, a, b, c) => (a || b || c) + "DATE"));
const prevDate = previous && /^\d{4}-\d{2}-\d{2}$/.test(previous.reportDate || "") ? previous.reportDate : null;

function build(date) {
  const acr = renderAcr(date);
  return { [OUT.json]: renderJson(date), [OUT.md]: renderCoreMd(date), [OUT.acr]: acr.text, [OUT.page]: renderPage(), tally: acr.tally };
}

const files = [OUT.json, OUT.md, OUT.acr, OUT.page];
const have = Object.fromEntries(files.map((f) => [f, exists(f) ? read(f) : null]));
const candidateDate = prevDate || today;
let out = build(candidateDate);
const stale = files.filter((f) => normalise(have[f]) !== normalise(out[f]));
const anyChange = stale.length > 0;
if (!check && anyChange && candidateDate !== today) out = build(today);

const summary = `generate-core: ${counts.candidates} candidates; (a) ${counts.keyboard}, (b) ${counts.e2e}, (c) ${counts.screenReader}; Core ${counts.core}` +
  `; ACR ${Object.entries(out.tally).map(([k, v]) => `${k} ${v}`).join(", ")}`;

if (check) {
  let bad = 0;
  for (const m of lost) { console.error(`Error: ${m}`); bad++; }
  for (const f of stale) { console.error(`Error: ${f} ${have[f] === null ? "is missing" : "is stale"}; run bin/generate-core`); bad++; }
  console.log(bad ? `generate-core: FAILED (${bad})` : `${summary}: OK`);
  process.exit(bad ? 1 : 0);
}

if (lost.length && !allowDemotion) {
  for (const m of lost) console.error(`Error: ${m}`);
  console.error("generate-core: refusing to drop a Core member; restore the evidence, or rerun with --allow-demotion");
  process.exit(1);
}
let wrote = 0;
for (const f of files) {
  if (have[f] === out[f]) continue;
  fs.mkdirSync(path.dirname(abs(f)), { recursive: true });
  fs.writeFileSync(abs(f), out[f]);
  wrote++;
}
console.log(`${summary}; ${wrote} file(s) written`);
if (have[OUT.page] !== out[OUT.page]) console.log("generate-core: the /quality page changed; now run bin/extract-site-pages, then bin/generate-page-markdown");

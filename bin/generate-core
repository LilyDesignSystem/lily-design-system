    ["1.2.4", "Captions (Live)"], ["1.2.5", "Audio Description (Prerecorded)"], ["1.3.4", "Orientation"], ["1.3.5", "Identify Input Purpose"],
    ["1.4.3", "Contrast (Minimum)"], ["1.4.4", "Resize Text"], ["1.4.5", "Images of Text"], ["1.4.10", "Reflow"], ["1.4.11", "Non-text Contrast"],
    ["1.4.12", "Text Spacing"], ["1.4.13", "Content on Hover or Focus"], ["2.4.5", "Multiple Ways"], ["2.4.6", "Headings and Labels"],
    ["2.4.7", "Focus Visible"], ["2.4.11", "Focus Not Obscured (Minimum)"], ["2.5.7", "Dragging Movements"], ["2.5.8", "Target Size (Minimum)"],

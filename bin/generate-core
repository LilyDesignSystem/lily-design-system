const LABEL = "Self-assessed — not an independent audit";

const WCAG = {
  A: [
    ["1.1.1", "Non-text Content"], ["1.2.1", "Audio-only and Video-only (Prerecorded)"], ["1.2.2", "Captions (Prerecorded)"],
    ["1.2.3", "Audio Description or Media Alternative (Prerecorded)"], ["1.3.1", "Info and Relationships"], ["1.3.2", "Meaningful Sequence"],
    ["1.3.3", "Sensory Characteristics"], ["1.4.1", "Use of Color"], ["1.4.2", "Audio Control"], ["2.1.1", "Keyboard"],

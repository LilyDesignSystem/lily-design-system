#!/usr/bin/env python3
"""bin/check-healthcare-requirements — the healthcare requirement ids and the tests that cite them agree.

spec/healthcare-ui/requirements.md gives each safety-relevant healthcare rule a permanent id (HC-F1, HC-C3, ...), a status
and its evidence (tasks.md P47-T10). This fails when:

  - an id is malformed or appears twice;
  - a status is not tested, checked, guide, untested, declined or withdrawn;
  - an evidence file does not exist;
  - a `tested` id is not cited in each of its evidence files;
  - a `checked` id's evidence is not a bin/ script;
  - any tracked test file cites an id the register does not have;
  - the generated table of which runtime's tests cite each id is stale (--write rewrites it).

A citation counts only where a test is: in a test's or describe's name, or in a comment on the lines just above one (tasks.md
P48-T3). It says a test claims the rule, not that the test ran: the release evidence says that.

Usage: bin/check-healthcare-requirements [--list] [--write]   (--list prints id, status and evidence count)
"""

import re
import subprocess
import sys
from pathlib import Path

TOP = Path(__file__).resolve().parent.parent
REGISTER = TOP / "spec/healthcare-ui/requirements.md"
STATUSES = {"tested", "checked", "guide", "untested", "declined", "withdrawn"}
ID = re.compile(r"^HC-[A-Z]\d+$")
CITATION = re.compile(r"\bHC-[A-Z]\d+\b")
TEST_FILE = re.compile(r"(\.test\.tsx?|\.test\.js|\.spec\.ts|Tests\.cs|Tests\.swift|Test\.kt)$")
NAMED = re.compile(r"""\b(?:test|it|describe)\b(?:\.\w+)*\s*(?:\((?:[^()"'`]|\([^()]*\)|"[^"]*"|'[^']*'|`[^`]*`)*?\)\s*)?\(\s*(["'`])((?:(?!\1).)*)\1""", re.S)
TEST_LINE = re.compile(r"^\s*(?:@Test\b|\[(?:Fact|Theory)\b|(?:test|it|describe)\b)")
# One column per runtime whose tests may cite an id, and the paths that belong to it.
RUNTIMES = [
    ("Shared", r"^shared/"),
    ("Svelte", r"-svelte-(headless|filter)"),
    ("React", r"-react-headless"),
    ("Solid", r"-solid-headless"),
    ("Vue", r"-vue-headless"),
    ("Angular", r"-angular-headless"),
    ("Web Components", r"-web-components-headless"),
    ("Nunjucks", r"-nunjucks-headless"),
    ("Blazor", r"-blazor-"),
    ("Swift", r"-swift/"),
    ("Kotlin", r"-kotlin/"),
    ("Browser", r"/e2e/"),
]
START = "<!-- generated by bin/check-healthcare-requirements --write: do not edit -->"
END = "<!-- end generated -->"


def citations(text, script=False):
    """The ids cited where a test is: in a test's name, or in comment lines just above one. Anywhere, in a bin/ script."""
    if script:
        return set(CITATION.findall(text))
    cited = set()
    for match in NAMED.finditer(text):
        cited |= set(CITATION.findall(match.group(2)))
    pending = set()
    for line in text.splitlines():
        if line.lstrip().startswith("//"):
            pending |= set(CITATION.findall(line))
        elif TEST_LINE.match(line):
            cited |= pending
            pending = set()
        elif line.strip():
            pending = set()
    return cited


def table(where, ids):
    used = [name for name, _ in RUNTIMES if any(name in where.get(i, ()) for i in ids)]
    lines = ["| Id | " + " | ".join(used) + " |", "| --- | " + " | ".join("---" for _ in used) + " |"]
    for i in ids:
        lines.append(f"| {i} | " + " | ".join("yes" if name in where.get(i, ()) else "" for name in used) + " |")
    return "\n".join(lines)


def rows():
    generated = False
    for number, line in enumerate(REGISTER.read_text(encoding="utf-8").splitlines(), 1):
        if line in (START, END):
            generated = line == START
        if generated or not line.startswith("| HC-"):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) != 4:
            yield number, None, None, None, f"line {number}: expected 4 cells, found {len(cells)}"
            continue
        ident, _requirement, status, evidence = cells
        yield number, ident, status, re.findall(r"`([^`]+)`", evidence), None


def main() -> int:
    errors = []
    seen = {}
    for number, ident, status, evidence, problem in rows():
        if problem:
            errors.append(problem)
            continue
        if not ID.match(ident):
            errors.append(f"line {number}: malformed id {ident!r}")
        if ident in seen:
            errors.append(f"line {number}: {ident} already used on line {seen[ident][0]}")
        seen[ident] = (number, status, evidence)
        if status not in STATUSES:
            errors.append(f"{ident}: unknown status {status!r}")
        if not evidence:
            errors.append(f"{ident}: no evidence")
        for path in evidence:
            file = TOP / path
            if not file.exists():
                errors.append(f"{ident}: evidence {path} does not exist")
            elif status == "tested" and ident not in citations(file.read_text(encoding="utf-8"), path.startswith("bin/")):
                errors.append(f"{ident}: no test in {path} cites it in its name or the comment above it")
            elif status == "checked" and not path.startswith("bin/"):
                errors.append(f"{ident}: a checked rule's evidence must be a bin/ script, not {path}")

    where = {}
    tracked = subprocess.run(["git", "ls-files"], cwd=TOP, capture_output=True, text=True, check=True).stdout.split()
    for path in tracked:
        if not TEST_FILE.search(path) or "node_modules" in path:
            continue
        try:
            text = (TOP / path).read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        for cited in sorted(set(CITATION.findall(text))):
            if cited not in seen:
                errors.append(f"{path} cites {cited}, which the register does not have")
        # An example app's copy of a catalog's test is not another runtime's.
        for name, pattern in RUNTIMES:
            if re.search(pattern, path) and not (name != "Browser" and "-examples/" in path):
                # shared/ tests copied into a package are the shared test, not the package's own.
                copied = name not in ("Shared", "Browser") and (TOP / "shared" / Path(path).name.replace(".spec.ts", ".test.ts")).exists()
                for cited in () if copied else citations(text):
                    where.setdefault(cited, set()).add(name)

    tested = [i for i, (_n, status, _e) in seen.items() if status == "tested"]
    register = REGISTER.read_text(encoding="utf-8")
    if START not in register or END not in register:
        errors.append("the register has no generated table")
    else:
        before, rest = register.split(START, 1)
        current, after = rest.split(END, 1)
        cells = lambda t: [re.sub(r"\s+|-+", "", line) for line in t.strip().splitlines()]
        if cells(current) != cells(table(where, tested)):
            if "--write" in sys.argv[1:]:
                REGISTER.write_text(f"{before}{START}\n\n{table(where, tested)}\n\n{END}{after}", encoding="utf-8")
            else:
                errors.append("the generated table is stale; run bin/check-healthcare-requirements --write")

    if "--list" in sys.argv[1:]:
        for ident, (_number, status, evidence) in seen.items():
            print(f"{ident}\t{status}\t{len(evidence)}")
    for error in errors:
        print(f"check-healthcare-requirements: {error}", file=sys.stderr)
    if not errors:
        counts = {}
        for _number, status, _evidence in seen.values():
            counts[status] = counts.get(status, 0) + 1
        summary = ", ".join(f"{n} {s}" for s, n in sorted(counts.items()))
        print(f"check-healthcare-requirements: {len(seen)} ids ({summary})")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())

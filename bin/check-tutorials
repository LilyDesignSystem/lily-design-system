#!/usr/bin/env node
// bin/check-tutorials — the project tutorials work, as a reader would follow them (spec/tutorials).
//
// For each tutorial: scaffold a new SvelteKit app, install what the page says from npm, copy each code block that has a
// `data-file` off the page into that file, then type-check, run the tutorial's own tests, make each mistake the page says a
// test will catch (a test must fail), and drive the app in Chromium with axe at 320 pixels wide.
//
// It installs from npm, so it is not in bin/test: `bin/ci --job tutorials`, weekly. --syntax only reads the pages (in bin/test):
// every block parses, no file is shown twice, and the next-step links name routes that exist.
//
// Usage: bin/check-tutorials [--syntax] [--repeat=N] [slug ...]   (--repeat drives each app N times)

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawn, spawnSync } = require("node:child_process");

const top = path.join(__dirname, "..");
const site = path.join(top, "lilydesignsystem.github.io");
const pageOf = (slug) => path.join(site, "src/routes/tutorials", slug, "+page.svelte");

// `mistakes` are [file, from, to]: the changes the pages promise a test will catch, and the rules the pages name.
const TUTORIALS = {
    "international-patient-summary": {
        tests: 12,
        mistakes: [
            // P55-T2: a narrower negative is not the whole section; a code is matched by system, in any coding.
            [
                "src/lib/ips/summary.ts",
                "return code ? WHOLE[key][code] : undefined;",
                'return code?.startsWith("no-known-") ? "none-known" : undefined;',
            ],
            [
                "src/lib/ips/summary.ts",
                "has(s.code, LOINC, REQUIRED[key])",
                "s.code?.coding?.find((c) => c.code)?.code === REQUIRED[key]",
            ],
            // P55-T3: an entry about someone else is never shown under this patient.
            ["src/lib/ips/summary.ts", "resolve(subjectOf(resource)) !== patient", "false"],
            [
                "src/lib/ips/summary.ts",
                'case undefined:\n      return "not-recorded"',
                'case undefined:\n      return "none-known"',
            ],
            ["src/lib/ips/summary.ts", 'entries.length > 0 && said === "none-known"', "false"],
            ["src/lib/ips/summary.ts", "missing.push(reference)", "undefined"],
        ],
    },
    "electronic-patient-record": {
        tests: 9,
        mistakes: [
            ["src/lib/server/match.ts", 'x === "" || y === "" ? null : x === y', "x === y"],
            ["src/lib/server/history.ts", "throw new StaleVersion()", "undefined"],
            ["src/lib/server/store.ts", "this.#say(user, patientId, false);", ""],
            ["src/lib/server/store.ts", "allergy.patientId !== patientId", "false"],
        ],
    },
    "pre-operative-assessment-by-patient": {
        tests: 15,
        mistakes: [
            // An empty list is not "none known"; only a "No" is (HC-C17).
            [
                "src/lib/rules.ts",
                'if (s.anyAllergies === "no") return "none-known";',
                'if (s.allergies.length === 0) return "none-known";',
            ],
            // A follow-up the patient can no longer see is not sent.
            [
                "src/lib/rules.ts",
                'bloodThinnerName: a.bloodThinner === "yes" ? a.bloodThinnerName : "",',
                "bloodThinnerName: a.bloodThinnerName,",
            ],
            ["src/lib/rules.ts", "const POUND = 0.45359237;", "const POUND = 1;"],
            // The flags come from what is sent, so an answer taken back raises none.
            [
                "src/lib/rules.ts",
                "const s = sent(a);\n  const unsure",
                "const s = a;\n  const unsure",
            ],
        ],
    },
    "patient-administration-system": {
        tests: 14,
        serve: "dev",
        mistakes: [
            ["src/lib/server/pas.ts", 'appointment.urgent ? "held" : "cancelled"', '"cancelled"'],
            ["src/lib/reminders.ts", 'appointment.status === "held"', "false"],
            ["src/lib/server/links.ts", "!link.used && ", ""],
            ["src/lib/views.ts", "    timeZone,\n    year", '    timeZone: "UTC",\n    year'],
        ],
    },
};

function readPage(slug) {
    const source = fs.readFileSync(pageOf(slug), "utf8");
    const files = new Map();
    const problems = [];
    const commands = [];
    for (const [, attrs, expr] of source.matchAll(
        /<pre([^>]*)><code>\{([\s\S]*?)\}<\/code><\/pre>/g,
    )) {
        const text = String(new Function("return (" + expr + ");")());
        const file = (attrs.match(/data-file="([^"]+)"/) || [])[1];
        if (!file) commands.push(text);
        else if (files.has(file)) problems.push(`${file} is shown twice`);
        else if (file.includes("..") || path.isAbsolute(file))
            problems.push(`${file} is outside the app`);
        else files.set(file, text.endsWith("\n") ? text : text + "\n");
    }
    for (const [, href] of source
        .replace(/<pre[\s\S]*?<\/pre>/g, "")
        .matchAll(/href="(\/[^"#]*)"/g))
        if (!fs.existsSync(path.join(site, "src/routes", href, "+page.svelte")))
            problems.push(`${href} is not a page`);
    for (const [file, from] of TUTORIALS[slug].mistakes)
        if ((files.get(file) ?? "").split(from).length !== 2)
            problems.push(`${file}: a mistake to make is not there once: ${from}`);
    return { files, commands, problems };
}

function run(cwd, command, args, quiet = true) {
    const r = spawnSync(command, args, { cwd, encoding: "utf8", env: { ...process.env, CI: "1" } });
    if (r.status !== 0 && quiet) console.error((r.stdout + r.stderr).slice(-3000));
    return r;
}

function must(ok, what) {
    if (!ok) throw new Error(what);
    console.log(`  ok: ${what}`);
}

// The built app, not the dev server: that reloads a module now and then, which empties an app's in-memory store. The patient
// administration app marks its cookie Secure when built, which a browser drops over http, so it alone runs in dev.
async function browse(dir, port, mode, flow) {
    const server = spawn(
        "npx",
        ["vite", mode, "--port", String(port), "--strictPort", "--host", "127.0.0.1"],
        { cwd: dir, detached: true, stdio: "ignore" },
    );
    const { chromium } = require(path.join(site, "node_modules/@playwright/test"));
    const { default: AxeBuilder } = require(path.join(site, "node_modules/@axe-core/playwright"));
    const browser = await chromium.launch();
    try {
        const base = `http://127.0.0.1:${port}`;
        for (let i = 0; ; i++) {
            if (
                await fetch(base).then(
                    () => true,
                    () => false,
                )
            )
                break;
            if (i > 60) throw new Error("the app did not start");
            await new Promise((r) => setTimeout(r, 1000));
        }
        const context = await browser.newContext({
            viewport: { width: 320, height: 800 },
            locale: "en-GB",
        });
        const page = await context.newPage();
        const crashes = [];
        page.on("pageerror", (e) => crashes.push(e.message));
        const go = async (url, on = page) => {
            const response = await on.goto(base + url);
            await on.waitForLoadState("networkidle");
            return response.status();
        };
        const accessible = async (what) => {
            const { violations } = await new AxeBuilder({ page })
                .withTags(["wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "wcag22aa"])
                .analyze();
            must(violations.length === 0, `${what} passes axe ${violations.map((v) => v.id)}`);
            must(
                await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth),
                `${what} does not scroll sideways at 320px`,
            );
        };
        const see = async (locator, text, what) => {
            await locator
                .filter({ hasText: text })
                .first()
                .waitFor({ timeout: 10_000 })
                .catch(() => {});
            const shown = (await locator.filter({ hasText: text }).count()) > 0;
            if (!shown) {
                const on = locator.page();
                console.error(
                    `  at ${on.url()}: ${(await on.locator("body").innerText()).replace(/\s+/g, " ").slice(0, 600)}`,
                );
            }
            must(shown, what);
        };
        await flow({ page, context, browser, base, go, accessible, see });
        must(crashes.length === 0, `no page crashed ${crashes}`);
    } finally {
        await browser.close();
        try {
            process.kill(-server.pid);
        } catch {
            // already gone
        }
    }
}


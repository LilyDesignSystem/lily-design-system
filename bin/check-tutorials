async function check(slug, port, repeat) {
    const { files, commands, problems } = readPage(slug);
    if (problems.length) throw new Error(problems.join("; "));
    const dir = path.join(fs.mkdtempSync(path.join(os.tmpdir(), "lily-tutorial-")), "app");
    console.log(`${slug}: ${files.size} files in ${dir}`);
    must(
        run(top, "npx", [
            "--yes",
            "sv@latest",
            "create",
            dir,
            "--template",
            "minimal",
            "--types",
            "ts",
            "--no-add-ons",
            "--install",
            "pnpm",
        ]).status === 0,
        "the app scaffolds",
    );
    const adds = [
        ...commands
            .join("\n")
            .replace(/\\\n/g, " ")
            .matchAll(/^\s*pnpm (add .+)$/gm),
    ].map((m) => m[1].trim().split(/\s+/));
    must(
        adds.length > 0 && adds.every((args) => run(dir, "pnpm", args).status === 0),
        "the packages on the page install",
    );
    for (const [file, text] of files) {
        fs.mkdirSync(path.dirname(path.join(dir, file)), { recursive: true });
        fs.writeFileSync(path.join(dir, file), text);
    }
    must(run(dir, "pnpm", ["run", "check"]).status === 0, "it type-checks");
    const { tests, mistakes } = TUTORIALS[slug];
    const result = run(dir, "npx", ["vitest", "run", "--no-color"]);
    must(
        result.status === 0 && new RegExp(`Tests\\s+${tests} passed`).test(result.stdout),
        `its ${tests} tests pass`,
    );
    for (const [file, from, to] of mistakes) {
        const target = path.join(dir, file);
        fs.writeFileSync(
            target,
            files.get(file).replace(from, () => to),
        );
        const failed = /Tests\s+\d+ failed/.test(
            run(dir, "npx", ["vitest", "run", "--no-color"], false).stdout,
        );
        fs.writeFileSync(target, files.get(file));
        must(failed, `a test catches: ${from.split("\n").pop().trim()}`);
    }
    must(run(dir, "pnpm", ["run", "build"]).status === 0, "it builds");
    await browse(dir, port, TUTORIALS[slug].serve ?? "preview", FLOWS[slug]);
    for (let i = 1; i < repeat; i++)
        await browse(dir, port, TUTORIALS[slug].serve ?? "preview", FLOWS[slug]);
    console.log("  left in " + dir);
}

(async () => {
    const args = process.argv.slice(2);
    const slugs = args.filter((a) => !a.startsWith("-"));
    const unknown = slugs.filter((s) => !TUTORIALS[s]);
    if (unknown.length) {
        console.error(`check-tutorials: no such tutorial: ${unknown}`);
        process.exit(1);
    }
    let failed = 0;
    for (const [i, slug] of (slugs.length ? slugs : Object.keys(TUTORIALS)).entries()) {
        try {
            if (args.includes("--syntax")) {
                const { files, problems } = readPage(slug);
                if (problems.length) throw new Error(problems.join("; "));
                console.log(`check-tutorials: ${slug}: ${files.size} files`);
            } else
                await check(
                    slug,
                    4460 + i,
                    Number((args.find((a) => a.startsWith("--repeat=")) ?? "=1").split("=")[1]),
                );
        } catch (e) {
            failed++;
            console.error(`check-tutorials: ${slug}: ${e.message}`);
        }
    }
    process.exit(failed ? 1 : 0);
})();

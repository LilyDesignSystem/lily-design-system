#!/usr/bin/env node
// bin/generate-locale-pages
//
// Write the thin route files for the translated text pages:
//   lilydesignsystem.github.io/src/routes/<code>/<slug>/+page.svelte
// for every locale directory whose language has all eight page files under src/lib/pages/<slug>/
// (see src/lib/pages.ts). English locales use the English routes and get none. Route files for a locale
// that has lost its translations are removed.
//
//   bin/generate-locale-pages          write / prune
//   bin/generate-locale-pages --check  exit 1 if anything would change

const fs = require("fs");
const path = require("path");

const top = path.join(__dirname, "..");
const site = path.join(top, "lilydesignsystem.github.io");
const SLUGS = ["about", "why", "accessibility", "help", "comparisons", "tutorials", "examples", "skills"];
const EXTRA = JSON.parse(fs.readFileSync(path.join(site, "src/lib/extra-pages.json"), "utf8"));
const check = process.argv.includes("--check");

const localesDir = path.join(site, "src/routes");
const codes = fs.readdirSync(localesDir, { withFileTypes: true }).filter((e) => e.isDirectory() && /^[a-z]{2,3}-([a-z]{2}|[0-9]{3})(-[a-z0-9]+)?$/.test(e.name)).map((e) => e.name);
const hasAll = (lang) => SLUGS.every((s) => fs.existsSync(path.join(site, "src/lib/pages", s, lang + ".html")));

let changes = 0;
const note = (m) => {
  changes++;
  console.log(m);
};

for (const code of codes) {
  const lang = code.split("-")[0];
  const translated = lang !== "en" && hasAll(lang);
  for (const slug of SLUGS) {
    const file = path.join(localesDir, code, slug, "+page.svelte");
    const want = `<script lang="ts">
  import LocalizedPage from '#lib/components/LocalizedPage.svelte';
</script>

<LocalizedPage slug="${slug}" locale="${code}" />
`;
    const have = fs.existsSync(file) ? fs.readFileSync(file, "utf8") : null;
    if (translated && have !== want) {
      note((check ? "would write " : "wrote ") + path.relative(top, file));
      if (!check) {
        fs.mkdirSync(path.dirname(file), { recursive: true });
        fs.writeFileSync(file, want);
      }
    } else if (!translated && have !== null) {
      note((check ? "would remove " : "removed ") + path.relative(top, file));
      if (!check) {
        fs.rmSync(path.dirname(file), { recursive: true });
      }
    }
  }
}
// Extra pages: one route per page a language has translated (a language need not have them all).
const extraRoute = (code, page) => {
  const bare = `<LocalizedPage slug="${page.slug}" locale="${code}" />`;
  const imports = `  import LocalizedPage from '#lib/components/LocalizedPage.svelte';`;
  if (page.slug === "locales") {
    return `<script lang="ts">
${imports}
  import LocaleList from '#lib/components/LocaleList.svelte';
</script>

${bare}

<LocaleList />
`;
  }
  if (page.introOnly) {
    return `<script lang="ts">
${imports}

  let { data } = $props();
</script>

${bare}

<section class="prose doc-render">
  {@html data.html}
</section>
`;
  }
  return `<script lang="ts">
${imports}
</script>

${bare}
`;
};
for (const code of codes) {
  const lang = code.split("-")[0];
  if (lang === "en") continue;
  for (const page of EXTRA) {
    const has = fs.existsSync(path.join(site, "src/lib/pages", page.slug, lang + ".html"));
    const dir = path.join(localesDir, code, page.route);
    const file = path.join(dir, "+page.svelte");
    const loader = path.join(dir, "+page.ts");
    const wantLoader = page.introOnly && page.slug !== "locales" ? `export { load, prerender } from '${"../".repeat(page.route.split("/").length + 1)}${page.route}/+page.js';\n` : null;
    const want = extraRoute(code, page);
    const have = fs.existsSync(file) ? fs.readFileSync(file, "utf8") : null;
    const haveLoader = fs.existsSync(loader) ? fs.readFileSync(loader, "utf8") : null;
    if (has) {
      if (have !== want) {
        note((check ? "would write " : "wrote ") + path.relative(top, file));
        if (!check) {
          fs.mkdirSync(dir, { recursive: true });
          fs.writeFileSync(file, want);
        }
      }
      if (wantLoader !== null && haveLoader !== wantLoader) {
        note((check ? "would write " : "wrote ") + path.relative(top, loader));
        if (!check) fs.writeFileSync(loader, wantLoader);
      }
    } else if (have !== null || haveLoader !== null) {
      note((check ? "would remove " : "removed ") + path.relative(top, dir));
      if (!check) fs.rmSync(dir, { recursive: true });
    }
  }
}
if (check && changes) process.exit(1);
if (!changes) console.log("generate-locale-pages: up to date");

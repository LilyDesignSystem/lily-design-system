#!/usr/bin/env python3
"""bin/generate-theme-contrast — the published theme contrast table (tasks.md P22-T6).

For each of the reference themes in themes/*.css, every text pair `bin/check-theme --contrast`
measures (body text on the three surfaces, each `-content` colour on its fill, and the error text
on the page), with its WCAG 2 contrast ratio and whether it meets AA (4.5:1) and AAA (7:1).
`bin/check-theme --contrast` reports only the pairs below AAA; this shows them all, so a reader
can see which themes reach AAA and which do not.

The ratios come from bin/check-theme's own colour maths, loaded from that file, so the two cannot
disagree. A ratio marked approximate has a colour outside sRGB, clipped as a browser paints it.

Writes:
  docs/theme-contrast.md                                         the table, per theme
  lilydesignsystem.github.io/src/routes/theme-contrast/+page.svelte the same, on the docs site

Usage:
  bin/generate-theme-contrast           write both
  bin/generate-theme-contrast --check   exit 1 when either is stale (bin/test runs this)
"""

import glob
import html
import importlib.machinery
import importlib.util
import os
import re
import sys

TOP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MD = os.path.join(TOP, "docs", "theme-contrast.md")
PAGE = os.path.join(TOP, "lilydesignsystem.github.io", "src", "routes", "theme-contrast", "+page.svelte")

# Loading bin/check-theme as a module would write bin/__pycache__, which is tracked.
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("check_theme", os.path.join(TOP, "bin", "check-theme"))
spec = importlib.util.spec_from_loader("check_theme", loader)
ct = importlib.util.module_from_spec(spec)
loader.exec_module(ct)


def measure():
    """[(theme, [(fg, bg, ratio or None, approximate)])], themes in file order."""
    themes = []
    for f in sorted(glob.glob(os.path.join(TOP, "themes", "*.css"))):
        css = ct.strip_comments(open(f).read())
        tokens = {}
        for name, value in re.findall(r"(--[a-z0-9-]+)\s*:\s*([^;]+);", css):
            tokens.setdefault(name, " ".join(value.split()))
        rows = []
        for fg, bg in ct.CONTRAST_PAIRS:
            c_fg, c_bg = ct.parse_color(tokens.get(fg, ""), tokens), ct.parse_color(tokens.get(bg, ""), tokens)
            if c_fg is None or c_bg is None:
                rows.append((fg, bg, None, False))
                continue
            (l1, k1), (l2, k2) = ct.luminance(c_fg), ct.luminance(c_bg)
            rows.append((fg, bg, (max(l1, l2) + 0.05) / (min(l1, l2) + 0.05), k1 or k2))
        themes.append((os.path.basename(f)[:-4], rows))
    return themes


def verdict(ratio, threshold):
    return "not parsed" if ratio is None else ("yes" if ratio >= threshold else "no")


def summary(themes):
    rows = [r for _, rs in themes for r in rs]
    aaa = sum(1 for r in rows if r[2] is not None and r[2] >= ct.AAA)
    aa = sum(1 for r in rows if r[2] is not None and r[2] >= ct.AA)
    all_aaa = sum(1 for _, rs in themes if all(r[2] is not None and r[2] >= ct.AAA for r in rs))
    return len(rows), aa, aaa, all_aaa


def markdown(themes):
    pairs, aa, aaa, all_aaa = summary(themes)
    out = [
        "# Theme contrast",
        "",
        "<!-- Generated by bin/generate-theme-contrast from themes/*.css; do not edit. -->",
        "",
        f"The WCAG 2 contrast ratio of every text pair in each of the {len(themes)} reference themes: body text",
        "(`--color-base-content`) on the three surfaces, each `-content` colour on its fill, and the error text",
        "(`--lily-error-text`) on the page. AA is 4.5:1 (WCAG 1.4.3) and AAA 7:1 (1.4.6), for normal-size text.",
        "",
        f"Of {pairs} pairs, {aa} meet AA and {aaa} meet AAA; {pairs - aaa} miss AAA. {all_aaa} of {len(themes)} themes meet AAA in",
        "every pair. `bin/test` fails when any pair is below AA. A ratio marked ≈ has a colour outside sRGB, clipped as a",
        "browser paints it, so it is approximate. The table measures tokens, not pages: a component's own colours, and the",
        "contrast of non-text parts (1.4.11), are checked by the axe sweeps.",
        "",
    ]
    for name, rows in themes:
        out += [f"## {name}", "", "| Text | On | Ratio | AA | AAA |", "| --- | --- | --- | --- | --- |"]
        for fg, bg, ratio, approx in rows:
            r = "—" if ratio is None else f"{'≈' if approx else ''}{ratio:.2f}:1"
            out.append(f"| `{fg}` | `{bg}` | {r} | {verdict(ratio, ct.AA)} | {verdict(ratio, ct.AAA)} |")
        out.append("")
    return "\n".join(out).rstrip() + "\n"


def svelte(themes):
    pairs, aa, aaa, all_aaa = summary(themes)
    e = html.escape
    body = []
    for name, rows in themes:
        for i, (fg, bg, ratio, approx) in enumerate(rows):
            r = "—" if ratio is None else f"{'≈' if approx else ''}{ratio:.2f}:1"
            theme_cell = f'<th scope="rowgroup" rowspan="{len(rows)}">{e(name)}</th>' if i == 0 else ""
            body.append(
                f"      <tr>{theme_cell}<td><code>{e(fg)}</code></td><td><code>{e(bg)}</code></td>"
                f"<td>{r}</td><td>{verdict(ratio, ct.AA)}</td><td>{verdict(ratio, ct.AAA)}</td></tr>"
            )
    rows = "\n".join(body)
    return f"""<svelte:head>
  <title>Theme contrast — Lily Design System</title>
  <meta name="description" content="The WCAG 2 contrast ratio of every text pair in each of the {len(themes)} Lily reference themes, against AA and AAA." />
</svelte:head>

<!-- Generated by bin/generate-theme-contrast from themes/*.css; do not edit. -->
<section class="page-intro">
  <h1>Theme contrast</h1>
  <p class="page-intro-tagline">Every text pair in each of the {len(themes)} reference themes, with its contrast ratio. Of {pairs} pairs, {aa} meet AA and {aaa} meet AAA; {all_aaa} of {len(themes)} themes meet AAA in every pair.</p>
</section>

<section class="prose">
  <p>The pairs are body text (<code>--color-base-content</code>) on the three surfaces, each <code>-content</code> colour on its fill, and the error text (<code>--lily-error-text</code>) on the page. AA is 4.5:1 (WCAG 1.4.3) and AAA 7:1 (1.4.6), for normal-size text. Lily's tests fail when any pair is below AA. A ratio marked ≈ has a colour outside sRGB, clipped as a browser paints it, so it is approximate.</p>
  <p>The table measures the themes' tokens, not pages: a component's own colours, and the contrast of borders and icons (1.4.11), are checked by the axe sweeps on the example apps.</p>
</section>

<!-- svelte-ignore a11y_no_noninteractive_tabindex -->
<section class="section prose" style="margin: 0 auto; max-width: 64rem; overflow-x: auto;" aria-labelledby="theme-contrast-table" tabindex="0">
  <h2 id="theme-contrast-table">All pairs</h2>
  <table style="min-inline-size: 44rem;">
    <thead>
      <tr><th scope="col">Theme</th><th scope="col">Text</th><th scope="col">On</th><th scope="col">Ratio</th><th scope="col">AA</th><th scope="col">AAA</th></tr>
    </thead>
    <tbody>
{rows}
    </tbody>
  </table>
</section>
"""


def main():
    check = "--check" in sys.argv[1:]
    themes = measure()
    stale = []
    for path, text in ((MD, markdown(themes)), (PAGE, svelte(themes))):
        current = open(path).read() if os.path.exists(path) else None
        if current == text:
            continue
        stale.append(os.path.relpath(path, TOP))
        if not check:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            open(path, "w").write(text)
    pairs, aa, aaa, all_aaa = summary(themes)
    state = ("stale: " + ", ".join(stale) if stale else "OK") if check else f"{len(stale)} file(s) written"
    print(f"generate-theme-contrast: {pairs} pairs in {len(themes)} themes; {aa} meet AA, {aaa} AAA; {state}")
    return 1 if check and stale else 0


if __name__ == "__main__":
    sys.exit(main())

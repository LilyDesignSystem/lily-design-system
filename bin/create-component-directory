#!/bin/sh
set -euf
## Usage: bin/create-component-directory [--dry-run] <name>
## --dry-run lists what would be created and writes nothing.
top="$(git rev-parse --show-toplevel)"

mkdir_with_ai() {
  # dir="$1"
  mkdir "$1" && cd $_
  touch index.md
  ln -sfn index.md README.md
  touch AGENTS.md
  mkdir spec
  touch spec/index.md
}

dry_run=
if [ "${1:-}" = "--dry-run" ]; then dry_run=1; shift; fi
test -n "${1:-}" || { echo "usage: bin/create-component-directory [--dry-run] <name>" >&2; exit 1; }
dir="$top/components/$1"
if [ -n "$dry_run" ]; then
  if [ -e "$dir" ]; then echo "would fail: already exists: $dir"; exit 1; fi
  for f in "" /index.md /README.md /AGENTS.md /spec/ /spec/index.md; do echo "would create: $dir$f"; done
  exit 0
fi
mkdir_with_ai "$dir"

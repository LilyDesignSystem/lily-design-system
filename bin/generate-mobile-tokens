#!/usr/bin/env python3
"""bin/generate-mobile-tokens — Swift and Kotlin tokens from the DTCG theme files (tasks.md P43-T5).

Reads themes/tokens/{slug}.json (strict DTCG 2025.10, the source bin/generate-theme-tokens also reads) for the themes in
MOBILE_THEMES and writes:

  lily-design-system-swift/Sources/LilyThemes/LilyTokens.swift
  lily-design-system-kotlin/lily-compose-themes/src/main/kotlin/io/github/lilydesignsystem/compose/themes/LilyTokens.kt

Colours are converted to sRGB (OKLCH through OKLab and linear sRGB, out-of-gamut channels clipped), because SwiftUI's and
Compose's Color take sRGB. Dimensions in rem become points or dp at 16 per rem; px stay as they are. Fluid spacing uses its
rem floor. Type is not a token here: mobile text uses the platform's text styles, so Dynamic Type and font scale apply.

  (default)  write both files
  --check    fail if either file differs from what the JSON produces (wired into bin/test)
"""

import json
import math
import os
import sys

TOP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TOKENS = os.path.join(TOP, "themes", "tokens")
SWIFT = os.path.join(TOP, "lily-design-system-swift", "Sources", "LilyThemes", "LilyTokens.swift")
KOTLIN = os.path.join(
    TOP, "lily-design-system-kotlin", "lily-compose-themes", "src", "main", "kotlin", "io", "github", "lilydesignsystem",
    "compose", "themes", "LilyTokens.kt",
)

# The first mobile themes (spec/apple-swift, advice 4): the two general-purpose ones, then public-sector references from
# three countries, then one non-Anglophone public-sector theme. Add a slug here to ship another.
MOBILE_THEMES = [
    ("light", "light"),
    ("dark", "dark"),
    ("nhsEnglandPatients", "united-kingdom-national-health-service-england-for-patients"),
    ("govUk", "united-kingdom-government-digital-service"),
    ("uswds", "united-states-web-design-system"),
    ("japanDigitalAgency", "japan-digital-agency-design-system"),
]

COLOR_ROLES = [
    "base-100", "base-200", "base-300", "base-content",
    "primary", "primary-content", "secondary", "secondary-content", "accent", "accent-content",
    "neutral", "neutral-content", "info", "info-content", "success", "success-content",
    "warning", "warning-content", "error", "error-content",
]
DIMENSIONS = [("radius", "selector"), ("radius", "field"), ("radius", "box"), ("border", "border")]
HEADER = "Generated by bin/generate-mobile-tokens from themes/tokens/*.json; edit the JSON, never this file."


def camel(name):
    head, *rest = name.split("-")
    return head + "".join(part.capitalize() for part in rest)


def srgb_from_oklch(l, c, h):
    a = c * math.cos(math.radians(h))
    b = c * math.sin(math.radians(h))
    l_ = (l + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m_ = (l - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s_ = (l - 0.0894841775 * a - 1.2914855480 * b) ** 3
    linear = (
        4.0767416621 * l_ - 3.3077115913 * m_ + 0.2309699292 * s_,
        -1.2684380046 * l_ + 2.6097574011 * m_ - 0.3413193965 * s_,
        -0.0041960863 * l_ - 0.7034186147 * m_ + 1.7076147010 * s_,
    )

    def gamma(x):
        x = min(max(x, 0.0), 1.0)
        return 12.92 * x if x <= 0.0031308 else 1.055 * x ** (1 / 2.4) - 0.055

    return tuple(gamma(x) for x in linear)


def to_srgb(value):
    space = value["colorSpace"]
    if space == "srgb":
        return tuple(float(x) for x in value["components"])
    if space == "oklch":
        l, c, h = (float(x) for x in value["components"])
        return srgb_from_oklch(l, c, h if not math.isnan(h) else 0.0)
    raise SystemExit(f"generate-mobile-tokens: unsupported colour space {space}")


def hex_of(rgb):
    return "".join(f"{round(min(max(x, 0.0), 1.0) * 255):02X}" for x in rgb)


def points(value):
    if isinstance(value, (int, float)):
        if value != 0:
            raise SystemExit(f"generate-mobile-tokens: a unitless dimension must be 0, got {value}")
        return 0.0  # a CSS unitless 0 (GOV.UK's square corners)
    unit = value["unit"]
    if unit == "rem":
        return float(value["value"]) * 16
    if unit == "px":
        return float(value["value"])
    raise SystemExit(f"generate-mobile-tokens: unsupported unit {unit}")


def number(x):
    text = f"{x:.3f}".rstrip("0").rstrip(".")
    return text if "." in text else text + ".0"


def load(slug):
    with open(os.path.join(TOKENS, slug + ".json"), encoding="utf-8") as f:
        data = json.load(f)
    colors = {role: hex_of(to_srgb(data["color"][role]["$value"])) for role in COLOR_ROLES}
    dims = {f"{group}-{name}": points(data[group][name]["$value"]) for group, name in DIMENSIONS}
    return colors, dims


def swift(themes):
    roles = [camel(r) for r in COLOR_ROLES]
    dims = [camel(f"{g}-{n}") for g, n in DIMENSIONS]
    out = [f"// {HEADER}", "", "import SwiftUI", ""]
    out.append("/// A theme's colours (sRGB) and sizes (points), from the DTCG tokens the web themes use.")
    out.append("public struct LilyTokens: Sendable, Equatable {")
    out.append("    /// The theme's slug in themes/, so an app can match the web theme it pairs with.")
    out.append("    public let slug: String")
    for r in roles:
        out.append(f"    public let {r}: Color")
    for d in dims:
        out.append(f"    public let {d}: CGFloat")
    out.append("}")
    out.append("")
    out.append("extension Color {")
    out.append("    /// A colour from a 24-bit sRGB value, as the generated tokens write them.")
    out.append("    init(lilyHex hex: UInt32) {")
    out.append("        self.init(")
    out.append("            .sRGB, red: Double((hex >> 16) & 0xFF) / 255, green: Double((hex >> 8) & 0xFF) / 255,")
    out.append("            blue: Double(hex & 0xFF) / 255, opacity: 1)")
    out.append("    }")
    out.append("}")
    out.append("")
    out.append("extension LilyTokens {")
    for name, slug, colors, sizes in themes:
        out.append(f"    /// themes/{slug}.css")
        out.append(f"    public static let {name} = LilyTokens(")
        args = [f'slug: "{slug}"']
        args += [f"{camel(r)}: Color(lilyHex: 0x{colors[r]})" for r in COLOR_ROLES]
        args += [f"{camel(k)}: {number(v)}" for k, v in sizes.items()]
        out.append("        " + ",\n        ".join(args) + ")")
    out.append("")
    out.append("    /// Every generated theme, in the order above.")
    out.append("    public static let all: [LilyTokens] = [" + ", ".join(n for n, *_ in themes) + "]")
    out.append("}")
    return "\n".join(out) + "\n"


def kotlin(themes):
    out = [f"// {HEADER}", "package io.github.lilydesignsystem.compose.themes", ""]
    out += ["import androidx.compose.runtime.Immutable", "import androidx.compose.ui.graphics.Color",
            "import androidx.compose.ui.unit.Dp", "import androidx.compose.ui.unit.dp", ""]
    out.append("/** A theme's colours (sRGB) and sizes (dp), from the DTCG tokens the web themes use. */")
    out.append("@Immutable")
    out.append("public data class LilyTokens(")
    out.append("    /** The theme's slug in themes/, so an app can match the web theme it pairs with. */")
    out.append("    val slug: String,")
    for r in COLOR_ROLES:
        out.append(f"    val {camel(r)}: Color,")
    for g, n in DIMENSIONS:
        out.append(f"    val {camel(g + '-' + n)}: Dp,")
    out.append(") {")
    out.append("    public companion object {")
    for name, slug, colors, sizes in themes:
        out.append(f"        /** themes/{slug}.css */")
        out.append(f"        public val {name}: LilyTokens = LilyTokens(")
        args = [f'slug = "{slug}"']
        args += [f"{camel(r)} = Color(0xFF{colors[r]})" for r in COLOR_ROLES]
        args += [f"{camel(k)} = {number(v)}.dp" for k, v in sizes.items()]
        out.append("            " + ",\n            ".join(args) + ",")
        out.append("        )")
    out.append("")
    out.append("        /** Every generated theme, in the order above. */")
    out.append("        public val all: List<LilyTokens> = listOf(" + ", ".join(n for n, *_ in themes) + ")")
    out.append("    }")
    out.append("}")
    return "\n".join(out) + "\n"


def main():
    themes = [(name, slug, *load(slug)) for name, slug in MOBILE_THEMES]
    outputs = {SWIFT: swift(themes), KOTLIN: kotlin(themes)}
    check = "--check" in sys.argv[1:]
    stale = []
    for path, text in outputs.items():
        current = open(path, encoding="utf-8").read() if os.path.exists(path) else None
        if current == text:
            continue
        stale.append(os.path.relpath(path, TOP))
        if not check:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="utf-8") as f:
                f.write(text)
    if check and stale:
        print("generate-mobile-tokens: stale, run bin/generate-mobile-tokens: " + ", ".join(stale), file=sys.stderr)
        sys.exit(1)
    print(f"generate-mobile-tokens: {'checked' if check else 'wrote'} {len(MOBILE_THEMES)} themes"
          + (f", updated {', '.join(stale)}" if stale and not check else ""))


if __name__ == "__main__":
    main()

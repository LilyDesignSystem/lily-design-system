#!/usr/bin/env node
// bin/generate-browser-support — the supported-browser table in docs/supported-browsers.md (tasks.md P50-T22).
//
// From the engines the tests run, never typed: every tracked Playwright configuration (playwright.config.ts) and
// WebdriverIO configuration (wdio.conf.js), with the engines its projects use, whether Firefox and WebKit run every spec
// or a named subset, and the @playwright/test range its package.json asks for. A browser is supported where a test runs
// in its engine; the unit tests run in jsdom, which is no browser, so they are not counted here.
//
// Usage:
//   bin/generate-browser-support           write docs/supported-browsers.md
//   bin/generate-browser-support --check   exit 1 if the file is out of date (bin/test runs this)
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const { execFileSync } = require("node:child_process");

const top = path.resolve(__dirname, "..");
const OUT = "docs/supported-browsers.md";
const read = (p) => fs.readFileSync(path.join(top, p), "utf-8");
// Only the two configuration names and the package.json files beside them: the whole listing is too large to buffer.
const tracked = execFileSync(
    "git",
    ["ls-files", "--", "*playwright.config.ts", "*wdio.conf.js", "*package.json"],
    { cwd: top, encoding: "utf-8", maxBuffer: 64 * 1024 * 1024 },
)
    .split("\n")
    .filter(Boolean);

const ENGINES = { "Desktop Chrome": "Chromium", "Desktop Firefox": "Firefox", "Desktop Safari": "WebKit" };
const WDIO = { chrome: "Chromium", firefox: "Firefox", safari: "WebKit", MicrosoftEdge: "Chromium" };

const rows = [];
const subsets = new Map();
for (const file of tracked.filter((f) => /(^|\/)playwright\.config\.ts$/.test(f)).sort()) {
    const dir = path.dirname(file);
    const source = read(file);
    const engines = {};
    // One project per line: { name: "…", use: { ...devices["…"] }, testMatch: … }
    for (const m of source.matchAll(/devices\[["']([^"']+)["']\][^\n]*/g)) {
        const engine = ENGINES[m[1]];
        if (!engine) continue;
        const subset = /testMatch:\s*(\w+)/.exec(m[0]);
        engines[engine] = subset ? "subset" : "all";
        if (subset) {
            const def = new RegExp(`const ${subset[1]}\\s*=\\s*\\/\\(([^)]*)\\)`).exec(source);
            if (def) subsets.set(dir, def[1].split("|"));
        }
    }
    const pkgPath = path.join(dir, "package.json");
    const pkg = tracked.includes(pkgPath) ? JSON.parse(read(pkgPath)) : {};
    const range =
        (pkg.devDependencies || {})["@playwright/test"] || (pkg.dependencies || {})["@playwright/test"] || "";
    rows.push({ dir, runner: "Playwright", engines, range });
}
for (const file of tracked.filter((f) => /(^|\/)wdio\.conf\.js$/.test(f)).sort()) {
    const engines = {};
    for (const m of read(file).matchAll(/browserName:\s*["']([^"']+)["']/g))
        if (WDIO[m[1]]) engines[WDIO[m[1]]] = "all";
    rows.push({ dir: path.dirname(file), runner: "WebdriverIO", engines, range: "" });
}
rows.sort((a, b) => a.dir.localeCompare(b.dir) || a.runner.localeCompare(b.runner));

const cell = (r, engine) => ({ all: "every spec", subset: "named specs" })[r.engines[engine]] || "—";
const tested = (engine) => rows.filter((r) => r.engines[engine]).length;

// The cross-engine subset, when every configuration that has one names the same specs.
const lists = [...new Set([...subsets.values()].map((l) => l.join("|")))];

const lines = [
    "# Supported browsers",
    "",
    "_Generated by `bin/generate-browser-support` from the test configurations; do not edit. A browser is supported where a",
    "test runs in its engine. The unit tests run in jsdom, which is not a browser, so they are not counted._",
    "",
    "## Engines",
    "",
    "| Engine | Browsers | Configurations that run it |",
    "| --- | --- | --- |",
    `| Chromium | Chrome, Edge, Opera | ${tested("Chromium")} of ${rows.length} |`,
    `| Firefox | Firefox | ${tested("Firefox")} of ${rows.length} |`,
    `| WebKit | Safari | ${tested("WebKit")} of ${rows.length} |`,
    "",
    "Desktop engines only, at the versions the Playwright release named in each package installs. No configuration runs a",
    "mobile device profile (Chrome on Android, Safari on iOS and iPadOS), and no older browser version is tested.",
    "",
    "## By configuration",
    "",
    "| Package | Runner | Playwright | Chromium | Firefox | WebKit |",
    "| --- | --- | --- | --- | --- | --- |",
    ...rows.map(
        (r) =>
            `| \`${r.dir}\` | ${r.runner} | ${r.range ? "\`" + r.range + "\`" : "—"} | ${cell(r, "Chromium")} | ${cell(r, "Firefox")} | ${cell(r, "WebKit")} |`,
    ),
    "",
];
if (lists.length) {
    lines.push("## Named specs in Firefox and WebKit", "");
    if (lists.length === 1) {
        lines.push(
            "Where Firefox and WebKit run a subset, every configuration names the same specs: Chromium runs every spec, and",
            "these run in all three engines:",
            "",
            ...lists[0].split("|").map((s) => `- \`${s}\``),
            "",
        );
    } else {
        for (const [dir, list] of subsets) lines.push(`- \`${dir}\`: ${list.map((s) => "\`" + s + "\`").join(", ")}`);
        lines.push("");
    }
}
const text = lines.join("\n");

if (process.argv.includes("--check")) {
    const current = fs.existsSync(path.join(top, OUT)) ? read(OUT) : "";
    if (current !== text) {
        console.error(`${OUT} is stale; run bin/generate-browser-support`);
        process.exit(1);
    }
    console.log(`generate-browser-support: ${rows.length} configurations: OK`);
} else {
    fs.writeFileSync(path.join(top, OUT), text);
    console.log(`wrote ${OUT} (${rows.length} configurations)`);
}

#!/usr/bin/env python3
"""bin/sync-shared-modules — one source for the pure modules every grid-like helper carries.

The data grid, kanban board, Gantt chart, calendar and filter helpers share
framework-neutral modules (text folding and search, type-ahead, edit history,
export, cell types, typed fields, right-to-left keys, label coverage,
dependency-arrow geometry, unavailable-day matching) and the tests that pin
them. They used to be copied by hand; by 2026-10-17 23 packages held a stale
export-data.ts and 18 a stale typed-fields.ts (spec/headless-improvements).

shared/ is the one source. A module is copied into every top-level package
that already has a file of that name (a package adopts a module by copying it
in once; from then on this script keeps it current).

Usage:
  bin/sync-shared-modules          copy every differing file
  bin/sync-shared-modules --check  report drift and exit 1 (wired into bin/test)

Edit shared/, then run this script; never edit a package's copy.
"""
import filecmp
import re
import shutil
import subprocess
import sys
from pathlib import Path

top = Path(__file__).resolve().parent.parent
check = "--check" in sys.argv[1:]
drift = []
for source in sorted((top / "shared").glob("*.ts")):
    for target in sorted(top.glob(f"lily-design-system-*/{source.name}")):
        if filecmp.cmp(source, target, shallow=False):
            continue
        drift.append(target.relative_to(top))
        if not check:
            shutil.copyfile(source, target)

# A shared module that a component (not a package root) imports is written to an explicit path. A ".js" target is the
# module with its TypeScript types stripped (Node's own stripTypeScriptTypes), for packages that ship plain JavaScript.
EXTRA_TARGETS = {
    "middle-truncation.ts": [
        "lily-design-system-svelte-headless/components/MiddleTruncation/middle-truncation.ts",
        "lily-design-system-react-headless/components/middle-truncation.ts",
        "lily-design-system-vue-headless/components/middle-truncation.ts",
        "lily-design-system-angular-headless/components/middle-truncation.ts",
        "lily-design-system-web-components-headless/lib/middle-truncation.ts",
        "lily-design-system-alpine-headless/middle-truncation.js",
        "lily-design-system-html-headless/components/middle-truncation.html",
    ],
    "markdown-format.ts": [
        "lily-design-system-nunjucks-markdown-editor/markdown-format.js",
    ],
    "org-format.ts": [
        "lily-design-system-nunjucks-org-editor/org-format.js",
    ],
    "zones.ts": [
        "lily-design-system-nunjucks-time-zone-picker/zones.js",
    ],
    "wheel-picker.ts": [
        "lily-design-system-svelte-headless/components/WheelPicker/wheel-picker.ts",
        "lily-design-system-react-headless/components/wheel-picker.ts",
        "lily-design-system-vue-headless/components/wheel-picker.ts",
        "lily-design-system-angular-headless/components/wheel-picker.ts",
        "lily-design-system-web-components-headless/lib/wheel-picker.ts",
        "lily-design-system-alpine-headless/wheel-picker.js",
        "lily-design-system-html-headless/components/wheel-picker.html",
    ],
}
REGION_BEGIN = "/* BEGIN shared/%s (generated by bin/sync-shared-modules; do not edit) */"
REGION_END = "/* END shared/%s */"


def stripped(source):
    script = "const m=require('node:module');process.stdout.write(m.stripTypeScriptTypes(require('fs').readFileSync(process.argv[1],'utf8')))"
    out = subprocess.run(["node", "--disable-warning=ExperimentalWarning", "-e", script, str(source)], capture_output=True, text=True, check=True).stdout
    lines, blank = [], False
    for line in out.splitlines():  # type stripping leaves blank-padded lines; tidy them
        line = line.rstrip()
        if not line and blank:
            continue
        blank = not line
        lines.append(line)
    out = "\n".join(lines).strip() + "\n"
    return f"// Generated from shared/{source.name} by bin/sync-shared-modules; edit the shared module, never this copy.\n{out}"


def region(text, name, source):
    """An .html target: replace what sits between the BEGIN/END markers with the stripped module, `export` removed."""
    begin, end = REGION_BEGIN % name, REGION_END % name
    i, j = text.index(begin) + len(begin), text.index(end)
    body = "\n".join(l for l in stripped(source).splitlines()[1:])
    body = re.sub(r"^export ", "", body, flags=re.M)  # a classic <script> has no modules
    return text[:i] + "\n" + body.rstrip() + "\n" + text[j:]


for name, targets in EXTRA_TARGETS.items():
    source = top / "shared" / name
    for rel in targets:
        target = top / rel
        if rel.endswith(".html"):
            wanted = region(target.read_text(), name, source) if target.exists() else None
            if wanted is not None and target.read_text() != wanted:
                drift.append(target.relative_to(top))
                if not check:
                    target.write_text(wanted)
            continue
        wanted = stripped(source) if rel.endswith(".js") else source.read_text()
        if target.exists() and target.read_text() == wanted:
            continue
        drift.append(target.relative_to(top))
        if not check:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(wanted)

# The label packs themselves ship in one package, @lilydesignsystem/locale-translations.
for source in sorted((top / "shared" / "label-packs").glob("*.json")):
    for package in sorted(top.glob("lily-design-system-*locale-translations")):
        if (package / "package.json").exists():
            target = package / "label-packs" / source.name
            if target.exists() and filecmp.cmp(source, target, shallow=False):
                continue
            drift.append(target.relative_to(top))
            if not check:
                target.parent.mkdir(exist_ok=True)
                shutil.copyfile(source, target)

# The zone-name packs (CLDR, generated by bin/generate-zone-names) ship next to the label packs, with the CLDR licence.
for source in sorted((top / "shared" / "zone-names").glob("*")):
    if source.suffix not in (".json", ".txt"):
        continue
    for package in sorted(top.glob("lily-design-system-*locale-translations")):
        if (package / "package.json").exists():
            target = package / "zone-names" / source.name
            if target.exists() and filecmp.cmp(source, target, shallow=False):
                continue
            drift.append(target.relative_to(top))
            if not check:
                target.parent.mkdir(exist_ok=True)
                shutil.copyfile(source, target)

for path in drift:
    print(("drift: " if check else "synced: ") + str(path))
if check and drift:
    print(f"{len(drift)} file(s) differ from shared/; run bin/sync-shared-modules")
    sys.exit(1)
print(f"{'checked' if check else 'synced'}: {len(drift)} difference(s)")

#!/bin/sh
# Publish the seven Lily Design System headless component libraries.
#
#   - npm: svelte / react / vue (built dist via each package's
#     prepublishOnly), html and nunjucks (file payloads: annotated
#     .html snippets and .njk macros plus a small node helper),
#     angular (ng-packagr writes the publishable package.json INTO
#     dist/, so it builds first and publishes from dist/).
#   - NuGet: the Blazor headless Razor class library
#     (LilyDesignSystem.Blazor.Headless).
#
# Usage:
#   bin/publish-headless --dry-run     # validate builds/tarballs, publish nothing
#   bin/publish-headless --nuget-only  # publish only the Blazor/NuGet package (real)
#   bin/publish-headless --nuget-only --dry-run  # same, dry-run
#   bin/publish-headless               # publish everything for real
#
# Requirements for a real publish:
#   - npm:   `npm login` (or NPM_TOKEN in ~/.npmrc) with rights to the
#            `lily-design-system-*` package names.
#   - NuGet: NUGET_API_KEY env var with push rights to nuget.org.
#
# Versioning note: svelte/react/vue share a 0.3.x line; html, angular,
# nunjucks, and Blazor first published at 0.1.0 (a first release
# numbered higher would imply registry history that never existed —
# the helper packages' July 2026 reasoning). Bump each package.json /
# .csproj before running; this script never edits versions.
#
# --nuget-only exists because the npm and NuGet packages don't release on
# the same schedule -- e.g. the Blazor headless package needed a solo
# 0.1.1 re-publish (a missing-readme fix) with none of the npm packages
# changed. Without it, `set -eu` means the first already-published npm
# version aborts the whole script before the NuGet section is ever
# reached, whether or not that was the intent.
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DRY=""
NUGET_ONLY=""
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY="--dry-run" ;;
    --nuget-only) NUGET_ONLY="1" ;;
  esac
done

# `npm publish --dry-run` still contacts the real registry, and refuses
# outright ("You cannot publish over the previously published versions")
# when the local version is already published there — an expected,
# non-fatal outcome once any package in the catalog has shipped, not a
# defect in whatever is about to be published. Left unhandled, `set -eu`
# turns that refusal into a hard abort on the FIRST already-published
# package the loop reaches, so every later package — including a
# brand-new, never-published one — is silently never dry-run-checked at
# all (same defect class found in bin/publish-helpers, plan P7-T19).
# Every other failure (bad manifest, network error, missing dist, ...)
# still aborts the script for real, exactly as before this function
# existed.
# Every npm headless package's prepublishOnly runs its build, which
# needs that package's devDependencies; nothing installed them, so a
# publish could only succeed where node_modules happened to exist (CI
# never exercised this: headless npm releases were done locally).
# Install from the committed lockfile first, here rather than in the
# workflow, so the local and CI paths cannot drift (2026-09-03, same
# fix as bin/publish-helpers).
ensure_installed() {
  pkg="$1"
  if [ ! -d "$pkg/node_modules" ]; then
    echo "--> installing $(basename "$pkg") devDependencies (frozen lockfile)"
    ( cd "$pkg" && pnpm install --frozen-lockfile )
  fi
}

# One path for dry-run and real mode. `status` MUST be captured inside
# the failure branch: captured after the `if`, $? is the status of the
# `if` compound -- 0 when the condition fails -- so every failure was
# silently returned as success (the dry-run branch here had exactly
# that bug; found 2026-09-03 after the same defect let a real helpers
# run go green while publishing nothing). "Cannot publish over" is
# tolerated in both modes as an idempotent release, exactly as NuGet's
# --skip-duplicate below; every other failure aborts.
publish_npm_package() {
  dir="$1"
  if output="$(cd "$dir" && npm publish --access public $DRY 2>&1)"; then
    printf '%s\n' "$output"
    return 0
  else
    status=$?
    printf '%s\n' "$output"
    if printf '%s' "$output" | grep -q "You cannot publish over the previously published versions"; then
      echo "    (already published at this version -- skipped, same as NuGet --skip-duplicate)"
      return 0
    fi
    echo "    publish FAILED (exit $status) -- aborting; this is not the already-published case" >&2
    return "$status"
  fi
}

if [ -z "$NUGET_ONLY" ]; then
  echo "== npm headless packages =="
  # web-components-headless is the 8th, partial catalog (30/491, plan
  # P7-T6 / P8-T6). Its prepublishOnly runs build.mjs, so it publishes
  # from the package root like svelte/react/vue.
  for d in "$ROOT"/lily-design-system-svelte-headless \
           "$ROOT"/lily-design-system-react-headless \
           "$ROOT"/lily-design-system-vue-headless \
           "$ROOT"/lily-design-system-html-headless \
           "$ROOT"/lily-design-system-nunjucks-headless \
           "$ROOT"/lily-design-system-web-components-headless; do
    [ -f "$d/package.json" ] || continue
    ensure_installed "$d"
    echo "--> $(basename "$d")"
    publish_npm_package "$d"
  done

  ensure_installed "$ROOT/lily-design-system-angular-headless"
  echo "--> building angular dist (ng-packagr)"
  ( cd "$ROOT/lily-design-system-angular-headless" && npm run build )
  echo "--> lily-design-system-angular-headless (from dist/)"
  publish_npm_package "$ROOT/lily-design-system-angular-headless/dist"
fi

echo "== Blazor NuGet package =="
NUPKG_OUT="$ROOT/dist-nuget"
mkdir -p "$NUPKG_OUT"
proj="$ROOT/lily-design-system-blazor-headless/src/LilyBlazorHeadless/LilyBlazorHeadless.csproj"
echo "--> pack $(basename "$proj")"
dotnet pack "$proj" -c Release -o "$NUPKG_OUT"
if [ -z "$DRY" ]; then
  : "${NUGET_API_KEY:?set NUGET_API_KEY to push to nuget.org}"
  for pkg in "$NUPKG_OUT"/LilyDesignSystem.Blazor.Headless.*.nupkg; do
    echo "--> push $(basename "$pkg")"
    dotnet nuget push "$pkg" --source https://api.nuget.org/v3/index.json --api-key "$NUGET_API_KEY" --skip-duplicate
  done
else
  echo "(dry run: NuGet pack validated, nothing pushed)"
fi

echo "done"

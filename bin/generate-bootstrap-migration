#!/usr/bin/env node
// Generate Bootstrap-to-Lily mapping tables and reject target slugs absent from the canonical catalog.
// Usage: bin/generate-bootstrap-migration [--check]
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const { execFileSync } = require("node:child_process");
const top = path.resolve(__dirname, "..");
const check = process.argv.includes("--check");
const read = (relative) => fs.readFileSync(path.join(top, relative), "utf8");
const catalog = new Set(
    read("components-categories.tsv")
        .trim()
        .split("\n")
        .map((line) => line.split("\t")[0]),
);
const lines = read("docs/migrating/bootstrap.tsv").trim().split("\n");
if (lines.shift() !== "Bootstrap component or class\tLily slugs\tWhat changes") {
    throw new Error("docs/migrating/bootstrap.tsv has an unexpected header");
}
const rows = lines.map((line, index) => {
    const cells = line.split("\t");
    if (cells.length !== 3 || cells.some((cell) => !cell.trim())) {
        throw new Error(
            `docs/migrating/bootstrap.tsv:${index + 2}: expected three non-empty tab-separated cells`,
        );
    }
    const slugs = cells[1].split(";");
    for (const slug of slugs) {
        if (!catalog.has(slug))
            throw new Error(
                `docs/migrating/bootstrap.tsv:${index + 2}: unknown Lily slug: ${slug}`,
            );
    }
    return { bootstrap: cells[0], slugs, note: cells[2] };
});

const markdown = [
    "<!-- Generated by bin/generate-bootstrap-migration; do not edit this region. -->",
    "| Bootstrap component or class | Lily component | What changes |",
    "| --- | --- | --- |",
    ...rows.map(
        ({ bootstrap, slugs, note }) =>
            `| ${bootstrap.replace(/\|/g, "\\|")} | ${slugs.map((slug) => `[\`${slug}\`](components/${slug}/)`).join(", ")} | ${note.replace(/\|/g, "\\|")} |`,
    ),
].join("\n");
const escapeHtml = (value) =>
    value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
const inlineCode = (value) => escapeHtml(value).replace(/`([^`]+)`/g, "<code>$1</code>");
const html = [
    "  <!-- Generated by bin/generate-bootstrap-migration; do not edit this region. -->",
    "  <!-- svelte-ignore a11y_no_noninteractive_tabindex -->",
    '  <div role="region" aria-label="Bootstrap to Lily component mapping" tabindex="0" style="overflow-x: auto;">',
    '    <table style="min-inline-size: 52rem;">',
    "      <thead><tr><th>Bootstrap component or class</th><th>Lily component</th><th>What changes</th></tr></thead>",
    "      <tbody>",
    ...rows.map(
        ({ bootstrap, slugs, note }) =>
            `        <tr><td>${inlineCode(bootstrap)}</td><td>${slugs.map((slug) => `<a href="/components/${slug}/"><code>${slug}</code></a>`).join(", ")}</td><td>${escapeHtml(note)}</td></tr>`,
    ),
    "      </tbody>",
    "    </table>",
    "  </div>",
].join("\n");

function update(relative, generated) {
    const file = path.join(top, relative);
    const source = fs.readFileSync(file, "utf8");
    const pattern =
        /([ \t]*)<!-- bootstrap-mapping:start -->[\s\S]*?\n\1<!-- bootstrap-mapping:end -->/;
    const match = source.match(pattern);
    if (!match) throw new Error(`${relative}: missing bootstrap mapping markers`);
    const replaced = source.replace(
        pattern,
        `${match[1]}<!-- bootstrap-mapping:start -->\n${generated}\n${match[1]}<!-- bootstrap-mapping:end -->`,
    );
    const next = execFileSync(
        path.join(top, "node_modules/.bin/prettier"),
        ["--stdin-filepath", relative],
        {
            cwd: top,
            input: replaced,
            encoding: "utf8",
        },
    );
    if (next === source) return false;
    if (check) console.error(`out of date: ${relative}`);
    else fs.writeFileSync(file, next);
    return true;
}

const changed = [
    update("MIGRATING-FROM-BOOTSTRAP.md", markdown),
    update("lilydesignsystem.github.io/src/routes/migrating/from-bootstrap/+page.svelte", html),
].filter(Boolean).length;
if (check && changed) process.exit(1);
console.log(
    changed
        ? `generate-bootstrap-migration: wrote ${changed} files`
        : `generate-bootstrap-migration: up to date (${rows.length} mappings)`,
);

## angular-headless
cat > "lily-design-system-angular-headless/components/$pascal.ts" <<NGEOF
import { ChangeDetectionStrategy, Component, input } from "@angular/core";

/**
 * $pascal — $description
 *
 * Generated by bin/new-component; replace the root element with the
 * real semantic tag once $pascal's actual purpose is decided.
 */
@Component({
  selector: "lily-${slug}",
  standalone: true,
  template: \`<div class="$slug {{ className() }}" [attr.aria-label]="label()"><ng-content /></div>\`,
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class $pascal {
  readonly className = input<string>("");
  readonly label = input<string | undefined>(undefined);
}
NGEOF
cat > "lily-design-system-angular-headless/components/$pascal.spec.ts" <<NGSPECEOF
import { describe, expect, test } from "vitest";
import { TestBed } from "@angular/core/testing";

import { $pascal } from "./$pascal";

describe("$pascal", () => {
  test("renders the root with the base class", () => {
    const fixture = TestBed.createComponent($pascal);
    fixture.detectChanges();
    const el = fixture.nativeElement.querySelector(".$slug");
    expect(el).toBeTruthy();
  });

  test("appends the className input to the root class list", () => {
    const fixture = TestBed.createComponent($pascal);
    fixture.componentRef.setInput("className", "extra");
    fixture.detectChanges();
    const el = fixture.nativeElement.querySelector(".$slug");
    expect(el.classList.contains("extra")).toBe(true);
  });

  test("sets aria-label from the label input", () => {
    const fixture = TestBed.createComponent($pascal);
    fixture.componentRef.setInput("label", "Hello");
    fixture.detectChanges();
    const el = fixture.nativeElement.querySelector(".$slug");
    expect(el.getAttribute("aria-label")).toBe("Hello");
  });
});
NGSPECEOF

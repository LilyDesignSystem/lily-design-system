- \`label\`: string (optional) -- accessible label via \`aria-label\`
- \`children\`: ReactNode (required) -- component content
- \`...restProps\`: unknown -- additional attributes spread onto the root

## Usage

\`\`\`tsx
<$pascal>...</$pascal>
\`\`\`
REACTMDEOF

## vue-headless
cat > "lily-design-system-vue-headless/components/$pascal.vue" <<VUEEOF
<script setup lang="ts">
    // $pascal component -- generated by bin/new-component; replace <div>
    // with the real semantic element once $pascal's actual purpose is
    // decided.
    //
    // Props:
    //   label -- string, optional. Accessible label via aria-label.
    //   default slot -- component content.

    withDefaults(defineProps<{
        /** Optional accessible label set on aria-label. */
        label?: string;
    }>(), {
        label: undefined,
    });
</script>

<template>
    <!-- $pascal.vue -->
    <div
        class="$slug"
        :aria-label="label"
    >
        <slot />
    </div>
</template>
VUEEOF
cat > "lily-design-system-vue-headless/components/$pascal.test.ts" <<VUETESTEOF
import { describe, expect, test } from "vitest";
import { render } from "@testing-library/vue";

import Subject from "./$pascal.vue";

describe("$pascal", () => {
    test("renders the root element with class $slug", () => {
        const { container } = render(Subject, { props: {}, slots: { default: "content" } });
        const root = container.querySelector(".$slug");
        expect(root).toBeTruthy();
    });

    test("renders slot content", () => {
        const { container } = render(Subject, { props: {}, slots: { default: "hello" } });
        expect(container.textContent).toContain("hello");
    });

    test("applies aria-label when label prop is provided", () => {
        const { container } = render(Subject, { props: { label: "Hello" }, slots: { default: "x" } });
        const root = container.querySelector(".$slug");
        expect(root?.getAttribute("aria-label")).toBe("Hello");
    });
});
VUETESTEOF
cat > "lily-design-system-vue-headless/components/$pascal.stories.ts" <<VUESTORYEOF

cat > "lily-design-system-nunjucks-headless/components/$slug/macro.njk" <<NJKEOF
{#
  $pascal macro -- generated by bin/new-component; replace <div> with
  the real semantic element once $slug's actual purpose is decided.

  HTML tag: <div>
  CSS class: $slug

  Params:
    text        string   Plain text content (escaped).
    html        string   Raw HTML content (rendered via | safe).
    label       string   Accessible name (aria-label).
    id          string
    classes     string
    attributes  object

  Usage:
    {% from "components/$slug/macro.njk" import $camel %}
    {{ $camel({ text: "Example", label: "Example" }) }}
#}
{%- macro $camel(params) -%}
<div
  class="$slug{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if params.html -%}{{ params.html | safe }}
  {%- elif params.text -%}{{ params.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}
NJKEOF
cat > "lily-design-system-nunjucks-headless/components/$slug/macro.test.js" <<NJKTESTEOF
import { describe, it, expect } from "vitest";
import { render } from "../../test/render.js";

describe("$camel", () => {
  it("renders the root with the base class", () => {
    const { document } = render("$slug", { text: "Example" });
    const el = document.querySelector(".$slug");
    expect(el).toBeTruthy();
    expect(el.textContent.trim()).toBe("Example");
  });

  it("sets aria-label when provided", () => {
    const { document } = render("$slug", { text: "x", label: "Example label" });
    expect(document.querySelector(".$slug").getAttribute("aria-label"))
      .toBe("Example label");
  });

  it("appends params.classes", () => {
    const { document } = render("$slug", { text: "x", classes: "extra" });
    expect(document.querySelector(".$slug.extra")).toBeTruthy();
  });

  it("contains no <style> or <script> tags", () => {
    const { html } = render("$slug", { text: "x" });
    expect(html).not.toContain("<style");
    expect(html).not.toContain("<script");
  });
});

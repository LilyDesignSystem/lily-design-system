cat > "lily-design-system-blazor-headless/tests/LilyBlazorHeadless.Tests/Components/${pascal}Tests.cs" <<BLAZORTESTEOF
using Bunit;
using LilyBlazorHeadless.Components;
using Xunit;

namespace LilyBlazorHeadless.Tests.Components;

public class ${pascal}Tests : TestContext
{
    [Fact]
    public void Renders_with_kebab_base_class()
    {
        var cut = RenderComponent<$pascal>(p => p
            .AddChildContent("body"));
        var root = cut.Find(".$slug");
        Assert.NotNull(root);
    }

    [Fact]
    public void CssClass_is_appended_to_kebab_base_class()
    {
        var cut = RenderComponent<$pascal>(p => p
            .AddChildContent("body")
            .Add(x => x.CssClass, "extra"));
        var root = cut.Find(".$slug");
        Assert.Contains("extra", root.GetAttribute("class"));
    }

    [Fact]
    public void AdditionalAttributes_pass_through_to_root()
    {
        var cut = RenderComponent<$pascal>(p => p
            .AddChildContent("body")
            .AddUnmatched("data-test", "value"));
        var root = cut.Find(".$slug");
        Assert.Equal("value", root.GetAttribute("data-test"));
    }
}

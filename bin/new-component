#!/bin/sh
set -euf

## bin/new-component -- plan P7-T3: end-to-end component scaffolder.
##
## Generates a NEW, GENERIC, WORKING placeholder component across every
## layer bin/test and the registries check: the catalog row, the docs
## dir, the CSS hook, all 7 headless implementations + tests + stories,
## the two example apps bin/test verifies per-component
## (svelte-sveltekit-examples, nunjucks-eleventy-examples), the
## github.io route, and every generated registry (via
## bin/generate-component-categories + bin/generate-registries).
##
## The generated component is deliberately generic: a <div>-rooted
## element with a `label` prop (-> aria-label) and a children slot,
## matching the headless base-class + rest-props contract but no
## component-specific semantics -- because this script cannot know
## what real HTML tag, ARIA, or behaviour a not-yet-invented component
## needs. Status is set to "experimental" precisely so nobody mistakes
## the scaffold for a finished component. Replace the HTML tag, ARIA,
## and behaviour in all 7 implementations (and the AGENTS.md "HTML
## tag" line + the CSS hook comment) once the real design is known.
##
## Usage:
##   bin/new-component <slug> ["description"]
##   bin/new-component --revert <slug>
##
## <slug> is kebab-case (e.g. "example-widget"); the PascalCase name is
## derived automatically ("ExampleWidget"). description defaults to a
## generic placeholder if omitted.
##
## --revert undoes exactly what a prior run created or modified for
## <slug>: new files/dirs are removed, the shared registries this
## script's own generators touch are `git checkout --`'d back to HEAD.
## Only safe if nothing else has modified those same shared files
## since the run being reverted -- this is a scratch/testing tool, not
## a merge-aware undo.
##
## Verify (plan P7-T3's own criterion): run this on a scratch slug,
## run bin/test, confirm it passes, then --revert and confirm
## `git status` is clean again.

top="$(git rev-parse --show-toplevel)"
cd "$top"

usage() {
    sed -n '2,40p' "$0" | sed 's/^## \{0,1\}//'
}

# ---------- shared registries this script's generators touch ----------
# (components.tsv, components-categories.tsv, and the css template are
# edited directly by this script; everything else here is regenerated
# by bin/generate-component-categories / bin/generate-registries, which
# this script always calls -- so --revert can restore all of them the
# same way, with `git checkout --`.)
SHARED_FILES="
components.tsv
components-categories.tsv
css-style-sheet-template.css
index.md
lily-design-system-svelte-sveltekit-examples/src/lib/data/components.ts
lily-design-system-svelte-sveltekit-examples/src/lib/data/component-demos.ts
lily-design-system-react-next-examples/app/data/components.ts
lily-design-system-react-next-examples/app/data/component-demos.ts
lily-design-system-vue-nuxt-examples/data/components.ts
lily-design-system-vue-nuxt-examples/data/component-demos.ts
lily-design-system-angular-examples/src/app/components-data.ts
lily-design-system-angular-examples/src/app/component-demos.ts
lily-design-system-blazor-web-examples/src/LilyBlazorWebExamples/Data/ComponentData.cs
lily-design-system-html-css-js-examples/pages/components/index.html
lily-design-system-html-css-js-examples/pages/components/component.html
lilydesignsystem.github.io/src/lib/components.ts
"

new_dirs_for() (
    # slug="$1" pascal="$2"
    # svelte-headless has TWO real component trees, not a canonical +
    # a duplicate: build.mjs's dist build reads components/{Pascal}/
    # directly (the actual npm-published source), while
    # src/lib/components/{Pascal}/ is the SvelteKit-convention mirror
    # used for local dev; vitest's default include glob runs both
    # trees' tests project-wide (plan P7-T14 -- an earlier version of
    # this script only wrote the src/lib mirror, which is why P7-T13's
    # first Kbd fix missed the copy that actually ships).
    printf '%s\n' \
        "components/$1" \
        "lily-design-system-svelte-headless/components/$2" \
        "lily-design-system-svelte-headless/src/lib/components/$2" \
        "lily-design-system-svelte-sveltekit-examples/src/lib/components/$2" \
        "lily-design-system-nunjucks-headless/components/$1" \
        "lilydesignsystem.github.io/src/routes/components/$1"
)

new_files_for() (
    # slug="$1" pascal="$2"
    printf '%s\n' \
        "lily-design-system-react-headless/components/$2.tsx" \
        "lily-design-system-react-headless/components/$2.test.tsx" \
        "lily-design-system-react-headless/components/$2.stories.tsx" \
        "lily-design-system-react-headless/components/$2.md" \
        "lily-design-system-vue-headless/components/$2.vue" \
        "lily-design-system-vue-headless/components/$2.test.ts" \
        "lily-design-system-vue-headless/components/$2.stories.ts" \
        "lily-design-system-vue-headless/components/$2.md" \
        "lily-design-system-angular-headless/components/$2.ts" \
        "lily-design-system-angular-headless/components/$2.spec.ts" \
        "lily-design-system-angular-headless/components/$2.stories.ts" \
        "lily-design-system-angular-headless/components/$2.md" \
        "lily-design-system-html-headless/components/$1.html" \
        "lily-design-system-html-headless/components/$1.test.js" \
        "lily-design-system-html-headless/components/$1.stories.ts" \
        "lily-design-system-blazor-headless/src/LilyBlazorHeadless/Components/$2.razor" \
        "lily-design-system-blazor-headless/tests/LilyBlazorHeadless.Tests/Components/${2}Tests.cs" \
        "lily-design-system-blazor-headless/src/LilyBlazorHeadless/Components/$2.md" \
        "lily-design-system-nunjucks-eleventy-examples/src/components/$1.njk"
)

if [ "${1:-}" = "--revert" ]; then
    slug="${2:-}"
    test -n "$slug" || { echo "usage: bin/new-component --revert <slug>" >&2; exit 1; }
    pascal="$(printf '%s' "$slug" | awk -F'-' '{o="";for(i=1;i<=NF;i++){w=$i;o=o toupper(substr(w,1,1)) substr(w,2)}print o}')"

    echo "Reverting scaffold for '$slug' ($pascal)..."
    new_dirs_for "$slug" "$pascal" | while IFS= read -r d; do
        test -e "$d" && { echo "  rm -rf $d"; rm -rf "$d"; } || true
    done
    new_files_for "$slug" "$pascal" | while IFS= read -r f; do
        test -e "$f" && { echo "  rm -f $f"; rm -f "$f"; } || true
    done
    echo "$SHARED_FILES" | while IFS= read -r f; do
        test -z "$f" && continue
        git diff --quiet -- "$f" 2>/dev/null || { echo "  git checkout -- $f"; git checkout -- "$f"; }
    done
    echo "Reverted. Run 'git status' to confirm the tree is clean."
    exit 0
fi

slug="${1:-}"
if [ -z "$slug" ]; then
    usage
    exit 1
fi
case "$slug" in
    -h|--help) usage; exit 0 ;;
esac
description="${2:-a generated placeholder component -- replace this description and implementation}"

case "$slug" in
    [a-z]*) ;;
    *) echo "slug must be lowercase kebab-case, starting with a letter: $slug" >&2; exit 1 ;;
esac
if printf '%s' "$slug" | grep -qE '[^a-z0-9-]'; then
    echo "slug must be lowercase kebab-case (a-z, 0-9, hyphen only): $slug" >&2
    exit 1
fi
if grep -q "^$slug	" components.tsv; then
    echo "slug already exists in components.tsv: $slug" >&2
    exit 1
fi

pascal="$(printf '%s' "$slug" | awk -F'-' '{o="";for(i=1;i<=NF;i++){w=$i;o=o toupper(substr(w,1,1)) substr(w,2)}print o}')"

# $description is interpolated directly into UNQUOTED heredocs below
# (so it can flow through sentences naturally), which means the shell
# expands `, $(), and bare $ inside it same as any other unquoted
# string. Reject those rather than silently mis-generating a file or,
# worse, executing something -- this is a dev tool for a trusted local
# description, not a sanitizer for untrusted input.
if printf '%s' "$description" | grep -qE '[`$]'; then
    echo "description must not contain \` or \$ (it's interpolated into generated source): $description" >&2
    exit 1
fi

# JS-string-safe copy of the description, for the single-quoted /
# double-quoted JS string literal contexts it's substituted into.
desc_js="$(printf '%s' "$description" | sed -e "s/'/\\\\'/g")"

echo "Scaffolding '$slug' ($pascal): $description"

# ---------- 1. catalog row ----------
printf '%s\t%s\t%s\n' "$slug" "$pascal" "$description" >> components.tsv

# ---------- 2. docs dir (components/{slug}/) ----------
mkdir -p "components/$slug/spec"
ln -sfn index.md "components/$slug/README.md"
echo "@AGENTS.md" > "components/$slug/CLAUDE.md"

cat > "components/$slug/AGENTS.md" <<AGENTSEOF
# $pascal

## Metadata

- Component: $slug
- PascalCase: $pascal
- Description: $description
- Status: experimental — generated by bin/new-component; not yet reviewed, styled, or exercised in a composed flow
- HTML tag: <div>
- CSS class: .$slug
- Interactive: no

## Key Behaviors

- Renders a generic \`<div>\` root with the kebab-case base class \`$slug\` plus the consumer's class hook
- Accepts \`label\` to set \`aria-label\` when the visible content alone isn't a sufficient accessible name
- Spreads rest props / additional attributes onto the root element
- Children / default slot renders the component's content

## Keyboard

- None yet — this scaffold has no interactive behavior

## Props

- \`className\`: string (default: \`""\`) -- CSS class name appended to the base class
- \`label\`: string (optional) -- sets \`aria-label\` on the root
- \`children\`: slot (required) -- the component's content
- \`...restProps\`: unknown -- additional attributes spread onto the root element

## ARIA

- \`aria-label\` when \`label\` is provided

## Acceptance Criteria

- [ ] Replace the \`<div>\` root with the correct semantic HTML element for this component
- [ ] Renders the root element with class="$slug"
- [ ] WCAG 2.2 AAA compliant
- [ ] Zero CSS — fully headless

## References

- Documentation: index.md
- CSS class: .$slug in css-style-sheet-template.css
AGENTSEOF

cat > "components/$slug/index.md" <<INDEXEOF
# $pascal

$pascal is a headless placeholder component, generated by \`bin/new-component\` (plan P7-T3). $description

**Status:** experimental — generated by bin/new-component; not yet reviewed, styled, or exercised in a composed flow.

## Implementation Notes

- Renders a generic \`<div>\` root with the kebab-case base class \`$slug\` plus the consumer's class hook
- Accepts \`label\` to set \`aria-label\`
- Spreads rest props / additional attributes onto the root element
- Children / default slot renders the component's content

## Props

- \`className\`: string (default: \`""\`) -- CSS class name appended to the base class
- \`label\`: string (optional) -- sets \`aria-label\` on the root
- \`children\`: slot (required) -- the component's content
- \`...restProps\`: unknown -- additional attributes spread onto the root element

## Usage

\`\`\`html
<$pascal label="$pascal example">Content</$pascal>
\`\`\`

## Keyboard Interactions

None yet.

## ARIA

\`aria-label\` when \`label\` is provided.

## When to Use

- This is a generated scaffold — replace this section once the component's real purpose is decided.

## When Not to Use

- This is a generated scaffold — replace this section once the component's real purpose is decided.

## Headless

This headless component renders a generic \`<div>\`. Replace it with the correct semantic element before shipping.

## Styles

The consumer provides all CSS styling via the \`.$slug\` class.

## Testing

- Verify the component renders its root element with class \`$slug\`
- Verify children content is rendered
- Verify \`label\` sets \`aria-label\`
- Verify pass-through attributes are applied

## References

- AGENTS/headless.md

---

Lily™ and Lily Design System™ are trademarks.
INDEXEOF

cat > "components/$slug/spec/index.md" <<SPECEOF
# $pascal — spec

Generated by \`bin/new-component\` (plan P7-T3). Not yet implemented for real.

## Plan

- [ ] Decide the real HTML tag, ARIA, and behavior for $pascal.
- [ ] Update \`AGENTS.md\`'s "HTML tag" line and this component's 7 implementations to match.
- [ ] Write real "When to Use" / "When Not to Use" guidance in \`index.md\`.
- [ ] Verify: \`bin/test\` passes; each headless catalog's test suite passes.
SPECEOF

# ---------- 3. CSS hook ----------
{
    printf '\n/* %s: %s */\n' "$slug" "$description"
    printf '.%s {\n}\n' "$slug"
} >> css-style-sheet-template.css

# ---------- 4. demo entry (canonical; copies come from bin/generate-registries) ----------
demo_html="<div class=\"$slug\" aria-label=\"$desc_js\">$pascal</div>"
awk -v line="  '$slug': '$demo_html'," '
    /^};$/ && !done { print line; done=1 }
    { print }
' "lily-design-system-svelte-sveltekit-examples/src/lib/data/component-demos.ts" \
    > "lily-design-system-svelte-sveltekit-examples/src/lib/data/component-demos.ts.tmp"
mv "lily-design-system-svelte-sveltekit-examples/src/lib/data/component-demos.ts.tmp" \
    "lily-design-system-svelte-sveltekit-examples/src/lib/data/component-demos.ts"

# ---------- 5. seven headless implementations + tests + stories ----------

## svelte-headless has two real component trees (not canonical + dead
## duplicate -- see the new_dirs_for() comment above): components/ is
## what build.mjs actually reads to publish the npm package;
## src/lib/components/ is the SvelteKit-convention mirror for local
## dev, also required (identically) in svelte-sveltekit-examples by
## bin/test's test_implementations_with_svelte. All three get the
## exact same files.
for svelte_root in \
    "lily-design-system-svelte-headless/components/$pascal" \
    "lily-design-system-svelte-headless/src/lib/components/$pascal" \
    "lily-design-system-svelte-sveltekit-examples/src/lib/components/$pascal"
do
    mkdir -p "$svelte_root"
    cat > "$svelte_root/$pascal.svelte" <<SVELTEEOF
<script lang="ts">
    import type { Snippet } from "svelte";
    let {
        class: className = "",
        label = undefined,
        children,
        ...restProps
    }: {
        label?: string;
        children: Snippet;
        [key: string]: unknown;
    } = \$props();
</script>

<!-- $pascal.svelte -- generated by bin/new-component; replace <div> with the real semantic element -->
<div class={\`$slug \${className}\`} aria-label={label} {...restProps}>
    {@render children?.()}
</div>
SVELTEEOF
    cat > "$svelte_root/$pascal.test.ts" <<SVELTETESTEOF
import { render, screen } from "@testing-library/svelte";
import { describe, expect, test } from "vitest";
import $pascal from "./$pascal.svelte";

describe("$pascal", () => {
    test("renders with content", () => {
        render($pascal, { props: { label: "Test" } });
        const el = screen.getByLabelText("Test");
        expect(el).toBeTruthy();
        expect(el.getAttribute("class")).toContain("$slug");
    });
});
SVELTETESTEOF
    cat > "$svelte_root/$pascal.stories.svelte" <<SVELTESTORYEOF
<script module lang="ts">
    import { defineMeta } from "@storybook/addon-svelte-csf";
    import $pascal from "./$pascal.svelte";
    const { Story } = defineMeta({
        title: "Headless/$pascal",
        component: $pascal,
    });
</script>

<Story name="Default" tags={["autodocs", "!dev"]}>
    <$pascal label="$pascal example">
        <span>$pascal example</span>
    </$pascal>
</Story>
SVELTESTORYEOF
    cp "components/$slug/index.md" "$svelte_root/index.md"
done

## react-headless
cat > "lily-design-system-react-headless/components/$pascal.tsx" <<REACTEOF
// $pascal component -- generated by bin/new-component; replace <div> with
// the real semantic element once $pascal's actual purpose is decided.
//
// Props:
//   className -- string, optional. CSS class name.
//   label     -- string, optional. Accessible label via aria-label.
//   children  -- ReactNode, required. Component content.
//   ...restProps -- additional HTML attributes spread onto the root.

import React from "react";

export interface ${pascal}Props {
    className?: string;
    /** Optional accessible label set on aria-label. */
    label?: string;
    /** Component content. */
    children: React.ReactNode;
    [key: string]: unknown;
}

export default function $pascal({
    className = "",
    label = undefined,
    children,
    ...restProps
}: ${pascal}Props) {
    return (
        <div
            className={\`$slug \${className}\`}
            aria-label={label}
            {...restProps}
        >
            {children}
        </div>
    );
}
REACTEOF
cat > "lily-design-system-react-headless/components/$pascal.test.tsx" <<REACTTESTEOF
import { render } from "@testing-library/react";
import { describe, expect, test } from "vitest";

import Subject from "./$pascal";

describe("$pascal", () => {
    test("renders the root element with class $slug", () => {
        const { container } = render(<Subject>content</Subject>);
        const root = container.querySelector(".$slug");
        expect(root).toBeTruthy();
    });

    test("renders children content", () => {
        const { container } = render(<Subject>content</Subject>);
        expect(container.textContent).toContain("content");
    });

    test("applies aria-label when label prop is provided", () => {
        const { container } = render(<Subject label="Hello">content</Subject>);
        const root = container.querySelector(".$slug");
        expect(root?.getAttribute("aria-label")).toBe("Hello");
    });

    test("passes through additional HTML attributes", () => {
        const { container } = render(<Subject data-testid="subject">content</Subject>);
        expect(container.querySelector("[data-testid='subject']")).toBeTruthy();
    });
});
REACTTESTEOF
cat > "lily-design-system-react-headless/components/$pascal.stories.tsx" <<REACTSTORYEOF
import type { Meta, StoryObj } from '@storybook/react-vite';
import $pascal from './$pascal';

const meta = {
  title: 'Headless/$pascal',
  component: $pascal,
  tags: ['autodocs']
} satisfies Meta<typeof $pascal>;

export default meta;
type Story = StoryObj<typeof meta>;

export const Default: Story = {};
REACTSTORYEOF
cat > "lily-design-system-react-headless/components/$pascal.md" <<REACTMDEOF

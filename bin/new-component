cat > "lily-design-system-html-headless/components/$slug.test.js" <<HTMLTESTEOF
// $slug.test.js
// $pascal component test

const path = require('path');

describe('$pascal', function() {
  beforeEach(async function() {
    await browser.url('file://' + path.resolve(__dirname, '$slug.html'));
  });

  it('should render the root element with correct class', async function() {
    const el = await \$('.$slug');
    await expect(el).toExist();
  });

  it('should have an aria-label attribute', async function() {
    const el = await \$('.$slug');
    const label = await el.getAttribute('aria-label');
    expect(label).not.toBeNull();
  });
});

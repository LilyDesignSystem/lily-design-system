@namespace LilyBlazorHeadless.Components

@*
    $pascal component -- generated by bin/new-component; replace the
    root element with the real semantic tag once $pascal's actual
    purpose is decided.
    $description
*@

<div class="@(\$"$slug {CssClass}".Trim())" aria-label="@Label" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

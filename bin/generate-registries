#!/usr/bin/env node
// bin/generate-registries
//
// Regenerate every example-app catalog registry from the two canonical
// sources, so the hand-copied registries can never drift again:
//
//   - components.tsv                                  → slug, name, description
//   - components-categories.tsv (bin/generate-component-categories)
//                                                       → slug → tag, category
//   - lily-design-system-svelte-sveltekit-examples/
//     src/lib/data/component-demos.ts                 → slug → demo HTML
//       (the curated demo map; regenerate its baseline with
//       generate-component-demos.js, then curate in place)
//
// Outputs (overwritten in full or region-replaced):
//   - {svelte-sveltekit,react-next,vue-nuxt,angular} components registry .ts
//     (each entry carries tag + category; category id resolves via the
//     exported CATEGORY_LABEL map, also written into each registry file —
//     see plan P6-T5, the /components search category + suffix-pattern
//     filters)
//   - {react-next,vue-nuxt,angular} component-demos.ts (copies of canonical)
//   - blazor-web ComponentData.cs (slug/name/description/tag/category + demo HTML)
//   - html-css-js pages/components/{index,component}.html embedded arrays
//   - lilydesignsystem.github.io/src/lib/components.ts
//   - root index.md component listing section
//
// Run bin/generate-component-categories first if components-categories.tsv
// is stale (bin/test checks it isn't).
//
// Run bin/test afterwards; it asserts every registry matches the catalog.
//
// --check writes nothing and exits 1 if any output would change (bin/test
// runs it: a catalog change once updated components-categories.tsv without
// regenerating the registries, and only CI's git-diff step noticed).

const fs = require("fs");
const path = require("path");

// LILY_ROOT points the generator at another tree (the golden-test fixture, test/generators).
const top = process.env.LILY_ROOT || path.join(__dirname, "..");
const check = process.argv.includes("--check");
const stale = [];
const read = (p) => fs.readFileSync(path.join(top, p), "utf-8");
const write = (p, s) => {
  if (check) {
    const file = path.join(top, p);
    if (!fs.existsSync(file) || fs.readFileSync(file, "utf-8") !== s) stale.push(p);
    return;
  }
  fs.writeFileSync(path.join(top, p), s);
  console.log("wrote", p);
};

// ---------- canonical sources ----------

const { CATEGORY_LABEL } = require("./generate-component-categories");
const categoryOf = {};
const tagOf = {};
for (const line of read("components-categories.tsv").split("\n")) {
  if (!line.trim()) continue;
  const [slug, tag, category] = line.split("\t");
  tagOf[slug] = tag;
  categoryOf[slug] = category;
}

const components = read("components.tsv")
  .split("\n")
  .filter((l) => l.trim())
  .map((l) => {
    const [slug, name, description] = l.split("\t");
    if (!(slug in categoryOf)) {
      throw new Error(`${slug} missing from components-categories.tsv — run bin/generate-component-categories`);
    }
    return { slug, name, description: description || "", tag: tagOf[slug], category: categoryOf[slug] };
  });

const demosSource = read(
  "lily-design-system-svelte-sveltekit-examples/src/lib/data/component-demos.ts"
);
const demos = {};
for (const m of demosSource.matchAll(/^ {2}'([^']+)': '((?:[^'\\]|\\.)*)',$/gm)) {
  demos[m[1]] = m[2]; // value kept in its JS-escaped form
}
const missingDemos = components.filter((c) => !(c.slug in demos));
if (missingDemos.length) {
  console.error(
    "canonical demo map is missing:",
    missingDemos.map((c) => c.slug).join(", ")
  );
  process.exit(1);
}

const jsStr = (s) => JSON.stringify(s); // double-quoted JS/TS/JSON string
const csStr = (s) => '"' + s.replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"';
const unescapeJs = (s) =>
  s.replace(/\\'/g, "'").replace(/\\\\/g, "\\"); // demo map value → raw HTML

// ---------- TS/JS components arrays ----------

const tsEntry = (c, indent) => {
  const i = " ".repeat(indent);
  const f = " ".repeat(indent + 4);
  return [
    `${i}{`,
    `${f}slug: ${jsStr(c.slug)},`,
    `${f}name: ${jsStr(c.name)},`,
    `${f}description: ${jsStr(c.description)},`,
    `${f}tag: ${jsStr(c.tag)},`,
    `${f}category: ${jsStr(c.category)},`,
    `${i}},`,
  ].join("\n");
};
const tsEntries = (indent) => components.map((c) => tsEntry(c, indent)).join("\n");

// The category id → display label map (plan P6-T5's category filter),
// as one TS literal shared by every registry below — the single place
// the labels are spelled out, sourced from generate-component-categories.
const categoryLabelEntries = (indent) => {
  const i = " ".repeat(indent);
  return Object.entries(CATEGORY_LABEL)
    .map(([id, label]) => `${i}${jsStr(id)}: ${jsStr(label)},`)
    .join("\n");
};

write(
  "lily-design-system-svelte-sveltekit-examples/src/lib/data/components.ts",
  `export const components = [\n${tsEntries(2)}\n];\n
/** Category id → display label (plan P6-T5's category filter). */
export const CATEGORY_LABEL: Record<string, string> = {
${categoryLabelEntries(2)}
};
`
);

write(
  "lily-design-system-react-next-examples/app/data/components.ts",
  `export interface Component {
  slug: string;
  name: string;
  description: string;
  tag: string;
  category: string;
}

export const components: Component[] = [
${tsEntries(2)}
];

/** Category id → display label (plan P6-T5's category filter). */
export const CATEGORY_LABEL: Record<string, string> = {
${categoryLabelEntries(2)}
};
`
);

write(
  "lily-design-system-angular-examples/src/app/components-data.ts",
  `export interface ComponentMeta {
  slug: string;
  name: string;
  description: string;
  tag: string;
  category: string;
}

export const components: ComponentMeta[] = [
${tsEntries(2)}
];

/** Category id → display label (plan P6-T5's category filter). */
export const CATEGORY_LABEL: Record<string, string> = {
${categoryLabelEntries(2)}
};
`
);

write(
  "lily-design-system-vue-nuxt-examples/data/components.ts",
  `export interface ComponentMeta {
  slug: string;
  name: string;
  description: string;
  tag: string;
  category: string;
}

export const components: ComponentMeta[] = [
${tsEntries(2)}
];

/** Category id → display label (plan P6-T5's category filter). */
export const CATEGORY_LABEL: Record<string, string> = {
${categoryLabelEntries(2)}
};
`
);

// ---------- github.io registry ----------

// Maturity status per component, read from the canonical metadata
// (components/{slug}/AGENTS.md "- Status:" bullet; spec/components).
const statusOf = (slug) => {
  const m = read(`components/${slug}/AGENTS.md`).match(/^- Status: (\w+)/m);
  if (!m) throw new Error(`components/${slug}/AGENTS.md has no Status bullet`);
  return m[1];
};

write(
  "lilydesignsystem.github.io/src/lib/components.ts",
  `// Lily component catalog — generated from components.tsv
// Components across HTML, Svelte, React, Vue, Angular, Blazor, Nunjucks headless

export type LilyComponent = {
  name: string;
  pascal: string;
  description: string;
  /** Maturity: see the rubric in spec/components. */
  status: 'stable' | 'beta' | 'experimental';
};

export const LILY_COMPONENTS: LilyComponent[] = [
${components
  .map(
    (c) =>
      `  { name: ${jsStr(c.slug)}, pascal: ${jsStr(c.name)}, description: ${jsStr(c.description)}, status: ${jsStr(statusOf(c.slug))} },`
  )
  .join("\n")}
];
`
);

// ---------- component-demos.ts copies ----------

for (const p of [
  "lily-design-system-react-next-examples/app/data/component-demos.ts",
  "lily-design-system-vue-nuxt-examples/data/component-demos.ts",
  "lily-design-system-angular-examples/src/app/component-demos.ts",
]) {
  write(p, demosSource);
}

// ---------- blazor ComponentData.cs ----------

write(
  "lily-design-system-blazor-web-examples/src/LilyBlazorWebExamples/Data/ComponentData.cs",
  `namespace LilyBlazorWebExamples.Data;

public record ComponentInfo(string Slug, string Name, string Description, string Tag, string Category, string DemoHtml);
public static class ComponentData
{
    // Category id → display label (plan P6-T5's category filter).
    public static readonly Dictionary<string, string> CategoryLabel = new()
    {
${Object.entries(CATEGORY_LABEL)
  .map(([id, label]) => `        { ${csStr(id)}, ${csStr(label)} },`)
  .join("\n")}
    };

    public static readonly List<ComponentInfo> Components = new()
    {
${components
  .map(
    (c) =>
      `        new(${csStr(c.slug)}, ${csStr(c.name)}, ${csStr(c.description)}, ${csStr(c.tag)}, ${csStr(c.category)}, ${csStr(unescapeJs(demos[c.slug]))}),`
  )
  .join("\n")}
    };
}
`
);

// ---------- embedded HTML arrays (region replace) ----------

function replaceRegion(text, startMarker, endMarker, body, label) {
  const start = text.indexOf(startMarker);
  if (start < 0) throw new Error(`start marker not found in ${label}`);
  const from = start + startMarker.length;
  const end = text.indexOf(endMarker, from);
  if (end < 0) throw new Error(`end marker not found in ${label}`);
  return text.slice(0, from) + "\n" + body + "\n" + text.slice(end);
}

const htmlEntry = (c, indent) => {
  const i = " ".repeat(indent);
  const f = " ".repeat(indent + 4);
  return [
    `${i}{`,
    `${f}slug: ${jsStr(c.slug)},`,
    `${f}name: ${jsStr(c.name)},`,
    `${f}description: ${jsStr(c.description)},`,
    `${f}tag: ${jsStr(c.tag)},`,
    `${f}category: ${jsStr(c.category)},`,
    `${i}},`,
  ].join("\n");
};

{
  const p = "lily-design-system-html-css-js-examples/pages/components/index.html";
  let t = read(p);
  t = replaceRegion(
    t,
    "var components = [",
    "                ];",
    components.map((c) => htmlEntry(c, 20)).join("\n"),
    p
  );
  write(p, t);
}

{
  const p = "lily-design-system-html-css-js-examples/pages/components/component.html";
  let t = read(p);
  t = replaceRegion(
    t,
    "var components = [",
    "                ];",
    components.map((c) => htmlEntry(c, 20)).join("\n"),
    p
  );
  t = replaceRegion(
    t,
    "var componentDemos = {",
    "            };",
    components.map((c) => `                '${c.slug}': '${demos[c.slug]}',`).join("\n"),
    p
  );
  write(p, t);
}

// ---------- root index.md listing ----------
//
// Special-purpose identifier components (category "national" — national
// personal identifiers such as government health-insurance or national-ID
// numbers) are listed in their own "## Special-Purpose Identifiers"
// section, immediately after "## Components", rather than interleaved
// alphabetically among general-purpose components. Both blocks stay
// sorted by slug within themselves.

{
  const p = "index.md";
  const lines = read(p).split("\n");
  const first = lines.findIndex((l) => /^- \[.*\]\(components\//.test(l));
  if (first < 0) throw new Error("index.md listing not found");
  // Walk to the end of the WHOLE listing region, not just the first
  // contiguous run of bullets: a prior run already wrote a "##
  // Special-Purpose Identifiers" heading, its intro prose, and its own
  // bullet list right after the general list, all of which must be
  // replaced too on a second run -- stopping at the first contiguous
  // bullet run (the original logic) left that second heading/list in
  // place and prepended a fresh copy in front of it, duplicating the
  // section every time this script ran. Only a heading OTHER than that
  // one (e.g. "## Design Principles") ends the region.
  let last = first;
  for (let i = first; i < lines.length; i++) {
    if (/^## /.test(lines[i]) && lines[i].trim() !== "## Special-Purpose Identifiers") break;
    last = i;
  }

  const generalComponents = components.filter((c) => c.category !== "national");
  const specialPurposeComponents = components
    .filter((c) => c.category === "national")
    .sort((a, b) => a.slug.localeCompare(b.slug));

  const listingFor = (list) =>
    list.map((c) => `- [${c.slug}](components/${c.slug}): ${c.description}`);

  const block = [
    ...listingFor(generalComponents),
    "",
    "## Special-Purpose Identifiers",
    "",
    "National personal identifier components — government health-insurance,",
    "national-ID, tax, and passport identifiers — kept separate from the",
    "general-purpose catalog above. See",
    "[spec/national-identifiers](spec/national-identifiers/index.md) for the",
    "full contract.",
    "",
    ...listingFor(specialPurposeComponents),
    ""
  ];

  write(p, [...lines.slice(0, first), ...block, ...lines.slice(last + 1)].join("\n"));
}

// ---------- shadcn registry for React headless (P16-T5) ----------
//
// lilydesignsystem.github.io/static/r/react/registry.json and
// /r/react/{slug}.json in shadcn's own registry schema
// (https://ui.shadcn.com/schema/registry.json, registry-item.json), so
// `npx shadcn add @lily/<slug>` copies a component into a project. These
// sit beside, and never replace, Lily's own metadata manifests
// /r/{slug}.json (bin/generate-api-docs).
//
// Each item inlines its file content, as `shadcn build` would emit. Every
// file targets @components/lily/, one flat directory, so the components'
// relative imports (./ScrollerBase, ./form-reset) keep working unchanged.
// A sibling import becomes a registryDependency on @lily/<item>; a shared
// helper module (*.ts) is its own registry:lib item, "<module>-utils",
// since two helpers share a name with a component. A bare npm import other
// than react becomes an npm dependency. Files that call a React hook get a
// leading "use client" directive, the shadcn convention, so they work in a
// Next.js App Router project; a hook-free component stays a server
// component. The only other change to a file is where its header comment
// sits (preserveHeader below).
//
// Skipped when the React headless library is absent (the golden fixture).

{
  const srcDir = "lily-design-system-react-headless/components";
  const outDir = "lilydesignsystem.github.io/static/r/react";
  if (fs.existsSync(path.join(top, srcDir))) {
    const SITE = "https://lilydesignsystem.com";
    const NS = "@lily";
    const SCHEMA_ITEM = "https://ui.shadcn.com/schema/registry-item.json";
    const helperName = (mod) => `${mod}-utils`;
    const slugOfName = Object.fromEntries(components.map((c) => [c.name, c.slug]));
    const imports = (src) =>
      [...src.matchAll(/^\s*(?:import|export)\b[^'"]*?\bfrom\s+["']([^"']+)["']/gm)].map((m) => m[1]);
    const usesHook = (src) => /\buse[A-Z]\w*\s*\(/.test(src);
    // shadcn add (CLI 4.x) drops the comments that lead a file, which is
    // where each Lily component documents its props, keyboard and ARIA. A
    // comment that follows a statement survives, so the header goes after
    // the "use client" directive, or else after the import block. A file
    // with neither (an interface first) loses its header in the copy; its
    // docs URL is in the item.
    const preserveHeader = (src, client) => {
      const header = (src.match(/^(?:[ \t]*\/\/[^\n]*\n|[ \t]*\n)+/) || [""])[0];
      if (client) return `"use client";\n\n${src}`;
      if (!header.trim()) return src;
      const rest = src.slice(header.length);
      const block = (rest.match(/^(?:import\b[^;]*?["'][^"']+["'];?[ \t]*\n|[ \t]*\n)+/) || [""])[0];
      if (!block.trim()) return src;
      return `${block.trimEnd()}\n\n${header.trimEnd()}\n\n${rest.slice(block.length).trimStart()}`;
    };

    const items = {}; // item name → registry item
    const helpers = new Set();
    const build = (name, title, description, file, type, categories) => {
      const raw = read(`${srcDir}/${file}`);
      const registryDependencies = [];
      const dependencies = [];
      for (const spec of imports(raw)) {
        if (spec.startsWith("./")) {
          const base = spec.slice(2).replace(/\.(tsx?|jsx?)$/, "");
          if (base in slugOfName) registryDependencies.push(`${NS}/${slugOfName[base]}`);
          else if (fs.existsSync(path.join(top, srcDir, `${base}.ts`))) {
            helpers.add(base);
            registryDependencies.push(`${NS}/${helperName(base)}`);
          } else throw new Error(`${srcDir}/${file}: unresolved import ${spec}`);
        } else if (spec.startsWith(".")) {
          throw new Error(`${srcDir}/${file}: import ${spec} leaves the components directory`);
        } else {
          const pkg = spec.startsWith("@") ? spec.split("/").slice(0, 2).join("/") : spec.split("/")[0];
          if (pkg !== "react" && pkg !== "react-dom" && !dependencies.includes(pkg)) dependencies.push(pkg);
        }
      }
      const content = preserveHeader(raw, file.endsWith(".tsx") && usesHook(raw));
      const item = {
        $schema: SCHEMA_ITEM,
        name,
        type,
        title,
        description,
        author: "Lily Design System <https://lilydesignsystem.com>",
        ...(dependencies.length ? { dependencies: [...new Set(dependencies)].sort() } : {}),
        ...(registryDependencies.length ? { registryDependencies: [...new Set(registryDependencies)].sort() } : {}),
        files: [{ path: `${srcDir}/${file}`, content, type, target: `@components/lily/${file}` }],
        ...(categories ? { categories } : {}),
        docs: categories ? `Docs: ${SITE}/components/${name}/` : undefined,
      };
      items[name] = item;
    };

    for (const c of components) {
      const file = `${c.name}.tsx`;
      if (!fs.existsSync(path.join(top, srcDir, file))) throw new Error(`${srcDir}/${file} missing for ${c.slug}`);
      const desc = c.description ? c.description[0].toUpperCase() + c.description.slice(1) + "." : c.name;
      build(c.slug, c.name, desc, file, "registry:component", [c.category]);
    }
    for (const mod of [...helpers].sort()) {
      if (helperName(mod) in items) throw new Error(`registry item name clash: ${helperName(mod)}`);
      build(helperName(mod), `${mod}.ts`, `Shared helper module ${mod}.ts, used by Lily React headless components.`, `${mod}.ts`, "registry:lib", null);
    }

    const names = Object.keys(items).sort();
    const wanted = {};
    for (const n of names) wanted[`${n}.json`] = JSON.stringify(items[n], null, 2) + "\n";
    wanted["registry.json"] =
      JSON.stringify(
        {
          $schema: "https://ui.shadcn.com/schema/registry.json",
          name: "lily",
          homepage: `${SITE}/tutorials/shadcn/`,
          items: names.map((n) => {
            const { $schema, files, docs, ...rest } = items[n];
            return { ...rest, files: files.map(({ content, ...f }) => f) };
          }),
        },
        null,
        2
      ) + "\n";

    const absOut = path.join(top, outDir);
    if (!check) fs.mkdirSync(absOut, { recursive: true });
    let changed = 0;
    for (const [f, body] of Object.entries(wanted)) {
      const p = path.join(absOut, f);
      if (fs.existsSync(p) && fs.readFileSync(p, "utf-8") === body) continue;
      changed++;
      if (check) stale.push(`${outDir}/${f}`);
      else fs.writeFileSync(p, body);
    }
    if (fs.existsSync(absOut)) {
      for (const f of fs.readdirSync(absOut)) {
        if (f in wanted) continue;
        changed++;
        if (check) stale.push(`${outDir}/${f} (no source; remove it)`);
        else fs.rmSync(path.join(absOut, f));
      }
    }
    if (!check) console.log(`wrote ${outDir}/ (${names.length} shadcn items, ${changed} changed)`);
  }
}

if (check) {
  if (stale.length) {
    console.error(`generate-registries: ${stale.length} stale registr${stale.length === 1 ? "y" : "ies"}; run bin/generate-registries:`);
    for (const p of stale) console.error("  " + p);
    process.exit(1);
  }
  console.log(`generate-registries: up to date (${components.length} components)`);
} else {
  console.log(`done: ${components.length} components across all registries`);
}

#!/bin/sh
set -euf

## https://github.com/sixarm/unix-shell-script-kit

# Errors are collected via a flag file (functions below run in
# subshells, so a plain variable would not survive); the script
# exits non-zero if any check failed.
ERRFLAG="$(mktemp)"
trap 'rm -f "$ERRFLAG"' EXIT

err() { >&2 printf %s\\n "Error: ${*}"; printf 1 >> "$ERRFLAG"; }

# Written as `if cmd; then :; else err ...; fi` rather than `cmd || err
# ...`: under `set -e`, bash 3.2 (Apple's frozen last-GPLv2 build, the
# `/bin/sh` this script actually runs under on macOS) pays a severe
# per-call penalty for a function whose body chains `&&`/`||` — not a
# POSIX requirement, just that build's own quirk — and with ~491
# components x several implementations x several checks each, that
# penalty is most of bin/test's wall-clock (see plan P7-T2: measured
# a single 491-component loop drop from ~13s to ~0.05s from this
# rewrite alone, same pass/fail results). `if`/`else` is exempt.
directory_exists_or_err() { if test -d "$1"; then :; else err "Directory should exist: $1"; fi; }
file_exists_or_err() { if test -f "$1"; then :; else err "File should exist: $1"; fi; }
file_size_or_err() { if file_exists_or_err "$1" && test -s "$1"; then :; else err "File should have size: $1"; fi; }
symlink_exists_or_err() { if test -h "$1"; then :; else err "Symlink should exist: $1"; fi; }
grep_exists_or_err() { if grep -q -m 1 "$@"; then :; else err "grep should exist: " "$@"; fi; }
task_exists_or_err() { if grep -q -m 1 "^- \[" "$1"; then :; else err "task should exist: " "$1"; fi; }
# No AGENTS.md or spec/index.md, tracked or new, still says "Not yet implemented." One git grep over the repo
# (ignored files excluded) instead of two greps per directory, which cost ~6 s (tasks.md P12-T7).
implemented_everywhere_or_err() {
    if stubs="$(git -C "$top" grep -l --untracked -F "Not yet implemented." -- '*AGENTS.md' '*spec/index.md')"; then
        err "not yet implemented: $stubs"
    fi
}

## Utilities

repo_setup_exists_or_err() (
    # dir="$1"
    file_size_or_err "$1/CITATION.cff"
    file_size_or_err "$1/CODE_OF_CONDUCT.md"
    file_size_or_err "$1/LICENSE.md"
)

# Every subproject carries the top-level special files -- above all
# LICENSE.md, because a published package (npm tarballs include LICENSE*)
# or a copied-out directory without one is "all rights reserved" by
# default whatever the monorepo says. (Until 2026-10-10 each subproject
# was also its own public subtree repository; those mirrors are gone.)
# The root is canonical and bin/sync-special-files propagates the set.
# Spec: spec/special-files-for-public-repos/index.md
special_files_exist_or_err() (
    # dir="$1"
    for f in \
        LICENSE.md CITATION.cff NEWS.md COMPARE.md BENCHMARKS.md \
        INSTALL.md CONTRIBUTING.md CODEOWNERS MAINTAINERS.md CHANGELOG.md \
        AI_STATEMENT.md GOVERNANCE.md SECURITY.md CODE_OF_CONDUCT.md RFC.md
    do
        file_size_or_err "$1/$f"
    done
)

ai_exists_or_err() (
    # dir="$1" — the spec-driven-development convention is a spec/
    # directory of specification files per directory, entered via
    # spec/index.md; older single-file spec.md (and the still-older
    # plan.md / tasks.md split) have been merged into it.
    directory_exists_or_err "$1"
    file_size_or_err "$1/index.md"
    symlink_exists_or_err "$1/README.md"
    file_size_or_err "$1/AGENTS.md"
    directory_exists_or_err "$1/spec"
    file_size_or_err "$1/spec/index.md"
)

## Main

top="$(git rev-parse --show-toplevel)"

# repo_root_ai_exists_or_err is identical to ai_exists_or_err now that
# every dir uses spec/index.md; kept as an alias for callers that read
# more naturally with the repo-root phrasing.
repo_root_ai_exists_or_err() (
    ai_exists_or_err "$1"
)

test_repository() {
    repo_setup_exists_or_err "$top"
    repo_root_ai_exists_or_err "$top"
    special_files_exist_or_err "$top"
}

# The canonical catalog must be internally consistent, and every
# hand-off copy of it (component dirs, CSS hooks, example-app
# registries) must carry exactly one entry per catalog row. Every
# defect class here has occurred in practice.
test_catalog_consistency() {
    tsv="$top/components.tsv"
    count="$(wc -l < "$tsv" | tr -d ' ')"

    dups="$(cut -f1 "$tsv" | sort | uniq -d)"
    test -z "$dups" || err "duplicate slugs in components.tsv: $dups"
    dup_names="$(cut -f2 "$tsv" | sort | uniq -d)"
    test -z "$dup_names" || err "duplicate PascalCase names in components.tsv: $dup_names"

    # components/ directories <-> catalog rows, both directions.
    cut -f1 "$tsv" | sort > "${ERRFLAG}.slugs"
    find "$top/components" -mindepth 1 -maxdepth 1 -type d -not -name '.*' | sed 's|.*/||' | sort > "${ERRFLAG}.dirs"
    missing_dirs="$(comm -23 "${ERRFLAG}.slugs" "${ERRFLAG}.dirs")"
    test -z "$missing_dirs" || err "catalog slugs without components/ dir: $missing_dirs"
    orphan_dirs="$(comm -13 "${ERRFLAG}.slugs" "${ERRFLAG}.dirs")"
    test -z "$orphan_dirs" || err "components/ dirs not in catalog: $orphan_dirs"

    # css-style-sheet-template.css: exactly one hook per slug. One pass counts every `.slug {` line (a grep per slug
    # cost ~1.6 s; tasks.md P12-T7).
    awk 'NR == FNR { if (match($0, /^\.[a-z0-9-]+ \{/)) n[substr($0, 2, RLENGTH - 3)]++; next }
         (n[$0] + 0) != 1 { printf "%d %s\n", n[$0], $0 }' \
        "$top/css-style-sheet-template.css" "${ERRFLAG}.slugs" |
    while read -r hooks slug; do
        err "css-style-sheet-template.css has $hooks hooks for: $slug"
    done

    rm -f "${ERRFLAG}.slugs" "${ERRFLAG}.dirs"

    # Example-app registries carry one entry per catalog row.
    registry_count_or_err() {
        # file="$1" pattern="$2"
        n="$(grep -c "$2" "$1" || true)"
        test "$n" = "$count" || err "registry $1 has $n entries; catalog has $count"
    }
    registry_count_or_err "$top/lily-design-system-svelte-sveltekit-examples/src/lib/data/components.ts" 'slug: "'
    registry_count_or_err "$top/lily-design-system-react-next-examples/app/data/components.ts" 'slug: "'
    registry_count_or_err "$top/lily-design-system-vue-nuxt-examples/data/components.ts" 'slug: "'
    registry_count_or_err "$top/lily-design-system-angular-examples/src/app/components-data.ts" 'slug: "'
    registry_count_or_err "$top/lily-design-system-blazor-web-examples/src/LilyBlazorWebExamples/Data/ComponentData.cs" '^        new("'
    registry_count_or_err "$top/lily-design-system-html-css-js-examples/assets/js/pages/components-index.js" 'slug: "'
    registry_count_or_err "$top/lily-design-system-html-css-js-examples/assets/js/pages/component.js" 'slug: "'
    registry_count_or_err "$top/lilydesignsystem.github.io/src/lib/components.ts" 'name: "'
    registry_count_or_err "$top/lily-design-system-svelte-sveltekit-examples/src/lib/data/component-demos.ts" "^  '"
    registry_count_or_err "$top/lily-design-system-react-next-examples/app/data/component-demos.ts" "^  '"
    registry_count_or_err "$top/lily-design-system-vue-nuxt-examples/data/component-demos.ts" "^  '"
    registry_count_or_err "$top/lily-design-system-angular-examples/src/app/component-demos.ts" "^  '"
    registry_count_or_err "$top/index.md" '^- \[.*\](components/'
}

test_components() {
    "$top/bin/list-components-as-kebab-case" |
    while read -r component; do
        ai_exists_or_err "$top/components/$component"
        # Maturity: exactly one valid Status bullet per component
        # (spec/components § Maturity). The site registry is generated
        # from it, so a missing or misspelled one breaks the build there
        # too — this catches it at the source with a better message.
        n="$(grep -cE '^- Status: (stable|beta|experimental|deprecated|discouraged)( |$)' "$top/components/$component/AGENTS.md" || true)"
        test "$n" = "1" || err "components/$component/AGENTS.md needs exactly one valid '- Status:' bullet (has $n)"
    done
}

test_lilydesignsystem_github_io() {
    special_files_exist_or_err "$top/lilydesignsystem.github.io"
    "$top/bin/list-components-as-kebab-case" |
    while read -r component; do
        dir="$top/lilydesignsystem.github.io/src/routes/components/$component"
        ai_exists_or_err "$dir"
        file_size_or_err "$dir/+page.svelte"
    done
}

test_implementations() {
    "$top/bin/list-implementations" |
    while read -r implementation; do
        dir="$top/$implementation"
        ai_exists_or_err "$dir"
        special_files_exist_or_err "$dir"
    done
}

test_implementations_with_vite() {
    "$top/bin/list-implementations" | grep \(react-next-examples\|svelte-sveltekit-examples\|vue-nuxt-examples\) |
    while read -r implementation; do
        dir="$top/$implementation"
        file_size_or_err "$dir/package.json"
        file_size_or_err "$dir/pnpm-lock.yaml"
        file_size_or_err "$dir/tsconfig.json"
        file_size_or_err "$dir/vite.config.ts"
        file_size_or_err "$dir/vitest-setup.js"
    done
}

test_implementations_with_svelte() {
    # The two full-catalog svelte subprojects: the headless library keeps
    # its components in components/ (what build.mjs publishes; its old
    # src/lib/components/ mirror was removed 2026-10-11), the SvelteKit
    # example app in src/lib/components/. Named outright rather than
    # excluded piecemeal, because every other lily-design-system-svelte-*
    # subproject (each helper package, each *-skill) is something else.
    "$top/bin/list-implementations" | grep -E -- '^lily-design-system-svelte-(headless|sveltekit-examples)$' |
    while read -r implementation; do
        case "$implementation" in
            *-headless) root="$top/$implementation/components" ;;
            *) root="$top/$implementation/src/lib/components" ;;
        esac
        "$top/bin/list-components-as-pascal-case" |
        while read -r component; do
            dir="$root/$component"
            file_size_or_err "$dir/index.md"
            file_size_or_err "$dir/$component.svelte"
            file_size_or_err "$dir/$component.stories.svelte"
            file_size_or_err "$dir/$component.test.ts"
            if test -e "$dir/$component.md"; then rm -f "$dir/$component.md"; fi
        done
    done
}

test_implementation_nunjucks_headless() {
    # Exclude lily-design-system-nunjucks-headless-skill: it matches the
    # "nunjucks-headless" substring but is documentation for an AI agent,
    # not the macro catalog itself.
    "$top/bin/list-implementations" | grep nunjucks-headless | grep -v -- '-skill' |
    while read -r implementation; do
        "$top/bin/list-components-as-kebab-case" |
        while read -r component; do
            dir="$top/$implementation/components/$component"
            file_size_or_err "$dir/macro.njk"
            file_size_or_err "$dir/macro.test.js"
            file_size_or_err "$dir/index.md"
        done
    done
}

test_implementation_nunjucks_example() {
    "$top/bin/list-implementations" | grep nunjucks-example |
    while read -r implementation; do
        "$top/bin/list-components-as-kebab-case" |
        while read -r component; do
            dir="$top/$implementation/components"
            file_size_or_err "$dir/$component.njk"
        done
    done
}

##
# Helper picker glyphs must appear as bare literal characters in the places
# that RENDER them: the exported constant, and the icon markup. Reversed
# 2026-09-03 (was: glyphs must be escaped) — the glyph is visual, so a bare
# character is easy to type and easy to proofread by eye, where an escape
# has to be mentally decoded to confirm which character it even is.
#
# Code contexts must hold the glyph directly, not an escape ("\u27A4");
# markup contexts must hold it directly too, not an HTML entity (&#10148;).
# Prose is not checked: a changelog explaining that the glyph moved from
# one character to another has to show both.
#
# ASCII "A" (U+0041) is exempt either way — it cannot be mangled, so
# nothing here checks it.
#
# 2026-09-16: five of the six picker glyphs (theme, locale, text-size,
# motion, share) were reversed again — from Unicode characters to bundled
# SVG icons — so CIRCLE_WITH_RIGHT_HALF_BLACK, GLOBE_WITH_MERIDIANS,
# BLACK_RIGHTWARDS_ARROWHEAD, and PAUSE_SIGN no longer exist as exported
# constants; the patterns below simply find nothing for them now, which is
# correct (not a bug in this check). Only date-time-picker's CALENDAR
# constant is still a Unicode glyph and still covered — joined 2026-10-02
# by search-picker's RETURN_SYMBOL (⏎, U+23CE), the submit button's
# visible label.
##
test_helper_glyphs_are_bare() (
    # NOTE: this script runs under `set -euf`; -f disables globbing, so
    # file lists come from find, as everywhere else here.
    #
    # `-prune` on node_modules/.git (rather than filtering them out
    # with `-not -path` after the fact) matters here: `-not -path`
    # only hides matched results, it doesn't stop find from descending
    # into every node_modules tree first — across this monorepo's ~20
    # of them that's several GB of files walked for nothing. Pruning
    # cut this one find from ~2.5s to ~0.2s (plan P7-T2).
    find "$top" \( -name node_modules -o -name .git \) -prune -o \
        -type d -name 'lily-design-system-*-picker' -print \
    | while IFS= read -r pkg; do
        find "$pkg" -maxdepth 1 -type f \
            \( -name '*.ts' -o -name '*.tsx' -o -name '*.vue' -o -name '*.svelte' \
               -o -name '*.cs' -o -name '*.js' -o -name '*.njk' -o -name '*.razor' \) \
        | while IFS= read -r file; do
            case "$file" in *.test.*|*.spec.*|*Tests.cs) continue ;; esac

            # The exported glyph constant, in any framework's spelling.
            if grep -e 'CIRCLE_WITH_RIGHT_HALF_BLACK *=' -e 'GLOBE_WITH_MERIDIANS *=' \
                    -e 'BLACK_RIGHTWARDS_ARROWHEAD *=' -e 'CALENDAR *=' -e 'PAUSE_SIGN *=' \
                    -e 'CircleWithRightHalfBlack *=' -e 'GlobeWithMeridians *=' \
                    -e 'BlackRightwardsArrowhead *=' -e 'Calendar *=' -e 'PauseSign *=' \
                    -e 'RETURN_SYMBOL *=' -e 'ReturnSymbol *=' "$file" \
               | grep -q -e '\\u'; then
                err "glyph constant holds an escape; use the bare glyph character directly: $file"
            fi

            # The icon markup that emits the glyph.
            if grep -e '-picker-icon' -e '-picker-submit-symbol' "$file" | grep -q -e '&#'; then
                err "icon markup holds an HTML entity; use the bare glyph character directly: $file"
            fi
        done
    done
)

test_repository
test_catalog_consistency
test_components
test_lilydesignsystem_github_io
test_implementations
test_implementations_with_vite
test_implementations_with_svelte
test_implementation_nunjucks_headless
test_implementation_nunjucks_example
# Lockfiles are always committed (spec/tooling): an untracked or
# gitignored pnpm-lock.yaml means CI, fresh clones, and published
# packages resolve a different dependency graph than was tested.
##
# pnpm 10+ reads `overrides` from pnpm-workspace.yaml, NOT from
# package.json's "pnpm" key. The 2026-09-03 Dependabot pass (P8-T4)
# found five subprojects carrying `"pnpm": { "overrides": {...} }`
# blocks that had been silent no-ops since the pnpm 10 upgrade -- one
# held 13 accumulated CVE-fix entries that never applied. A block like
# that reads as a fixed vulnerability while fixing nothing, so fail
# loudly and point at the file that actually works.
##
test_no_package_json_pnpm_overrides() (
    find "$top" \( -name node_modules -o -name .git \) -prune -o \
        -type f -name package.json -print \
    | while IFS= read -r file; do
        if grep -q '"pnpm"' "$file" && grep -q '"overrides"' "$file"; then
            err "package.json pnpm.overrides is ignored by pnpm 10+; move it to pnpm-workspace.yaml \`overrides:\`: $file"
        fi
    done
)

test_lockfiles_are_tracked() (
    # Every pnpm-lock.yaml outside node_modules must be tracked, whether untracked or git-ignored. Found with find and
    # compared with git ls-files: `git ls-files --others -i` (ignored files) listed every ignored file, node_modules
    # included, and cost ~10 s of bin/test (tasks.md P12-T7).
    found="$(cd "$top" && find . \( -name node_modules -o -name .git \) -prune -o -type f -name pnpm-lock.yaml -print \
        | sed 's|^\./||' | sort)"
    (cd "$top" && git ls-files '*pnpm-lock.yaml' | sort) > "${ERRFLAG}.locks"
    untracked="$(printf %s\\n "$found" | comm -23 - "${ERRFLAG}.locks")"
    rm -f "${ERRFLAG}.locks"
    test -z "$untracked" || err "lockfiles must be committed (spec/tooling): $untracked"
)

# Every locale directory is <language>-<region> (e.g. cy-gb, en-001), never a bare language like
# "en" (lilydesignsystem.github.io/spec/locales-for-global-sharing-with-svelte, "Locale directory names").
test_locale_directories_have_a_region() (
    dir="$top/lilydesignsystem.github.io/src/routes"
    [ -d "$dir" ] || return 0
    # Locale routes live at /<code>/ (no /locales/ prefix since 2026-10-07). A bare language
    # directory (two or three letters, no region) is the forbidden shape; find, not a glob: this
    # script runs with globbing off (set -f).
    names="$(find "$dir" -mindepth 1 -maxdepth 1 -type d -exec basename {} \;)"
    langs="$(printf %s\\n "$names" | grep -Ex '[a-z]{2,3}-([a-z]{2}|[0-9]{3})(-[a-z0-9]+)?' | cut -d- -f1 | sort -u || true)"
    bad=""
    for l in $langs; do
        if printf %s\\n "$names" | grep -qx "$l"; then bad="$bad$l "; fi
    done
    test -z "$bad" || err "locale directories must be <language>-<region>, found: $bad"
    sub="$(find "$dir/locales" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | tr '\n' ' ' || true)"
    test -z "$sub" || err "locale routes live at /<code>/, not under /locales/: $sub"
)

# The per-subproject subtree mirrors were deleted 2026-10-10: every
# subproject lives only in this monorepo. A link to a mirror is a 404 (the
# docs site carried dozens), and a .git-subtree-push file or the old push
# script would bring the mirror workflow back. Link to the subproject's
# directory instead: https://github.com/LilyDesignSystem/lily-design-system/tree/main/<name>
# (docs/superpowers holds dated plans, kept as written).
test_no_subtree_mirrors() (
    cd "$top" || return
    links="$(git grep -nIiE '(github\.com|codeberg\.org|gitlab\.com)[/:]lilydesignsystem/lily-design-system-[a-z]' \
        -- . ':!docs/superpowers' ':!bin/test' || true)"
    test -z "$links" || err "links to a deleted subtree mirror (link the monorepo directory instead):
$links"
    files="$(git ls-files '*.git-subtree-push' 'bin/git-subtree-push')"
    test -z "$files" || err "subtree push files are retired (packages publish from the monorepo): $files"
)


    || err "a native-platform decision is missing or out of step with spec/competitive-position/native-primitives.tsv; run bin/check-native-primitives"
"$top/bin/generate-page-markdown" --check >/dev/null 2>&1 \
    || err "a site page's .md twin is missing or stale; run bin/generate-page-markdown"
"$top/bin/extract-site-pages" --check >/dev/null 2>&1 \
    || err "site pages' English sources drift from their routes; run bin/extract-site-pages"
"$top/bin/check-site-page-translations" >/dev/null 2>&1 \
    || err "a translated site page differs in structure or is missing; run bin/check-site-page-translations"
"$top/bin/generate-locale-pages" --check >/dev/null 2>&1 \
    || err "locale page routes are out of date; run bin/generate-locale-pages"
"$top/bin/sync-special-files" --check >/dev/null 2>&1 \
    || err "special files are out of sync; run bin/sync-special-files"
"$top/bin/generate-registries" --check >/dev/null 2>&1 \
    || err "example-app registries or the shadcn registry (static/r/react/) are stale; run bin/generate-registries"
# --dry-run must write nothing: the working tree is identical before and after.
dry_before="$(git -C "$top" status --porcelain | cksum)"
"$top/bin/new-component" --dry-run bin-test-dry-run-probe >/dev/null 2>&1 \
    || err "bin/new-component --dry-run failed"
"$top/bin/create-component-directory" --dry-run bin-test-dry-run-probe >/dev/null 2>&1 \
    || err "bin/create-component-directory --dry-run failed"
"$top/bin/create-implementation-directory" --dry-run lily-design-system-bin-test-dry-run-probe >/dev/null 2>&1 \
    || err "bin/create-implementation-directory --dry-run failed"
test "$dry_before" = "$(git -C "$top" status --porcelain | cksum)" \
    || err "a scaffolder --dry-run changed the working tree"
"$top/bin/check-generated-files" >/dev/null 2>&1 \
    || err "the Generated files table in AGENTS/lily.md disagrees with bin/; run bin/check-generated-files"
"$top/bin/check-port-parity" --quiet >/dev/null 2>&1 \
    || err "a port (Web Components, Alpine) drifted from its reference; run bin/check-port-parity"
"$top/bin/check-port-logic" --quiet >/dev/null 2>&1 \
    || err "an Angular or Blazor port has no logic where Svelte has behaviour; run bin/check-port-logic"

# Coverage drift across the 7 headless catalogs, including components with a keyboard contract whose test sends no
# key (tasks.md P12-T5; today's gaps are listed in bin/check-coverage.keys-allow.json and may only shrink).
"$top/bin/check-worldwide" --quiet >/dev/null 2>&1 \
    || err "a single-region default (currency, weekend or English locale) is back in shipped code; run bin/check-worldwide"
"$top/bin/check-coverage" --quiet >/dev/null 2>&1 \
    || err "headless coverage drifted (a missing file, or a keyboard contract without a key test); run bin/check-coverage"
"$top/bin/check-links" >/dev/null 2>&1 \
    || err "a relative markdown link does not resolve; run bin/check-links"
"$top/bin/test-generators" >/dev/null 2>&1 \
    || err "a generator's output differs from its golden; run bin/test-generators (then --update-goldens if intended)"
# The Alpine snippets are generated (tasks.md P12-T5b). The generator formats with the root Prettier, so it needs the
# root install; where that is missing (CI's verify job) the lint job runs the same check.
if test -e "$top/node_modules/prettier/package.json"; then
    node "$top/lily-design-system-alpine-headless/generate-components.mjs" --check >/dev/null 2>&1 \
        || err "the Alpine snippets differ from their generator; run node lily-design-system-alpine-headless/generate-components.mjs --check"
else
    printf %s\\n "bin/test: skipped the Alpine generator check (no root node_modules; run pnpm install)"
fi

if test -s "$ERRFLAG"; then
    >&2 printf %s\\n "bin/test: FAILED"
    exit 1
fi

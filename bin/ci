#!/usr/bin/env bash
# bin/ci — the CI gate, runnable on the maintainer's machine (tasks.md P24-T2, spec/local-ci).
#
#   bin/ci --list                 the jobs, in the order --full runs them
#   bin/ci --job <name> [arg...]  one job; a matrix job takes its matrix values (default: all of them)
#   bin/ci --fast                 seconds: the checks that need no per-package install (generated files, links,
#                                 coverage, class names); bin/test in it needs the root and docs-site installs
#   bin/ci --full [--serial] [--no-cache]
#                                 every job, side by side in lanes (LILY_CI_JOBS at a time, default 3, each tool limited to its share of the cores), a passed job not rerun
#                                 while what it reads is unchanged (.ci/cache/); --serial runs one job at a time, in order,
#                                 --no-cache runs everything. Ends with a table of step, result and seconds, and writes
#                                 .ci/receipt.json (git-ignored)
#   bin/ci --verify-receipt        is there a receipt for HEAD, from a clean tree, with every job passing, consumer-smoke included? (the publish gate)
#   bin/ci --clean [mode]         a clean-room mode: runs a mode (default --full) in a fresh git worktree of HEAD,
#                                 e.g. `bin/ci --clean --job verify` (tasks.md P24-T6)
#
# Each function below is one job in .github/workflows/ci.yml, and ci.yml calls `bin/ci --job <name>` for it, so the local and
# GitHub runs cannot drift: the YAML keeps only the setup (checkout, Node, pnpm, .NET, caches, Playwright browsers).
#
# Locally, `consumer-smoke` refuses to run unless CI is set or LILY_CI_ALLOW_CONSUMER_SMOKE=1: it runs `npm install` inside
# pnpm projects and then deletes their node_modules, which would wreck a working checkout. Run it in a fresh worktree.
# Playwright browsers are assumed installed (`pnpm exec playwright install chromium firefox webkit` in each app).

set -uo pipefail

top="$(cd "$(dirname "$0")/.." && pwd)"
cd "$top" || exit 1

JOBS=(verify lint helper-packages headless html-headless dotnet-tests dotnet-helper-packages example-smoke accessibility-examples
    eleventy-example alpine-examples consumer-smoke shadcn-registry spell-check shared-tests coverage-floor security-audit)
HELPER_FRAMEWORKS=(svelte react vue angular html web-components nunjucks alpine solid)
HEADLESS_CATALOGS=(lily-design-system-svelte-headless lily-design-system-svelte-headless-identifiers lily-design-system-react-headless lily-design-system-react-headless-identifiers lily-design-system-vue-headless lily-design-system-vue-headless-identifiers
    lily-design-system-angular-headless lily-design-system-angular-headless-identifiers lily-design-system-nunjucks-headless lily-design-system-nunjucks-headless-identifiers lily-design-system-web-components-headless lily-design-system-web-components-headless-identifiers
    lily-design-system-alpine-headless lily-design-system-alpine-headless-identifiers lily-design-system-solid-headless lily-design-system-solid-headless-identifiers)
export SCRATCH="${RUNNER_TEMP:-${TMPDIR:-/tmp}}"

# Results, for the closing table.
STEPS=()
RESULTS=()
SECONDS_TAKEN=()

group() { if [ -n "${GITHUB_ACTIONS:-}" ]; then echo "::group::$*"; else echo "== $*"; fi; }
endgroup() { if [ -n "${GITHUB_ACTIONS:-}" ]; then echo "::endgroup::"; fi; }

# Record one step's outcome for the closing table, and (in a parallel run) in this unit's step log for the parent.
record() {
    STEPS+=("$1")
    RESULTS+=("$2")
    SECONDS_TAKEN+=("$3")
    if [ -n "${LILY_CI_STEP_LOG:-}" ]; then printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$LILY_CI_STEP_LOG"; fi
}

# Run one named step in a subshell that stops at its first failure, and record how it went.
step() {
    local name="$1"
    shift
    local start=$SECONDS status
    group "$name"
    # A fresh bash, not a subshell: the caller is `step ... || failed=1`, and bash ignores `set -e` for everything run in
    # such a context, subshells included, so a step would only fail on its last command. The functions travel along.
    bash -e -o pipefail -c "$(declare -f); $(printf '%q ' "$@")"
    status=$?
    endgroup
    if [ "$status" -eq 0 ]; then record "$name" "pass" $((SECONDS - start)); else record "$name" "FAIL ($status)" $((SECONDS - start)); fi
    return "$status"
}

in_dir() { (cd "$1" && shift && "$@"); }

# The root and docs-site installs. A parallel --full run does them once, up front (LILY_CI_PREINSTALLED), because two jobs
# running pnpm install in one directory at once would race.
root_install() { if [ -n "${LILY_CI_PREINSTALLED:-}" ]; then echo "root install: done up front"; else pnpm install --frozen-lockfile; fi; }
docs_install() { if [ -n "${LILY_CI_PREINSTALLED:-}" ]; then echo "docs install: done up front"; else (cd lilydesignsystem.github.io && pnpm install --frozen-lockfile); fi; }

# A hash of the working-tree contents of the tracked files under the given paths, plus the Node version: what a build or a
# cached result depends on. Uncommitted edits count, so a stale result is never reused.
paths_key() {
    { git ls-files -z -- "$@" | xargs -0 shasum -a 1 2>/dev/null; node --version; } | shasum -a 1 | cut -d' ' -f1
}

# `pnpm run build` unless this directory, and every directory built before it in this chain, is unchanged since its last
# build here. Only the build is skipped: the checks and tests that follow always run. Keyed on a chain, so a package built
# after another one is rebuilt when that one changes.
BUILD_CHAIN=""
cached_build() {
    local dir="$1" key stamp
    BUILD_CHAIN="$BUILD_CHAIN$(paths_key "$dir")"
    key="$(printf '%s' "$BUILD_CHAIN" | shasum -a 1 | cut -d' ' -f1)"
    stamp="$dir/node_modules/.cache/lily-build-key"
    if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$key" ] && [ -d "$dir/dist" ]; then
        echo "build skipped: $dir is unchanged since its last build"
        return 0
    fi
    (cd "$dir" && pnpm run --if-present build) || return 1
    mkdir -p "$dir/node_modules/.cache" && printf '%s' "$key" > "$stamp"
}

# --- the install-free checks (the fast tier, and most of verify) ---

no_junk() {
    local junk
    junk="$(git ls-files | grep -E '(^|/)(node_modules|dist)/|/(obj|bin)/(Debug|Release|.*\.nuget\.)' || true)"
    if [ -n "$junk" ]; then
        echo "Tracked build/dependency artifacts found:" >&2
        echo "$junk" | head -20 >&2
        return 1
    fi
}

fast_checks() {
    local failed=0
    step "no tracked node_modules or dist" no_junk || failed=1
    step "bin/test" bin/test || failed=1
    step "bin/check-links" bin/check-links || failed=1
    step "registries are freshly generated" bin/generate-registries --check || failed=1
    step "bin/check-coverage" bin/check-coverage --quiet || failed=1
    step "bin/check-class-names" bin/check-class-names || failed=1
    step "bin/check-package-metadata" bin/check-package-metadata || failed=1
    # The generator formats with the root Prettier; without the root install the lint job runs it, as in bin/test.
    if test -e node_modules/prettier/package.json; then
        step "Alpine snippets match their generator" node lily-design-system-alpine-headless/generate-components.mjs --check || failed=1
    else
        echo "bin/ci: skipped the Alpine generator check (no root node_modules; the lint job runs it)"
    fi
    return "$failed"
}

# --- the jobs, one per ci.yml job ---

job_verify() {
    local failed=0
    step "verify: no tracked node_modules or dist" no_junk || failed=1
    # The root install brings Prettier, which the generators' --check modes format through.
    step "verify: install the root" root_install || return 1
    step "verify: install the docs site" docs_install || return 1
    step "verify: bin/test" bin/test || failed=1
    step "verify: bin/check-links" bin/check-links || failed=1
    step "verify: registries are freshly generated" bin/generate-registries --check || failed=1
    step "verify: bin/check-coverage" bin/check-coverage --quiet || failed=1
    step "verify: bin/check-class-names" bin/check-class-names || failed=1
    step "verify: bin/check-package-metadata" bin/check-package-metadata || failed=1
    return "$failed"
}

job_lint() {
    local failed=0
    step "lint: install" root_install || return 1
    step "lint: eslint" pnpm lint || failed=1
    step "lint: prettier" pnpm format:check || failed=1
    step "lint: dotnet format" bin/dotnet-format --check || failed=1
    step "lint: Alpine snippets match their generator" node lily-design-system-alpine-headless/generate-components.mjs --check || failed=1
    return "$failed"
}

helper_packages_one() {
    local framework="$1" d
    root_install
    (cd "lily-design-system-$framework-headless" && pnpm install --frozen-lockfile --prefer-offline) &&
        cached_build "lily-design-system-$framework-headless" || return 1
    for d in $(bin/list-helper-packages "$framework"); do
        echo "-- $d"
        (cd "$d" && pnpm install --frozen-lockfile --prefer-offline) && cached_build "$d" &&
            (cd "$d" && pnpm run check && pnpm run test) || return 1
    done
}

job_helper_packages() {
    local failed=0 framework
    for framework in "${@:-${HELPER_FRAMEWORKS[@]}}"; do
        step "helper-packages: $framework" helper_packages_one "$framework" || failed=1
    done
    return "$failed"
}

headless_one() {
    local dir="$1"
    (cd "$dir" && pnpm install --frozen-lockfile --prefer-offline && pnpm run check) || return 1
    cached_build "$dir" || return 1
    cd "$dir" && pnpm exec vitest run
}

job_headless() {
    local failed=0 catalog
    for catalog in "${@:-${HEADLESS_CATALOGS[@]}}"; do
        step "headless: $catalog" headless_one "$catalog" || failed=1
    done
    return "$failed"
}

html_headless() {
    (
        cd lily-design-system-html-headless
        pnpm install --frozen-lockfile
        pnpm run check
        pnpm test
    ) || return 1
    # Its national identifiers add-on (spec/headless-identifiers) runs the same way.
    cd lily-design-system-html-headless-identifiers
    pnpm install --frozen-lockfile
    pnpm run check
    pnpm test
}

job_html_headless() { step "html-headless: WebDriverIO" html_headless; }

dotnet_one() {
    # Its national identifiers add-on first (spec/headless-identifiers): the same SDK, its own bUnit project.
    dotnet test lily-design-system-blazor-headless-identifiers/tests/LilyBlazorHeadless.Tests/LilyBlazorHeadless.Identifiers.Tests.csproj
    # The example app's page tests, which ran nowhere until 2026-11-25 and had six failures.
    dotnet test lily-design-system-blazor-web-examples/tests/LilyBlazorWebExamples.Tests/LilyBlazorWebExamples.Tests.csproj
    cd lily-design-system-blazor-headless
    dotnet test tests/LilyBlazorHeadless.Tests/LilyBlazorHeadless.Tests.csproj
    # The JavaScript modules behind the components whose keys bUnit cannot run: node:test + jsdom.
    npm install --prefix "$SCRATCH/jsdom" --no-save --no-audit --no-fund jsdom@30.1.3
    JSDOM_PATH="$SCRATCH/jsdom/node_modules/jsdom" node --test tests/js/
}

job_dotnet_tests() { step "dotnet-tests: lily-design-system-blazor-headless" dotnet_one; }

dotnet_helpers() {
    local d
    for d in $(bin/list-helper-packages blazor); do
        echo "-- $d"
        dotnet test "$d"/tests/*.csproj
    done
}

job_dotnet_helper_packages() { step "dotnet-helper-packages" dotnet_helpers; }

example_smoke() {
    cd lily-design-system-svelte-sveltekit-examples
    pnpm install --frozen-lockfile
    pnpm exec playwright test \
        e2e/accessibility.spec.ts \
        e2e/responsive.spec.ts \
        e2e/components-index.spec.ts \
        e2e/rtl-demo.spec.ts \
        e2e/book-an-appointment.spec.ts
    # Every component page through axe, a second framework beside Nunjucks and Alpine. Chromium only: axe reads the DOM,
    # and three browsers would triple the job for the same findings.
    pnpm exec playwright test e2e/axe-catalog.spec.ts --project chromium
}

job_example_smoke() { step "example-smoke: svelte-sveltekit-examples" example_smoke; }

ACCESSIBILITY_APPS=(
    lily-design-system-react-next-examples
    lily-design-system-vue-nuxt-examples
    lily-design-system-angular-examples
    lily-design-system-html-css-js-examples
    lily-design-system-blazor-web-examples
    lily-design-system-solid-examples
)

accessibility_examples() {
    local app="$1"
    cd "$app"
    pnpm install --frozen-lockfile
    pnpm exec playwright test e2e/accessibility.spec.ts
}

job_accessibility_examples() {
    local app
    if [ -n "${1:-}" ]; then
        step "accessibility-examples: $1" accessibility_examples "$1"
        return
    fi
    for app in "${ACCESSIBILITY_APPS[@]}"; do
        step "accessibility-examples: $app" accessibility_examples "$app"
    done
}

job_security_audit() { step "security-audit" bin/security-audit; }

eleventy_example() {
    # The site serves the locale picker's and the date-time picker's dist/index.js.
    (cd lily-design-system-nunjucks-locale-picker && pnpm install --frozen-lockfile --prefer-offline) && cached_build lily-design-system-nunjucks-locale-picker
    (cd lily-design-system-nunjucks-date-time-picker && pnpm install --frozen-lockfile --prefer-offline) && cached_build lily-design-system-nunjucks-date-time-picker
    cd lily-design-system-nunjucks-eleventy-examples
    pnpm install --frozen-lockfile
    pnpm run build
    pnpm exec playwright test
}

job_eleventy_example() { step "eleventy-example: nunjucks-eleventy-examples" eleventy_example; }

alpine_examples() {
    cd lily-design-system-alpine-examples
    pnpm install --frozen-lockfile
    pnpm run build
    pnpm run test
    pnpm exec playwright test
}

job_alpine_examples() { step "alpine-examples" alpine_examples; }

consumer_smoke() {
    local dir framework d
    # npm, not the projects' pnpm, to install as a real consumer would. --legacy-peer-deps sidesteps an npm Arborist crash
    # ("Cannot read properties of null (reading 'edgesOut')") seen on every run since 2026-09-07. Each build removes its
    # node_modules once the dist exists: npm pack needs the dist and the manifest, and ten dependency trees crowd a runner.
    for dir in angular svelte react vue; do
        echo "-- lily-design-system-$dir-headless"
        (cd "lily-design-system-$dir-headless" && npm install --no-audit --no-fund --legacy-peer-deps && npm run build &&
            rm -rf node_modules)
    done
    for framework in svelte react vue angular html nunjucks web-components; do
        for d in $(bin/list-helper-packages "$framework"); do
            echo "-- $d"
            (cd "$d" && npm install --no-audit --no-fund --legacy-peer-deps && npm run build && rm -rf node_modules)
        done
    done
    bin/smoke-packages
}

job_consumer_smoke() {
    if [ -z "${CI:-}" ] && [ -z "${LILY_CI_ALLOW_CONSUMER_SMOKE:-}" ]; then
        echo "consumer-smoke: skipped. It runs npm install in pnpm projects and deletes their node_modules; run it in a fresh" >&2
        echo "worktree with LILY_CI_ALLOW_CONSUMER_SMOKE=1, or leave it to CI." >&2
        record "consumer-smoke" "skipped (local)" 0
        return 0
    fi
    # A pass is recorded for this commit in the git directory every worktree shares, so the publish gate of another checkout of
    # it can see it (tasks.md P48-T6). Only from a tree that was clean: the run itself leaves npm lockfiles behind.
    local sha clean=""
    sha="$(git rev-parse HEAD)"
    [ -z "$(git status --porcelain)" ] && clean=1
    step "consumer-smoke" consumer_smoke || return 1
    if [ -n "$clean" ] && [ -z "${CI:-}" ]; then
        mkdir -p "$(git rev-parse --git-common-dir)/lily-ci"
        date -u +%Y-%m-%dT%H:%M:%SZ > "$(git rev-parse --git-common-dir)/lily-ci/consumer-smoke-$sha"
    fi
}

# Where the consumer smoke test passed for a commit: "local <date>", "GitHub", or nothing.
consumer_smoke_evidence() {
    local file
    file="$(git rev-parse --git-common-dir)/lily-ci/consumer-smoke-$1"
    if [ -s "$file" ]; then
        echo "local $(cat "$file")"
    elif command -v gh >/dev/null && [ "$(gh api "repos/LilyDesignSystem/lily-design-system/commits/$1/check-runs?per_page=100" \
        --jq '[.check_runs[] | select(.name | startswith("consumer smoke"))] | last | .conclusion' 2>/dev/null)" = "success" ]; then
        echo "GitHub"
    fi
}

shadcn_registry() {
    node bin/generate-registries --check
    # Serve the registry from this checkout, so the job never reads the live site. A server already on the port (a
    # run that died before its cleanup) would be read instead, so refuse to start rather than test a stale registry.
    # SO_REUSEADDR, as http.server sets: a port left in TIME_WAIT is free, one with a listener is not.
    if ! python3 -c 'import socket; s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1); s.bind(("127.0.0.1", 8787))' 2>/dev/null; then
        echo "port 8787 is already in use; stop that server first (lsof -nP -iTCP:8787)" >&2
        return 1
    fi
    (cd lilydesignsystem.github.io/static/r/react && exec python3 -m http.server 8787 --bind 127.0.0.1 >/dev/null 2>&1) &
    local server=$! i
    # Stop the server however the step ends: on return, and on the exit `bash -e` takes when a command fails. Never let
    # the cleanup itself fail the step.
    trap 'kill "$server" 2>/dev/null || true' RETURN EXIT
    for i in $(seq 1 20); do curl -sf http://127.0.0.1:8787/registry.json >/dev/null && break; sleep 0.5; done
    curl -sf http://127.0.0.1:8787/scroller.json >/dev/null
    local app="$SCRATCH/lily-shadcn-app"
    rm -rf "$app"
    (cd "$SCRATCH" && npx --yes create-next-app@16.4.6 lily-shadcn-app --ts --app --eslint --tailwind --src-dir \
        --import-alias "@/*" --use-npm --skip-install --yes)
    # create-next-app's own install trips newer npm's install-script policy (EALLOWSCRIPTS) and still exits 0.
    (cd "$app" && npm install --no-audit --no-fund)
    cat > "$app/components.json" <<'EOF'
{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": { "config": "", "css": "src/app/globals.css", "baseColor": "neutral", "cssVariables": true },
  "aliases": { "components": "@/components", "utils": "@/lib/utils", "ui": "@/components/ui", "lib": "@/lib", "hooks": "@/hooks" },
  "registries": { "@lily": "http://127.0.0.1:8787/{name}.json" }
}
EOF
    cd "$app"
    npx --yes shadcn@latest add @lily/button @lily/dialog @lily/scroller @lily/listbox --yes
    local f
    for f in Button Dialog Scroller ScrollerBase Listbox; do
        test -f "src/components/lily/$f.tsx" || { echo "missing src/components/lily/$f.tsx" >&2; return 1; }
    done
    for f in listbox-machine typeahead search-text; do
        test -f "src/components/lily/$f.ts" || { echo "missing src/components/lily/$f.ts" >&2; return 1; }
    done
    cat > src/app/demo.tsx <<'EOF'
"use client";
import { useState } from "react";
import Dialog from "@/components/lily/Dialog";
import Scroller from "@/components/lily/Scroller";
export default function Demo() {
  const [open, setOpen] = useState(false);
  const [step, setStep] = useState(0);
  return (
    <>
      <button type="button" onClick={() => setOpen(true)}>Open dialog</button>
      <Dialog label="Lily dialog" open={open} onChange={setOpen}><p>Copied with shadcn.</p></Dialog>
      <Scroller label="Lily scroller" onIndexChange={setStep} background={<p>Step {step}</p>}>
        <section>One</section>
        <section>Two</section>
      </Scroller>
    </>
  );
}
EOF
    cat > src/app/page.tsx <<'EOF'
import Button from "@/components/lily/Button";
import Demo from "./demo";
export default function Home() {
  return (<main><h1>Lily via shadcn</h1><Button type="button">Lily button</Button><Demo /></main>);
}
EOF
    npx next build
    npx tsc --noEmit
    local html=.next/server/app/index.html hook
    for hook in 'class="button ' 'class="scroller ' 'scroller-foreground' 'scroller-background'; do
        grep -q "$hook" "$html" || { echo "prerendered page lacks $hook" >&2; return 1; }
    done
}

job_shadcn_registry() { step "shadcn-registry" shadcn_registry; }

spell_check() {
    npx --yes cspell --no-progress \
        "*.md" "docs/**/*.md" "help/**/*.md" \
        "lilydesignsystem.github.io/src/routes/+page.svelte" \
        "lilydesignsystem.github.io/src/routes/{about,accessibility,comparisons,examples,help,lily-claude-code,lily-claude-design,lily-figma,tutorials,why}/**/*.svelte"
}

job_spell_check() { step "spell-check" spell_check; }

# The shared pure modules' own tests, example-based and fast-check properties (tasks.md P38-T5), in shared/ where
# bin/sync-shared-modules copies them from. Before this job nothing in CI ran them; only bin/mutation-test did.
shared_tests() {
    cd shared && pnpm install --frozen-lockfile && pnpm test
}

job_shared_tests() { step "shared-tests" shared_tests; }

# The coverage floor (coverage-floor.tsv, spec/lessons/openehr-rust item 8): shared/, Svelte headless and Blazor headless may
# not lose coverage, and a gain must be kept by lowering the floor. Measures only; writes nothing.
job_coverage_floor() { step "coverage-floor" bin/coverage-report --floor-only; }

# --- the command line ---

# The receipt of a --full run (tasks.md P24-T5): the commit, whether the tree was clean, each step's result and seconds, the
# tool versions and the date. It is self-asserted: it proves discipline, not integrity.
write_receipt() {
    local sha clean i steps
    sha="$(git rev-parse HEAD)"
    if [ -z "$(git status --porcelain)" ]; then clean=true; else clean=false; fi
    steps=""
    for i in "${!STEPS[@]}"; do
        steps+="${STEPS[$i]}"$'\t'"${RESULTS[$i]}"$'\t'"${SECONDS_TAKEN[$i]}"$'\n'
    done
    mkdir -p .ci
    STEPS_TSV="$steps" SHA="$sha" CLEAN="$clean" node --input-type=module -e '
        import { execSync } from "node:child_process";
        import { writeFileSync } from "node:fs";
        const version = (cmd) => { try { return execSync(cmd, { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim().split("\n")[0]; } catch { return null; } };
        const steps = process.env.STEPS_TSV.split("\n").filter(Boolean).map((line) => {
            const [name, result, seconds] = line.split("\t");
            return { name, result, seconds: Number(seconds) };
        });
        const receipt = {
            sha: process.env.SHA,
            clean: process.env.CLEAN === "true",
            date: new Date().toISOString(),
            tools: { node: process.version, pnpm: version("pnpm --version"), dotnet: version("dotnet --version"), git: version("git --version") },
            steps,
        };
        writeFileSync(".ci/receipt.json", JSON.stringify(receipt, null, 2) + "\n");
    '
    echo "bin/ci: wrote .ci/receipt.json for $sha ($([ "$clean" = true ] && echo clean || echo "dirty tree"))"
}

# The publish gate: exit 0 only for a receipt of HEAD, written from a clean tree that is still clean, with every step passing.
# A --full run skips consumer-smoke, so the gate needs its pass for this commit from elsewhere, and says where (P48-T6).
# LILY_PUBLISH_WITHOUT_RECEIPT=1 warns and lets the publish go ahead.
check_receipt() {
    local problem skipped smoke=""
    skipped="$(node --input-type=module -e '
        import { existsSync, readFileSync } from "node:fs";
        if (existsSync(".ci/receipt.json"))
            console.log(JSON.parse(readFileSync(".ci/receipt.json", "utf8")).steps.filter((s) => s.result.startsWith("skipped")).map((s) => s.name).join(", "));
    ')"
    [ -n "$skipped" ] && smoke="$(consumer_smoke_evidence "$(git rev-parse HEAD)")"
    problem="$(SMOKE="$smoke" SHA="$(git rev-parse HEAD)" DIRTY="$(git status --porcelain | head -1)" node --input-type=module -e '
        import { existsSync, readFileSync } from "node:fs";
        const file = ".ci/receipt.json";
        if (!existsSync(file)) { console.log("there is no .ci/receipt.json; run bin/ci --full"); process.exit(0); }
        const r = JSON.parse(readFileSync(file, "utf8"));
        if (r.sha !== process.env.SHA) console.log(`the receipt is for ${r.sha}, not HEAD ${process.env.SHA}; run bin/ci --full`);
        else if (!r.clean) console.log("the receipt was written from a dirty tree; commit or stash, then run bin/ci --full");
        else {
            const bad = r.steps.filter((s) => !s.result.startsWith("pass") && !(s.name === "consumer-smoke" && s.result.startsWith("skipped")));
            if (bad.length) console.log("not every step passed: " + bad.map((s) => `${s.name} (${s.result})`).join(", "));
            else if (r.steps.some((s) => s.name === "consumer-smoke" && s.result.startsWith("skipped")) && !process.env.SMOKE)
                console.log("consumer-smoke was skipped and has not passed for this commit; run LILY_CI_ALLOW_CONSUMER_SMOKE=1 bin/ci --job consumer-smoke in a fresh worktree, or wait for CI on GitHub");
            else if (process.env.DIRTY) console.log("the tree is dirty now; commit or stash first");
        }
    ')"
    if [ -z "$problem" ]; then
        echo "bin/ci: the receipt for $(git rev-parse --short HEAD) is clean and green${skipped:+; skipped here: $skipped (passed: $smoke)}"
        return 0
    fi
    if [ -n "${LILY_PUBLISH_WITHOUT_RECEIPT:-}" ]; then
        echo "bin/ci: WARNING: $problem; publishing anyway (LILY_PUBLISH_WITHOUT_RECEIPT is set)" >&2
        return 0
    fi
    echo "bin/ci: no publish: $problem. (LILY_PUBLISH_WITHOUT_RECEIPT=1 overrides, with a warning.)" >&2
    return 1
}

# --- the parallel --full run ---
#
# `--full` runs the jobs as "units" in "lanes". Units in one lane run one after another, because they share directories (a
# framework's headless library, its helpers and its example app); lanes run side by side, at most LILY_CI_JOBS at a time
# (default 3, each tool limited to its share of the cores). Every unit is `bin/ci --job ...` writing its log to .ci/logs/ and its steps to .ci/units/, so the receipt and
# the table are the same as a serial run's. A passed unit is cached in .ci/cache/ under a hash of everything it reads (its
# directories, shared/, the themes, the catalog, this script, the tool versions), and is not run again while that is
# unchanged; the table and the receipt then say "pass (cached)". `--no-cache` runs everything; `--serial` runs one job at a
# time, as before. The security audit is cached for 24 hours (it reads the network, not the tree).

UNIT_LANES=()
UNIT_ARGS=()
add_unit() { UNIT_LANES+=("$1"); UNIT_ARGS+=("$2"); }

build_units() {
    local fw app cat cats
    add_unit nunjucks "helper-packages nunjucks"
    add_unit nunjucks "headless lily-design-system-nunjucks-headless lily-design-system-nunjucks-headless-identifiers"
    add_unit nunjucks "eleventy-example"
    add_unit audit "security-audit"
    add_unit html "html-headless"
    add_unit html "helper-packages html"
    add_unit alpine "helper-packages alpine"
    add_unit alpine "headless lily-design-system-alpine-headless lily-design-system-alpine-headless-identifiers"
    add_unit alpine "alpine-examples"
    add_unit root "verify"
    add_unit root "lint"
    add_unit root "shared-tests"
    add_unit coverage "coverage-floor"
    add_unit dotnet "dotnet-tests"
    add_unit dotnet "dotnet-helper-packages"
    add_unit sveltekit "example-smoke"
    for fw in svelte react vue angular web-components solid; do
        add_unit "$fw" "helper-packages $fw"
        add_unit "$fw" "headless lily-design-system-$fw-headless lily-design-system-$fw-headless-identifiers"
    done
    for app in "${ACCESSIBILITY_APPS[@]}"; do add_unit "a11y-$app" "accessibility-examples $app"; done
    add_unit shadcn "shadcn-registry"
    add_unit spell "spell-check"
    add_unit consumer "consumer-smoke"
}

# The directories and files a unit's result depends on, or nothing for a unit that is never cached.
unit_inputs() {
    local lane="$1" common="shared themes components.tsv components-categories.tsv bin/ci bin/list-helper-packages package.json pnpm-lock.yaml lily-design-system-locale-translations lily-design-system-themes lily-design-system-pattern-testers"
    case "$lane" in
        nunjucks | html | alpine | svelte | react | vue | angular | web-components | solid)
            # shellcheck disable=SC2086
            echo $common $(ls -d "lily-design-system-$lane-"* 2>/dev/null)
            ;;
        sveltekit) echo $common lily-design-system-svelte-sveltekit-examples ;;
        coverage) echo $common coverage-floor.tsv bin/coverage-report lily-design-system-svelte-headless lily-design-system-blazor-headless ;;
        dotnet) echo $common $(ls -d lily-design-system-blazor-* 2>/dev/null) ;;
        a11y-*) echo $common "${lane#a11y-}" ;;
        *) echo "" ;;
    esac
}

unit_id() { printf '%s' "$1 $2" | shasum -a 1 | cut -c1-12; }

# Run one unit, or replay it from the cache; prints nothing, records its status in .ci/units/<id>.status.
run_unit() {
    local lane="$1" args="$2" id inputs key cache_key log steps ttl="" age
    id="$(unit_id "$lane" "$args")"
    steps=".ci/units/$id.tsv"
    log=".ci/logs/${lane}-${args%% *}-$id.log"
    rm -f "$steps" ".ci/units/$id.status"
    inputs="$(unit_inputs "$lane")"
    cache_key=""
    if [ -z "${LILY_CI_NO_CACHE:-}" ]; then
        if [ "$args" = "security-audit" ]; then
            ttl=86400
            cache_key="$(git ls-files -z -- '*pnpm-lock.yaml' '*packages.lock.json' | xargs -0 shasum -a 1 | shasum -a 1 | cut -d' ' -f1)"
        elif [ -n "$inputs" ]; then
            # shellcheck disable=SC2086
            cache_key="$({ paths_key $inputs; echo "$args"; echo "$TOOLS"; } | shasum -a 1 | cut -d' ' -f1)"
        fi
    fi
    if [ -n "$cache_key" ] && [ -f ".ci/cache/$id.key" ] && [ "$(cat ".ci/cache/$id.key")" = "$cache_key" ]; then
        age=$(($(date +%s) - $(cat ".ci/cache/$id.time" 2>/dev/null || echo 0)))
        if [ -z "$ttl" ] || [ "$age" -lt "$ttl" ]; then
            awk -F'\t' '{ print $1 "\t" $2 " (cached)\t0" }' ".ci/cache/$id.tsv" > "$steps"
            echo "cached  $lane: $args" 
            echo 0 > ".ci/units/$id.status"
            return 0
        fi
    fi
    # shellcheck disable=SC2086
    LILY_CI_STEP_LOG="$steps" LILY_CI_PREINSTALLED=1 bin/ci --job $args > "$log" 2>&1
    local status=$?
    echo "$status" > ".ci/units/$id.status"
    if [ "$status" -eq 0 ] && [ -n "$cache_key" ]; then
        mkdir -p .ci/cache
        printf '%s' "$cache_key" > ".ci/cache/$id.key"
        date +%s > ".ci/cache/$id.time"
        cp "$steps" ".ci/cache/$id.tsv"
    fi
    return "$status"
}

run_lane() {
    local lane="$1" i start=$SECONDS failed=0
    for i in "${!UNIT_LANES[@]}"; do
        [ "${UNIT_LANES[$i]}" = "$lane" ] || continue
        run_unit "$lane" "${UNIT_ARGS[$i]}" || failed=1
    done
    echo "finished $lane in $((SECONDS - start))s ($([ "$failed" -eq 0 ] && echo pass || echo FAIL))"
    return "$failed"
}

full_parallel() {
    local jobs="${LILY_CI_JOBS:-3}" cores workers lane lanes=() seen=" " i failed=0 id log
    TOOLS="$(node --version) $(pnpm --version 2>/dev/null) $(dotnet --version 2>/dev/null)"
    export TOOLS
    build_units
    mkdir -p .ci/logs .ci/units
    rm -f .ci/units/* .ci/logs/*
    # The two installs every job needs, once, before the lanes start.
    group "installs"
    pnpm install --frozen-lockfile || return 1
    (cd lilydesignsystem.github.io && pnpm install --frozen-lockfile) || return 1
    endgroup
    export LILY_CI_PREINSTALLED=1
    # Every test tool defaults to about half the cores (or all of them), so lanes side by side oversubscribe the machine and
    # tests time out (a load average of 345 on 16 cores, 2026-11-23). Give each lane its share: Playwright, WebDriverIO and
    # Vitest read these.
    cores="$(node -p 'require("node:os").availableParallelism()')"
    workers=$((cores / jobs))
    [ "$workers" -lt 2 ] && workers=2
    export LILY_CI_WORKERS="$workers" VITEST_MAX_WORKERS="$workers"
    for i in "${!UNIT_LANES[@]}"; do
        case "$seen" in *" ${UNIT_LANES[$i]} "*) ;; *) lanes+=("${UNIT_LANES[$i]}"); seen="$seen${UNIT_LANES[$i]} " ;; esac
    done
    for lane in "${lanes[@]}"; do
        while [ "$(jobs -rp | wc -l | tr -d ' ')" -ge "$jobs" ]; do sleep 1; done
        echo "started $lane"
        run_lane "$lane" &
    done
    wait
    # Collect the steps in unit order, so the table and the receipt read like a serial run's.
    for i in "${!UNIT_LANES[@]}"; do
        id="$(unit_id "${UNIT_LANES[$i]}" "${UNIT_ARGS[$i]}")"
        if [ -f ".ci/units/$id.tsv" ]; then
            while IFS=$'\t' read -r name result secs; do record "$name" "$result" "$secs"; done < ".ci/units/$id.tsv"
        fi
        if [ "$(cat ".ci/units/$id.status" 2>/dev/null || echo 1)" != "0" ]; then
            failed=1
            log=".ci/logs/${UNIT_LANES[$i]}-${UNIT_ARGS[$i]%% *}-$id.log"
            echo "---- FAILED: ${UNIT_ARGS[$i]} (${UNIT_LANES[$i]}); the end of $log" >&2
            tail -n 25 "$log" 2>/dev/null >&2
        fi
    done
    return "$failed"
}

table() {
    local i
    printf '\n%-60s %-18s %s\n' "step" "result" "seconds"
    for i in "${!STEPS[@]}"; do
        printf '%-60s %-18s %s\n' "${STEPS[$i]}" "${RESULTS[$i]}" "${SECONDS_TAKEN[$i]}"
    done
}

usage() {
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
}

run_job() {
    local name="$1"
    shift
    local fn="job_${name//-/_}"
    if ! declare -F "$fn" >/dev/null; then
        echo "bin/ci: no job named '$name'; bin/ci --list names them" >&2
        exit 2
    fi
    "$fn" "$@"
}

case "${1:-}" in
    --list)
        printf '%s\n' "${JOBS[@]}"
        ;;
    --job)
        [ -n "${2:-}" ] || usage
        name="$2"
        shift 2
        run_job "$name" "$@"
        status=$?
        table
        exit "$status"
        ;;
    --fast)
        # A tree that already passed the fast tier is not checked again (a push right after a commit, a second push): the
        # marker is keyed on the tree object of HEAD and written only from a clean tree.
        fast_marker=".ci/fast-$(git rev-parse 'HEAD^{tree}').ok"
        if [ -z "$(git status --porcelain)" ] && [ -f "$fast_marker" ]; then
            echo "bin/ci: the fast tier already passed for this tree ($(git rev-parse --short HEAD))"
            exit 0
        fi
        fast_checks
        status=$?
        table
        if [ "$status" -eq 0 ] && [ -z "$(git status --porcelain)" ]; then
            mkdir -p .ci && rm -f .ci/fast-*.ok && touch "$fast_marker"
        fi
        exit "$status"
        ;;
    --full)
        shift
        failed=0
        serial=""
        for arg in "$@"; do
            case "$arg" in
                --serial) serial=1 ;;
                --no-cache) export LILY_CI_NO_CACHE=1 ;;
                *) usage ;;
            esac
        done
        if [ -n "$serial" ]; then
            for name in "${JOBS[@]}"; do run_job "$name" || failed=1; done
        else
            full_parallel || failed=1
        fi
        table
        write_receipt
        exit "$failed"
        ;;
    --clean)
        # Clean-room mode (tasks.md P24-T6): run a mode in a fresh git worktree of HEAD, with no node_modules, build
        # output or untracked file carried over, so a dependency missing from a lockfile fails here when a normal run
        # hides it. The mode is the rest of the arguments (default --full): `bin/ci --clean --job verify`, or --fast.
        # The worktree is removed on any exit, Ctrl-C included. A --full run's receipt stays in the worktree and is
        # discarded: the publish gate needs a receipt from the real checkout.
        shift
        [ "$#" -eq 0 ] && set -- --full
        case "$1" in --fast | --full | --job | --list) ;; *) usage ;; esac
        worktree_dir="$(mktemp -d -t ci-clean-XXXXXX)"
        cleanup_worktree() {
            git worktree remove --force "$worktree_dir" 2>/dev/null
            rm -rf "$worktree_dir"
        }
        trap cleanup_worktree EXIT
        trap 'exit 130' INT TERM
        echo "bin/ci: clean-room worktree of $(git rev-parse --short HEAD) at $worktree_dir"
        git worktree add --quiet --detach "$worktree_dir" HEAD || exit 1
        result=0
        (cd "$worktree_dir" && bin/ci "$@") || result=$?
        exit "$result"
        ;;
    --verify-receipt)
        check_receipt
        ;;
    *)
        usage
        ;;
esac

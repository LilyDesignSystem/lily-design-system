{
  "name": "@lilydesignsystem/web-components-filter",
  "version": "0.1.0",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System Web Components filter: a <lily-filter-builder> custom element, a headless filter builder (conditions and groups over text, number, date, choice and yes/no fields; and / or / not) that outputs JSON, SQL, MongoDB, OData or a predicate. No CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "@testing-library/dom": "^10.4.2"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "web-components",
    "custom-element",
    "filter",
    "query-builder",
    "sql",
    "mongodb",
    "odata"
  ],

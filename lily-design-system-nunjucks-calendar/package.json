{
  "name": "@lilydesignsystem/nunjucks-calendar",
  "version": "0.2.0",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System Nunjucks calendar: a week, four-week and month calendar (WAI-ARIA APG Grid, picked and disabled days, events per day) over the headless CalendarTable macros, hydrated by calendar-view.client.js. Headless, SSR-safe, no CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./template": "./dist/calendar-view.njk"
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "bash build.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lilydesignsystem/nunjucks-headless": "^0.4.0",
    "@lilydesignsystem/nunjucks-date-time-picker": "^0.2.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "nunjucks": "^3.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "nunjucks",
    "calendar",
    "grid"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system.git",
    "directory": "lily-design-system-nunjucks-calendar"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

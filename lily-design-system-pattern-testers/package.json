{
  "name": "@lilydesignsystem/pattern-testers",
  "version": "0.1.0",
  "engines": {
    "node": ">=26"
  },
  "description": "Lily Design System - testers that drive a rendered component through a WAI-ARIA keyboard and state contract, from data, in any framework",
  "type": "module",
  "main": "./dist/pattern-tester.js",
  "types": "./dist/pattern-tester.d.ts",
  "exports": {
    ".": {
      "types": "./dist/pattern-tester.d.ts",
      "default": "./dist/pattern-tester.js"
    },
    "./browser": "./pattern-browser.cjs",
    "./contracts.json": "./pattern-contracts.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "pattern-tester.ts",
    "pattern-contracts.json",
    "pattern-browser.cjs",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp pattern-contracts.json dist/",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "accessibility",
    "testing",
    "wai-aria",
    "keyboard"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system.git",
    "directory": "lily-design-system-pattern-testers"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

{#
  ItyopyaFaydaIdentificationNumberView macro -- a read-only display of Fayda Identification Number (FIN).

  HTML tag: <span>
  CSS class: ityopya-fayda-identification-number-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/ityopya-fayda-identification-number-view/macro.njk" import ityopyaFaydaIdentificationNumberView %}
    {{ ityopyaFaydaIdentificationNumberView({ value: "sample", label: "Fayda Identification Number (FIN)" }) }}
#}
{%- macro ityopyaFaydaIdentificationNumberView(params) -%}
<span
  class="ityopya-fayda-identification-number-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

{#
  GuatemalaCodigoUnicoDeIdentificacionView macro -- a read-only display of Código Único de Identificación (CUI).

  HTML tag: <span>
  CSS class: guatemala-codigo-unico-de-identificacion-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/guatemala-codigo-unico-de-identificacion-view/macro.njk" import guatemalaCodigoUnicoDeIdentificacionView %}
    {{ guatemalaCodigoUnicoDeIdentificacionView({ value: "sample", label: "Código Único de Identificación (CUI)" }) }}
#}
{%- macro guatemalaCodigoUnicoDeIdentificacionView(params) -%}
<span
  class="guatemala-codigo-unico-de-identificacion-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

{#
  GhanaCardPersonalIdentificationNumberView macro -- a read-only display of Ghana Card PIN.

  HTML tag: <span>
  CSS class: ghana-card-personal-identification-number-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/ghana-card-personal-identification-number-view/macro.njk" import ghanaCardPersonalIdentificationNumberView %}
    {{ ghanaCardPersonalIdentificationNumberView({ value: "sample", label: "Ghana Card PIN" }) }}
#}
{%- macro ghanaCardPersonalIdentificationNumberView(params) -%}
<span
  class="ghana-card-personal-identification-number-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

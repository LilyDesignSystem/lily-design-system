{#
  BangladeshNationalIdentityCardView macro -- a read-only display of National ID (NID) number.

  HTML tag: <span>
  CSS class: bangladesh-national-identity-card-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/bangladesh-national-identity-card-view/macro.njk" import bangladeshNationalIdentityCardView %}
    {{ bangladeshNationalIdentityCardView({ value: "sample", label: "National ID (NID) number" }) }}
#}
{%- macro bangladeshNationalIdentityCardView(params) -%}
<span
  class="bangladesh-national-identity-card-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

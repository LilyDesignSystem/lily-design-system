{#
  GuatemalaCodigoUnicoDeIdentificacionInput macro -- an input for entering Código Único de Identificación (CUI).

  HTML tag: <input type="text">
  CSS class: guatemala-codigo-unico-de-identificacion-input
  Format: Thirteen digits, written 4-5-4 on the DPI card: eight assigned in sequence, one check digit, then two for the department and two for the municipality of birth (RENAP). RENAP does not publish the check-digit formula; open-source validators use weights 2 to 9 over the first eight digits, modulo 11, but that is not confirmed by the registry.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/guatemala-codigo-unico-de-identificacion-input/macro.njk" import guatemalaCodigoUnicoDeIdentificacionInput %}
    {{ guatemalaCodigoUnicoDeIdentificacionInput({ id: "field-id", label: "Código Único de Identificación (CUI)" }) }}
#}
{%- macro guatemalaCodigoUnicoDeIdentificacionInput(params) -%}
<input
  class="guatemala-codigo-unico-de-identificacion-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

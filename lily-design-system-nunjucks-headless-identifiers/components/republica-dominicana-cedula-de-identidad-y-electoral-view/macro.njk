{#
  RepublicaDominicanaCedulaDeIdentidadYElectoralView macro -- a read-only display of Cédula de Identidad y Electoral.

  HTML tag: <span>
  CSS class: republica-dominicana-cedula-de-identidad-y-electoral-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/republica-dominicana-cedula-de-identidad-y-electoral-view/macro.njk" import republicaDominicanaCedulaDeIdentidadYElectoralView %}
    {{ republicaDominicanaCedulaDeIdentidadYElectoralView({ value: "sample", label: "Cédula de Identidad y Electoral" }) }}
#}
{%- macro republicaDominicanaCedulaDeIdentidadYElectoralView(params) -%}
<span
  class="republica-dominicana-cedula-de-identidad-y-electoral-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

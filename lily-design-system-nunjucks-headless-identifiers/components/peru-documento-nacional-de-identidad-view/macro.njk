{#
  PeruDocumentoNacionalDeIdentidadView macro -- a read-only display of Documento Nacional de Identidad (DNI).

  HTML tag: <span>
  CSS class: peru-documento-nacional-de-identidad-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/peru-documento-nacional-de-identidad-view/macro.njk" import peruDocumentoNacionalDeIdentidadView %}
    {{ peruDocumentoNacionalDeIdentidadView({ value: "sample", label: "Documento Nacional de Identidad (DNI)" }) }}
#}
{%- macro peruDocumentoNacionalDeIdentidadView(params) -%}
<span
  class="peru-documento-nacional-de-identidad-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

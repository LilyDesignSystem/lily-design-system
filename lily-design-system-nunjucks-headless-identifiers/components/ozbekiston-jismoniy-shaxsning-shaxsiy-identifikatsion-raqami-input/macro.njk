{#
  OzbekistonJismoniyShaxsningShaxsiyIdentifikatsionRaqamiInput macro -- an input for entering Personal identification number (JShShIR / PINFL).

  HTML tag: <input type="text">
  CSS class: ozbekiston-jismoniy-shaxsning-shaxsiy-identifikatsion-raqami-input
  Format: Fourteen digits in five groups (Cabinet of Ministers Resolution No. 177 of 2022): a first digit from 1 to 6 for sex and century of birth, then groups for the date of birth and the issuing district, a three-digit sequence and a final check digit. The check-digit formula is not published, so check the length, the digits and the first digit's range.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/ozbekiston-jismoniy-shaxsning-shaxsiy-identifikatsion-raqami-input/macro.njk" import ozbekistonJismoniyShaxsningShaxsiyIdentifikatsionRaqamiInput %}
    {{ ozbekistonJismoniyShaxsningShaxsiyIdentifikatsionRaqamiInput({ id: "field-id", label: "Personal identification number (JShShIR / PINFL)" }) }}
#}
{%- macro ozbekistonJismoniyShaxsningShaxsiyIdentifikatsionRaqamiInput(params) -%}
<input
  class="ozbekiston-jismoniy-shaxsning-shaxsiy-identifikatsion-raqami-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

{#
  SriLankaNationalIdentityCardView macro -- a read-only display of National Identity Card (NIC) number.

  HTML tag: <span>
  CSS class: sri-lanka-national-identity-card-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/sri-lanka-national-identity-card-view/macro.njk" import sriLankaNationalIdentityCardView %}
    {{ sriLankaNationalIdentityCardView({ value: "sample", label: "National Identity Card (NIC) number" }) }}
#}
{%- macro sriLankaNationalIdentityCardView(params) -%}
<span
  class="sri-lanka-national-identity-card-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

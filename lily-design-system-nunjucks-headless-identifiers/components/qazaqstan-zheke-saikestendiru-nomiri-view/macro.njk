{#
  QazaqstanZhekeSaikestendiruNomiriView macro -- a read-only display of Individual Identification Number (IIN).

  HTML tag: <span>
  CSS class: qazaqstan-zheke-saikestendiru-nomiri-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/qazaqstan-zheke-saikestendiru-nomiri-view/macro.njk" import qazaqstanZhekeSaikestendiruNomiriView %}
    {{ qazaqstanZhekeSaikestendiruNomiriView({ value: "sample", label: "Individual Identification Number (IIN)" }) }}
#}
{%- macro qazaqstanZhekeSaikestendiruNomiriView(params) -%}
<span
  class="qazaqstan-zheke-saikestendiru-nomiri-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

{#
  CostaRicaCedulaDeIdentidadView macro -- a read-only display of Cédula de Identidad.

  HTML tag: <span>
  CSS class: costa-rica-cedula-de-identidad-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/costa-rica-cedula-de-identidad-view/macro.njk" import costaRicaCedulaDeIdentidadView %}
    {{ costaRicaCedulaDeIdentidadView({ value: "sample", label: "Cédula de Identidad" }) }}
#}
{%- macro costaRicaCedulaDeIdentidadView(params) -%}
<span
  class="costa-rica-cedula-de-identidad-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

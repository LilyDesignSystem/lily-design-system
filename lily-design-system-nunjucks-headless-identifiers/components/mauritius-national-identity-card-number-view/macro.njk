{#
  MauritiusNationalIdentityCardNumberView macro -- a read-only display of National Identity Card number.

  HTML tag: <span>
  CSS class: mauritius-national-identity-card-number-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/mauritius-national-identity-card-number-view/macro.njk" import mauritiusNationalIdentityCardNumberView %}
    {{ mauritiusNationalIdentityCardNumberView({ value: "sample", label: "National Identity Card number" }) }}
#}
{%- macro mauritiusNationalIdentityCardNumberView(params) -%}
<span
  class="mauritius-national-identity-card-number-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

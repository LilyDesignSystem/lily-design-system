{#
  AlImaratRaqmAlHuwiyahView macro -- a read-only display of Emirates ID number.

  HTML tag: <span>
  CSS class: al-imarat-raqm-al-huwiyah-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/al-imarat-raqm-al-huwiyah-view/macro.njk" import alImaratRaqmAlHuwiyahView %}
    {{ alImaratRaqmAlHuwiyahView({ value: "sample", label: "Emirates ID number" }) }}
#}
{%- macro alImaratRaqmAlHuwiyahView(params) -%}
<span
  class="al-imarat-raqm-al-huwiyah-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

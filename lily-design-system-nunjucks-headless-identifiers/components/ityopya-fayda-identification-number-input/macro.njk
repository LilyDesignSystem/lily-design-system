{#
  ItyopyaFaydaIdentificationNumberInput macro -- an input for entering Fayda Identification Number (FIN).

  HTML tag: <input type="text">
  CSS class: ityopya-fayda-identification-number-input
  Format: Twelve digits issued by the National ID Program (NIDP). The number encodes no personal attributes and no check-digit algorithm is published, so only the length and digits can be checked. Do not confuse it with the six-digit Fayda alternative number used to link bank accounts.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/ityopya-fayda-identification-number-input/macro.njk" import ityopyaFaydaIdentificationNumberInput %}
    {{ ityopyaFaydaIdentificationNumberInput({ id: "field-id", label: "Fayda Identification Number (FIN)" }) }}
#}
{%- macro ityopyaFaydaIdentificationNumberInput(params) -%}
<input
  class="ityopya-fayda-identification-number-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

@namespace LilyBlazorHeadless.Components

@*
    ToolCallName component

    The name of the tool in a ToolCall, shown in its summary. Renders a <span> with the `tool-call-name`
    hook.

    Props:
      CssClass — string, optional. CSS class name, added after the base class hook on the root.
      ChildContent — RenderFragment, optional. The tool name.
      AdditionalAttributes — Dictionary<string, object>, captures unmatched attributes and splats them onto the root with @attributes.

    Syntax:
      <ToolCallName>…</ToolCallName>

    Examples:
      <ToolCall Status="running"><ToolCallName>search_web</ToolCallName></ToolCall>

    Keyboard:
      - None -- not interactive; any interactive children handle their own keys

    Accessibility:
      - No role or ARIA: plain text inside the ToolCall summary

    Internationalization:
      - No hardcoded user-facing strings

    Claude rules:
      - Headless: no CSS, no styles -- consumer provides all styling
      - A part of ToolCall; draws nothing and carries no strings of its own

    References:
      - MDN <span>: https://developer.mozilla.org/en-US/docs/Web/HTML/Element/span
*@

<span class="@($"tool-call-name {CssClass}".Trim())"  @attributes="AdditionalAttributes">@ChildContent</span>

@code {

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

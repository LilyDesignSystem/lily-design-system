@namespace LilyBlazorHeadless.Components

@*
    Editable component
    an inline-editable text element that toggles between view and edit modes

    The root is a <div class="editable">. Display mode: a native <button type="button" class="editable-button"> showing
    the value (or ChildContent), named "value, label" (the label alone when the value is empty) so the visible text is
    part of the name (WCAG 2.5.3); a click, or the button's own Enter and Space, starts editing. Edit mode: an
    <input class="editable-input"> named by the label, holding a draft of the value; Enter confirms it (Value /
    ValueChanged), Escape cancels it. Editing / EditingChanged is two-way (@bind-Editing). Disabled: the button is
    disabled and never starts editing. Focus moves to the field on edit and back to the button after.

    Deviation from the Svelte canonical: an event handler cannot call preventDefault for only some keys, so Enter in the
    field also submits an enclosing form.
    Unmatched attributes spread onto the root <div>.
*@

<div class="@($"editable {CssClass}".Trim())" @attributes="AdditionalAttributes">
    @if (Editing)
    {
        <input @ref="_input" class="editable-input" type="text" aria-label="@Label" value="@_draft" @oninput="e => _draft = e.Value?.ToString() ?? string.Empty" @onkeydown="OnInputKeyDown" />
    }
    else
    {
        <button @ref="_button" type="button" class="editable-button" aria-label="@AccessibleName" disabled="@Disabled" @onclick="StartEditing">@(ChildContent ?? (RenderFragment)(b => b.AddContent(0, Value)))</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    /// <summary>The visible text. Bindable. When given, the accessible name is "value, label" so the visible text is part of the name (WCAG 2.5.3).</summary>
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Whether the component is in edit mode. Bindable.</summary>
    [Parameter] public bool Editing { get; set; }
    [Parameter] public EventCallback<bool> EditingChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Display-mode content, in place of the value text.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string _draft = "";
    private ElementReference _input;
    private ElementReference _button;
    // The element that had focus is removed by the switch, so focus follows the user to the element that replaces it.
    private string? _focusNext;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var next = _focusNext;
        _focusNext = null;
        try
        {
            if (next == "input") await _input.FocusAsync();
            else if (next == "button") await _button.FocusAsync();
        }
        catch (InvalidOperationException) { } // not interactive (static rendering): nothing to focus
    }
    private string AccessibleName => string.IsNullOrEmpty(Value) ? Label : $"{Value}, {Label}";

    protected override void OnInitialized() => _draft = Value;

    private async Task SetEditing(bool editing)
    {
        Editing = editing;
        await EditingChanged.InvokeAsync(editing);
    }

    private async Task StartEditing()
    {
        if (Disabled) return;
        _draft = Value;
        _focusNext = "input";
        await SetEditing(true);
    }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Value = _draft;
            await ValueChanged.InvokeAsync(_draft);
            _focusNext = "button";
            await SetEditing(false);
        }
        else if (e.Key == "Escape")
        {
            _draft = Value;
            _focusNext = "button";
            await SetEditing(false);
        }
    }
}

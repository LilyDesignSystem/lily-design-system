@namespace LilyBlazorHeadless.Components

@*
    InternationalPatientSummarySection component
    one section of an International Patient Summary, with its LOINC code and a status that is never blank

    A <section> named by its heading, carrying the section's key, LOINC code, status and whether the IPS requires it, as
    data. For any status but "known" the consumer's words are shown under the heading. Narrative, when given, sits in a
    <details> after the entries. See components/international-patient-summary-section/index.md.
*@
<section class="@($"international-patient-summary-section {CssClass}".Trim())" id="@SectionId" aria-labelledby="@HeadingId" data-section="@Section" data-code="@(Code ?? IpsSections.Code(Section))" data-status="@Status" data-required="@(IsRequired ? "true" : null)" data-level="@(Level ?? IpsSections.Level(Section))" @attributes="AdditionalAttributes">
    @switch (HeadingLevel)
    {
        case 3: <h3 id="@HeadingId" class="international-patient-summary-section-heading">@Heading</h3> break;
        case 4: <h4 id="@HeadingId" class="international-patient-summary-section-heading">@Heading</h4> break;
        case 5: <h5 id="@HeadingId" class="international-patient-summary-section-heading">@Heading</h5> break;
        case 6: <h6 id="@HeadingId" class="international-patient-summary-section-heading">@Heading</h6> break;
        default: <h2 id="@HeadingId" class="international-patient-summary-section-heading">@Heading</h2> break;
    }
    @if (Status != "known" && !string.IsNullOrEmpty(StatusLabel) && StatusPlacement != "list" && !(Status == "none-known" && conflicts.Any)) {<p class="international-patient-summary-section-status">@StatusLabel</p>}
    @if (Meta is not null) {<div class="international-patient-summary-section-meta">@Meta</div>}
    @if (Warning is not null) {<div class="international-patient-summary-section-warning">@Warning</div>}
    <CascadingValue Value="conflicts" IsFixed="true">@ChildContent</CascadingValue>
    @if (Narrative is not null) {<details class="international-patient-summary-section-narrative" open="@NarrativeOpen"><summary>@NarrativeLabel</summary>@Narrative</details>}
</section>
@code {
    /// <summary>The IPS section key, such as "allergies". Required.</summary>
    [Parameter, EditorRequired] public string Section { get; set; } = "";
    [Parameter, EditorRequired] public string Heading { get; set; } = "";
    /// <summary>2 to 6. Default 2.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 2;
    /// <summary>known, none-known, not-recorded, unavailable, omitted. Default known.</summary>
    [Parameter] public string Status { get; set; } = "known";
    /// <summary>The status in words; required for any status but known.</summary>
    [Parameter] public string? StatusLabel { get; set; }
    /// <summary>Where a status other than "known" is said in words: "heading" (default) prints the status label under the heading; "list" leaves the words to the record list inside, whose own status item says them, so they are not shown twice.</summary>
    [Parameter] public string StatusPlacement { get; set; } = "heading";
    /// <summary>The LOINC code; default the IPS code for the key.</summary>
    [Parameter] public string? Code { get; set; }
    /// <summary>Default whether the IPS requires the section.</summary>
    [Parameter] public bool? Required { get; set; }
    /// <summary>"required", "recommended" or "optional"; default the section's level in the IPS.</summary>
    [Parameter] public string? Level { get; set; }
    /// <summary>What a viewer shows beside the heading, after the heading and status and before the entries. Nothing without it.</summary>
    [Parameter] public RenderFragment? Meta { get; set; }
    /// <summary>A notice about the entries, after Meta and before them. Nothing without it.</summary>
    [Parameter] public RenderFragment? Warning { get; set; }
    [Parameter] public string? Id { get; set; }
    /// <summary>The same as its summary's; ids are {IdPrefix}-{Section}.</summary>
    [Parameter] public string? IdPrefix { get; set; }
    /// <summary>The author's narrative (sanitised by the consumer).</summary>
    [Parameter] public RenderFragment? Narrative { get; set; }
    [Parameter] public string? NarrativeLabel { get; set; }
    [Parameter] public bool NarrativeOpen { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // "None known" is never printed above a record list in conflict (HC-C17, P50-T29); the list says it in the consumer's words.
    private readonly SectionConflicts conflicts;

    public InternationalPatientSummarySection() => conflicts = new SectionConflicts(() => InvokeAsync(StateHasChanged));

    private string SectionId => IpsSections.Id(Section, Id, IdPrefix);
    private string HeadingId => $"{SectionId}-heading";
    private bool IsRequired => Required ?? IpsSections.IsRequired(Section);
}

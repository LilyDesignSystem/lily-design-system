@namespace LilyBlazorHeadless.Components

@*
    Hero component

    A prominent introductory banner at the top of a page or section. Renders a <section> with the `hero`
    hook around the consumer's headline, text and media.

    Props:
      CssClass — string, optional. CSS class name, added after the base class hook on the root.
      Label — string, optional. Accessible name, rendered as aria-label on the root.
      ChildContent — RenderFragment, required. The hero content.
      AdditionalAttributes — Dictionary<string, object>, captures unmatched attributes and splats them onto the root with @attributes.

    Syntax:
      <Hero Label="…">…</Hero>

    Examples:
      <Hero Label="Welcome"><h1>Welcome</h1></Hero>

    Keyboard:
      - None -- not interactive; any interactive children handle their own keys

    Accessibility:
      - aria-label comes from `label` when given
      - A <section> with an accessible name is exposed as a region landmark

    Internationalization:
      - No hardcoded user-facing strings

    Claude rules:
      - Headless: no CSS, no styles -- consumer provides all styling

    References:
      - MDN <section>: https://developer.mozilla.org/en-US/docs/Web/HTML/Element/section
*@

<section class="@($"hero {CssClass}".Trim())" aria-label="@Label" @attributes="AdditionalAttributes">@ChildContent</section>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

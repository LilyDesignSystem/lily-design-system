@namespace LilyBlazorHeadless.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    SplitButton component
    a button with a primary action and a dropdown for related actions

    Renders <div class="split-button" role="group" aria-label> with a
    <button class="split-button-primary">, a <button class="split-button-menu-trigger">
    (aria-haspopup="menu", aria-expanded, aria-controls, aria-label) and a
    <div class="split-button-menu" popover="auto"> holding ChildContent.

    Parameters:
        Label — string, required. aria-label of the group.
        PrimaryLabel — string, required. Text of the primary button.
        MenuLabel — string, required. aria-label of the menu trigger.
        MenuOpen / MenuOpenChanged — two-way (@bind-MenuOpen).
        Disabled — bool. Disables both buttons.
        OnPrimaryClick — EventCallback<MouseEventArgs>.
        TriggerContent — optional RenderFragment for the trigger (an icon).
        ChildContent — the menu content. CssClass, AdditionalAttributes (root).

    The menu is popover="auto" (tasks.md P18-T11): the trigger names it with command="toggle-popover"
    commandfor (and popovertarget), so the browser opens and closes it, the browser closes it
    on Escape and on a click outside it (light dismiss) and puts it in the top
    layer, with no script, also under static SSR. Ported from the Svelte
    reference on 2026-10-30; it was a bare <div> stub before.

    Blazor deviation: the toggle event, opening from MenuOpen, and the APG menu
    focus code (opening focuses the first role="menuitem"; ArrowDown/ArrowUp
    wrap, Home/End jump) go through Popover.razor.js with { menu: true },
    loaded after first render (skipped during prerender); where the Popover
    API is missing it toggles the hidden attribute on click, and Escape closes.
*@

<div class="@($"split-button {CssClass}".Trim())" role="group" aria-label="@Label" @attributes="AdditionalAttributes">
    <button class="split-button-primary" type="button" disabled="@Disabled" @onclick="OnPrimaryClick">@PrimaryLabel</button>
    <button class="split-button-menu-trigger"
            type="button"
            disabled="@Disabled"
            aria-haspopup="menu"
            aria-expanded="@(MenuOpen ? "true" : "false")"
            aria-label="@MenuLabel"
            aria-controls="@_menuId"
            command="toggle-popover"
            commandfor="@_menuId"
            popovertarget="@_menuId"
            @ref="_trigger">@TriggerContent</button>
    <div class="split-button-menu" id="@_menuId" popover="auto" @ref="_menu">@ChildContent</div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string PrimaryLabel { get; set; } = "";
    [Parameter, EditorRequired] public string MenuLabel { get; set; } = "";
    [Parameter] public bool MenuOpen { get; set; }
    [Parameter] public EventCallback<bool> MenuOpenChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnPrimaryClick { get; set; }
    [Parameter] public RenderFragment? TriggerContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _menuId = $"split-button-menu-{Guid.NewGuid():N}";
    private ElementReference _trigger;
    private ElementReference _menu;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<SplitButton>? _self;
    private bool _synced;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_self is null)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", Popover.ModulePath);
            _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _menu, _self, MenuOpen, _trigger, new { menu = true });
            _synced = MenuOpen;
        }
        else if (_handle is not null && _synced != MenuOpen)
        {
            _synced = MenuOpen;
            await _handle.InvokeVoidAsync("set", MenuOpen);
        }
    }

    /// <summary>Called from the menu's toggle event (trigger, Escape, light dismiss) or the no-API fallback.</summary>
    [JSInvokable]
    public async Task OnPopoverToggle(bool open)
    {
        _synced = open;
        if (MenuOpen == open) return;
        MenuOpen = open;
        await MenuOpenChanged.InvokeAsync(open);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}

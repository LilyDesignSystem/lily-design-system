@namespace LilyBlazorHeadless.Components
@inherits KeyedComponentBase

@*
    ImageCropper component
    a crop rectangle in percent, over the consumer's image and overlay. The keys
    are ActionBar.razor.js, generated from shared/widget-keys.ts: the arrows move
    it, Alt+arrows resize it, Shift for ten steps, Home and End along the row.
*@

<div @ref="Root" class="@($"image-cropper {CssClass}".Trim())" role="application" aria-label="@Label" tabindex="0" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    /// <summary>Called with each new rectangle.</summary>
    [Parameter] public EventCallback<CropRect> OnCropChange { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override string Kind => "cropper";

    public override Task OnKeyedCrop(CropRect crop) => OnCropChange.InvokeAsync(crop);
}

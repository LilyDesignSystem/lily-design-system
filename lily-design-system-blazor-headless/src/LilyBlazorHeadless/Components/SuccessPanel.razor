@namespace LilyBlazorHeadless.Components

@*
    SuccessPanel component

    A confirmation panel shown after an action succeeds. Renders a <div role="status"> with the
    `success-panel` hook.

    Props:
      CssClass — string, optional. CSS class name, added after the base class hook on the root.
      Label — string, optional. Accessible name, rendered as aria-label on the root.
      ChildContent — RenderFragment, required. The confirmation heading and text.
      AdditionalAttributes — Dictionary<string, object>, captures unmatched attributes and splats them onto the root with @attributes.

    Syntax:
      <SuccessPanel Label="…">…</SuccessPanel>

    Examples:
      <SuccessPanel Label="Saved"><h2>Saved</h2><p>Your changes were saved.</p></SuccessPanel>

    Keyboard:
      - None -- not interactive; any interactive children handle their own keys

    Accessibility:
      - aria-label comes from `label` when given
      - role="status" is a polite live region: text inserted into it after load is announced

    Internationalization:
      - No hardcoded user-facing strings

    Claude rules:
      - Headless: no CSS, no styles -- consumer provides all styling
      - Do not rely on colour alone to show success (WCAG 1.4.1); include a heading or text

    References:
      - WAI-ARIA status role: https://www.w3.org/TR/wai-aria-1.2/#status
*@

<div class="@($"success-panel {CssClass}".Trim())" role="alert" aria-label="@Label" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

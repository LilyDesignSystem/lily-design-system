@namespace LilyBlazorHeadless.Components

@*
    RedOrangeYellowGreenBluePicker component
    a picker for a red/orange/yellow/green/blue status

    A <fieldset role="radiogroup"> of native radios, one per status (red, orange, yellow, green, blue), sharing Name, as
    FiveStarRatingPicker is. The radios give the keys natively: Tab focuses the checked radio, the arrow keys move and
    check, Space checks. Value / ValueChanged is two-way (@bind-Value; "" = none). Disabled disables the whole group.
    StatusLabel gives each option's visible text and is required: there is no English default, and without it an
    option shows its value. Unmatched attributes spread onto the <fieldset>.
*@

<fieldset class="@($"red-orange-yellow-green-blue-picker {CssClass}".Trim())" role="radiogroup" aria-label="@Label" disabled="@Disabled" @attributes="AdditionalAttributes">
    @foreach (var status in Statuses)
    {
        var option = status;
        <label><input type="radio" name="@Name" value="@option" checked="@(Value == option)" @onchange="() => Choose(option)" /> @(StatusLabel is null ? option : StatusLabel(option))</label>
    }
</fieldset>

@code {
    private static readonly string[] Statuses = new[] { "red", "orange", "yellow", "green", "blue" };

    /// <summary>Accessible name for the group via aria-label.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    /// <summary>The checked status ("" = none).</summary>
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Radio group name for form submission.</summary>
    [Parameter] public string Name { get; set; } = "status";
    /// <summary>Each option's visible text, e.g. s => Labels[s]. No English default.</summary>
    [Parameter, EditorRequired] public Func<string, string>? StatusLabel { get; set; }
    /// <summary>Whether the entire group is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task Choose(string option)
    {
        Value = option;
        await ValueChanged.InvokeAsync(option);
    }
}

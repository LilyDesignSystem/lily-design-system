@namespace LilyBlazorHeadless.Components

@*
    Thinking component

    A headless disclosure for an AI assistant's reasoning / "thinking" trace,
    built on the native <details>. Closed by default. While `streaming` the root
    carries data-streaming and aria-busy so consumer CSS/AT know it is still filling.

    Props:
      CssClass — string, optional. CSS class name, added after the base class hook on the root.
      Label — string, required. The summary text. No default.
      Open — boolean, default false. Bindable.
      Streaming — boolean, default false. Adds data-streaming="true" + aria-busy="true" when true.
      ChildContent — RenderFragment. The reasoning content.
      AdditionalAttributes — Dictionary<string, object>, captures unmatched attributes and splats them onto the root with @attributes.

    Keyboard:
      - Enter / Space on the native <summary> toggles

    Accessibility:
      - Native details/summary semantics; aria-busy only while streaming

    Claude rules:
      - Headless: no CSS, no animation, no hardcoded strings
*@

<details class="@($"thinking {CssClass}".Trim())"
         open="@Open"
         data-streaming="@(Streaming ? "true" : null)"
         aria-busy="@(Streaming ? "true" : null)"
         @attributes="AdditionalAttributes">
    <summary class="thinking-summary" @onclick="ToggleAsync">@Label</summary>
    <div class="thinking-content">@ChildContent</div>
</details>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool Streaming { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task ToggleAsync()
    {
        Open = !Open;
        await OpenChanged.InvokeAsync(Open);
    }
}

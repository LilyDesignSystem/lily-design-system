@namespace LilyBlazorHeadless.Components
@*
    RecordList: a list of records from one section of a patient's record, whose status is never blank (tasks.md P28-T3, spec/healthcare-ui).
    For any status but "known", StatusLabel is the list's one item. Props and rules: RecordList.md.
*@
<ul class="@($"record-list {CssClass}".Trim())" data-status="@Shown.Status" aria-label="@Shown.Name" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(CoverageLabel)) {<li class="record-list-coverage">@CoverageLabel</li>}
    @if (Shown.ShowItem) {<li class="record-list-status">@Shown.Words</li>}
    <CascadingValue Value="entries" IsFixed="true">@ChildContent</CascadingValue>
</ul>
@code {
    private readonly RecordListEntries entries;
    /// <summary>known, none-known, not-recorded, unavailable, omitted, not-applicable. Required.</summary>
    [Parameter, EditorRequired] public string Status { get; set; } = "";
    /// <summary>The consumer's words for the status; names the list. Required.</summary>
    [Parameter, EditorRequired] public string StatusLabel { get; set; } = "";
    /// <summary>The accessible name, when it should differ from StatusLabel.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Your words for a list that says none are known and holds an entry, shown instead of StatusLabel; it never says both (HC-C17).</summary>
    [Parameter] public string? ConflictLabel { get; set; }
    /// <summary>What this list is a view of, in the consumer's words: its window and order, what it leaves out and why, and which sources did not answer. Rendered first, as an item of its own (spec/lessons/zoblocks).</summary>
    [Parameter] public string? CoverageLabel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private RecordListState Shown => RecordListState.Of(Status, StatusLabel, ConflictLabel, Label, entries.Any);

    public RecordList() => entries = new RecordListEntries(() => InvokeAsync(StateHasChanged));
}

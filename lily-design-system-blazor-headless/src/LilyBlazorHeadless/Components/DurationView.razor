@namespace LilyBlazorHeadless.Components
@*
    DurationView: a length of time in the consumer's words, in a <time> whose datetime is the ISO 8601 duration (tasks.md
    P29-T6). A negative duration renders its length as datetime and data-negative; years and months are no datetime.
    Props: DurationView.md.
*@
@{
    var parsed = ClinicalFormat.HtmlDuration(Duration);
}
<time class="@($"duration-view {CssClass}".Trim())" datetime="@parsed?.Datetime" data-negative="@(parsed?.Negative == true ? "" : null)" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(Label)) {<span class="screen-reader-span">@($"{Label} ")</span>}@Value</time>
@code {
    /// <summary>The length of time as the consumer writes it ("3 days 4 hours").</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    /// <summary>The same length as an ISO 8601 duration of days, hours, minutes and seconds, optionally negative.</summary>
    [Parameter, EditorRequired] public string Duration { get; set; } = "";
    /// <summary>Hidden text naming the value.</summary>
    [Parameter] public string? Label { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

@namespace LilyBlazorHeadless.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    VideoPlayer component
    a video player with play-in-view

    The contract's <figure> holding a native <video>. Autoplay here means play while in view: it pauses when half of the
    video leaves the viewport. Browsers block sound, so pair it with Muted. VideoPlayer.razor.js does this, and sets
    Muted on the element, where the attribute alone has no effect after the element is created.

    Parameters:
        Src, Label — string, required.
        Poster — string. Autoplay, Muted, Loop — bool. Controls — bool, default true.
        Caption — RenderFragment. Rendered in .video-player-caption.
        ChildContent — custom controls, in .video-player-controls.
        CssClass, AdditionalAttributes (spread onto the root).
*@

<figure class="@($"video-player {CssClass}".Trim())" aria-label="@Label" @attributes="AdditionalAttributes">
    <video class="video-player-element" src="@Src" poster="@Poster" muted="@Muted" loop="@Loop" controls="@Controls" playsinline @ref="_video"></video>
    @if (ChildContent is not null)
    {
        <div class="video-player-controls">@ChildContent</div>
    }
    @if (Caption is not null)
    {
        <figcaption class="video-player-caption">@Caption</figcaption>
    }
</figure>

@code {
    [Parameter, EditorRequired] public string Src { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Poster { get; set; }
    [Parameter] public bool Autoplay { get; set; }
    [Parameter] public bool Muted { get; set; }
    [Parameter] public bool Loop { get; set; }
    [Parameter] public bool Controls { get; set; } = true;
    [Parameter] public RenderFragment? Caption { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Module path, relative to the app base (static web asset of this library).</summary>
    public const string ModulePath = "./_content/LilyDesignSystem.Blazor.Headless/Components/VideoPlayer.razor.js";

    private ElementReference _video;
    private ElementModule? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _module = await ElementModule.AttachAsync(JS, ModulePath, _video, Autoplay, Muted);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null) await _module.DisposeAsync();
    }
}

@namespace LilyBlazorHeadless.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Popup component
    a temporary overlay that appears above page content

    Renders <div popover="auto" role="dialog">. The native Popover API puts it in
    the top layer while open and closes it on Escape and on a click outside it
    (light dismiss); a consumer trigger names it by Id with
    command="toggle-popover" commandfor="..." (or popovertarget="..."), so it
    opens with no script, also under static SSR.

    Parameters:
        Label — string, required. aria-label.
        Open / OpenChanged — two-way (@bind-Open). Setting Open opens or closes it;
            the browser's own toggles (trigger, Escape, light dismiss) write back.
        Id — string, optional. id of the popup, so a trigger can name it.
        ChildContent, CssClass, AdditionalAttributes (spread onto the root).

    Blazor deviation: C# has no synchronous DOM access, so opening from Open and
    the toggle event go through a small ES module (Popover.razor.js) loaded after
    first render; it is skipped during prerender. Where the Popover API is
    missing it falls back to the hidden attribute.
*@

<div class="@($"popup {CssClass}".Trim())" id="@Id" role="dialog" aria-label="@Label" popover="auto" @ref="_root" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<Popup>? _self;
    private bool _synced;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", Popover.ModulePath);
            _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _root, _self, Open, null);
            _synced = Open;
        }
        else if (_handle is not null && _synced != Open)
        {
            _synced = Open;
            await _handle.InvokeVoidAsync("set", Open);
        }
    }

    /// <summary>Called from the element's toggle event (trigger, Escape, light dismiss).</summary>
    [JSInvokable]
    public async Task OnPopoverToggle(bool open)
    {
        _synced = open;
        if (Open == open) return;
        Open = open;
        await OpenChanged.InvokeAsync(open);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}

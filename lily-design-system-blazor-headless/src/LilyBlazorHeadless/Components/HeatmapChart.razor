@namespace LilyBlazorHeadless.Components

@*
    HeatmapChart component
    A headless wrapper for a grid chart where cell colour encodes the value at each row and column. Renders a <figure> holding a
    role="img" graphic wrapper around the consumer-supplied inline <svg>.
    No drawing happens here. The optional DataTable fragment renders the
    accessible table alternative in .heatmap-chart-data-table, a SIBLING of the
    image wrapper: role="img" makes descendants presentational, so a table
    inside it would be invisible to assistive technology.
    Use aria-describedby (unmatched attribute, applied to the figure) for a
    text description; unmatched attributes spread onto the <figure>.
*@

<figure class="@($"heatmap-chart {CssClass}".Trim())" @attributes="AdditionalAttributes">
    <div class="heatmap-chart-graphic" role="img" aria-label="@Label">@ChildContent</div>
    @if (DataTable is not null)
    {
        <div class="heatmap-chart-data-table">@DataTable</div>
    }
</figure>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Optional accessible data table alternative, rendered outside the role=img wrapper.</summary>
    [Parameter] public RenderFragment? DataTable { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

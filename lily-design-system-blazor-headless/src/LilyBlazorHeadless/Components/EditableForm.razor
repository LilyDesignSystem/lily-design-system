@namespace LilyBlazorHeadless.Components

@*
    EditableForm component
    a form wrapper for inline editing of content

    Rendered while Editing is true (two-way: @bind-Editing). Submitting it (Enter in a field, or a submit button) leaves
    edit mode and raises OnSubmit; Escape inside it leaves edit mode and raises OnCancel. tabindex="-1" lets the form
    take focus. Blazor's @onsubmit already stops the browser's own submission.
    Unmatched attributes spread onto the <form>.
*@

@if (Editing)
{
    <form class="@($"editable-form {CssClass}".Trim())" aria-label="@Label" tabindex="-1" @onsubmit="HandleSubmit" @onkeydown="HandleKeyDown" @attributes="AdditionalAttributes">@ChildContent</form>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    /// <summary>Whether the form is in edit mode. Bindable.</summary>
    [Parameter] public bool Editing { get; set; }
    [Parameter] public EventCallback<bool> EditingChanged { get; set; }
    /// <summary>Raised when the form is submitted.</summary>
    [Parameter] public EventCallback OnSubmit { get; set; }
    /// <summary>Raised when editing is cancelled with Escape.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task Leave()
    {
        Editing = false;
        await EditingChanged.InvokeAsync(false);
    }

    private async Task HandleSubmit()
    {
        await Leave();
        await OnSubmit.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        await Leave();
        await OnCancel.InvokeAsync();
    }
}

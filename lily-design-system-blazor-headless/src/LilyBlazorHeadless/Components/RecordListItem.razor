@namespace LilyBlazorHeadless.Components
@*
    RecordListItem: one record in a record list, with its status and last update around the consumer's content (tasks.md P28-T3, spec/healthcare-ui). Props: RecordListItem.md.
*@
<li class="@($"record-list-item {CssClass}".Trim())" data-status="@(string.IsNullOrEmpty(Status) ? null : Status)" @attributes="AdditionalAttributes">@ChildContent@if (!string.IsNullOrEmpty(StatusLabel)) {@(" ")<span class="record-list-item-status">@StatusLabel</span>}@if (!string.IsNullOrEmpty(UpdatedLabel)) {@(" ")<time class="record-list-item-updated" datetime="@Updated">@UpdatedLabel</time>}</li>
@code {
    /// <summary>the record's status, as the consumer's code.</summary>
    [Parameter] public string? Status { get; set; }
    [Parameter] public string? StatusLabel { get; set; }
    /// <summary>when the record was last updated.</summary>
    [Parameter] public string? Updated { get; set; }
    [Parameter] public string? UpdatedLabel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

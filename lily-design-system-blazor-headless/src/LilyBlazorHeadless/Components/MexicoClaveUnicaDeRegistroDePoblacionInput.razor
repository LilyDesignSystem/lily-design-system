@namespace LilyBlazorHeadless.Components

@*
    MexicoClaveUnicaDeRegistroDePoblacionInput component
    an input for entering Mexico's Clave Unica de Registro de Poblacion (CURP)
*@

<input class="@($"mexico-clave-unica-de-registro-de-poblacion-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

@namespace LilyBlazorHeadless.Components
@inherits ValueInputBase

@*
    DateInput component
    an input for entering a date value <input type="date">
*@

@* The type is an expression because a literal one makes Razor bind DateTime, and the value is the text the browser holds. *@
<input class="@($"date-input {CssClass}".Trim())" type="@("date")" aria-label="@Label" @bind:get="Value" @bind:set="SetValueAsync" @bind:event="oninput" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

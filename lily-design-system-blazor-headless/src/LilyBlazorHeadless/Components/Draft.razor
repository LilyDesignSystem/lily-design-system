@namespace LilyBlazorHeadless.Components

@*
    Draft component

    A wrapper that marks content as a draft. Renders a <div> with the `draft` hook; `status` is exposed
    as data-status for the consumer's CSS (for example to show a watermark).

    Props:
      CssClass — string, optional. CSS class name, added after the base class hook on the root.
      Label — string, optional. Accessible name, rendered as aria-label on the root.
      Status — string, optional. Rendered as data-status; the vocabulary (for example "draft", "review") is the consumer's.
      ChildContent — RenderFragment, required. The content.
      AdditionalAttributes — Dictionary<string, object>, captures unmatched attributes and splats them onto the root with @attributes.

    Syntax:
      <Draft Label="…" Status="draft">…</Draft>

    Examples:
      <Draft Label="Draft policy" Status="draft"><p>Text under review.</p></Draft>

    Keyboard:
      - None -- not interactive; any interactive children handle their own keys

    Accessibility:
      - aria-label comes from `label` when given
      - A <div> has no role; do not rely on the CSS watermark alone to say the content is a draft (WCAG 1.4.1), include visible text

    Internationalization:
      - No hardcoded user-facing strings

    Claude rules:
      - Headless: no CSS, no styles -- consumer provides all styling
      - `status` is a data attribute for the consumer, not an ARIA state

    References:
      - MDN <div>: https://developer.mozilla.org/en-US/docs/Web/HTML/Element/div
*@

<div class="@($"draft {CssClass}".Trim())" aria-label="@Label" data-status="@(string.IsNullOrEmpty(Status) ? null : Status)" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

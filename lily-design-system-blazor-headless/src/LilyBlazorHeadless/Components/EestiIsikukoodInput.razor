@namespace LilyBlazorHeadless.Components
@inherits ValueInputBase

@*
    EestiIsikukoodInput component
    an input for entering Estonia's Isikukood (IK)
*@

<input class="@($"eesti-isikukood-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" @bind:get="Value" @bind:set="SetValueAsync" @bind:event="oninput" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

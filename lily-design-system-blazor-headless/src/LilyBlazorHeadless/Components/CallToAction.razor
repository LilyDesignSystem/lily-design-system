@namespace LilyBlazorHeadless.Components

@*
    CallToAction component
    a prominent prompt to act

    The contract's <a> when Href is given, else a <button type="button">; the root carries the class hook, with no wrapper.

    Parameters:
        Href — string. Makes it a link.
        Label — string. aria-label of the link or button, when its text is not enough.
        Disabled — bool. Button only: a link cannot be disabled.
        OnClick — EventCallback<MouseEventArgs>. Button only.
        ChildContent, CssClass, AdditionalAttributes (spread onto the root).
*@

@if (!string.IsNullOrEmpty(Href))
{
    <a class="@($"call-to-action {CssClass}".Trim())" href="@Href" aria-label="@AriaLabel" @attributes="AdditionalAttributes">@ChildContent</a>
}
else
{
    <button class="@($"call-to-action {CssClass}".Trim())" type="button" disabled="@Disabled" aria-label="@AriaLabel" @onclick="OnClick" @attributes="AdditionalAttributes">@ChildContent</button>
}

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string? AriaLabel => string.IsNullOrEmpty(Label) ? null : Label;
}

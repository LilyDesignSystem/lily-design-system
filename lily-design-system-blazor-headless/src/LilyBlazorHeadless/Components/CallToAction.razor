@namespace LilyBlazorHeadless.Components

@*
    CallToAction component
    a prominent prompt to act

    The contract's <div>, which the themes style as a band, holding a link when Href is given and a button otherwise.

    Parameters:
        Href — string. Makes it a link.
        Label — string. aria-label of the link or button, when its text is not enough.
        Disabled — bool. Button only: a link cannot be disabled.
        OnClick — EventCallback<MouseEventArgs>. Button only.
        ChildContent, CssClass, AdditionalAttributes (spread onto the root).
*@

<div class="@($"call-to-action {CssClass}".Trim())" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Href))
    {
        <a href="@Href" aria-label="@AriaLabel">@ChildContent</a>
    }
    else
    {
        <button type="button" disabled="@Disabled" aria-label="@AriaLabel" @onclick="OnClick">@ChildContent</button>
    }
</div>

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string? AriaLabel => string.IsNullOrEmpty(Label) ? null : Label;
}

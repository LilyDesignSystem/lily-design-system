@namespace LilyBlazorHeadless.Components

@*
    MedicalBannerBox component
    a medical banner box that is inside a medical-banner component, using flexbox horizontal, with medical information
*@

<div class="@($"medical-banner-box {CssClass}".Trim())" data-context="medical" role="@(string.IsNullOrEmpty(Label) ? null : "group")" aria-label="@(string.IsNullOrEmpty(Label) ? null : Label)" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

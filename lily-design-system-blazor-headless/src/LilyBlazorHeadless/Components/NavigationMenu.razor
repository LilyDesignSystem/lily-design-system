@namespace LilyBlazorHeadless.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    NavigationMenu component
    a site-wide navigation menu with links

    Parameters:
        Label — string, required. aria-label.
        Overflow — bool, default false. Overflow mode: the content must be <li>
            items; they render in <ul class="navigation-menu-list"> beside a hidden
            "More" item, and a ResizeObserver moves the items that do not fit into a
            disclosure. Publishes data-overflow="true". Without JavaScript the links
            simply wrap and the More item stays hidden.
        MoreLabel — string, required with Overflow. The More button's accessible
            name (no English from us).
        ChildContent, CssClass, AdditionalAttributes — as every component.

    Keyboard (overflow mode): Enter / Space toggle the More button; Escape closes
    the list and returns focus to the button; a click outside closes it.

    Blazor deviation: C# cannot measure the DOM, so the measuring lives in a small
    collocated ES module (NavigationMenu.razor.js, generated from
    shared/overflow-navigation.ts by bin/sync-shared-modules), loaded through JS
    interop after first render, only when Overflow is set. The JS interop is
    skipped during prerender. Items moved into the More list are moved in the DOM
    behind Blazor's back, so the set of items must not change while the component
    is rendered (re-create it with @key when it does).
*@

<nav class="@($"navigation-menu {CssClass}".Trim())" role="navigation" aria-label="@Label" data-overflow="@(Overflow ? "true" : null)" @ref="_root" @attributes="AdditionalAttributes">
    @if (Overflow)
    {
        <ul class="navigation-menu-list">@ChildContent<li class="navigation-menu-more" hidden><button class="navigation-menu-more-button" type="button" aria-expanded="false">@MoreLabel</button><ul class="navigation-menu-more-list" hidden></ul></li></ul>
    }
    else
    {
        @ChildContent
    }
</nav>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Overflow { get; set; }
    [Parameter] public string MoreLabel { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Module path, relative to the app base (static web asset of this library).</summary>
    public const string ModulePath = "./_content/LilyDesignSystem.Blazor.Headless/Components/NavigationMenu.razor.js";

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Overflow) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _root);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}

@namespace LilyBlazorHeadless.Components
@inherits ValueInputBase

@*
    MisrAlRaqmAlQawmiInput component
    an input for entering Egypt's National Number
*@

<input class="@($"misr-al-raqm-al-qawmi-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" spellcheck="false" @bind:get="Value" @bind:set="SetValueAsync" @bind:event="oninput" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

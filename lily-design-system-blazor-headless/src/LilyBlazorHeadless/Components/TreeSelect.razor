@namespace LilyBlazorHeadless.Components
@inherits KeyedPopoverBase

@*
    TreeSelect component
    a trigger opening a role="tree" the consumer supplies. The keys are
    ActionBar.razor.js, generated from shared/widget-keys.ts.
*@

<div @ref="Root" class="@($"tree-select {CssClass}".Trim())" role="combobox" aria-haspopup="tree" aria-expanded="@(Expanded ? "true" : "false")" aria-label="@Label" data-multiple="@(Multiple ? "true" : null)" @attributes="AdditionalAttributes">
    <button class="tree-select-trigger" type="button" disabled="@Disabled">@(Value ?? Placeholder)</button>
    <div class="tree-select-panel" popover="manual" @ref="Panel">@ChildContent</div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    /// <summary>Whether the panel is open, bindable.</summary>
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Value { get; set; }
    /// <summary>The chosen item's value, its path and every selected value.</summary>
    [Parameter] public EventCallback<TreeSelection> OnSelect { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override bool Shown => Expanded;

    protected override string Kind => "tree-popup";
    protected override object? KeyOptions => new { exclusive = false };

    protected override async Task KeyedOpen(bool open)
    {
        Expanded = open;
        await ExpandedChanged.InvokeAsync(open);
        await InvokeAsync(StateHasChanged);
    }

    protected override Task KeyedSelect(string value, string[] path, string[] selected) =>
        OnSelect.InvokeAsync(new TreeSelection(value, path, selected));
}

@namespace LilyBlazorHeadless.Components

@*
    BrasilCartaoNacionalDeSaudeInput component
    an input for entering Brazil's Cartao Nacional de Saude (CNS)
*@

<input class="@($"brasil-cartao-nacional-de-saude-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

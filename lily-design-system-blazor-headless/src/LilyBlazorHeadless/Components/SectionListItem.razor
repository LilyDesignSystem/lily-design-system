@namespace LilyBlazorHeadless.Components

@*
    SectionListItem component
    one section navigation item
*@

<li class="@($"section-list-item {CssClass}".Trim())" data-current="@(Current ? "" : null)" @attributes="AdditionalAttributes">@ChildContent</li>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>As data-current, as in Svelte.</summary>
    [Parameter] public bool Current { get; set; } = false;
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

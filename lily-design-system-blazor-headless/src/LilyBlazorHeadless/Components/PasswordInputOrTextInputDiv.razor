@namespace LilyBlazorHeadless.Components
@inherits ValueInputBase

@*
    PasswordInputOrTextInputDiv component
    a password input with a button that shows or hides the text

    Parameters:
        Label — string, required. The field's name.
        ToggleLabel — string, required. The button's text and name.
        Value / ValueChanged — two-way (@bind-Value).
        ShowToggle — bool, default true.
        Required, Disabled — bool.
        CssClass, AdditionalAttributes (spread onto the root).
*@

<div class="@($"password-input-or-text-input-div {CssClass}".Trim())" @attributes="AdditionalAttributes">
    <input type="@(_visible ? "text" : "password")" aria-label="@Label" required="@Required" disabled="@Disabled" autocomplete="current-password" @bind:get="Value" @bind:set="SetValueAsync" @bind:event="oninput" />
    @if (ShowToggle)
    {
        <button type="button" aria-label="@ToggleLabel" aria-pressed="@(_visible ? "true" : "false")" @onclick="@(() => _visible = !_visible)">@ToggleLabel</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string ToggleLabel { get; set; } = "";
    [Parameter] public bool ShowToggle { get; set; } = true;
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _visible;
}

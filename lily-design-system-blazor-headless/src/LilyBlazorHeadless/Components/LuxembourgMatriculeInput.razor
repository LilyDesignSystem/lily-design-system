@namespace LilyBlazorHeadless.Components

@*
    LuxembourgMatriculeInput component
    an input for entering Luxembourg's Numero d'Identification Nationale (Matricule)
*@

<input class="@($"luxembourg-matricule-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

@namespace LilyBlazorHeadless.Components

@*
    MagyarorszagTajSzamInput component
    an input for entering Hungary's Tarsadalombiztositasi Azonosito Jel (TAJ)
*@

<input class="@($"magyarorszag-taj-szam-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

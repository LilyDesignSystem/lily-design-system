@namespace LilyBlazorHeadless.Components

@*
    TourList component
    an ordered list of tour guide steps

    A plain <ol> (tasks.md P18-T6): no role="dialog" (it hid the list semantics)
    and no aria-modal; any dialog semantics belong to the enclosing Tour.
    Rendered while Active is true (bindable: @bind-Active); Escape inside the
    list sets Active to false. tabindex="-1" lets it take focus.
*@

@if (Active)
{
    <ol class="@($"tour-list {CssClass}".Trim())" aria-label="@Label" tabindex="-1" @onkeydown="OnKeyDown" @attributes="AdditionalAttributes">@ChildContent</ol>
}

@code {
    [Parameter] public string Label { get; set; } = "";
    /// <summary>Whether the tour is visible. Bindable.</summary>
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<bool> ActiveChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        Active = false;
        await ActiveChanged.InvokeAsync(false);
    }
}

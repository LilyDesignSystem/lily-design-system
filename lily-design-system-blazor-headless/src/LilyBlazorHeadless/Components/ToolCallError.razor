@namespace LilyBlazorHeadless.Components

@*
    ToolCallError component

    The error shown when a tool call fails. Renders a <div role="alert"> with the `tool-call-error`
    hook, so the error is announced when it appears.

    Props:
      CssClass — string, optional. CSS class name, added after the base class hook on the root.
      ChildContent — RenderFragment, optional. The error text.
      AdditionalAttributes — Dictionary<string, object>, captures unmatched attributes and splats them onto the root with @attributes.

    Syntax:
      <ToolCallError>…</ToolCallError>

    Examples:
      <ToolCall Status="error" open><ToolCallError>The tool timed out.</ToolCallError></ToolCall>

    Keyboard:
      - None -- not interactive; any interactive children handle their own keys

    Accessibility:
      - role="alert" announces the error assertively when it is inserted
      - Open the ToolCall on error so the alert is not inside a closed <details>, where it would not be announced

    Internationalization:
      - No hardcoded user-facing strings

    Claude rules:
      - Headless: no CSS, no styles -- consumer provides all styling
      - A part of ToolCall; carries no strings of its own

    References:
      - WAI-ARIA alert role: https://www.w3.org/TR/wai-aria-1.2/#alert
*@

<div class="@($"tool-call-error {CssClass}".Trim())" role="alert" @attributes="AdditionalAttributes">@ChildContent</div>

@code {

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

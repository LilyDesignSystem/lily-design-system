@namespace LilyBlazorHeadless.Components
@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    HorizontalScroller component
    a horizontally scrollable content container

    A focusable region. ArrowLeft and ArrowRight scroll by Step pixels; Home and End go to the ends. C# cannot scroll an
    element or prevent a default per key, so the keys are in HorizontalScroller.razor.js.

    Parameters:
        Label — string, required. aria-label.
        Step — double, default 100. Pixels per arrow key; rendered as data-step.
        ChildContent, CssClass, AdditionalAttributes (spread onto the root).
*@

<div class="@($"horizontal-scroller {CssClass}".Trim())" role="region" aria-label="@Label" tabindex="0" data-step="@Step.ToString(CultureInfo.InvariantCulture)" @ref="_root" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public double Step { get; set; } = 100;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Module path, relative to the app base (static web asset of this library).</summary>
    public const string ModulePath = "./_content/LilyDesignSystem.Blazor.Headless/Components/HorizontalScroller.razor.js";

    private ElementReference _root;
    private ElementModule? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _module = await ElementModule.AttachAsync(JS, ModulePath, _root);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null) await _module.DisposeAsync();
    }
}

@namespace LilyBlazorHeadless.Components
@inherits ValueInputBase

@*
    NetPromoterScorePicker component
    a picker for a score from 0 to 10

    Eleven native radios in a <fieldset role="radiogroup">, as in every catalog, so the browser supplies the arrow keys.

    Parameters:
        Label — string, required. aria-label of the group.
        Value / ValueChanged — "0" to "10", two-way (@bind-Value).
        Name — string, default "nps".
        CssClass, AdditionalAttributes (spread onto the root).
*@

<fieldset class="@($"net-promoter-score-picker {CssClass}".Trim())" role="radiogroup" aria-label="@Label" @attributes="AdditionalAttributes">
    @for (var i = 0; i <= 10; i++)
    {
        var score = i.ToString(System.Globalization.CultureInfo.InvariantCulture);
        <label>
            <input type="radio" name="@Name" value="@score" checked="@(Value == score)" aria-label="@score" @onchange="@(() => SetValueAsync(score))" />
            @score
        </label>
    }
</fieldset>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Name { get; set; } = "nps";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

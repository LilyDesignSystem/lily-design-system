@namespace LilyBlazorHeadless.Components

@*
    MexicoClaveUnicaDeRegistroDePoblacionView component
    a read-only display of Mexico's Clave Unica de Registro de Poblacion (CURP)
*@

<span class="@($"mexico-clave-unica-de-registro-de-poblacion-view {CssClass}".Trim())" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(Label)) {<span class="screen-reader-span">@($"{Label} ")</span>}@ChildContent</span>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

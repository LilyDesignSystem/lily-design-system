@namespace LilyBlazorHeadless.Components

@*
    AngleSliderRangeInput component
    a range input for selecting an angle in degrees
*@

<input class="@($"angle-slider-range-input {CssClass}".Trim())" type="range" min="@Number(Min)" max="@Number(Max)" step="@Number(Step)" aria-valuemin="@Number(Min)" aria-valuemax="@Number(Max)" aria-valuenow="@Number(Value)" aria-valuetext="@($"{Number(Value)}{ValueTextSuffix}")" aria-label="@Label" @attributes="AdditionalAttributes" @bind:get="Value" @bind:set="SetValueAsync" @bind:event="oninput" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    /// <summary>The current number.</summary>
    [Parameter] public double Value { get; set; } = 0;
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 360;
    [Parameter] public double Step { get; set; } = 1;
    /// <summary>Follows the number in <c>aria-valuetext</c>.</summary>
    [Parameter] public string ValueTextSuffix { get; set; } = "°";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private static string Number(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private async Task SetValueAsync(double value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}

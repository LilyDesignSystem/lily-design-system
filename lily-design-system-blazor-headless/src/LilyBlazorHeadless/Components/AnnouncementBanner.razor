@namespace LilyBlazorHeadless.Components

@*
    AnnouncementBanner component

    A banner announcing news or a service notice. Renders a <div role="region"> with the `announcement-
    banner` hook.

    Props:
      CssClass — string, optional. CSS class name, added after the base class hook on the root.
      Label — string, optional. Accessible name, rendered as aria-label on the root.
      ChildContent — RenderFragment, required. The announcement.
      AdditionalAttributes — Dictionary<string, object>, captures unmatched attributes and splats them onto the root with @attributes.

    Syntax:
      <AnnouncementBanner Label="…">…</AnnouncementBanner>

    Examples:
      <AnnouncementBanner Label="Service notice">The service is closed on Monday.</AnnouncementBanner>

    Keyboard:
      - None -- not interactive; any interactive children handle their own keys

    Accessibility:
      - aria-label comes from `label` when given
      - role="region" with aria-label makes it a landmark; pass `label`, since a region without a name is not exposed as one

    Internationalization:
      - No hardcoded user-facing strings

    Claude rules:
      - Headless: no CSS, no styles -- consumer provides all styling

    References:
      - WAI-ARIA region role: https://www.w3.org/TR/wai-aria-1.2/#region
*@

<div class="@($"announcement-banner {CssClass}".Trim())" role="region" aria-label="@Label" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

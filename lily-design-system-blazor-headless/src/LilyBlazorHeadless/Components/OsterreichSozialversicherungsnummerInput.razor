@namespace LilyBlazorHeadless.Components

@*
    OsterreichSozialversicherungsnummerInput component
    an input for entering Austria's Sozialversicherungsnummer (SVNR)
*@

<input class="@($"osterreich-sozialversicherungsnummer-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

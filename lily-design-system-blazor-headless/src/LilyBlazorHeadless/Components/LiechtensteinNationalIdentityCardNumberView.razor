@namespace LilyBlazorHeadless.Components

@*
    LiechtensteinNationalIdentityCardNumberView component
    a read-only display of Liechtenstein's Liechtenstein National Identity Card Number
*@

<span class="@($"liechtenstein-national-identity-card-number-view {CssClass}".Trim())" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(Label)) {<span class="screen-reader-span">@($"{Label} ")</span>}@ChildContent</span>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

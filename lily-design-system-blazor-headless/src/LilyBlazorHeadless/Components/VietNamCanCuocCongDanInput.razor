@namespace LilyBlazorHeadless.Components

@*
    VietNamCanCuocCongDanInput component
    an input for entering Viet Nam's Citizen Identification Number (CCCD)
*@

<input class="@($"viet-nam-can-cuoc-cong-dan-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

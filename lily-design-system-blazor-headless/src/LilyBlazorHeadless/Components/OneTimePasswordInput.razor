@namespace LilyBlazorHeadless.Components

@*
    OneTimePasswordInput component
    a single one-time-password input with a numeric keypad, SMS autofill, and a fixed length

    One real <input> (not the segmented boxes of PinInputDiv) so the platform's
    SMS / password-manager autofill and paste both work.

    Parameters:
        Label — string, required. Accessible name via aria-label.
        Length — int, required, no default (the consumer decides). Sets maxlength and data-length.
        Value — string, bindable via @bind-Value (ValueChanged fires on every input).
        InputMode — string, default "numeric".
        Pattern — string, default "[0-9]*".
        Name / Required / Disabled — native attributes.
        AdditionalAttributes — spread onto the <input>.

    No keyboard handling beyond native.
*@

<input class="@($"one-time-password-input {CssClass}".Trim())"
       type="text"
       inputmode="@InputMode"
       autocomplete="one-time-code"
       maxlength="@Length"
       pattern="@Pattern"
       spellcheck="false"
       autocapitalize="off"
       aria-label="@Label"
       data-length="@Length"
       name="@Name"
       value="@Value"
       required="@Required"
       disabled="@Disabled"
       @oninput="HandleInput"
       @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public int Length { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string InputMode { get; set; } = "numeric";
    [Parameter] public string Pattern { get; set; } = "[0-9]*";
    [Parameter] public string? Name { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var next = e.Value?.ToString() ?? "";
        if (Value == next) return;
        Value = next;
        await ValueChanged.InvokeAsync(next);
    }
}

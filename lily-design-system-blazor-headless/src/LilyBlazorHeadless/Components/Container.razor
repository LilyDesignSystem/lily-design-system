@namespace LilyBlazorHeadless.Components

@*
    Container component

    A generic block-level content container. Renders a <div> with the `container` hook and no ARIA; use
    ContainerWithFixedWidth or ContainerWithFluidWidth when a width behaviour is wanted.

    Props:
      CssClass — string, optional. CSS class name, added after the base class hook on the root.
      ChildContent — RenderFragment, optional. The content.
      AdditionalAttributes — Dictionary<string, object>, captures unmatched attributes and splats them onto the root with @attributes.

    Syntax:
      <Container>…</Container>

    Examples:
      <Container><p>Content</p></Container>

    Keyboard:
      - None -- not interactive; any interactive children handle their own keys

    Accessibility:
      - No role or ARIA: a generic wrapper

    Internationalization:
      - No hardcoded user-facing strings

    Claude rules:
      - Headless: no CSS, no styles -- consumer provides all styling

    References:
      - MDN <div>: https://developer.mozilla.org/en-US/docs/Web/HTML/Element/div
*@

<div class="@($"container {CssClass}".Trim())" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

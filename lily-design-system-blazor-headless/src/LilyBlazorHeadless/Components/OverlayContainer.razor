@namespace LilyBlazorHeadless.Components

@*
    OverlayContainer component
    a full-viewport overlay backdrop for modals and sheets
*@

<div class="@($"overlay-container {CssClass}".Trim())" role="presentation" data-open="@(Open ? "true" : "false")" aria-hidden="@(Open ? null : "true")" hidden="@(!Open)" aria-label="@Label" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Whether the overlay is shown; when not, it is hidden and aria-hidden.</summary>
    [Parameter] public bool Open { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

@namespace LilyBlazorHeadless.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Visible component
    an IntersectionObserver wrapper that tells its content whether it is on screen

    Parameters:
        Once — bool. Stops watching the first time it is seen.
        Threshold — double, default 0. RootMargin — string, default "0px".
        ChildContent — RenderFragment<bool>: context is whether it is visible.
        CssClass, AdditionalAttributes (spread onto the root).
*@

<div class="@($"visible {CssClass}".Trim())" data-visible="@(_visible ? "true" : "false")" @ref="_root" @attributes="AdditionalAttributes">@ChildContent?.Invoke(_visible)</div>

@code {
    [Parameter] public bool Once { get; set; }
    [Parameter] public double Threshold { get; set; }
    [Parameter] public string RootMargin { get; set; } = "0px";
    [Parameter] public RenderFragment<bool>? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Module path, relative to the app base (static web asset of this library).</summary>
    public const string ModulePath = "./_content/LilyDesignSystem.Blazor.Headless/Components/Visible.razor.js";

    private ElementReference _root;
    private ElementModule? _module;
    private DotNetObjectReference<Visible>? _self;
    private bool _visible;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _module = await ElementModule.AttachAsync(JS, ModulePath, _root, _self, Once, Threshold, RootMargin);
    }

    /// <summary>Called from JS: it came on or went off screen.</summary>
    [JSInvokable]
    public void OnVisibleChange(bool visible)
    {
        if (_visible == visible) return;
        _visible = visible;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null) await _module.DisposeAsync();
        _self?.Dispose();
    }
}

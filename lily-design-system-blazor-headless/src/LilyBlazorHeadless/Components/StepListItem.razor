@namespace LilyBlazorHeadless.Components

@*
    StepListItem component
    one step in a step list with status of waiting, in progress, finished, or error
*@

<li class="@($"step-list-item {CssClass}".Trim())" data-status="@Status" data-current="@(Current ? "" : null)" aria-label="@Label" @attributes="AdditionalAttributes">@ChildContent</li>

@code {
    [Parameter] public string Label { get; set; } = "";
    /// <summary>"waiting", "in-progress", "finished" or "error", as data-status.</summary>
    [Parameter] public string Status { get; set; } = "waiting";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>As data-current, as in Svelte.</summary>
    [Parameter] public bool Current { get; set; } = false;
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

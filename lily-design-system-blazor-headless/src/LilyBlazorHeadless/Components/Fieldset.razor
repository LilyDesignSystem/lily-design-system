@namespace LilyBlazorHeadless.Components

@*
    Fieldset component
    a group of related form fields with a legend
*@

<fieldset class="@($"fieldset {CssClass}".Trim())" aria-label="@(string.IsNullOrEmpty(Label) ? null : Label)" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(Legend)) {<legend>@Legend</legend>}@ChildContent</fieldset>

@code {
    [Parameter] public string Label { get; set; } = "";
    /// <summary>The group's visible name, in a legend.</summary>
    [Parameter] public string? Legend { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

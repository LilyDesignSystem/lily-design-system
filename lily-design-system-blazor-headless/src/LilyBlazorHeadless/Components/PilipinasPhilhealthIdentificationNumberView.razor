@namespace LilyBlazorHeadless.Components

@*
    PilipinasPhilhealthIdentificationNumberView component
    a read-only display of the Philippines' PhilHealth Identification Number (PIN)
*@

<span class="@($"pilipinas-philhealth-identification-number-view {CssClass}".Trim())" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(Label)) {<span class="screen-reader-span">@($"{Label} ")</span>}@ChildContent</span>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

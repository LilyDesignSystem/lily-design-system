@namespace LilyBlazorHeadless.Components

@*
    PakistanComputerizedNationalIdentityCardView component
    a read-only display of Pakistan's Computerized National Identity Card Number (CNIC)
*@

<span class="@($"pakistan-computerized-national-identity-card-view {CssClass}".Trim())" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(Label)) {<span class="screen-reader-span">@($"{Label} ")</span>}@ChildContent</span>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

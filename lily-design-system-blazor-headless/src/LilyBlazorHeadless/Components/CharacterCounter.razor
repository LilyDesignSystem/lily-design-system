@namespace LilyBlazorHeadless.Components
@using System.Globalization

@*
    CharacterCounter component
    a counter showing remaining or used characters in a text field

    Parameters, as in Svelte:
        Count — int, default 0. The current character count.
        Max — int?. The limit; with it the text is "Count / Max" and data-max, data-remaining and, past the
            limit, data-over-limit are rendered.
        Label — string. aria-label.
        ChildContent — the consumer's own words; when given they replace the numbers. No English default.
*@

<span class="@($"character-counter {CssClass}".Trim())" aria-live="polite" role="status" aria-label="@(string.IsNullOrEmpty(Label) ? null : Label)" data-count="@Num(Count)" data-max="@(Max is { } max ? Num(max) : null)" data-remaining="@(Max is { } m ? Num(m - Count) : null)" data-over-limit="@(Max is { } l && Count > l ? "" : null)" @attributes="AdditionalAttributes">@if (ChildContent is not null)
{
    @ChildContent
}
else
{
    @(Max is { } total ? $"{Num(Count)} / {Num(total)}" : Num(Count))
}</span>

@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public int? Max { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private static string Num(int n) => n.ToString(CultureInfo.InvariantCulture);
}

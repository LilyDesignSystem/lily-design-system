@namespace LilyBlazorHeadless.Components

@*
    UruguayCedulaDeIdentidadView component
    a read-only display of Uruguay's Cedula de Identidad Number
*@

<span class="@($"uruguay-cedula-de-identidad-view {CssClass}".Trim())" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(Label)) {<span class="screen-reader-span">@($"{Label} ")</span>}@ChildContent</span>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

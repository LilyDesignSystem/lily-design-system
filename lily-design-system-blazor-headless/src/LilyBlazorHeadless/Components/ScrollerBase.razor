@namespace LilyBlazorHeadless.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    ScrollerBase component
    a scrollytelling container that reports its step and progress

    Each direct child is a step. A step is current when it crosses the line Offset of the way down the viewport.
    ScrollerBase.razor.js watches the page, and reports progress at most once a frame.

    Parameters:
        Label — string. aria-label.
        Offset — double, default 0.5.
        OnIndexChange — EventCallback<int>. OnProgressChange — EventCallback<double>, 0 to 1.
        ChildContent, CssClass, AdditionalAttributes (spread onto the root).
*@

<div class="@($"scroller-base {CssClass}".Trim())" aria-label="@(string.IsNullOrEmpty(Label) ? null : Label)" @ref="_root" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public double Offset { get; set; } = 0.5;
    [Parameter] public EventCallback<int> OnIndexChange { get; set; }
    [Parameter] public EventCallback<double> OnProgressChange { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Module path, relative to the app base (static web asset of this library).</summary>
    public const string ModulePath = "./_content/LilyDesignSystem.Blazor.Headless/Components/ScrollerBase.razor.js";

    private ElementReference _root;
    private ElementModule? _module;
    private DotNetObjectReference<ScrollerBase>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _module = await ElementModule.AttachAsync(JS, ModulePath, _root, _self, Offset, OnIndexChange.HasDelegate, OnProgressChange.HasDelegate);
    }

    /// <summary>Called from JS: a step reached the line.</summary>
    [JSInvokable]
    public Task OnScrollerIndex(int index) => OnIndexChange.InvokeAsync(index);

    /// <summary>Called from JS: the page scrolled.</summary>
    [JSInvokable]
    public Task OnScrollerProgress(double progress) => OnProgressChange.InvokeAsync(progress);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null) await _module.DisposeAsync();
        _self?.Dispose();
    }
}

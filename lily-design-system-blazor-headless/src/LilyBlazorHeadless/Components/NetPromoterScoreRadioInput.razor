@namespace LilyBlazorHeadless.Components

@*
    NetPromoterScoreRadioInput component
    a radio input for one choice of a 0-10 Net Promoter Score <input type="radio">
*@

<input class="@($"net-promoter-score-radio-input {CssClass}".Trim())" type="radio" aria-label="@Label" value="@Value" data-value="@Value" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

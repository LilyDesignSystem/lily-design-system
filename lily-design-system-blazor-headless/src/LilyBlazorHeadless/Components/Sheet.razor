@namespace LilyBlazorHeadless.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Sheet component
    a panel that slides in from a screen edge as an overlay

    Parameters:
        Label — string, required. aria-label.
        Open — bool, default false. Whether the panel is shown; two-way bindable
            (@bind-Open). Escape sets it to false.
        Side — "left" | "right" | "top" | "bottom", default "right". Exposed as data-side
            for consumer positioning CSS.
        ChildContent, CssClass, AdditionalAttributes — as every component.

    Modal (tasks.md P18-T6): while Open it renders a native <dialog> with
    aria-modal="true", opened with showModal() through JS interop (the collocated
    Drawer.razor.js, shared by Drawer, Sheet and SlideOutDrawer), so the page
    behind it is inert and Tab stays inside it. Focus moves inside on open and
    returns to the element that had it on close. Escape (keydown, or the native
    cancel event, whose default is prevented) closes it through Open/OpenChanged.
    The interop is skipped during prerender; until it runs the dialog is closed.
*@

@if (Open)
{
    <dialog class="@($"sheet {CssClass}".Trim())" tabindex="-1" aria-label="@Label" aria-modal="true" data-side="@Side" @ref="_dialog" @onkeydown="OnKeyDown" @oncancel="CloseAsync" @oncancel:preventDefault @onclose="CloseAsync" @attributes="AdditionalAttributes">@ChildContent</dialog>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Side { get; set; } = "right";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && _handle is null)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", Drawer.ModulePath);
            _handle = await _module.InvokeAsync<IJSObjectReference>("open", _dialog);
        }
        else if (!Open && _handle is not null)
        {
            await ReleaseAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (!Open) return;
        Open = false;
        await OpenChanged.InvokeAsync(false);
    }

    private async Task ReleaseAsync()
    {
        var handle = _handle;
        _handle = null;
        if (handle is null) return;
        await handle.InvokeVoidAsync("close");
        await handle.DisposeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await ReleaseAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}

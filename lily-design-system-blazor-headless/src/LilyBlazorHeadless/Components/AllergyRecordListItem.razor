@namespace LilyBlazorHeadless.Components
@*
    AllergyRecordListItem: one allergy or intolerance in an allergy record list, with substance, reaction, severity, criticality and status (tasks.md P28-T3, spec/healthcare-ui). Props: AllergyRecordListItem.md.
*@
<li class="@($"allergy-record-list-item {CssClass}".Trim())" data-severity="@(string.IsNullOrEmpty(Severity) ? null : Severity)" data-criticality="@(string.IsNullOrEmpty(Criticality) ? null : Criticality)" data-clinical-status="@(string.IsNullOrEmpty(ClinicalStatus) ? null : ClinicalStatus)" data-verification-status="@(string.IsNullOrEmpty(VerificationStatus) ? null : VerificationStatus)" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(SubjectLabel)) {<span class="allergy-record-list-item-subject">@SubjectLabel</span>@(" ")}<span class="allergy-record-list-item-substance">@Substance</span>@if (!string.IsNullOrEmpty(Reaction)) {@(" ")<span class="allergy-record-list-item-reaction">@Reaction</span>}@if (!string.IsNullOrEmpty(SeverityLabel)) {@(" ")<span class="allergy-record-list-item-severity">@SeverityLabel</span>}@if (!string.IsNullOrEmpty(CriticalityLabel)) {@(" ")<span class="allergy-record-list-item-criticality">@CriticalityLabel</span>}@if (!string.IsNullOrEmpty(ClinicalStatusLabel)) {@(" ")<span class="allergy-record-list-item-clinical-status">@ClinicalStatusLabel</span>}@if (!string.IsNullOrEmpty(VerificationStatusLabel)) {@(" ")<span class="allergy-record-list-item-verification-status">@VerificationStatusLabel</span>}@if (!string.IsNullOrEmpty(TypeLabel)) {@(" ")<span class="allergy-record-list-item-type">@TypeLabel</span>}@if (!string.IsNullOrEmpty(CategoryLabel)) {@(" ")<span class="allergy-record-list-item-category">@CategoryLabel</span>}@if (!string.IsNullOrEmpty(UpdatedLabel)) {@(" ")<time class="allergy-record-list-item-updated" datetime="@Updated">@UpdatedLabel</time>}@ChildContent</li>
@code {
    /// <summary>whose record it is, when it is not the patient's (&quot;Mother&quot;, &quot;Fetus 1&quot;); shown first.</summary>
    [Parameter] public string? SubjectLabel { get; set; }
    /// <summary>what the patient reacts to; never truncated.</summary>
    [Parameter, EditorRequired] public string Substance { get; set; } = "";
    /// <summary>the manifestation.</summary>
    [Parameter] public string? Reaction { get; set; }
    /// <summary>the reaction's severity (FHIR reaction.severity).</summary>
    [Parameter] public string? Severity { get; set; }
    [Parameter] public string? SeverityLabel { get; set; }
    /// <summary>the risk of a future reaction (FHIR criticality), not the severity of a past one.</summary>
    [Parameter] public string? Criticality { get; set; }
    [Parameter] public string? CriticalityLabel { get; set; }
    /// <summary>FHIR clinicalStatus.</summary>
    [Parameter] public string? ClinicalStatus { get; set; }
    [Parameter] public string? ClinicalStatusLabel { get; set; }
    /// <summary>FHIR verificationStatus; a refuted or entered-in-error record must never read as a confirmed one.</summary>
    [Parameter] public string? VerificationStatus { get; set; }
    [Parameter] public string? VerificationStatusLabel { get; set; }
    /// <summary>allergy or intolerance, in words (FHIR type).</summary>
    [Parameter] public string? TypeLabel { get; set; }
    /// <summary>food, medication, environment or biologic, in words (FHIR category).</summary>
    [Parameter] public string? CategoryLabel { get; set; }
    /// <summary>when the record was last updated.</summary>
    [Parameter] public string? Updated { get; set; }
    [Parameter] public string? UpdatedLabel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

@namespace LilyBlazorHeadless.Components

@*
    MagyarorszagTajSzamView component
    a read-only display of Hungary's Tarsadalombiztositasi Azonosito Jel (TAJ)
*@

<span class="@($"magyarorszag-taj-szam-view {CssClass}".Trim())" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(Label)) {<span class="screen-reader-span">@($"{Label} ")</span>}@ChildContent</span>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

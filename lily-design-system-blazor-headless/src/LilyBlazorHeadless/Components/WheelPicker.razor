@namespace LilyBlazorHeadless.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    WheelPicker component
    A single-select listbox, vertical by default, where the selection follows the cursor: moving with the arrow keys, typing, or clicking an
    option chooses it. Use it to pick one of a short list (hours, minutes, months, years) in the manner of a scroll wheel. The
    component owns the roles and the keys; the wheel LOOK (scroll snapping, fading, 3-D) is the consumer's CSS.

    Value / ValueChanged is two-way (@bind-Value). Options are WheelPickerOption records. The key model is WheelPickerKeys.

    WheelPicker.razor.js (spec/detent-lessons, P26-T10), loaded once the component is interactive, does what an event
    handler cannot: it stops the page scrolling for the keys the wheel handles, keeps the chosen option centred, reports
    the text direction (so a horizontal wheel's ArrowLeft and ArrowRight swap right-to-left), chooses the option the user
    scrolls to once the wheel settles, and puts the picker back to its first value on a form reset. Under static rendering
    none of that runs: the keys still choose, and the list scrolls with them.
    Orientation "horizontal" moves with ArrowLeft / ArrowRight. The hidden input is disabled with the picker, so not
    submitted, and takes Form, the id of a form elsewhere.
    Unmatched attributes spread onto the root <div>.
*@

<div class="@($"wheel-picker {CssClass}".Trim())" @attributes="AdditionalAttributes">
    <div @ref="_list"
         class="wheel-picker-list"
         role="listbox"
         aria-label="@Label"
         aria-orientation="@(Orientation == "horizontal" ? "horizontal" : "vertical")"
         aria-disabled="@(Disabled ? "true" : null)"
         aria-activedescendant="@(SelectedIndex >= 0 ? $"{_uid}-option-{SelectedIndex}" : null)"
         tabindex="@(Disabled ? -1 : 0)"
         @onkeydown="OnKeyDown">
        @for (var i = 0; i < Options.Count; i++)
        {
            var index = i;
            var option = Options[i];
            <div class="wheel-picker-option"
                 role="option"
                 id="@($"{_uid}-option-{index}")"
                 aria-selected="@(index == SelectedIndex ? "true" : "false")"
                 aria-disabled="@(option.Disabled ? "true" : null)"
                 data-value="@option.Value"
                 data-index="@index"
                 @onclick="() => OnOptionClick(index)">@option.Label</div>
        }
    </div>
    @if (!string.IsNullOrEmpty(Name))
    {
        <input type="hidden" name="@Name" value="@Value" form="@Form" disabled="@Disabled" />
    }
</div>

@code {
    private static int _count;
    private readonly string _uid = $"wheel-picker-{Interlocked.Increment(ref _count)}";
    private ElementReference _list;
    public const string ModulePath = "./_content/LilyDesignSystem.Blazor.Headless/Components/WheelPicker.razor.js";
    private ElementModule? _module;
    private DotNetObjectReference<WheelPicker>? _self;
    private bool _rtl;
    private string _initialValue = "";

    protected override void OnInitialized() => _initialValue = Value;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var state = new { orientation = Orientation == "horizontal" ? "horizontal" : "vertical", disabled = Disabled };
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await ElementModule.AttachAsync(JS, ModulePath, _list, _self, state);
        }
        else if (_module is not null) await _module.SetAsync(state);
    }

    /// <summary>Called from JS: whether the nearest <c>dir</c> is right-to-left.</summary>
    [JSInvokable]
    public void OnWheelDirection(bool rtl) => _rtl = rtl;

    /// <summary>Called from JS: the user scrolled the wheel and it settled on this option.</summary>
    [JSInvokable]
    public async Task OnWheelChoose(int index)
    {
        if (Disabled || index < 0 || index >= Options.Count || Options[index].Disabled) return;
        await Select(index);
        StateHasChanged();
    }

    /// <summary>Called from JS: the form reset; go back to the first value.</summary>
    [JSInvokable]
    public async Task OnWheelReset()
    {
        if (Value == _initialValue) return;
        Value = _initialValue;
        await ValueChanged.InvokeAsync(_initialValue);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null) await _module.DisposeAsync();
        _self?.Dispose();
    }
    private (string Prefix, long At) _typeahead = ("", 0);

    /// <summary>Accessible name of the listbox.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    /// <summary>The choices.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<WheelPickerOption> Options { get; set; } = [];
    /// <summary>The selected option's value; empty or unknown selects nothing.</summary>
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Arrow keys wrap from the last enabled option to the first and back.</summary>
    [Parameter] public bool Loop { get; set; }
    /// <summary>Enabled options PageUp / PageDown move by.</summary>
    [Parameter] public int PageSize { get; set; } = 5;
    /// <summary>Ignores keys and clicks; not focusable.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>"vertical" (default) or "horizontal".</summary>
    [Parameter] public string Orientation { get; set; } = "vertical";
    /// <summary>When set, a hidden input carries the value for a form; it is disabled while the picker is.</summary>
    [Parameter] public string? Name { get; set; }
    /// <summary>The id of the form the hidden input belongs to, when the picker sits outside it.</summary>
    [Parameter] public string? Form { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int SelectedIndex
    {
        get
        {
            for (var i = 0; i < Options.Count; i++) if (Options[i].Value == Value) return i;
            return -1;
        }
    }

    private async Task Select(int index)
    {
        if (index < 0) return;
        var next = Options[index].Value;
        if (next == Value) return; // applying the selection already held is a no-op
        Value = next;
        await ValueChanged.InvokeAsync(next);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (Disabled) return;
        if (WheelPickerKeys.MoveKey(e.Key, Orientation, _rtl) is { } move)
        {
            await Select(WheelPickerKeys.NextIndex(Options, SelectedIndex, move, Loop, PageSize));
        }
        else if (WheelPickerKeys.IsTypeaheadKey(e.Key, e.CtrlKey, e.AltKey, e.MetaKey))
        {
            _typeahead = WheelPickerKeys.NextPrefix(_typeahead, e.Key, DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
            await Select(WheelPickerKeys.TypeaheadIndex(Options, SelectedIndex, _typeahead.Prefix));
        }
    }

    private async Task OnOptionClick(int index)
    {
        if (Disabled || Options[index].Disabled) return;
        await Select(index);
        await _list.FocusAsync();
    }
}

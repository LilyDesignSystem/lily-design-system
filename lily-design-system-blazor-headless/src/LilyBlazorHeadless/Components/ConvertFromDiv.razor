@namespace LilyBlazorHeadless.Components

@*
    ConvertFromDiv component
    A headless part of ConvertDiv: the source side of a conversion, holding the value and unit to convert from.
    Contract: a plain <div> with the base class and child content.
    Unmatched attributes spread onto the root.
*@

<div class="@($"convert-from-div {CssClass}".Trim())" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

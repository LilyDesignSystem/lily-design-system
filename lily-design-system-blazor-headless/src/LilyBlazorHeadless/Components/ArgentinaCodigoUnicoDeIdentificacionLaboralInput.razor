@namespace LilyBlazorHeadless.Components

@*
    ArgentinaCodigoUnicoDeIdentificacionLaboralInput component
    an input for entering Argentina's Codigo Unico de Identificacion Laboral (CUIL)
*@

<input class="@($"argentina-codigo-unico-de-identificacion-laboral-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

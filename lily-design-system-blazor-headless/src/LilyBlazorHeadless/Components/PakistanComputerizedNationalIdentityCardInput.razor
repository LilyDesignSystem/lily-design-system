@namespace LilyBlazorHeadless.Components

@*
    PakistanComputerizedNationalIdentityCardInput component
    an input for entering Pakistan's Computerized National Identity Card Number (CNIC)
*@

<input class="@($"pakistan-computerized-national-identity-card-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

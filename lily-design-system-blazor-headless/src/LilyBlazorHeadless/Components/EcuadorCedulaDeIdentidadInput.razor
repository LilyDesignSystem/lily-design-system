@namespace LilyBlazorHeadless.Components

@*
    EcuadorCedulaDeIdentidadInput component
    an input for entering Ecuador's Cedula de Identidad Number
*@

<input class="@($"ecuador-cedula-de-identidad-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

@namespace LilyBlazorHeadless.Components
@using Microsoft.JSInterop
@inherits ValueInputBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    TagInput component
    an input for adding and removing tags

    Enter with text calls OnAdd with the trimmed text and clears the field. Enter with no text stays a normal Enter,
    which submits a surrounding form; that choice is per key, so it needs TagInput.razor.js. The tags themselves are the
    consumer's: ChildContent renders before the field. The root is the contract's <div>, as in Nunjucks and Alpine.

    Parameters:
        Label — string, required. aria-label of the group and of the field.
        Value / ValueChanged — the field's text, two-way (@bind-Value).
        OnAdd — EventCallback<string>. The trimmed text.
        Disabled — bool. Native disabled on the field.
        ChildContent — the tags so far.
        CssClass, AdditionalAttributes (spread onto the root).
*@

<div class="@($"tag-input {CssClass}".Trim())" role="group" aria-label="@Label" @attributes="AdditionalAttributes">
    @ChildContent
    <input class="tag-input-field" type="text" aria-label="@Label" disabled="@Disabled" @ref="_field" @bind:get="Value" @bind:set="SetValueAsync" @bind:event="oninput" />
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public EventCallback<string> OnAdd { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Module path, relative to the app base (static web asset of this library).</summary>
    public const string ModulePath = "./_content/LilyDesignSystem.Blazor.Headless/Components/TagInput.razor.js";

    private ElementReference _field;
    private ElementModule? _module;
    private DotNetObjectReference<TagInput>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _module = await ElementModule.AttachAsync(JS, ModulePath, _field, _self);
    }

    /// <summary>Called from JS: Enter with this trimmed text.</summary>
    [JSInvokable]
    public async Task OnTagAdd(string value)
    {
        await SetValueAsync("");
        await OnAdd.InvokeAsync(value);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null) await _module.DisposeAsync();
        _self?.Dispose();
    }
}

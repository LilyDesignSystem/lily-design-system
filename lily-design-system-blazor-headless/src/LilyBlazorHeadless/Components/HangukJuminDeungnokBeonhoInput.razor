@namespace LilyBlazorHeadless.Components

@*
    HangukJuminDeungnokBeonhoInput component
    an input for entering South Korea's Resident Registration Number
*@

<input class="@($"hanguk-jumin-deungnok-beonho-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

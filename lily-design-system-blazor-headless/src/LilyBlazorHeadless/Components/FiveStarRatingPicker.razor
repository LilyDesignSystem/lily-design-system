@namespace LilyBlazorHeadless.Components

@*
    FiveStarRatingPicker component
    a picker for selecting a 1-5 star rating using radio buttons

    A <fieldset role="radiogroup"> of five native radios (values 1 to 5) sharing Name. The radios give the keys natively:
    Tab focuses the checked radio, the arrow keys move and check, Space checks. Value / ValueChanged is two-way
    (@bind-Value; 0 = none). Disabled disables the whole group. The option text is the consumer's (the numbers by default,
    no English). Unmatched attributes spread onto the <fieldset>.
*@

<fieldset class="@($"five-star-rating-picker {CssClass}".Trim())" role="radiogroup" aria-label="@Label" disabled="@Disabled" @attributes="AdditionalAttributes">
    @for (var n = 1; n <= 5; n++)
    {
        var option = n;
        <label><input type="radio" name="@Name" value="@option" checked="@(Value == option)" @onchange="() => Choose(option)" /> @(StarLabel is null ? option.ToString(System.Globalization.CultureInfo.InvariantCulture) : StarLabel(option))</label>
    }
</fieldset>

@code {
    /// <summary>Accessible name for the rating group via aria-label.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    /// <summary>Current rating (1-5, 0 = none).</summary>
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    /// <summary>Radio group name for form submission.</summary>
    [Parameter] public string Name { get; set; } = "rating";
    /// <summary>Each option's text, e.g. n => $"{n} stars"; the number alone by default.</summary>
    [Parameter] public Func<int, string>? StarLabel { get; set; }
    /// <summary>Whether the entire group is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task Choose(int option)
    {
        Value = option;
        await ValueChanged.InvokeAsync(option);
    }
}

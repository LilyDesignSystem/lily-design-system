@namespace LilyBlazorHeadless.Components

@*
    KbdShortcut component

    A headless keyboard shortcut: an outer <kbd> holding one inner <kbd> per key,
    with a decorative separator between keys. Use Kbd for a single key.

    Props:
      CssClass — string, optional. CSS class name, added after the base class hook on the root.
      Keys — string[], required. The key names, in order, e.g. ["Ctrl", "K"].
      Separator — string, default "+". Decorative text between keys (aria-hidden).
      Label — string, optional. Spoken form, read instead of the visible keys.
      AdditionalAttributes — Dictionary<string, object>, captures unmatched attributes and splats them onto the root with @attributes.

    Keyboard:
      - None; display only

    Accessibility:
      - Separators are aria-hidden so screen readers read the keys
      - label (optional) replaces the spoken form, e.g. "Control K": it is hidden text, and the keys are aria-hidden

    Internationalization:
      - Key names are consumer-supplied; no hardcoded strings

    Claude rules:
      - Headless: no CSS, no icons for keys
*@

<kbd class="@($"kbd-shortcut {CssClass}".Trim())" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(Label)) {<span class="screen-reader-span">@($"{Label} ")</span>}@for (var i = 0; i < Keys.Count; i++)
{
    if (i > 0)
    {
        <span class="kbd-shortcut-separator" aria-hidden="true">@Separator</span>
    }
    <kbd class="kbd-shortcut-key" aria-hidden="@(string.IsNullOrEmpty(Label) ? null : "true")">@Keys[i]</kbd>
}</kbd>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Keys { get; set; } = Array.Empty<string>();
    [Parameter] public string Separator { get; set; } = "+";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

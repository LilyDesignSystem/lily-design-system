@namespace LilyBlazorHeadless.Components

@*
    Statistic component
    a numeric value display with title, prefix, and suffix
*@

<div class="@($"statistic {CssClass}".Trim())" role="group" aria-label="@Label" @attributes="AdditionalAttributes">@ChildContent@if (!string.IsNullOrEmpty(Change))
    {
        <div class="statistic-change" data-trend="@Trend">@Change</div>
    }@if (!string.IsNullOrEmpty(AsOfLabel))
    {
        <time class="statistic-as-of" datetime="@AsOf">@AsOfLabel</time>
    }</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The change, in words that name what it is compared with ("0.5 more than October 2024").</summary>
    [Parameter] public string? Change { get; set; }
    /// <summary>"up", "down" or "flat": data-trend for the theme; the words in Change carry the direction for everyone.</summary>
    [Parameter] public string? Trend { get; set; }
    /// <summary>When the value was measured, as an ISO 8601 date or date-time for the time element.</summary>
    [Parameter] public string? AsOf { get; set; }
    /// <summary>When the value was measured, in words; the as-of line renders only with it.</summary>
    [Parameter] public string? AsOfLabel { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

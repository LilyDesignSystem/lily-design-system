@namespace LilyBlazorHeadless.Components

@*
    Kbd component

    Marks keyboard input, such as a key or shortcut. Renders a <kbd> with the `kbd` hook.

    Props:
      CssClass — string, optional. CSS class name, added after the base class hook on the root.
      Label — string, optional. Spoken form, read instead of the visible key.
      ChildContent — RenderFragment, required. The key text, for example Ctrl.
      AdditionalAttributes — Dictionary<string, object>, captures unmatched attributes and splats them onto the root with @attributes.

    Syntax:
      <Kbd Label="…">…</Kbd>

    Examples:
      <p>Press <Kbd>Esc</Kbd> to close.</p>

    Keyboard:
      - None -- not interactive; any interactive children handle their own keys

    Accessibility:
      - hidden text comes from `label` when given

    Internationalization:
      - No hardcoded user-facing strings

    Claude rules:
      - Headless: no CSS, no styles -- consumer provides all styling

    References:
      - MDN <kbd>: https://developer.mozilla.org/en-US/docs/Web/HTML/Element/kbd
*@

<kbd class="@($"kbd {CssClass}".Trim())" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(Label)) {<span class="screen-reader-span">@($"{Label} ")</span>}<span class="kbd-text" aria-hidden="@(string.IsNullOrEmpty(Label) ? null : "true")">@ChildContent</span></kbd>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

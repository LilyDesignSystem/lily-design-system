@namespace LilyBlazorHeadless.Components

@*
    TaskListItem component
    a task list item with a checkbox

    Parameters:
        Label — string, required. The task's text.
        Checked / CheckedChanged — two-way (@bind-Checked). Rendered as data-checked.
        Disabled — bool. Rendered as data-disabled.
        CssClass, AdditionalAttributes (spread onto the li).
*@

<li class="@($"task-list-item {CssClass}".Trim())" data-checked="@(Checked ? "true" : "false")" data-disabled="@(Disabled ? "true" : null)" @attributes="AdditionalAttributes">
    <label>
        <input type="checkbox" disabled="@Disabled" @bind:get="Checked" @bind:set="SetCheckedAsync" />
        @Label
    </label>
</li>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task SetCheckedAsync(bool value)
    {
        Checked = value;
        await CheckedChanged.InvokeAsync(value);
    }
}

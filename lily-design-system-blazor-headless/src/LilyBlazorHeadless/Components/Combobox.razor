@namespace LilyBlazorHeadless.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Combobox component

    A headless combobox combining a text input with a dropdown listbox of
    suggestions for autocomplete or type-ahead search experiences. Users type
    into the input to filter suggestions, then select from matching options
    in the dropdown. Commonly used for search fields, address inputs, tag
    selectors, and choosing from large option sets.

    Parameters:
        Label — string, required. Accessible name via aria-label on both
                the input and the listbox.
        Value — string, default "". Bindable current text input value via
                @bind-Value.
        Open — bool, default false. Bindable dropdown visibility state via
               @bind-Open.
        ChildContent — RenderFragment, required. Option elements rendered
                       inside the listbox dropdown.
        CssClass — string, optional. Extra CSS classes appended to
                   "combobox".
        AdditionalAttributes — captures unmatched attributes onto the root
                               <div>.

    Accessibility:
        - role="combobox" on the input identifies it as a combobox widget
        - aria-expanded reflects the open state for screen readers
        - aria-controls links the input to the associated listbox by id
        - aria-autocomplete="list" indicates suggestions are provided via a list
        - role="listbox" on the dropdown identifies selectable options

    Keyboard:
        - Escape: closes the dropdown listbox

    References:
        - WAI-ARIA Combobox Pattern: https://www.w3.org/WAI/ARIA/apg/patterns/combobox/
*@

<div class="@($"combobox {CssClass}".Trim())" @attributes="AdditionalAttributes">
    <input
        type="text"
        role="combobox"
        aria-label="@Label"
        aria-expanded="@Open.ToString().ToLowerInvariant()"
        aria-controls="@ListboxId"
        aria-autocomplete="list"
        value="@Value"
        @oninput="HandleInput"
        @onkeydown="HandleKeyDown"
    />
    <div role="listbox" id="@ListboxId" aria-label="@Label" popover="manual" @ref="_listbox">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _listbox;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<Combobox>? _self;
    private bool _synced;

    // P16-T4: the listbox is popover="manual", opened from the Open state by the Popover API bridge
    // (Popover.razor.js; the hidden attribute where the API is missing). Skipped during prerender.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", Popover.ModulePath);
            _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _listbox, _self, Open, null);
            _synced = Open;
        }
        else if (_handle is not null && _synced != Open)
        {
            _synced = Open;
            await _handle.InvokeVoidAsync("set", Open);
        }
    }

    /// <summary>Called by the bridge from the toggle event; the state follows the component, so nothing to do.</summary>
    [JSInvokable]
    public Task OnPopoverToggle(bool open) => Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }

    private string ListboxId { get; } = $"combobox-listbox-{Guid.NewGuid().ToString("N")[..8]}";

    private async Task HandleInput(ChangeEventArgs e)
    {
        var next = e.Value?.ToString() ?? "";
        if (Value != next)
        {
            Value = next;
            await ValueChanged.InvokeAsync(next);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && Open)
        {
            Open = false;
            await OpenChanged.InvokeAsync(false);
        }
    }
}

@namespace LilyBlazorHeadless.Components
@inherits ValueInputBase

@*
    TimeInput component
    an input for entering a time value <input type="time">
*@

@* The type is an expression because a literal one makes Razor bind DateTime, and the value is the text the browser holds. *@
<input class="@($"time-input {CssClass}".Trim())" type="@("time")" aria-label="@Label" @bind:get="Value" @bind:set="SetTimeValueAsync" @bind:event="oninput" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

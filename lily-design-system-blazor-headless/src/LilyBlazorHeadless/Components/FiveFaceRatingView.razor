@namespace LilyBlazorHeadless.Components
@using System.Globalization

@*
    FiveFaceRatingView component
    a read-only display of a five-face satisfaction rating

    Parameters, as in Svelte:
        Value — int. The rating, rendered as data-value.
        Label — string, required. The accessible name of the role="img" root.
        Labels — the five faces' text, lowest first; default the numbers 1 to 5. The face for Value is shown.
        ChildContent — when given, replaces the face text.
*@

<span class="@($"five-face-rating-view {CssClass}".Trim())" role="img" aria-label="@Label" data-value="@Value.ToString(CultureInfo.InvariantCulture)" @attributes="AdditionalAttributes">@if (ChildContent is not null)
{
    @ChildContent
}
else
{
    @FaceLabel
}</span>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public IReadOnlyList<string> Labels { get; set; } = ["1", "2", "3", "4", "5"];
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string FaceLabel => Value >= 1 && Value <= Labels.Count ? Labels[Value - 1] : "";
}

@namespace LilyBlazorHeadless.Components

@*
    Character component
    a single character display element
*@

<span class="@($"character {CssClass}".Trim())" role="@(Decorative ? "presentation" : "img")" aria-label="@(Decorative || string.IsNullOrEmpty(Label) ? null : Label)" aria-hidden="@(Decorative ? "true" : null)" @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [Parameter] public string Label { get; set; } = "";
    /// <summary>Adds nothing to the text beside it, so it is hidden from assistive technology.</summary>
    [Parameter] public bool Decorative { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

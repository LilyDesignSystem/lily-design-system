{
  "name": "@lilydesignsystem/nunjucks-link-picker",
  "version": "0.1.1",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System Nunjucks link picker: an icon button (a home icon) opening a disclosure of app-defined page links. Headless, SSR-safe, no CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./template": "./dist/link-picker.njk"
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "bash build.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "nunjucks": "^3.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "nunjucks",
    "link",
    "navigation",
    "home",
    "picker"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-nunjucks-link-picker.git"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

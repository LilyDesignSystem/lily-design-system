{
  "name": "@lilydesignsystem/nunjucks-listbox-behavior",
  "version": "0.1.0",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System Nunjucks shared listbox keyboard behaviour: the WAI-ARIA APG active-descendant contract (clamp, typeahead, paging) factored out of the theme/locale/text-size/motion picker client.js files. Behaviour only, no markup, no CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "bash build.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "nunjucks": "^3.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "nunjucks",
    "listbox",
    "keyboard",
    "aria"
  ],

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@lilydesignsystem/solid-link-picker": ["../lily-design-system-solid-link-picker/index.ts"],
      "@lilydesignsystem/solid-locale-picker": [
        "../lily-design-system-solid-locale-picker/index.ts"
      ],
      "@lilydesignsystem/solid-search-picker": [
        "../lily-design-system-solid-search-picker/index.ts"
      ],
      "@lilydesignsystem/solid-share-picker": ["../lily-design-system-solid-share-picker/index.ts"],
      "@lilydesignsystem/solid-text-size-picker": [
        "../lily-design-system-solid-text-size-picker/index.ts"
      ],
      "@lilydesignsystem/solid-theme-picker": ["../lily-design-system-solid-theme-picker/index.ts"],
      "@lilydesignsystem/solid-time-zone-picker": [
        "../lily-design-system-solid-time-zone-picker/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "dist", "examples", "docs"]
}

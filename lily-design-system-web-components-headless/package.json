{
  "name": "lily-design-system-web-components-headless",
  "version": "0.1.0",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System headless components as native autonomous custom elements (Web Components). Partial catalog (30 of 491, plan P7-T6) proving the pattern: light DOM, zero CSS, WCAG 2.2 AAA target.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/web-components-vite": "^10.5.10",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^30.0.1",
    "storybook": "^10.5.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "web-components",
    "custom-elements",
    "headless",
    "accessibility",
    "wcag",
    "aria",
    "a11y"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-web-components-headless.git"
  },
  "homepage": "https://lilydesignsystem.github.io/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

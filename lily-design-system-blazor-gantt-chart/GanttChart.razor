@namespace LilyDesignSystem.Blazor.Helpers
@using LilyBlazorHeadless.Components

@*
    GanttChart — Blazor helper component.
    Single source of truth: spec/index.md (§1-§10).

    Composes the headless GanttTable family (table/thead/tbody/tr/th/td)
    unmodified, plus the SIBLING DateTimePicker helper — used twice per
    edit session, once for a task's start date and once for its end —
    for keyboard-accessible date editing. WAI-ARIA APG Grid
    roving-tabindex keyboard model, hand-rolled via AdditionalAttributes
    splatting, matching KanbanBoard's own approach (no headless data-grid
    exists yet in this catalog to reuse it from).

    IMPORTANT FINDING (see CHANGELOG.md for the full write-up): the
    Svelte reference's spec anticipated that the headless GanttTableTD
    might expose its own `active` prop overloaded to mean "cell is
    within the task's span" (a real conflict its own headless catalog
    had). This catalog's actual GanttTableTD.razor has NO such
    parameter at all — no `Active`, no roving-tabindex concept of any
    kind, only Label/CssClass/ChildContent/AdditionalAttributes. So
    there is no overload to avoid; `data-in-range` (span membership) and
    `tabindex` (the roving-tabindex cursor; never `aria-selected`, since
    focus is not selection) are both
    just ordinary attributes passed through AdditionalAttributes, kept
    conceptually distinct exactly as the Svelte contract requires.

    A REAL bug was found instead: GanttTableTD.razor hardcodes
    `role="grid"` on its own `<td>` element — invalid ARIA (a grid
    cell's implicit/expected role is "gridcell", not "grid" nested
    inside a grid). Not modified (per this task's instructions); instead
    overridden per-cell to `role="gridcell"` via the same attribute-splat
    last-value-wins mechanism KanbanBoard uses for KanbanTable's
    role="region"/"list"/"listitem".
*@

<div id="@RootId" class="@RootClass" data-readonly="@(Readonly ? "" : null)" @attributes="AdditionalAttributes">
    @{ var parentIds = ParentIds; var collapsedNow = _collapsed; }
    @if (parentIds.Count > 0 && (Labels.ExpandAll is not null || Labels.CollapseAll is not null))
    {
        <div class="gantt-chart-collapse-all" role="group" aria-label="@Label">
            @if (Labels.ExpandAll is not null)
            {
                <button type="button" class="gantt-chart-expand-all-button"
                        disabled="@(CollapsedTaskIds.Count == 0)" @onclick="@(() => SetAllCollapsedAsync(false))">@Labels.ExpandAll</button>
            }
            @if (Labels.CollapseAll is not null)
            {
                <button type="button" class="gantt-chart-collapse-all-button"
                        disabled="@(parentIds.All(id => collapsedNow.Contains(id)))" @onclick="@(() => SetAllCollapsedAsync(true))">@Labels.CollapseAll</button>
            }
        </div>
    }
    @if (Labels.ZoomIn is not null || Labels.ZoomOut is not null)
    {
        <div class="gantt-chart-zoom" role="group" aria-label="@Label">
            @if (Labels.ZoomOut is not null)
            {
                <button type="button" class="gantt-chart-zoom-out-button" aria-label="@Labels.ZoomOut"
                        disabled="@(ZoomIndex <= 0)" @onclick="@(() => ZoomAsync(-1))">&#8722;</button>
            }
            @if (Labels.ZoomIn is not null)
            {
                <button type="button" class="gantt-chart-zoom-in-button" aria-label="@Labels.ZoomIn"
                        disabled="@(ZoomIndex >= ZoomOrder.Length - 1)" @onclick="@(() => ZoomAsync(1))">+</button>
            }
        </div>
    }
    @if (HasExportButtons)
    {
        var exportTasks = ExportTasks();
        <div class="gantt-chart-export" role="group" aria-label="@Labels.Export">
            @if (Labels.ExportCsv is not null)
            {
                <button type="button" class="gantt-chart-export-button" data-gantt-export-format="csv" disabled="@(exportTasks.Count == 0)" @onclick="@(() => RunExportAsync(DataGridExportFormat.Csv))">@Labels.ExportCsv</button>
            }
            @if (Labels.ExportTsv is not null)
            {
                <button type="button" class="gantt-chart-export-button" data-gantt-export-format="tsv" disabled="@(exportTasks.Count == 0)" @onclick="@(() => RunExportAsync(DataGridExportFormat.Tsv))">@Labels.ExportTsv</button>
            }
            @if (Labels.ExportExcel is not null)
            {
                <button type="button" class="gantt-chart-export-button" data-gantt-export-format="xlsx" disabled="@(exportTasks.Count == 0)" @onclick="@(() => RunExportAsync(DataGridExportFormat.Xlsx))">@Labels.ExportExcel</button>
            }
        </div>
    }
    @* The scroll area is structural: a virtualized chart gets a fixed height and renders only the rows in view. *@
    <div id="@ScrollId"
         class="@(Virtualize is not null ? "gantt-chart-scroll" : "gantt-chart-body")"
         style="@(Virtualize is { } vz ? $"height: {vz.Height}px; overflow: auto" : null)"
         @onscroll="OnScrollAsync">
    <GanttTable Label="@Label" aria-rowcount="@(Virtualize is not null ? (Rows.Count + 1).ToString() : null)" @onkeydown="OnGridKeyDown">
        @if (!string.IsNullOrEmpty(Caption))
        {
            <caption>@Caption</caption>
        }
        <GanttTableThead>
            <GanttTableTr>
                <GanttTableTH scope="col">@(Labels.TaskColumnHeader ?? "")</GanttTableTH>
                @foreach (var f in ResolvedFields)
                {
                    <GanttTableTH scope="col" data-field="@f.Id">@f.Header</GanttTableTH>
                }
                @foreach (var column in Columns)
                {
                    var isColumnToday = Today is not null && RangesOverlap(column.Start, column.End, Today, Today);
                    var columnMarkers = MarkersIn(column);
                    <GanttTableTH scope="col"
                                  data-today="@(isColumnToday ? "" : null)"
                                  data-non-working="@(IsNonWorkingColumn(column) ? "" : null)"
                                  data-marker="@MarkerKinds(columnMarkers)">
                        @(Labels.ColumnLabel?.Invoke(column.Start, column.End, TimeUnit) ?? column.Start)
                        @foreach (var marker in columnMarkers)
                        {
                            @if (!string.IsNullOrEmpty(marker.Label))
                            {
                                <span class="gantt-chart-marker-label">@marker.Label</span>
                            }
                        }
                    </GanttTableTH>
                }
            </GanttTableTr>
        </GanttTableThead>
        <GanttTableTbody role="rowgroup">
            @{
                var rows = Rows;
                var columns = Columns;
                var ranges = EffectiveRanges(Tasks);
            }
            @foreach (var item in RenderItems(rows.Count))
            {
                if (item.Row < 0)
                {
                    <tr class="gantt-chart-spacer" aria-hidden="true" style="@($"height: {item.SpacerRows * Virtualize!.RowHeight}px")"><td colspan="@(columns.Count + 1 + ResolvedFields.Count)"></td></tr>
                    continue;
                }
                var rowIndex = item.Row;
                var row = rows[rowIndex];
                var rowNum = rowIndex;
                var range = RangeFor(row.Task, row.HasChildren, ranges);
                var deps = PredecessorLabels(row.Task);
                <GanttTableTr data-task-type="@row.Task.Type"
                              data-critical="@(row.Task.Critical ? "" : null)"
                              data-slack="@(row.Task.Slack?.ToString())"
                              data-task-id="@row.Task.Id"
                              aria-rowindex="@(Virtualize is not null ? (rowIndex + 2).ToString() : null)"
                              data-unscheduled="@(!row.HasChildren && (string.IsNullOrEmpty(row.Task.Start) || string.IsNullOrEmpty(row.Task.End)) ? "" : null)"
                              aria-selected="@(SelectedTaskId == row.Task.Id ? "true" : null)"
                              data-selected="@(SelectedTaskId == row.Task.Id ? "" : null)"
                              @attributes="@(TaskAttributes is not null ? TaskAttributes(row.Task) : null)">
                    @* Depth is data for the consumer's CSS (indentation), never an inline style. *@
                    <GanttTableTH scope="row" data-depth="@row.Depth">
                        @* Gated on Labels.CollapseButton: an unnamed button is worse than none. *@
                        @if (row.HasChildren && Labels.CollapseButton is not null)
                        {
                            var collapsibleTask = row.Task;
                            var isCollapsed = _collapsed.Contains(collapsibleTask.Id);
                            <button type="button"
                                    class="gantt-chart-collapse-button"
                                    aria-expanded="@(!isCollapsed ? "true" : "false")"
                                    aria-label="@Labels.CollapseButton(collapsibleTask, isCollapsed)"
                                    @onclick="@(() => ToggleCollapseAsync(collapsibleTask.Id))">
                                @(isCollapsed ? "▸" : "▾")
                            </button>
                        }
                        @ResolveTaskLabel(row.Task)
                        @if (deps.Count > 0 && Labels.DependencySummary is not null)
                        {
                            <span id="@DependencyId(row.Task.Id)" class="gantt-chart-dependency-summary" hidden>
                                @Labels.DependencySummary(deps)
                            </span>
                        }
                        @if (row.Task.Baseline is not null && Labels.BaselineSummary is not null)
                        {
                            <span id="@BaselineId(row.Task.Id)" class="gantt-chart-baseline-summary" hidden>
                                @Labels.BaselineSummary(ResolveTaskLabel(row.Task), row.Task.Baseline, VarianceDays(row.Task.Baseline, range.End))
                            </span>
                        }
                    </GanttTableTH>
                    @foreach (var f in ResolvedFields)
                    {
                        var field = f;
                        var fieldTask = row.Task;
                        var text = TypedFields.Text(field, fieldTask.Values);
                        var editable = IsFieldEditable(field);
                        var nameId = $"{_baseId}-fn-{fieldTask.Id}-{field.Id}";
                        var valueId = $"{_baseId}-fv-{fieldTask.Id}-{field.Id}";
                        <GanttTableTD role="gridcell" data-field="@field.Id" data-type="@field.Type.ToString().ToLowerInvariant()"
                                      data-align="@(field.Align == DataGridAlign.Default ? null : field.Align.ToString().ToLowerInvariant())">
                            @if (IsEditingField(fieldTask, field))
                            {
                                var draft = _fieldEditing!.Draft;
                                var kind = TypedFields.EditorOf(field);
                                @if (kind == DataGridEditor.Select)
                                {
                                    <select id="@EditorId" class="gantt-chart-field-editor" aria-label="@field.Header"
                                            value="@draft"
                                            @onchange="OnFieldSelectChangedAsync"
                                            @onkeydown="OnFieldEditorKeyDownAsync" @onkeydown:stopPropagation="true"
                                            @onblur="@(() => CommitFieldEditAsync())">
                                        <option value=""></option>
                                        @foreach (var option in field.Options ?? Array.Empty<DataGridOption>())
                                        {
                                            <option value="@option.Id" disabled="@option.Disabled" selected="@(option.Id == draft)">@option.Label</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input id="@EditorId" class="gantt-chart-field-editor"
                                           type="@(kind == DataGridEditor.Number ? "number" : kind == DataGridEditor.Date ? "date" : kind == DataGridEditor.Time ? "time" : "text")"
                                           inputmode="@(kind == DataGridEditor.Number ? "decimal" : null)"
                                           aria-label="@field.Header"
                                           value="@draft"
                                           @oninput="@(e => SetFieldDraft(e.Value?.ToString() ?? ""))"
                                           @onkeydown="OnFieldEditorKeyDownAsync" @onkeydown:stopPropagation="true"
                                           @onblur="@(() => CommitFieldEditAsync())" />
                                }
                            }
                            else if (editable)
                            {
                                <span id="@nameId" hidden>@field.Header</span>
                                <button type="button" class="gantt-chart-field-button" id="@valueId" tabindex="-1" aria-labelledby="@($"{nameId} {valueId}")"
                                        @onclick="@(() => StartFieldEdit(fieldTask, field))">@text</button>
                            }
                            else
                            {
                                @text
                            }
                        </GanttTableTD>
                    }
                    @for (var colIndex = 0; colIndex < columns.Count; colIndex++)
                    {
                        var colNum = colIndex;
                        var column = columns[colNum];
                        var inRange = range.Start != "" && range.End != "" && RangesOverlap(column.Start, column.End, range.Start, range.End);
                        var isMilestone = inRange && range.Start == range.End;
                        var isCellToday = Today is not null && RangesOverlap(column.Start, column.End, Today, Today);
                        var isLeadingCell = inRange && RangesOverlap(column.Start, column.End, range.Start, range.Start);
                        var hasDescribedBy = deps.Count > 0 && Labels.DependencySummary is not null;
                        var isActiveCell = ActiveRow == rowNum && ActiveCol == colNum;
                        var currentTask = row.Task;
                        var hasChildrenForCell = row.HasChildren;
                        <GanttTableTD id="@CellId(rowNum, colNum)"
                                      role="gridcell"
                                      data-row="@rowNum"
                                      data-col="@colNum"
                                      tabindex="@(isActiveCell ? "0" : "-1")"
                                      data-in-range="@(inRange ? "" : null)"
                                      data-milestone="@(isMilestone ? "" : null)"
                                      data-today="@(isCellToday ? "" : null)"
                                      data-non-working="@(IsNonWorkingColumn(column) ? "" : null)"
                                      data-marker="@(MarkersIn(column).Count > 0 ? "" : null)"
                                      aria-describedby="@DescribedBy(currentTask, hasDescribedBy)"
                                      data-baseline="@(HasBaseline(currentTask, column) ? "" : null)"
                                      @ondragover:preventDefault="true"
                                      @ondrop="@(e => OnCellDropAsync(column, e))"
                                      @onclick="@(() => SelectTaskAsync(currentTask.Id))"
                                      @onfocusin="@(() => OnCellFocusIn(rowNum, colNum))">
                            @if (isLeadingCell)
                            {
                                <span class="gantt-chart-bar"
                                      data-percent-complete="@(currentTask.PercentComplete?.ToString() ?? null)"
                                      draggable="@(!hasChildrenForCell && !Readonly ? "true" : null)"
                                      @ondragstart="@(e => OnBarDragStart(currentTask, e))">@if (!hasChildrenForCell && !Readonly)
                                    {
                                        <span class="gantt-chart-bar-handle gantt-chart-bar-handle-start"
                                              draggable="true"
                                              aria-hidden="true"
                                              @ondragstart="@(() => OnHandleDragStart(currentTask, "start"))"
                                              @ondragstart:stopPropagation="true"></span>
                                    }</span>
                            }
                            @if (!hasChildrenForCell && !Readonly && inRange && RangesOverlap(column.Start, column.End, range.End, range.End))
                            {
                                <span class="gantt-chart-bar-handle gantt-chart-bar-handle-end"
                                      draggable="true"
                                      aria-hidden="true"
                                      @ondragstart="@(() => OnHandleDragStart(currentTask, "end"))"
                                      @ondragstart:stopPropagation="true"></span>
                            }
                        </GanttTableTD>
                    }
                </GanttTableTr>
                @if (_editingTaskId == row.Task.Id && CanEdit && Labels.DateTimePickerLabels is not null)
                {
                    var editingTask = row.Task;
                    <tr class="gantt-chart-edit-row">
                        <td colspan="@(columns.Count + 1 + ResolvedFields.Count)">
                            <DateTimePicker Label="@(Labels.StartLabel ?? "")"
                                             InputId="@EditStartInputId"
                                             Labels="@Labels.DateTimePickerLabels"
                                             Mode="DateTimeMode.Date"
                                             @bind-Value="_editStart" />
                            <DateTimePicker Label="@(Labels.EndLabel ?? "")"
                                             Labels="@Labels.DateTimePickerLabels"
                                             Mode="DateTimeMode.Date"
                                             @bind-Value="_editEnd" />
                            @if (!string.IsNullOrEmpty(Labels.PercentLabel))
                            {
                                <label class="gantt-chart-percent-label">
                                    @Labels.PercentLabel
                                    <input class="gantt-chart-percent-input"
                                           type="number" min="0" max="100" step="1"
                                           value="@_editPercent"
                                           @onchange="@(e => _editPercent = e.Value?.ToString() ?? "")" />
                                </label>
                            }
                            <button type="button"
                                    class="gantt-chart-save-button"
                                    disabled="@(string.IsNullOrEmpty(_editStart) || string.IsNullOrEmpty(_editEnd))"
                                    @onclick="@(() => SaveEditAsync(editingTask))">
                                @(Labels.SaveLabel ?? "")
                            </button>
                            <button type="button" class="gantt-chart-cancel-button" @onclick="CancelEdit">
                                @(Labels.CancelLabel ?? "")
                            </button>
                        </td>
                    </tr>
                }
            }
        </GanttTableTbody>
    </GanttTable>
    </div>

    <p class="gantt-chart-status" aria-live="polite">@_statusMessage</p>
</div>

@namespace LilyBlazorHeadless.Components
@inherits ValueInputBase

@*
    OzbekistonJismoniyShaxsningShaxsiyIdentifikatsionRaqamiInput component
    an input for entering Uzbekistan's Personal identification number (JShShIR / PINFL)
*@

<input class="@($"ozbekiston-jismoniy-shaxsning-shaxsiy-identifikatsion-raqami-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" spellcheck="false" @bind:get="Value" @bind:set="SetValueAsync" @bind:event="oninput" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

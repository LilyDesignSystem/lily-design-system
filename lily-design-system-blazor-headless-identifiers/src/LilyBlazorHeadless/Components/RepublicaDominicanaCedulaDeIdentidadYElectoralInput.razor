@namespace LilyBlazorHeadless.Components
@inherits ValueInputBase

@*
    RepublicaDominicanaCedulaDeIdentidadYElectoralInput component
    an input for entering the Dominican Republic's Cédula de Identidad y Electoral
*@

<input class="@($"republica-dominicana-cedula-de-identidad-y-electoral-input {CssClass}".Trim())" type="text" aria-label="@Label" autocomplete="off" spellcheck="false" @bind:get="Value" @bind:set="SetValueAsync" @bind:event="oninput" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

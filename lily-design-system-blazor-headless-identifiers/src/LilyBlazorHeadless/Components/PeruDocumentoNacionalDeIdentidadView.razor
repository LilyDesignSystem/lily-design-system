@namespace LilyBlazorHeadless.Components

@*
    PeruDocumentoNacionalDeIdentidadView component
    a read-only display of Peru's Documento Nacional de Identidad (DNI)
*@

<span class="@($"peru-documento-nacional-de-identidad-view {CssClass}".Trim())" @attributes="AdditionalAttributes">@if (!string.IsNullOrEmpty(Label)) {<span class="screen-reader-span">@($"{Label} ")</span>}@ChildContent</span>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

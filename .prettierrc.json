{
  "printWidth": 100,
  "tabWidth": 4,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["*.md", "*.json", "*.yml", "*.yaml", "*.css", "*.html"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    },
    {
      "files": "lily-design-system-angular-*/**/*.ts",
      "options": {
        "embeddedLanguageFormatting": "off",
        "tabWidth": 2
      }
    }
  ],
  "plugins": ["prettier-plugin-svelte"],
  "singleAttributePerLine": true
}

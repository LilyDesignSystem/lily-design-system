@namespace LilyDesignSystem.Blazor.Helpers
@using LilyBlazorHeadless.Components

@*
    CalendarView — Blazor helper component.
    Single source of truth: the canonical Svelte spec
    (lily-design-system-svelte-calendar/spec/index.md); see this package's
    own spec/index.md for the Blazor differences.

    Composes the headless CalendarTable family unmodified, plus the sibling
    DateTimePicker helper's static civil-date arithmetic. WAI-ARIA APG Grid
    roving-tabindex keyboard model, hand-rolled via AdditionalAttributes
    splatting (CalendarTableTD has no Selected/Today parameter in this
    catalog; tabindex, aria-selected and aria-current are ordinary
    attributes that flow through its @attributes).
*@

<div id="@RootId" class="@RootClass" @attributes="AdditionalAttributes">
    @if (Labels.PeriodTitle is not null || Labels.DayView is not null || Labels.WeekView is not null || Labels.FourWeekView is not null || Labels.MonthView is not null || Labels.AgendaView is not null)
    {
        <div class="calendar-view-toolbar">
            <div class="calendar-view-switcher" role="group">
                @if (Labels.DayView is not null)
                {
                    <button type="button"
                            class="calendar-view-switcher-button calendar-view-switcher-button-day"
                            aria-pressed="@(View == CalendarViewMode.Day ? "true" : "false")"
                            @onclick="@(() => SetViewAsync(CalendarViewMode.Day))">@Labels.DayView</button>
                }
                @if (Labels.WeekView is not null)
                {
                    <button type="button"
                            class="calendar-view-switcher-button calendar-view-switcher-button-week"
                            aria-pressed="@(View == CalendarViewMode.Week ? "true" : "false")"
                            @onclick="@(() => SetViewAsync(CalendarViewMode.Week))">@Labels.WeekView</button>
                }
                @if (Labels.FourWeekView is not null)
                {
                    <button type="button"
                            class="calendar-view-switcher-button calendar-view-switcher-button-four-week"
                            aria-pressed="@(View == CalendarViewMode.FourWeek ? "true" : "false")"
                            @onclick="@(() => SetViewAsync(CalendarViewMode.FourWeek))">@Labels.FourWeekView</button>
                }
                @if (Labels.MonthView is not null)
                {
                    <button type="button"
                            class="calendar-view-switcher-button calendar-view-switcher-button-month"
                            aria-pressed="@(View == CalendarViewMode.Month ? "true" : "false")"
                            @onclick="@(() => SetViewAsync(CalendarViewMode.Month))">@Labels.MonthView</button>
                }
                @if (Labels.AgendaView is not null)
                {
                    <button type="button"
                            class="calendar-view-switcher-button calendar-view-switcher-button-agenda"
                            aria-pressed="@(View == CalendarViewMode.Agenda ? "true" : "false")"
                            @onclick="@(() => SetViewAsync(CalendarViewMode.Agenda))">@Labels.AgendaView</button>
                }
            </div>
            <div class="calendar-view-nav">
                <button type="button"
                        class="calendar-view-previous-button"
                        aria-label="@Labels.Previous?.Invoke(View)"
                        @onclick="@(() => StepViewAsync(-1))">&#8249;</button>
                @if (Labels.PeriodTitle is not null)
                {
                    var (titleStart, titleEnd) = PeriodRange(View, EffectiveAnchor, FirstDay);
                    <span class="calendar-view-title">@Labels.PeriodTitle(View, titleStart, titleEnd)</span>
                }
                @if (Labels.Today is not null)
                {
                    <button type="button"
                            class="calendar-view-today-button"
                            disabled="@string.IsNullOrEmpty(Today)"
                            @onclick="GoTodayAsync">@Labels.Today</button>
                }
                <button type="button"
                        class="calendar-view-next-button"
                        aria-label="@Labels.Next?.Invoke(View)"
                        @onclick="@(() => StepViewAsync(1))">&#8250;</button>
            </div>
        </div>
    }

    @if (HasExportButtons)
    {
        var exportEvents = ExportEvents();
        <div class="calendar-view-export" role="group" aria-label="@Labels.Export">
            @if (Labels.ExportCsv is not null)
            {
                <button type="button" class="calendar-view-export-button" data-calendar-export-format="csv" disabled="@(exportEvents.Count == 0)" @onclick="@(() => RunExportAsync(DataGridExportFormat.Csv))">@Labels.ExportCsv</button>
            }
            @if (Labels.ExportTsv is not null)
            {
                <button type="button" class="calendar-view-export-button" data-calendar-export-format="tsv" disabled="@(exportEvents.Count == 0)" @onclick="@(() => RunExportAsync(DataGridExportFormat.Tsv))">@Labels.ExportTsv</button>
            }
            @if (Labels.ExportExcel is not null)
            {
                <button type="button" class="calendar-view-export-button" data-calendar-export-format="xlsx" disabled="@(exportEvents.Count == 0)" @onclick="@(() => RunExportAsync(DataGridExportFormat.Xlsx))">@Labels.ExportExcel</button>
            }
        </div>
    }

    @if (View == CalendarViewMode.Agenda)
    {
        @* The agenda is a plain list of days, not a grid: ordinary tab stops, no roving cursor. *@
        var agendaEvents = EventsByDay(Events);
        var agendaDays = AgendaDayList(agendaEvents);
        <ol class="calendar-view-agenda" aria-label="@Label">
            @foreach (var agendaDate in agendaDays)
            {
                var d = agendaDate;
                var weekday = DateTimePicker.WeekdayOf(d);
                var dayEvents = agendaEvents.TryGetValue(d, out var agendaList) ? agendaList : (IReadOnlyList<CalendarEvent>)Array.Empty<CalendarEvent>();
                var isToday = !string.IsNullOrEmpty(Today) && d == Today;
                var dayRanges = RangesFor(d);
                <li class="calendar-view-agenda-day"
                    data-date="@d"
                    data-today="@(isToday ? "" : null)"
                    data-weekend="@(WeekendDays?.Contains(weekday) == true ? "" : null)"
                    data-range="@(dayRanges.Count > 0 ? string.Join(" ", dayRanges.Select(x => x.Kind ?? "range")) : null)"
                    aria-current="@(isToday ? "date" : null)">
                    <time class="calendar-view-agenda-date" datetime="@d">@(Labels.Day?.Invoke(d, weekday, false) ?? d)</time>
                    @if (Day is not null)
                    {
                        @Day(new CalendarDayContext
                        {
                            Date = d,
                            Events = dayEvents,
                            VisibleEvents = VisibleEvents(dayEvents),
                            HiddenCount = HiddenCount(dayEvents),
                            EventAttributes = EventAttributes,
                            BeginDrag = BeginEventDrag,
                            IsToday = isToday,
                            OutsidePeriod = false,
                            Selected = false,
                            Disabled = IsDisabledDay(d),
                            InRange = false,
                            Ranges = dayRanges,
                            OpenEvent = OpenEventAsync,
                            FieldText = FieldTextOf,
                        })
                    }
                    else if (dayEvents.Count > 0)
                    {
                        <ul class="calendar-view-agenda-events">
                            @foreach (var calendarEvent in dayEvents)
                            {
                                var ev = calendarEvent;
                                <li data-event-key="@ev.Id">
                                    <button type="button"
                                            class="calendar-view-event"
                                            @onclick="@(() => OpenEventAsync(ev))">@(string.IsNullOrEmpty(ev.Title) ? ev.Id : ev.Title)</button>
                                    @if (ResolvedFields.Count > 0)
                                    {
                                        <span class="calendar-view-event-fields">
                                            @foreach (var f in ResolvedFields)
                                            {
                                                var field = f;
                                                var text = TypedFields.Text(field, ev.Values);
                                                var editable = IsFieldEditable(field);
                                                var nameId = $"{_baseId}-fn-{ev.Id}-{field.Id}";
                                                var valueId = FieldButtonId(ev.Id, field.Id);
                                                if (IsEditingField(ev, field))
                                                {
                                                    var draft = _fieldEditing!.Draft;
                                                    var kind = TypedFields.EditorOf(field);
                                                    <span class="calendar-view-event-field" data-field="@field.Id" data-editing="">
                                                        <span class="calendar-view-event-field-name" id="@nameId">@field.Header</span>@(" ")
                                                        @if (kind == DataGridEditor.Select)
                                                        {
                                                            <select id="@EditorId" class="calendar-view-field-editor" aria-label="@field.Header"
                                                                    value="@draft"
                                                                    @onchange="OnFieldSelectChangedAsync"
                                                                    @onkeydown="OnFieldEditorKeyDownAsync" @onkeydown:stopPropagation="true"
                                                                    @onblur="@(() => CommitFieldEditAsync())">
                                                                <option value=""></option>
                                                                @foreach (var option in field.Options ?? Array.Empty<DataGridOption>())
                                                                {
                                                                    <option value="@option.Id" disabled="@option.Disabled" selected="@(option.Id == draft)">@option.Label</option>
                                                                }
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <input id="@EditorId" class="calendar-view-field-editor"
                                                                   type="@(kind == DataGridEditor.Number ? "number" : kind == DataGridEditor.Date ? "date" : kind == DataGridEditor.Time ? "time" : "text")"
                                                                   inputmode="@(kind == DataGridEditor.Number ? "decimal" : null)"
                                                                   aria-label="@field.Header"
                                                                   value="@draft"
                                                                   @oninput="@(e => SetFieldDraft(e.Value?.ToString() ?? ""))"
                                                                   @onkeydown="OnFieldEditorKeyDownAsync" @onkeydown:stopPropagation="true"
                                                                   @onblur="@(() => CommitFieldEditAsync())" />
                                                        }
                                                    </span>
                                                }
                                                else if (text.Length > 0 || editable)
                                                {
                                                    <span class="calendar-view-event-field" data-field="@field.Id" data-type="@field.Type.ToString().ToLowerInvariant()">
                                                        <span class="calendar-view-event-field-name" id="@nameId">@field.Header</span>@(" ")
                                                        @if (editable)
                                                        {
                                                            <button type="button" class="calendar-view-field-button" id="@valueId" aria-labelledby="@($"{nameId} {valueId}")"
                                                                    @onclick="@(() => StartFieldEdit(ev, field))">@text</button>
                                                        }
                                                        else
                                                        {
                                                            <span class="calendar-view-event-field-value">@text</span>
                                                        }
                                                    </span>
                                                }
                                            }
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ol>
        @if (agendaDays.Count == 0 && Labels.AgendaEmpty is not null)
        {
            <p class="calendar-view-agenda-empty">@Labels.AgendaEmpty</p>
        }
    }
    else
    {
    <CalendarTable Label="@Label" CssClass="calendar-view-table" @onkeydown="OnGridKeyDownAsync">
        <CalendarTableHead>
            <CalendarTableRow>
                @if (ShowWeekNumbers)
                {
                    <CalendarTableTH scope="col" data-week-number-header="">@Labels.WeekNumberHeader</CalendarTableTH>
                }
                @for (var i = 0; i < (View == CalendarViewMode.Day ? 1 : 7); i++)
                {
                    var weekday = View == CalendarViewMode.Day ? DateTimePicker.WeekdayOf(EffectiveAnchor) : (FirstDay + i) % 7;
                    <CalendarTableTH scope="col">
                        @if (Labels.WeekdayAbbr is not null)
                        {
                            <abbr title="@(Labels.Weekday?.Invoke(weekday) ?? Labels.WeekdayAbbr(weekday))">@Labels.WeekdayAbbr(weekday)</abbr>
                        }
                        else if (Labels.Weekday is not null)
                        {
                            @Labels.Weekday(weekday)
                        }
                    </CalendarTableTH>
                }
            </CalendarTableRow>
        </CalendarTableHead>
        <CalendarTableBody>
            @{
                var weeks = Days;
                var eventMap = EventsByDay(Events);
                var cursor = EffectiveCursor(weeks);
            }
            @foreach (var week in weeks)
            {
                <CalendarTableRow>
                    @if (ShowWeekNumbers)
                    {
                        var weekNo = WeekNumberOf(week);
                        <CalendarTableTH scope="row"
                                         data-week-number="@weekNo"
                                         aria-label="@Labels.WeekNumber?.Invoke(weekNo)">@weekNo</CalendarTableTH>
                    }
                    @foreach (var date in week)
                    {
                        var d = date;
                        var outside = IsOutsidePeriod(View, d, AnchorDate);
                        var isToday = !string.IsNullOrEmpty(Today) && d == Today;
                        var disabled = IsDisabledDay(d);
                        var picked = IsPicked(d);
                        var dayEvents = eventMap.TryGetValue(d, out var list) ? list : (IReadOnlyList<CalendarEvent>)Array.Empty<CalendarEvent>();
                        var isCursor = d == cursor;
                        var inRange = InSelectedRange(d);
                        var dayRanges = RangesFor(d);
                        var rangeKinds = dayRanges.Count > 0 ? string.Join(" ", dayRanges.Select(x => x.Kind ?? "range")) : null;
                        <CalendarTableTD id="@CellId(d)"
                                         Label="@Labels.Day?.Invoke(d, DateTimePicker.WeekdayOf(d), outside)"
                                         tabindex="@(isCursor ? "0" : "-1")"
                                         aria-selected="@(isCursor ? "true" : null)"
                                         aria-current="@(isToday ? "date" : null)"
                                         aria-disabled="@(disabled ? "true" : null)"
                                         data-date="@d"
                                         data-outside-period="@(outside ? "" : null)"
                                         data-weekend="@(WeekendDays?.Contains(DateTimePicker.WeekdayOf(d)) == true ? "" : null)"
                                         data-selected="@(picked ? "" : null)"
                                         data-disabled="@(disabled ? "" : null)"
                                         data-in-range="@(inRange ? "" : null)"
                                         data-range-start="@(SelectedRange?.Start == d ? "" : null)"
                                         data-range-end="@(SelectedRange?.End == d ? "" : null)"
                                         data-range="@rangeKinds"
                                         @onclick="@((MouseEventArgs e) => OnDayCellClickAsync(d, e))"
                                         @ondragover:preventDefault="@(_draggingEventId is not null && MoveEvents)"
                                         @ondrop="@(() => OnDayDropAsync(d))">
                            @if (HideOutsideDays && outside)
                            {
                            }
                            else if (Day is not null)
                            {
                                @Day(new CalendarDayContext
                                {
                                    Date = d,
                                    Events = dayEvents,
                                    VisibleEvents = VisibleEvents(dayEvents),
                                    HiddenCount = HiddenCount(dayEvents),
                                    EventAttributes = EventAttributes,
                                    BeginDrag = BeginEventDrag,
                                    IsToday = isToday,
                                    OutsidePeriod = outside,
                                    Selected = picked,
                                    Disabled = disabled,
                                    InRange = inRange,
                                    Ranges = dayRanges,
                                    OpenEvent = OpenEventAsync,
                                    FieldText = FieldTextOf,
                                })
                            }
                            else
                            {
                                @DateTimePicker.ParseIsoDate(d)?.Day
                                @foreach (var calendarEvent in VisibleEvents(dayEvents))
                                {
                                    var ev = calendarEvent;
                                    @if (!string.IsNullOrEmpty(ev.Title))
                                    {
                                        <button type="button"
                                                class="calendar-view-event"
                                                draggable="@(MoveEvents ? "true" : null)"
                                                data-event-id="@(MoveEvents ? ev.Id : null)"
                                                @ondragstart="@(() => OnEventDragStart(ev))"
                                                @onkeydown="@((KeyboardEventArgs e) => OnEventKeyDownAsync(ev, d, e))"
                                                @onclick="@(() => OpenEventAsync(ev))"
                                                @onclick:stopPropagation="true">@ev.Title</button>
                                    }
                                }
                                @if (HiddenCount(dayEvents) > 0 && Labels.MoreEvents is not null)
                                {
                                    var moreDate = d;
                                    <button type="button"
                                            class="calendar-view-more-button"
                                            @onclick="@(() => OnMoreClick.InvokeAsync(moreDate))"
                                            @onclick:stopPropagation="true">@Labels.MoreEvents(HiddenCount(dayEvents), moreDate)</button>
                                }
                            }
                        </CalendarTableTD>
                    }
                </CalendarTableRow>
            }
        </CalendarTableBody>
    </CalendarTable>
    }

    <div class="calendar-view-status" aria-live="polite">@_statusMessage</div>
</div>

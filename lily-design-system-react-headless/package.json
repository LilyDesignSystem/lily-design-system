{
  "name": "lily-design-system-react-headless",
  "version": "0.3.1",
  "description": "A comprehensive headless React component library with 491 accessible, unstyled components for building design systems. Targets WCAG 2.2 AAA.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-react-headless.git"
  },
  "keywords": [
    "react",
    "headless",
    "design-system",
    "components",
    "accessible",
    "wcag",
    "aria",
    "a11y",
    "unstyled",
    "typescript"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  },
  "homepage": "https://lilydesignsystem.github.io/",
  "devDependencies": {
    "@storybook/react-vite": "^9.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^4.0.18",
    "jsdom": "^30.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false
}

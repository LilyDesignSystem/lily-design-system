{
  "name": "lily-design-system-angular-headless",
  "version": "0.2.0",
  "description": "Lily Design System Angular headless component library: all 491 catalog components as standalone, signal-based, OnPush components. Unstyled, accessible, zero CSS. Targets WCAG 2.2 AAA.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "ng-packagr -p ng-package.json",
    "storybook": "ng run lily-design-system-angular-headless:storybook",
    "build-storybook": "ng run lily-design-system-angular-headless:build-storybook"
  },
  "peerDependencies": {
    "@angular/core": ">=20.0.0 <23.0.0",
    "@angular/common": ">=20.0.0 <23.0.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@analogjs/vitest-angular": "^2.7.0",
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular-devkit/build-angular": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@storybook/angular": "^10.5.0",
    "@types/node": "^26.3.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.1.0",
    "rxjs": "^7.8.0",
    "storybook": "^10.5.0",
    "tslib": "^2.7.0",
    "typescript": "~7.0.2",
    "vitest": "^4.0.0",
    "zone.js": "^0.16.2"
  },
  "keywords": [
    "lily",
    "design-system",
    "angular",
    "headless",
    "wcag",
    "aria"
  ],
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-angular-headless.git"
  },
  "homepage": "https://lilydesignsystem.github.io/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  },
  "sideEffects": false
}

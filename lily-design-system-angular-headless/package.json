{
  "name": "@lilydesignsystem/angular-headless",
  "version": "0.7.2",
  "engines": {
    "node": ">=26"
  },
  "description": "Lily Design System Angular headless component library: all 491 catalog components as standalone, signal-based, OnPush components. Unstyled, accessible, zero CSS. Targets WCAG 2.2 AAA.",
  "type": "module",
  "scripts": {
    "test": "vitest run && pnpm run test:prerender",
    "test:prerender": "vitest run --config vitest.prerender.config.ts --silent",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "node generate-index.mjs && ng-packagr -p ng-package.json",
    "storybook": "ng run @lilydesignsystem/angular-headless:storybook",
    "build-storybook": "ng run @lilydesignsystem/angular-headless:build-storybook",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "peerDependencies": {
    "@angular/common": ">=20.0.0 <23.0.0",
    "@angular/core": ">=20.0.0 <23.0.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.4",
    "@analogjs/vitest-angular": "^2.9.4",
    "@angular-devkit/build-angular": "^22.2.5",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@storybook/angular": "^10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.5",
    "rxjs": "^7.8.2",
    "storybook": "^10.6.5",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "zone.js": "^0.16.3"
  },
  "keywords": [
    "lily",
    "design-system",
    "angular",
    "headless",
    "wcag",
    "aria"
  ],
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system.git",
    "directory": "lily-design-system-angular-headless"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  },
  "sideEffects": false
}

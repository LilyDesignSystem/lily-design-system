{
  "name": "lily-design-system-nunjucks-theme-picker",
  "version": "0.1.1",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System Nunjucks theme picker: an icon button opening an APG listbox that swaps a theme stylesheet and sets data-theme. Headless, SSR-safe, no CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./template": "./dist/theme-picker.njk"
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "cd .. && npm run build"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "nunjucks",
    "theme",
    "picker"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",

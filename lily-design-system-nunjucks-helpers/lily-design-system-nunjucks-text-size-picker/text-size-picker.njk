{#
  TextSizePicker macro — icon button that opens a listbox of text sizes.

  HTML tag: <div> (root), <button> + <ul role="listbox">
  CSS class: text-size-picker
  Companion runtime: text-size-picker.client.js

  BREAKING (Unreleased): this macro no longer renders a native
  <select>. It renders an icon button (a bundled stroke-drawn "A" SVG,
  viewBox 0 0 16 16 — reversed 2026-09-16 from the Unicode glyph
  U+0041 LATIN CAPITAL LETTER A) that opens a listbox, matching
  theme-picker and locale-picker. All three helpers are now the same
  shape.

  Params (single `opts` object):
    label         — string, required. aria-label for the button AND the
                    listbox. The button is icon-only, so this is the
                    ONLY accessible name it has.
    sizes         — array<string>, required. Available size slugs.
    value         — string. Initial slug, emitted as
                    data-lily-text-size-picker-value for the client to
                    read.
    defaultValue  — string. Initial slug when nothing else is supplied.
    storageKey    — string. If non-empty, client.js persists to localStorage.
    name          — string. Hidden-input `name` (default "text-size").
    sizeLabels    — object<string,string>. Pretty label per slug.
    id            — string. Id prefix for the listbox and its options.
                    Defaults to "text-size-picker-{name}". Supply an
                    explicit id when rendering two instances that share
                    a `name`.
    classes       — string. Extra CSS classes on the root <div>.
    attributes    — object. Extra HTML attributes spread onto the root.

  There is deliberately NO detection prop. Unlike theme-picker's
  `prefers-color-scheme` and locale-picker's `navigator.languages`,
  the web platform exposes no OS "preferred text size" signal, so
  there is nothing to detect.

  Custom icon: call the macro with a `{% call %}` block and the block
  body replaces the default icon inside the button:

    {% call textSizePicker({label: "Text size", sizes: [...]}) %}
      <svg aria-hidden="true">…</svg>
    {% endcall %}

  Usage:
    {% from "./text-size-picker.njk" import textSizePicker %}
    {{ textSizePicker({
      label: "Text size",
      sizes: ["small", "medium", "large", "x-large"],
      storageKey: "lily-text-size"
    }) }}

  Then load text-size-picker.client.js once and call autoInit().

  NOTE: the button does nothing until text-size-picker.client.js runs.
  See docs/ssr.md — this is a real no-JS regression from the old
  <select>.

  Spec: spec/index.md §4.1 (macro parameters), §4.2 (DOM contract).
#}
{%- macro textSizePicker(opts) -%}
{%- set name = opts.name | default("text-size") -%}
{%- set value = opts.value | default("") -%}
{%- set storageKey = opts.storageKey | default("") -%}
{%- set defaultValue = opts.defaultValue | default("") -%}
{%- set sizeLabels = opts.sizeLabels | default({}) -%}
{%- set id = opts.id | default("text-size-picker-" + name) -%}
{%- set listId = id + "-list" -%}
{#- Server-side selected resolution. localStorage is client-only —
    there is no storage at render time — so the client may correct this
    after hydration; the point is that the server markup always marks
    exactly one option aria-selected. -#}
{%- set fallback = "medium" if "medium" in opts.sizes else opts.sizes[0] -%}
{%- set selected = value or defaultValue or fallback -%}
<div
  class="text-size-picker{% if opts.classes %} {{ opts.classes }}{% endif %}"
  data-lily-text-size-picker-root
  data-lily-text-size-picker-name="{{ name }}"
  data-lily-text-size-picker-storage-key="{{ storageKey }}"
  data-lily-text-size-picker-default-value="{{ defaultValue }}"
  {%- if value %} data-lily-text-size-picker-value="{{ value }}"{% endif %}
  {%- if opts.attributes %}{% for k, v in opts.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
<input type="hidden" name="{{ name }}" value="{{ selected }}" data-lily-text-size-picker-input>
<button type="button" class="text-size-picker-button" aria-label="{{ opts.label }}" aria-haspopup="listbox" aria-expanded="false" aria-controls="{{ listId }}" data-lily-text-size-picker-button>
{%- if caller %}{{ caller() }}{% else %}<svg class="text-size-picker-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="1.05rem" height="1.05rem"><path d="M4 13 7.2 3h1.6L12 13M5.4 9.5h5.2"/></svg>{% endif -%}
</button>
<ul class="text-size-picker-list" id="{{ listId }}" role="listbox" aria-label="{{ opts.label }}" tabindex="-1" hidden data-lily-text-size-picker-list>
{%- for slug in opts.sizes -%}
  <li class="text-size-picker-option" id="{{ id }}-option-{{ loop.index0 }}" role="option" aria-selected="{{ 'true' if slug == selected else 'false' }}" data-value="{{ slug }}">
    {%- if sizeLabels[slug] -%}
      {{ sizeLabels[slug] }}
    {%- else -%}
      {{ slug | replace(r/-/g, " ") | title }}
    {%- endif -%}
  </li>
{%- endfor -%}
</ul>
</div>
{%- endmacro -%}

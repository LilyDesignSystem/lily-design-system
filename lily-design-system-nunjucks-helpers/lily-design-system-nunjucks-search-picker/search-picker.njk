{#
  SearchPicker macro — icon button (a bundled magnifying-glass SVG,
  viewBox 0 0 16 16) that opens a disclosure panel holding a real
  <form role="search">: a type="search" field and, after it, a submit
  button whose visible label is ⏎ (U+23CE RETURN SYMBOL).

  HTML tag: <div> (root), <button> + <div> panel (disclosure, NOT a menu)
  CSS class: search-picker
  Companion runtime: search-picker.client.js

  Like share-picker, this helper owns an ACTION rather than a user
  preference. It applies nothing to the document and persists nothing:
  no localStorage, no data-* on the document root.

  The macro renders the panel `hidden`; search-picker.client.js removes
  that on activation and owns the submit. Submitting cancels the native
  GET (which would send `/?name=value`) and navigates to the bare query,
  `${action}?${encodeURIComponent(query.trim())}` — `foo` goes to
  `/?foo`. See spec/index.md §3.

  Params (single `opts` object):
    label       — string, required. aria-label for the icon button AND
                  the search landmark. The button is icon-only, so this
                  is the ONLY accessible name it has.
    inputLabel  — string, required. aria-label for the search field.
    submitLabel — string, required. aria-label for the ⏎ submit button;
                  the ⏎ itself is aria-hidden.
    placeholder — string. Placeholder for the field. No default (it
                  would be English).
    value       — string. Initial text in the field.
    action      — string, default "/". Path the query is appended to.
    name        — string, default "search". Discriminator used to
                  derive ids.
    id          — string. Id prefix. Defaults to "search-picker-{name}".
                  Supply an explicit id when rendering two instances
                  that share a `name`.
    classes     — string. Extra CSS classes on the root <div>.
    attributes  — object. Extra HTML attributes spread onto the root.

  Custom icon: call the macro with a `{% call %}` block and the block
  body replaces the default icon inside the button. The block receives
  one argument, a render-time snapshot `{open: false, query: value}`
  (the canonical Svelte ChildArgs) — see spec/index.md §3.3:

    {% call(args) searchPicker({label: "Search", …}) %}
      <svg aria-hidden="true">…</svg>
    {% endcall %}

  Usage:
    {% from "./search-picker.njk" import searchPicker %}
    {{ searchPicker({
      label: "Search this site",
      inputLabel: "Search terms",
      submitLabel: "Search"
    }) }}

  Then load search-picker.client.js once and call autoInit().

  Spec: spec/index.md §4.1 (macro parameters), §4.2 (DOM contract).
#}
{%- macro searchPicker(opts) -%}
{%- set name = opts.name | default("search") -%}
{%- set id = opts.id | default("search-picker-" + name) -%}
{%- set panelId = id + "-panel" -%}
{%- set action = opts.action | default("/") -%}
{%- set value = opts.value | default("") -%}
<div
  class="search-picker{% if opts.classes %} {{ opts.classes }}{% endif %}"
  data-lily-search-picker-root
  data-lily-search-picker-name="{{ name }}"
  {%- if opts.attributes %}{% for k, v in opts.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
<button type="button" class="search-picker-button" aria-label="{{ opts.label }}" aria-expanded="false" aria-controls="{{ panelId }}" data-lily-search-picker-button>
{%- if caller %}{{ caller({open: false, query: value}) }}{% else %}<svg class="search-picker-icon" viewBox="0 0 16 16" width="1.05rem" height="1.05rem" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/></svg>{% endif -%}
</button>
<div class="search-picker-panel" id="{{ panelId }}" hidden data-lily-search-picker-panel>
{#- A real search landmark: Return-to-submit, mobile search keyboards and
    form semantics all come from the platform. action/method stay
    truthful even though the client performs the navigation itself. -#}
<form class="search-picker-form" role="search" aria-label="{{ opts.label }}" action="{{ action }}" method="get" data-lily-search-picker-form>
<input class="search-picker-input" id="{{ id }}-input" type="search" aria-label="{{ opts.inputLabel }}"{% if opts.placeholder %} placeholder="{{ opts.placeholder }}"{% endif %}{% if value %} value="{{ value }}"{% endif %} enterkeyhint="search" data-lily-search-picker-input>
{#- ⏎ is the visible label only; the accessible name is submitLabel. -#}
<button type="submit" class="search-picker-submit" aria-label="{{ opts.submitLabel }}" data-lily-search-picker-submit><span class="search-picker-submit-symbol" aria-hidden="true">⏎</span></button>
</form>
</div>
</div>
{%- endmacro -%}

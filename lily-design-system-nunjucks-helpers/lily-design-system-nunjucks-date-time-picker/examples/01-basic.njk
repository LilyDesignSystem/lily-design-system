{# Minimal DateTimePicker: a label, the six always-required labels, an
   initial value, and the three optional labels worth supplying --
   clear (gates the clear button), invalid (gates the refused-input
   live region), instructions (gates the dialog keyboard help).
   `mode` defaults to "date".

   Note the field shows `value` RAW (unformatted) until the client runs
   -- the macro cannot call Intl to format it locale-correctly. See
   ../spec/index.md §3.4 and §5.7.
#}
{% from "date-time-picker.njk" import dateTimePicker %}

{{ dateTimePicker({
    label: "Appointment date",
    labels: {
        previousYear: "Previous year",
        previousMonth: "Previous month",
        nextMonth: "Next month",
        nextYear: "Next year",
        confirm: "Confirm",
        cancel: "Cancel",
        clear: "Clear",
        invalid: "Enter a valid date, for example 21 3 2026",
        instructions: "Use the arrow keys to choose a day, and Enter to confirm"
    },
    value: "2026-08-15",
    min: "2026-01-01",
    name: "appointment"
}) }}

<script type="module">
    import { autoInit } from "/js/date-time-picker.client.js";
    autoInit();
</script>

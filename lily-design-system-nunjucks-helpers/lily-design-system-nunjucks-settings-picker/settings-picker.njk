{#
  SettingsPicker macro — icon button (a bundled cog SVG, viewBox 0 0 16 16) that opens a
  disclosure panel holding whatever the app provides.

  HTML tag: <div> (root), <button> + <div role="group"> (disclosure, NOT a menu)
  CSS class: settings-picker
  Companion runtime: settings-picker.client.js

  It owns an interaction, not a preference: it applies nothing to the document and persists
  nothing. The panel's content is server-rendered and present without JavaScript; the panel
  cannot be opened without it. See docs/ssr.md.

  The panel's content is the `{% call %}` block body (the macro's `caller()`).

  Params (single `opts` object):
    label       — string, required. aria-label for the trigger button AND the panel, and the
                  tooltip text. The button is icon-only, so this is the ONLY accessible name it has.
    iconHtml    — string. Trusted HTML that replaces the default cog icon inside the button.
    open        — boolean. Render the panel open (aria-expanded="true", no hidden attribute).
    name        — string, default "menu". Discriminator used to derive ids.
    id          — string. Id prefix for the panel. Defaults to "settings-picker-{name}". Supply an
                  explicit id when rendering two instances that share a `name`.
    classes     — string. Extra CSS classes on the root <div>.
    attributes  — object. Extra HTML attributes spread onto the root.

  There is NO default content and no English: the package ships no links.

  Usage:
    {% from "./settings-picker.njk" import settingsPicker %}
    {% call settingsPicker({ label: "Settings" }) %}
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about/">About Us</a></li>
      </ul>
    {% endcall %}

  Then load settings-picker.client.js once and call autoInit().

  Spec: spec/index.md §4 (macro parameters, DOM contract).
#}
{%- macro settingsPicker(opts) -%}
{%- set name = opts.name | default("menu") -%}
{%- set id = opts.id | default("settings-picker-" + name) -%}
{%- set panelId = id + "-panel" -%}
<div
  class="settings-picker{% if opts.classes %} {{ opts.classes }}{% endif %}"
  data-lily-settings-picker-root
  data-lily-settings-picker-name="{{ name }}"
  {%- if opts.attributes %}{% for k, v in opts.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
<button type="button" class="settings-picker-button" aria-label="{{ opts.label }}" aria-expanded="{{ 'true' if opts.open else 'false' }}" aria-controls="{{ panelId }}" data-lily-settings-picker-button>
{%- if opts.iconHtml %}{{ opts.iconHtml | safe }}{% else %}<svg class="settings-picker-icon" viewBox="0 0 16 16" width="1.05rem" height="1.05rem" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6.7 3.3L7.0 1.4L9.0 1.4L9.3 3.3L10.5 3.8L11.9 2.6L13.4 4.1L12.2 5.6L12.7 6.7L14.6 7.0L14.6 9.0L12.7 9.3L12.2 10.4L13.4 11.9L11.9 13.4L10.5 12.2L9.3 12.7L9.0 14.6L7.0 14.6L6.7 12.7L5.6 12.2L4.1 13.4L2.6 11.9L3.8 10.4L3.3 9.3L1.4 9.0L1.4 7.0L3.3 6.7L3.8 5.5L2.6 4.1L4.1 2.6L5.5 3.8Z"/><circle cx="8" cy="8" r="2.2"/></svg>{% endif -%}
</button>
<div class="settings-picker-tooltip" role="tooltip" id="{{ id }}-tooltip" hidden>{{ opts.label }}</div>
{#- A named group, not a menu: the content is the app's. -#}
<div class="settings-picker-panel" id="{{ panelId }}" role="group" aria-label="{{ opts.label }}"{% if not opts.open %} hidden{% endif %} data-lily-settings-picker-panel>
{%- if caller %}{{ caller() }}{% endif -%}
</div>
</div>
{%- endmacro -%}

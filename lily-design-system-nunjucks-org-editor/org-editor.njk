{#
  OrgEditor macro — a <textarea> with a toolbar of buttons that write Emacs Org mode
  into it: text effects, headings, tasks, priorities, planning, properties, drawers and
  contacts. The value is plain text, so it submits with the form and works without
  JavaScript (the buttons simply do nothing until the client script runs; the text is
  still editable).

  HTML tag: <div> (root), <div role="toolbar">, <button>, <textarea>
  CSS class: org-editor
  Companion runtime: org-editor.client.js

  Params (single `opts` object):
    label         — string, required. Accessible name of the textarea.
    toolbarLabel  — string, required. Accessible name of the toolbar.
    labels        — object, required. Accessible name per tool (heading, promote, demote,
                    todo, priority, scheduled, deadline, timestamp, bold, italic, underline,
                    strikethrough, code, verbatim, link, bulletList, numberedList, checkbox,
                    quote, sourceBlock, property, drawer, contact). A tool with no name is not rendered.
    tools         — array of tool ids, default all 23, in this order.
    headingLevel  — 1 to 6, default 1.
    todoKeywords, priorities, contactProperties — arrays (the cycles / the properties).
    today         — "YYYY-MM-DD", default the local date when a tool runs.
    propertyKey, drawerName — strings.
    value         — string, the initial text.
    name, id, rows, placeholder — passed to the textarea.
    disabled, readonly, required — booleans.
    classes       — string, appended to `org-editor`.
    attributes    — object, extra attributes on the root.

  Usage:
    {% from "org-editor.njk" import orgEditor %}
    {{ orgEditor({ label: "Notes", toolbarLabel: "Formatting", name: "notes",
                   labels: { todo: "Task", bold: "Bold" } }) }}
#}
{%- set _icons = {
  heading: "M3 3v10M13 3v10M3 8h10",
  promote: "M13 8H3M7 4 3 8l4 4",
  demote: "M3 8h10M9 4l4 4-4 4",
  todo: "M3 3h10v10H3zM5.5 8l2 2 3-4",
  priority: "M5.5 3 4.5 13M11.5 3l-1 10M2.5 6h11M2 10h11",
  scheduled: "M2.5 4h11v9.5h-11zM2.5 7h11M5 2.5v3M11 2.5v3",
  deadline: "M4 14V2.5M4 3h8l-1.5 2.5L12 8H4",
  timestamp: "M8 2.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11zM8 5v3l2 1.5",
  bold: "M4.5 3h4a2.5 2.5 0 0 1 0 5h-4zM4.5 8h5a2.5 2.5 0 0 1 0 5h-5z",
  italic: "M10 3H6.5M9.5 13H6M9 3 7 13",
  underline: "M4.5 3v5a3.5 3.5 0 0 0 7 0V3M3 14h10",
  strikethrough: "M2.5 8h11M10.5 5.2C10 4 9 3.5 8 3.5c-1.5 0-2.5.8-2.5 2 0 1 .6 1.6 2.5 2M6 11c.4.9 1.2 1.5 2.2 1.5 1.5 0 2.5-.8 2.5-2",
  code: "M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5",
  verbatim: "M3 6h10M3 10h10",
  link: "M6.5 9.5a2.5 2.5 0 0 0 3.5 0l2-2a2.5 2.5 0 0 0-3.5-3.5l-.7.7M9.5 6.5a2.5 2.5 0 0 0-3.5 0l-2 2a2.5 2.5 0 0 0 3.5 3.5l.7-.7",
  bulletList: "M6 4h8M6 8h8M6 12h8M2.5 4h.01M2.5 8h.01M2.5 12h.01",
  numberedList: "M7 4h7M7 8h7M7 12h7M2.5 3 3.5 2.5V6M2.5 9.5c.5-1 2-.8 2 .2 0 .8-1.5 1.3-2 2.3h2",
  checkbox: "M2.5 2.5h5v5h-5zM9.5 5h4M2.5 9.5h5v5h-5zM9.5 12h4",
  quote: "M3 4v8M6.5 5h7M6.5 8h7M6.5 11h5",
  sourceBlock: "M2 3h12v10H2zM6 6 4.5 8 6 10M10 6l1.5 2L10 10",
  property: "M2.5 5h4M2.5 8h4M2.5 11h4M8.5 5h5M8.5 8h5M8.5 11h5",
  drawer: "M2.5 3h11v4h-11zM2.5 9h11v4h-11zM6.5 5h3M6.5 11h3",
  contact: "M8 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM3 14c.5-3 2.5-4.5 5-4.5s4.5 1.5 5 4.5"
} -%}
{%- set _groups = {
  heading: "structure",
  promote: "structure",
  demote: "structure",
  bulletList: "structure",
  numberedList: "structure",
  checkbox: "structure",
  quote: "structure",
  sourceBlock: "structure",
  todo: "task",
  priority: "task",
  scheduled: "task",
  deadline: "task",
  timestamp: "task",
  bold: "text",
  italic: "text",
  underline: "text",
  strikethrough: "text",
  code: "text",
  verbatim: "text",
  link: "text",
  property: "data",
  drawer: "data",
  contact: "data"
} -%}
{%- macro orgEditor(opts) -%}
{%- set o = opts | default({}) -%}
{%- set tools = o.tools | default(["heading", "promote", "demote", "todo", "priority", "scheduled", "deadline", "timestamp", "bold", "italic", "underline", "strikethrough", "code", "verbatim", "link", "bulletList", "numberedList", "checkbox", "quote", "sourceBlock", "property", "drawer", "contact"]) -%}
{%- set labels = o.labels | default({}) -%}
{%- set textareaId = o.id | default("org-editor") -%}
<div class="org-editor{% if o.classes %} {{ o.classes }}{% endif %}" data-lily-org-editor data-heading-level="{{ o.headingLevel | default(1) }}"
  {%- if o.todoKeywords %} data-todo-keywords="{{ o.todoKeywords | join(' ') }}"{% endif %}
  {%- if o.priorities %} data-priorities="{{ o.priorities | join(' ') }}"{% endif %}
  {%- if o.contactProperties %} data-contact-properties="{{ o.contactProperties | join(' ') }}"{% endif %}
  {%- if o.today %} data-today="{{ o.today }}"{% endif %}
  {%- if o.propertyKey %} data-property-key="{{ o.propertyKey }}"{% endif %}
  {%- if o.drawerName %} data-drawer-name="{{ o.drawerName }}"{% endif %}
  {%- if o.attributes %}{% for k, v in o.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}>
  <div class="org-editor-toolbar" role="toolbar" aria-orientation="horizontal" aria-label="{{ o.toolbarLabel }}" aria-controls="{{ textareaId }}">
    {%- set first = true -%}
    {%- for tool in tools %}{% if labels[tool] %}
    <button class="org-editor-button" type="button" data-tool="{{ tool }}" data-group="{{ _groups[tool] }}" aria-label="{{ labels[tool] }}" tabindex="{{ 0 if first else -1 }}"{% if o.disabled %} disabled{% endif %}{% if o.readonly %} aria-disabled="true"{% endif %}>
      <svg class="org-editor-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="1.05rem" height="1.05rem"><path d="{{ _icons[tool] }}"></path></svg>
    </button>
    {%- set first = false -%}
    {% endif %}{% endfor %}
  </div>
  <textarea class="org-editor-textarea" id="{{ textareaId }}" aria-label="{{ o.label }}"
    {%- if o.name %} name="{{ o.name }}"{% endif %}
    {%- if o.rows %} rows="{{ o.rows }}"{% endif %}
    {%- if o.placeholder %} placeholder="{{ o.placeholder }}"{% endif %}
    {%- if o.disabled %} disabled{% endif %}
    {%- if o.readonly %} readonly{% endif %}
    {%- if o.required %} required{% endif %}>{{ o.value }}</textarea>
</div>
{%- endmacro -%}

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tests live next to the code, in ../LocaleTranslationsTests.cs, and are excluded from the published package. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LilyDesignSystem.Blazor.LocaleTranslations.Tests</RootNamespace>
    <AssemblyName>LilyDesignSystem.Blazor.LocaleTranslations.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LilyDesignSystem.Blazor.LocaleTranslations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LocaleTranslationsTests.cs" />
  </ItemGroup>

</Project>

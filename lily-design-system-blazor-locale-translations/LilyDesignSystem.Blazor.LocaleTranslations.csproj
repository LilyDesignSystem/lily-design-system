<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LilyDesignSystem.Blazor.LocaleTranslations</RootNamespace>
    <AssemblyName>LilyDesignSystem.Blazor.LocaleTranslations</AssemblyName>
    <PackageId>LilyDesignSystem.Blazor.LocaleTranslations</PackageId>
    <Version>0.2.0</Version>
    <Authors>Joel Parker Henderson</Authors>
    <Description>Lily Design System locale translations for Blazor: the 46 per-locale label packs (data grid, kanban board, calendar, Gantt chart, filter) embedded as resources, with each language's endonym and exonyms. Pairs with LabelPack.FromJson in the helper packages.</Description>
    <PackageProjectUrl>https://lilydesignsystem.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LilyDesignSystem/lily-design-system</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>lily;design-system;blazor;i18n;l10n;translations;accessibility</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The packs are edited in shared/ and copied into the npm package; this package embeds that copy, so there is one set of files. -->
  <ItemGroup>
    <EmbeddedResource Include="..\lily-design-system-locale-translations\label-packs\*.json" LogicalName="LocaleTranslations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**/*Tests.cs" />
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LilyDesignSystem.Blazor.LocaleTranslations.Tests" />
  </ItemGroup>

</Project>

{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@lilydesignsystem/angular-theme-picker": ["./lily-design-system-angular-theme-picker/dist/types/lilydesignsystem-angular-theme-picker.d.ts"],
      "@lilydesignsystem/angular-locale-picker": ["./lily-design-system-angular-locale-picker/dist/types/lilydesignsystem-angular-locale-picker.d.ts"],
      "@lilydesignsystem/angular-text-size-picker": ["./lily-design-system-angular-text-size-picker/dist/types/lilydesignsystem-angular-text-size-picker.d.ts"],
      "@lilydesignsystem/angular-share-picker": ["./lily-design-system-angular-share-picker/dist/types/lilydesignsystem-angular-share-picker.d.ts"],
      "@lilydesignsystem/angular-headless": ["../lily-design-system-angular-headless/dist/types/lilydesignsystem-angular-headless.d.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "include": ["lily-design-system-angular-*/**/*.ts"],
  "exclude": ["**/*.spec.ts", "node_modules", "dist"]
}

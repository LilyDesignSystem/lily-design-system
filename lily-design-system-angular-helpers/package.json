{
  "name": "lily-design-system-angular-helpers",
  "private": true,
  "type": "module",
  "description": "Lily Design System - Angular 20 helpers catalog (dev/test harness)",
  "scripts": {
    "build": "set -e; for d in lily-design-system-angular-*/; do [ -f \"$d/ng-package.json\" ] || continue; echo \"building ${d%/}\"; ng-packagr -p \"$d/ng-package.json\" -c \"$d/tsconfig.lib.json\"; done",
    "build:one": "ng-packagr",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@analogjs/vitest-angular": "^2.7.0",
    "@angular/build": "^22.1.6",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@types/node": "^26.3.0",
    "@vitest/ui": "^4.0.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.1.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.7.0",
    "typescript": "~7.0.2",
    "vitest": "^4.0.0",
    "zone.js": "^0.16.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-angular-helpers.git"
  },
  "homepage": "https://lilydesignsystem.github.io/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

<!-- In your project's src/app.html: data-theme on <html> and the theme's stylesheet in <head>, both filled in by
     hooks.server.ts before the page is sent, so the first paint is already in the chosen theme. For "system" the
     attribute is empty and both stylesheets are linked by media query. -->
<html lang="en" data-theme="%theme%">
  <head>
    %theme-links%
    %sveltekit.head%
  </head>

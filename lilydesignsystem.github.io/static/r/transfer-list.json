    "vue": "lily-design-system-vue-headless/components/TransferList.vue",
    "angular": "lily-design-system-angular-headless/components/TransferList.ts",
    "web-components": "lily-design-system-web-components-headless/components/transfer-list.ts",
    "alpine": "lily-design-system-alpine-headless/components/transfer-list.html",
    "nunjucks": "lily-design-system-nunjucks-headless/components/transfer-list/macro.njk",

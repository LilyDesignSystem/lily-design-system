    "react": "lily-design-system-react-headless/components/MedicationView.tsx",
    "vue": "lily-design-system-vue-headless/components/MedicationView.vue",
    "angular": "lily-design-system-angular-headless/components/MedicationView.ts",
    "web-components": "lily-design-system-web-components-headless/components/medication-view.ts",
    "alpine": "lily-design-system-alpine-headless/components/medication-view.html",
    "nunjucks": "lily-design-system-nunjucks-headless/components/medication-view/macro.njk",
    "blazor": "lily-design-system-blazor-headless/src/LilyBlazorHeadless/Components/MedicationView.razor"
  },

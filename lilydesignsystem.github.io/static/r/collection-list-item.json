    "react": "lily-design-system-react-headless/components/CollectionListItem.tsx",
    "vue": "lily-design-system-vue-headless/components/CollectionListItem.vue",
    "angular": "lily-design-system-angular-headless/components/CollectionListItem.ts",
    "web-components": "lily-design-system-web-components-headless/components/collection-list-item.ts",
    "alpine": "lily-design-system-alpine-headless/components/collection-list-item.html",

{% from "lily-design-system-nunjucks-theme-picker/theme-picker.njk" import themePicker %}
{% from "lily-design-system-nunjucks-locale-picker/locale-picker.njk" import localePicker %}
{% from "lily-design-system-nunjucks-text-size-picker/text-size-picker.njk" import textSizePicker %}
<header class="site-header" role="banner">
  <div class="width-container site-header-inner">
    {# No aria-label: the visible text is the link's name (WCAG 2.5.3 Label in Name). #}
    <a class="site-header-logo" href="/">
      <strong>{{ site.shortName }}</strong>
      <span class="site-header-tagline">Nunjucks example</span>
    </a>
    <nav class="site-header-nav" aria-label="Primary">
      <ul>
        {% for item in site.nav %}
        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <span class="site-header-pickers">
    {{ themePicker({
      label: "Choose a theme",
      themesUrl: "/themes/",
      themes: [
        "united-kingdom-national-health-service-england-for-patients",
        "united-kingdom-national-health-service-england-for-practitioners",
        "united-kingdom-national-health-service-scotland-for-patients",
        "united-kingdom-national-health-service-wales-for-patients",
        "australia-agriculture-design-system",
        "brazil-padrao-digital-de-governo",
        "canada-government-of-canada-design-system",
        "european-union-europa-component-library",
        "japan-digital-agency-design-system",
        "singapore-government-design-system",
        "united-kingdom-government-digital-service",
        "united-states-web-design-system",
        "adobe-spectrum",
        "mozilla-protocol",
        "light",
        "dark"
      ],
      themeLabels: {
        "united-kingdom-national-health-service-england-for-patients": "NHS England (patients)",
        "united-kingdom-national-health-service-england-for-practitioners": "NHS England (practitioners)",
        "united-kingdom-national-health-service-scotland-for-patients": "NHS Scotland (patients)",
        "united-kingdom-national-health-service-wales-for-patients": "NHS Wales (patients)",
        "australia-agriculture-design-system": "AgDS (Australia)",
        "brazil-padrao-digital-de-governo": "gov.br DS",
        "canada-government-of-canada-design-system": "GC Design System",
        "european-union-europa-component-library": "ECL (European Commission)",
        "japan-digital-agency-design-system": "Digital Agency (Japan)",
        "singapore-government-design-system": "SGDS",
        "united-kingdom-government-digital-service": "GOV.UK GDS",
        "united-states-web-design-system": "USWDS",
        "adobe-spectrum": "Adobe Spectrum",
        "mozilla-protocol": "Mozilla Protocol",
        light: "Light",
        dark: "Dark"
      },
      defaultValue: "united-kingdom-national-health-service-england-for-patients",
      storageKey: "lily-theme"
    }) }}
    {{ localePicker({
      label: "Choose a language",
      locales: ["en-GB", "cy-GB", "fr-FR", "ar"],
      localeLabels: {
        "en-GB": "English (UK)",
        "cy-GB": "Cymraeg",
        "fr-FR": "Français",
        "ar": "العربية"
      },
      defaultValue: "en-GB",
      storageKey: "lily-locale"
    }) }}
    {{ textSizePicker({
      label: "Text size",
      sizes: ["small", "medium", "large"],
      sizeLabels: { small: "Small", medium: "Medium", large: "Large" },
      defaultValue: "medium",
      storageKey: "lily-text-size"
    }) }}
    </span>
  </div>
</header>

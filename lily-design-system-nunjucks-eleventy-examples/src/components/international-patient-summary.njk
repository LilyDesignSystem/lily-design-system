{% from "components/international-patient-summary/macro.njk" import internationalPatientSummary %}
{% from "components/international-patient-summary-section/macro.njk" import internationalPatientSummarySection %}
{% from "components/allergy-record-list/macro.njk" import allergyRecordList %}

<h2>A document missing its medication summary</h2>
{% call internationalPatientSummary({
  label: "Patient summary",
  contentsLabel: "Contents",
  omittedLabel: "Section missing from document",
  requiredHeadings: { medications: "Medication summary", allergies: "Allergies and intolerances", problems: "Problem list" },
  sections: [
    { key: "allergies", heading: "Allergies and intolerances", status: "none-known" },
    { key: "problems", heading: "Problem list", status: "not-recorded" }
  ]
}) %}
  {% call internationalPatientSummarySection({ section: "allergies", heading: "Allergies and intolerances", status: "none-known", statusLabel: "No known allergies" }) %}
    {{ allergyRecordList({ status: "none-known", statusLabel: "No known allergies" }) }}
  {% endcall %}
  {{ internationalPatientSummarySection({ section: "problems", heading: "Problem list", status: "not-recorded", statusLabel: "Not recorded" }) }}
{% endcall %}


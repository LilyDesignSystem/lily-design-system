---
layout: layouts/component-demo.njk
title: CandlestickChart
description: a financial chart showing open, high, low and close values for each period as candles
---

{% from "components/candlestick-chart/macro.njk" import candlestickChart %}

<h2>Consumer-supplied svg with a data table alternative</h2>
{% set dataTable %}<table>
  <caption>Candlestick chart data</caption>
  <thead><tr><th scope="col">Name</th><th scope="col">Value</th></tr></thead>
  <tbody><tr><th scope="row">Example</th><td>42</td></tr></tbody>
</table>{% endset %}
{% call candlestickChart({ label: "Candlestick chart example", dataTable: dataTable }) %}
  <svg viewBox="0 0 100 50" width="200" height="100" aria-hidden="true" focusable="false"><circle cx="50" cy="25" r="20"></circle></svg>
{% endcall %}

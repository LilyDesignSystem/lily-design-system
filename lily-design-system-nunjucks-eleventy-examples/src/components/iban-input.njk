{% from "components/iban-input/macro.njk" import ibanInput %}
{% from "components/label/macro.njk" import label %}
{% from "components/field/macro.njk" import field %}

<h2>Default</h2>
{% call field() %}
  {{ label({ for: "iban-input-demo", text: "IBAN" }) }}
  {{ ibanInput({ id: "iban-input-demo" }) }}
{% endcall %}

<h2>Format</h2>
<p>Up to 34 letters and digits: a two-letter country code, two check digits, then the national account number.</p>

<h2>Reference</h2>
<p>See <a href="https://en.wikipedia.org/wiki/International_Bank_Account_Number">IBAN</a>.</p>


---
layout: layouts/component-demo.njk
title: Emoji Character Radio Group
description: a fieldset radio group for selecting an emoji character
---

{% from "components/emoji-character-radio-group/macro.njk" import emojiCharacterRadioGroup %}
{% from "components/emoji-character-radio-input/macro.njk" import emojiCharacterRadioInput %}

<h2>Default</h2>
{% call emojiCharacterRadioGroup({ label: "Your reaction" }) %}
  <div>
    {{ emojiCharacterRadioInput({ id: "emoji-g-0", name: "reaction", value: "😀", label: "Grinning face" }) }}
    <label class="label" for="emoji-g-0"><span aria-hidden="true">😀</span> Grinning face</label>
  </div>
  <div>
    {{ emojiCharacterRadioInput({ id: "emoji-g-1", name: "reaction", value: "🙂", checked: true, label: "Slightly smiling face" }) }}
    <label class="label" for="emoji-g-1"><span aria-hidden="true">🙂</span> Slightly smiling face</label>
  </div>
  <div>
    {{ emojiCharacterRadioInput({ id: "emoji-g-2", name: "reaction", value: "😐", label: "Neutral face" }) }}
    <label class="label" for="emoji-g-2"><span aria-hidden="true">😐</span> Neutral face</label>
  </div>
{% endcall %}


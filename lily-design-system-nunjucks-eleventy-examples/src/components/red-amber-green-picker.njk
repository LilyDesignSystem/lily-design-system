---
layout: layouts/component-demo.njk
title: Red/Amber/Green Picker
description: a picker for selecting a red/amber/green status
---

{% from "components/red-amber-green-picker/macro.njk" import redAmberGreenPicker %}
{% from "components/red-amber-green-picker-button/macro.njk" import redAmberGreenPickerButton %}

<h2>Risk rating</h2>
{% call redAmberGreenPicker({ label: "Risk rating" }) %}
  {{ redAmberGreenPickerButton({ status: "red" }) }}
  {{ redAmberGreenPickerButton({ status: "amber", checked: true }) }}
  {{ redAmberGreenPickerButton({ status: "green" }) }}
{% endcall %}

<h2>Project status</h2>
{% call redAmberGreenPicker({ label: "Project status" }) %}
  {{ redAmberGreenPickerButton({
    status: "red",
    text: "Off track"
  }) }}
  {{ redAmberGreenPickerButton({
    status: "amber",
    text: "At risk",
    checked: true
  }) }}
  {{ redAmberGreenPickerButton({
    status: "green",
    text: "On track"
  }) }}
{% endcall %}

{# BEGIN generated: examples (bin/generate-examples) #}
<h2>Usage</h2>
<pre tabindex="0"><code>{% raw %}&lt;form&gt;
  &lt;fieldset&gt;
    &lt;legend&gt;Sprint 14 Status&lt;/legend&gt;
    &lt;RedAmberGreenPicker label="Overall sprint health"&gt;
      &lt;RedAmberGreenPickerButton value="red" label="Red - Critical" onclick={handleSelect} /&gt;
      &lt;RedAmberGreenPickerButton value="amber" label="Amber - At risk" selected onclick={handleSelect} /&gt;
      &lt;RedAmberGreenPickerButton value="green" label="Green - On track" onclick={handleSelect} /&gt;
    &lt;/RedAmberGreenPicker&gt;
  &lt;/fieldset&gt;
&lt;/form&gt;
{% endraw %}</code></pre>

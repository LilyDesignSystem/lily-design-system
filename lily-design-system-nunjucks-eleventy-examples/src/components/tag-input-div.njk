{% from "components/tag-input-div/macro.njk" import tagInputDiv %}

<p><label for="conditions">Conditions</label></p>
{% macro removeCondition(tag) %}Remove {{ tag }}{% endmacro %}
{{ tagInputDiv({
  removeLabel: removeCondition,
  id: "conditions",
  name: "conditions",
  tags: ["hypertension", "asthma"],
  label: "Add condition",
  placeholder: "Add condition…"
}) }}

{# BEGIN generated: examples (bin/generate-examples) #}
<h2>Usage</h2>
<pre tabindex="0"><code>{% raw %}&lt;TagInputDiv
  label="Add tag"
  bind:value={tagText}
  onadd={(tag) =&gt; { tags = [...tags, tag]; }}
&gt;
  {#each tags as tag}
    &lt;Tag&gt;{tag}&lt;/Tag&gt;
  {/each}
&lt;/TagInputDiv&gt;
{% endraw %}</code></pre>

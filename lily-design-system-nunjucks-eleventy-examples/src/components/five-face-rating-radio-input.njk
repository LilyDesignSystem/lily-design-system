<pre tabindex="0"><code>{% raw %}&lt;label class="label" for="demo-five-face-rating-i-0"&gt;&lt;input class="five-face-rating-radio-input" type="radio" id="demo-five-face-rating-i-0" name="demo-satisfaction" aria-label="Satisfied" value="4" data-value="4" checked /&gt; Satisfied&lt;/label&gt;
{% endraw %}</code></pre>

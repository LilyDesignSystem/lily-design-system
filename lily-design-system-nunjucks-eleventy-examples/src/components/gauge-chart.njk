---
layout: layouts/component-demo.njk
title: GaugeChart
description: a dial chart showing one value within a range
---

{% from "components/gauge-chart/macro.njk" import gaugeChart %}

<h2>Consumer-supplied svg with a data table alternative</h2>
{% set dataTable %}<table>
  <caption>Gauge chart data</caption>
  <thead><tr><th scope="col">Name</th><th scope="col">Value</th></tr></thead>
  <tbody><tr><th scope="row">Example</th><td>42</td></tr></tbody>
</table>{% endset %}
{% call gaugeChart({ label: "Gauge chart example", dataTable: dataTable }) %}
  <svg viewBox="0 0 100 50" width="200" height="100" aria-hidden="true" focusable="false"><circle cx="50" cy="25" r="20"></circle></svg>
{% endcall %}

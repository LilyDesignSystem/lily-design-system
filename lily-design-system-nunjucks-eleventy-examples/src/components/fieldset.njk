{% from "components/fieldset/macro.njk" import fieldset %}

<h2>Default</h2>
{% call fieldset({ legend: "What is your home address?" }) %}
  <div>
    <label for="line1" class="label">Address line 1</label>
    <input id="line1" type="text" class="form">
  </div>
  <div>
    <label for="line2" class="label">Address line 2 (optional)</label>
    <input id="line2" type="text" class="form">
  </div>
  <div>
    <label for="postcode" class="label">Postcode</label>
    <input id="postcode" type="text" class="form">
  </div>
{% endcall %}

<h2>As page heading</h2>
{% call fieldset({ legend: "Contact details", isPageHeading: true }) %}
  <p>Enter at least one way for us to reach you.</p>
{% endcall %}

{# BEGIN generated: examples (bin/generate-examples) #}
<h2>Usage</h2>
<pre tabindex="0"><code>{% raw %}&lt;Fieldset legend="What is your address?"&gt;
  &lt;Field label="Address line 1"&gt;
    &lt;TextInput label="Address line 1" autocomplete="address-line1" /&gt;
  &lt;/Field&gt;
  &lt;Field label="Address line 2 (optional)"&gt;
    &lt;TextInput label="Address line 2" autocomplete="address-line2" /&gt;
  &lt;/Field&gt;
  &lt;Field label="Town or city"&gt;
    &lt;TextInput label="Town or city" autocomplete="address-level2" /&gt;
  &lt;/Field&gt;
  &lt;Field label="Postcode"&gt;
    &lt;TextInput label="Postcode" autocomplete="postal-code" /&gt;
  &lt;/Field&gt;
&lt;/Fieldset&gt;
{% endraw %}</code></pre>

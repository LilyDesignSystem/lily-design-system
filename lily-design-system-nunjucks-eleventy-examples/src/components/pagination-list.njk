<p>The <code>PaginationList</code> is an <code>&lt;ol&gt;</code>
  containing the pagination items. Use inside a
  <a href="/components/pagination-nav/"><code>PaginationNav</code></a>.
  See the <a href="/components/pagination-nav/">PaginationNav demo</a>
  for the composed example.</p>

{# BEGIN generated: examples (bin/generate-examples) #}
<h2>Usage</h2>
<pre tabindex="0"><code>{% raw %}&lt;PaginationNav label="Search results pages"&gt;
  &lt;PaginationList&gt;
    &lt;PaginationListItem&gt;
      &lt;PaginationLink href="/results?page=1" rel="prev"&gt;Previous&lt;/PaginationLink&gt;
    &lt;/PaginationListItem&gt;
    &lt;PaginationListItem&gt;
      &lt;PaginationLink href="/results?page=1" label="Page 1"&gt;1&lt;/PaginationLink&gt;
    &lt;/PaginationListItem&gt;
    &lt;PaginationListItem&gt;
      &lt;PaginationLink href="/results?page=2" label="Page 2" aria-current="page"&gt;2&lt;/PaginationLink&gt;
    &lt;/PaginationListItem&gt;
    &lt;PaginationListItem&gt;
      &lt;PaginationLink href="/results?page=3" label="Page 3"&gt;3&lt;/PaginationLink&gt;
    &lt;/PaginationListItem&gt;
    &lt;PaginationListItem&gt;
      &lt;PaginationLink href="/results?page=3" rel="next"&gt;Next&lt;/PaginationLink&gt;
    &lt;/PaginationListItem&gt;
  &lt;/PaginationList&gt;
&lt;/PaginationNav&gt;
{% endraw %}</code></pre>
{# END generated: examples #}

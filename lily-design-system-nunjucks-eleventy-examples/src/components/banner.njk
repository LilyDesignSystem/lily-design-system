{% from "components/banner/macro.njk" import banner %}
{% from "components/banner-box/macro.njk" import bannerBox %}

<h2>Service availability banner</h2>
{% call banner({ label: "Service availability banner" }) %}
  {% call bannerBox() %}
    <strong>NHS App</strong>
  {% endcall %}
  {% call bannerBox() %}
    Online booking is temporarily unavailable.
    <a href="#">Check status</a>.
  {% endcall %}
{% endcall %}

<h2>Promotional banner</h2>
{% call banner() %}
  {% call bannerBox() %}
    New health checks are now available.
    <a href="#">Find out more</a>.
  {% endcall %}
{% endcall %}

{# BEGIN generated: examples (bin/generate-examples) #}
<h2>Usage</h2>
<pre tabindex="0"><code>{% raw %}&lt;!-- Information banner for a service-wide delay --&gt;
&lt;Banner type="info"&gt;
  &lt;p&gt;You have 7 days left to send your application.
  &lt;a href="/applications"&gt;View application&lt;/a&gt;.&lt;/p&gt;
&lt;/Banner&gt;

&lt;!-- Success banner confirming a completed action --&gt;
&lt;Banner type="success"&gt;
  &lt;p&gt;Patient record for Sarah Mitchell has been updated.&lt;/p&gt;
&lt;/Banner&gt;

&lt;!-- Dismissible warning banner with callback --&gt;
&lt;Banner type="warning" dismissible closeLabel="Dismiss warning" onclose={handleDismiss}&gt;
  &lt;p&gt;Planned maintenance is scheduled for Saturday 12 April from 09:00 to 13:00.&lt;/p&gt;
&lt;/Banner&gt;
{% endraw %}</code></pre>
{# END generated: examples #}

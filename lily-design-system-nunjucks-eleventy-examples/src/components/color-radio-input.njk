---
layout: layouts/component-demo.njk
title: Color Radio Input
description: a radio input for one choice of a color swatch
---

{% from "components/color-radio-group/macro.njk" import colorRadioGroup %}
{% from "components/color-radio-input/macro.njk" import colorRadioInput %}
{% from "components/label/macro.njk" import label %}

<h2>In its group</h2>
{% call colorRadioGroup({ label: "Highlight colour" }) %}
  <div>
    {{ colorRadioInput({ id: "color-i-0", name: "colour", color: "#005eb8", checked: true }) }}
    {{ label({ for: "color-i-0", text: "Blue" }) }}
  </div>
  <div>
    {{ colorRadioInput({ id: "color-i-1", name: "colour", color: "#007f3b" }) }}
    {{ label({ for: "color-i-1", text: "Green" }) }}
  </div>
  <div>
    {{ colorRadioInput({ id: "color-i-2", name: "colour", color: "#d5281b" }) }}
    {{ label({ for: "color-i-2", text: "Red" }) }}
  </div>
{% endcall %}

{# BEGIN generated: examples (bin/generate-examples) #}
<h2>Usage</h2>
<pre tabindex="0"><code>{% raw %}&lt;label class="label" for="demo-color-i-0"&gt;&lt;input class="color-radio-input" type="radio" id="demo-color-i-0" name="demo-colour" aria-label="Blue" value="#005eb8" data-color="#005eb8" style="--color-radio-input-color: #005eb8" checked /&gt; Blue&lt;/label&gt;
{% endraw %}</code></pre>

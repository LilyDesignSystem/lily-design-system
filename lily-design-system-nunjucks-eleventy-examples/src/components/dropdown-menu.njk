{% from "components/dropdown-menu/macro.njk" import dropdownMenu %}

<button type="button" class="button" aria-haspopup="true" aria-controls="actions-menu" command="toggle-popover" commandfor="actions-menu" popovertarget="actions-menu">Actions</button>
{% call dropdownMenu({ id: "actions-menu", label: "Actions" }) %}
  <button type="button" role="menuitem">Edit</button>
  <button type="button" role="menuitem">Duplicate</button>
  <button type="button" role="menuitem">Delete</button>
{% endcall %}


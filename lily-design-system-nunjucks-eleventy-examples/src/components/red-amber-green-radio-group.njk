---
layout: layouts/component-demo.njk
title: Red Amber Green Radio Group
description: a fieldset radio group for selecting a red/amber/green status
---

{% from "components/red-amber-green-radio-group/macro.njk" import redAmberGreenRadioGroup %}
{% from "components/red-amber-green-radio-input/macro.njk" import redAmberGreenRadioInput %}
{% from "components/label/macro.njk" import label %}

<h2>Default</h2>
{% call redAmberGreenRadioGroup({ label: "Project status" }) %}
  <div>
    {{ redAmberGreenRadioInput({ id: "red-amber-green-g-0", name: "status", value: "red" }) }}
    {{ label({ for: "red-amber-green-g-0", text: "Off track" }) }}
  </div>
  <div>
    {{ redAmberGreenRadioInput({ id: "red-amber-green-g-1", name: "status", value: "amber", checked: true }) }}
    {{ label({ for: "red-amber-green-g-1", text: "At risk" }) }}
  </div>
  <div>
    {{ redAmberGreenRadioInput({ id: "red-amber-green-g-2", name: "status", value: "green" }) }}
    {{ label({ for: "red-amber-green-g-2", text: "On track" }) }}
  </div>
{% endcall %}

{# BEGIN generated: examples (bin/generate-examples) #}

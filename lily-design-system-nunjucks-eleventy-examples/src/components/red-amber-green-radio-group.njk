<pre tabindex="0"><code>{% raw %}&lt;fieldset class="red-amber-green-radio-group" role="radiogroup" aria-label="Project status"&gt;&lt;label class="label" for="demo-red-amber-green-g-0"&gt;&lt;input class="red-amber-green-radio-input" type="radio" id="demo-red-amber-green-g-0" name="demo-status" aria-label="Off track" value="red" data-value="red" /&gt; Off track&lt;/label&gt;&lt;label class="label" for="demo-red-amber-green-g-1"&gt;&lt;input class="red-amber-green-radio-input" type="radio" id="demo-red-amber-green-g-1" name="demo-status" aria-label="At risk" value="amber" data-value="amber" checked /&gt; At risk&lt;/label&gt;&lt;label class="label" for="demo-red-amber-green-g-2"&gt;&lt;input class="red-amber-green-radio-input" type="radio" id="demo-red-amber-green-g-2" name="demo-status" aria-label="On track" value="green" data-value="green" /&gt; On track&lt;/label&gt;&lt;/fieldset&gt;
{% endraw %}</code></pre>

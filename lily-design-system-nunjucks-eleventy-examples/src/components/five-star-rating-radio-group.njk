---
layout: layouts/component-demo.njk
title: Five Star Rating Radio Group
description: a fieldset radio group for selecting a 1-5 star rating
---

{% from "components/five-star-rating-radio-group/macro.njk" import fiveStarRatingRadioGroup %}
{% from "components/five-star-rating-radio-input/macro.njk" import fiveStarRatingRadioInput %}
{% from "components/label/macro.njk" import label %}

<h2>Default</h2>
{% call fiveStarRatingRadioGroup({ label: "Rate this service" }) %}
  <div>
    {{ fiveStarRatingRadioInput({ id: "five-star-rating-g-0", name: "rating", value: "1" }) }}
    {{ label({ for: "five-star-rating-g-0", text: "1 star" }) }}
  </div>
  <div>
    {{ fiveStarRatingRadioInput({ id: "five-star-rating-g-1", name: "rating", value: "2" }) }}
    {{ label({ for: "five-star-rating-g-1", text: "2 stars" }) }}
  </div>
  <div>
    {{ fiveStarRatingRadioInput({ id: "five-star-rating-g-2", name: "rating", value: "3" }) }}
    {{ label({ for: "five-star-rating-g-2", text: "3 stars" }) }}
  </div>
  <div>
    {{ fiveStarRatingRadioInput({ id: "five-star-rating-g-3", name: "rating", value: "4", checked: true }) }}
    {{ label({ for: "five-star-rating-g-3", text: "4 stars" }) }}
  </div>
  <div>
    {{ fiveStarRatingRadioInput({ id: "five-star-rating-g-4", name: "rating", value: "5" }) }}
    {{ label({ for: "five-star-rating-g-4", text: "5 stars" }) }}
  </div>
{% endcall %}


{% from "components/autosuggest/macro.njk" import autosuggest %}

<h2>Default</h2>
{{ autosuggest({ id: "service", label: "Find a service", suggestions: [{ value: "gp", label: "GP services" }, { value: "dental", label: "Dentists" }] }) }}

<h2>With accessible label</h2>
{{ autosuggest({ id: "town", label: "Town or city", placeholder: "Start typing", suggestions: [{ value: "cardiff", label: "Cardiff" }] }) }}


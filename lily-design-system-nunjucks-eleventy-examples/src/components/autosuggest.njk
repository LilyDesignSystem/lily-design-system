<h2>Usage</h2>
<pre tabindex="0"><code>{% raw %}&lt;Autosuggest
  label="Find a service"
  bind:value="{query}"
  suggestions="{current}"
  onInput="{handleQuery}"
  onSelect="{handleSelect}"
/&gt;
{% endraw %}</code></pre>

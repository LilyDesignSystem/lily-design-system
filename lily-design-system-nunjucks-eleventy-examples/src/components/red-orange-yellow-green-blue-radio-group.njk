{% from "components/red-orange-yellow-green-blue-radio-group/macro.njk" import redOrangeYellowGreenBlueRadioGroup %}
{% from "components/red-orange-yellow-green-blue-radio-input/macro.njk" import redOrangeYellowGreenBlueRadioInput %}
{% from "components/label/macro.njk" import label %}

<h2>Default</h2>
{% call redOrangeYellowGreenBlueRadioGroup({ label: "Risk level" }) %}
  <div>
    {{ redOrangeYellowGreenBlueRadioInput({ id: "red-orange-yellow-green-blue-g-0", name: "risk", value: "red" }) }}
    {{ label({ for: "red-orange-yellow-green-blue-g-0", text: "Severe" }) }}
  </div>
  <div>
    {{ redOrangeYellowGreenBlueRadioInput({ id: "red-orange-yellow-green-blue-g-1", name: "risk", value: "orange" }) }}
    {{ label({ for: "red-orange-yellow-green-blue-g-1", text: "High" }) }}
  </div>
  <div>
    {{ redOrangeYellowGreenBlueRadioInput({ id: "red-orange-yellow-green-blue-g-2", name: "risk", value: "yellow", checked: true }) }}
    {{ label({ for: "red-orange-yellow-green-blue-g-2", text: "Moderate" }) }}
  </div>
  <div>
    {{ redOrangeYellowGreenBlueRadioInput({ id: "red-orange-yellow-green-blue-g-3", name: "risk", value: "green" }) }}
    {{ label({ for: "red-orange-yellow-green-blue-g-3", text: "Low" }) }}
  </div>
  <div>
    {{ redOrangeYellowGreenBlueRadioInput({ id: "red-orange-yellow-green-blue-g-4", name: "risk", value: "blue" }) }}
    {{ label({ for: "red-orange-yellow-green-blue-g-4", text: "Minimal" }) }}
  </div>
{% endcall %}


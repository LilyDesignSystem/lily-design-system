---
layout: layouts/component-demo.njk
title: Five Face Rating Radio Group
description: a fieldset radio group for selecting a 1-5 satisfaction rating using face labels
---

{% from "components/five-face-rating-radio-group/macro.njk" import fiveFaceRatingRadioGroup %}
{% from "components/five-face-rating-radio-input/macro.njk" import fiveFaceRatingRadioInput %}
{% from "components/label/macro.njk" import label %}

<h2>Default</h2>
{% call fiveFaceRatingRadioGroup({ label: "How satisfied are you?" }) %}
  <div>
    {{ fiveFaceRatingRadioInput({ id: "five-face-rating-g-0", name: "satisfaction", value: "1" }) }}
    {{ label({ for: "five-face-rating-g-0", text: "Very dissatisfied" }) }}
  </div>
  <div>
    {{ fiveFaceRatingRadioInput({ id: "five-face-rating-g-1", name: "satisfaction", value: "2" }) }}
    {{ label({ for: "five-face-rating-g-1", text: "Dissatisfied" }) }}
  </div>
  <div>
    {{ fiveFaceRatingRadioInput({ id: "five-face-rating-g-2", name: "satisfaction", value: "3" }) }}
    {{ label({ for: "five-face-rating-g-2", text: "Neutral" }) }}
  </div>
  <div>
    {{ fiveFaceRatingRadioInput({ id: "five-face-rating-g-3", name: "satisfaction", value: "4", checked: true }) }}
    {{ label({ for: "five-face-rating-g-3", text: "Satisfied" }) }}
  </div>
  <div>
    {{ fiveFaceRatingRadioInput({ id: "five-face-rating-g-4", name: "satisfaction", value: "5" }) }}
    {{ label({ for: "five-face-rating-g-4", text: "Very satisfied" }) }}
  </div>
{% endcall %}

{# BEGIN generated: examples (bin/generate-examples) #}

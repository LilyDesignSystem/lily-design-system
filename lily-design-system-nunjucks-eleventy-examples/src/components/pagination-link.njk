{% from "components/pagination-link/macro.njk" import paginationLink %}

<h2>Page number</h2>
<p>{{ paginationLink({ href: "?page=4", text: "4" }) }}</p>

<h2>Current page</h2>
<p>{{ paginationLink({ href: "?page=2", text: "2", current: true }) }}</p>

<h2>Previous / next</h2>
<p>
  {{ paginationLink({
    href: "?page=1",
    text: "Previous",
    direction: "previous",
    hiddenLabel: "page 1"
  }) }}
  {{ paginationLink({
    href: "?page=3",
    text: "Next",
    direction: "next",
    hiddenLabel: "page 3"
  }) }}
</p>

<p>See the <a href="/components/pagination-nav/">PaginationNav
  demo</a> for the composed example.</p>

{# BEGIN generated: examples (bin/generate-examples) #}
<h2>Usage</h2>
<pre tabindex="0"><code>{% raw %}&lt;PaginationNav label="Pagination"&gt;
  &lt;PaginationList&gt;
    &lt;PaginationListItem&gt;
      &lt;PaginationLink href="/results?page=1" label="Page 1"&gt;1&lt;/PaginationLink&gt;
    &lt;/PaginationListItem&gt;
    &lt;PaginationListItem&gt;
      &lt;PaginationLink href="/results?page=2" label="Page 2" aria-current="page"&gt;2&lt;/PaginationLink&gt;
    &lt;/PaginationListItem&gt;
    &lt;PaginationListItem&gt;
      &lt;PaginationLink href="/results?page=3" label="Page 3"&gt;3&lt;/PaginationLink&gt;
    &lt;/PaginationListItem&gt;
  &lt;/PaginationList&gt;
&lt;/PaginationNav&gt;
{% endraw %}</code></pre>

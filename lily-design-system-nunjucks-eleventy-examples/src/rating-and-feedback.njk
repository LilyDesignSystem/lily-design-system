---
layout: layouts/page.njk
title: Rating and Feedback
---

<div id="success-section" hidden>
      <div class="alert" role="alert" aria-label="Thank you" data-type="success">
        <h2>Thank you!</h2>
        <p>Your feedback has been recorded.</p>
      </div>
      <div>
        <p>Your product rating:</p>
        <p class="five-star-rating-view" role="img" aria-label="Your rating" id="rating-view"></p>
      </div>
    </div>

    <div id="form-section">
      <h1>Feedback</h1>
      <form class="form" aria-label="Feedback form" id="feedback-form">
        <h2>We value your feedback</h2>

        <section class="section">
          <h3>Rate this product</h3>
          <fieldset class="five-star-rating-radio-group" role="radiogroup" aria-label="Product rating" id="star-rating">
            <label class="label" for="stars-1"><input class="five-star-rating-radio-input" type="radio" id="stars-1" name="stars" aria-label="1 star" value="1" data-value="1"> 1 star</label>
            <label class="label" for="stars-2"><input class="five-star-rating-radio-input" type="radio" id="stars-2" name="stars" aria-label="2 stars" value="2" data-value="2"> 2 stars</label>
            <label class="label" for="stars-3"><input class="five-star-rating-radio-input" type="radio" id="stars-3" name="stars" aria-label="3 stars" value="3" data-value="3"> 3 stars</label>
            <label class="label" for="stars-4"><input class="five-star-rating-radio-input" type="radio" id="stars-4" name="stars" aria-label="4 stars" value="4" data-value="4"> 4 stars</label>
            <label class="label" for="stars-5"><input class="five-star-rating-radio-input" type="radio" id="stars-5" name="stars" aria-label="5 stars" value="5" data-value="5"> 5 stars</label>
          </fieldset>
        </section>

        <hr class="separator" aria-label="Section divider">

        <section class="section">
          <h3>How satisfied are you with our service?</h3>
          <fieldset class="five-face-rating-radio-group" role="radiogroup" aria-label="Service satisfaction" id="face-rating">
            <label class="label" for="satisfaction-1"><input class="five-face-rating-radio-input" type="radio" id="satisfaction-1" name="satisfaction" aria-label="Very dissatisfied" value="1" data-value="1"> Very dissatisfied</label>
            <label class="label" for="satisfaction-2"><input class="five-face-rating-radio-input" type="radio" id="satisfaction-2" name="satisfaction" aria-label="Dissatisfied" value="2" data-value="2"> Dissatisfied</label>
            <label class="label" for="satisfaction-3"><input class="five-face-rating-radio-input" type="radio" id="satisfaction-3" name="satisfaction" aria-label="Neutral" value="3" data-value="3"> Neutral</label>
            <label class="label" for="satisfaction-4"><input class="five-face-rating-radio-input" type="radio" id="satisfaction-4" name="satisfaction" aria-label="Satisfied" value="4" data-value="4"> Satisfied</label>
            <label class="label" for="satisfaction-5"><input class="five-face-rating-radio-input" type="radio" id="satisfaction-5" name="satisfaction" aria-label="Very satisfied" value="5" data-value="5"> Very satisfied</label>
          </fieldset>
        </section>

        <hr class="separator" aria-label="Section divider">

        <section class="section">
          <h3>How likely are you to recommend us?</h3>
          <fieldset class="net-promoter-score-radio-group" role="radiogroup" aria-label="Recommendation likelihood" id="nps-rating">
            <label class="label" for="nps-0"><input class="net-promoter-score-radio-input" type="radio" id="nps-0" name="nps" aria-label="0 - Not at all likely" value="0" data-value="0"> 0 - Not at all likely</label>
            <label class="label" for="nps-1"><input class="net-promoter-score-radio-input" type="radio" id="nps-1" name="nps" aria-label="1" value="1" data-value="1"> 1</label>
            <label class="label" for="nps-2"><input class="net-promoter-score-radio-input" type="radio" id="nps-2" name="nps" aria-label="2" value="2" data-value="2"> 2</label>
            <label class="label" for="nps-3"><input class="net-promoter-score-radio-input" type="radio" id="nps-3" name="nps" aria-label="3" value="3" data-value="3"> 3</label>
            <label class="label" for="nps-4"><input class="net-promoter-score-radio-input" type="radio" id="nps-4" name="nps" aria-label="4" value="4" data-value="4"> 4</label>
            <label class="label" for="nps-5"><input class="net-promoter-score-radio-input" type="radio" id="nps-5" name="nps" aria-label="5" value="5" data-value="5"> 5</label>
            <label class="label" for="nps-6"><input class="net-promoter-score-radio-input" type="radio" id="nps-6" name="nps" aria-label="6" value="6" data-value="6"> 6</label>
            <label class="label" for="nps-7"><input class="net-promoter-score-radio-input" type="radio" id="nps-7" name="nps" aria-label="7" value="7" data-value="7"> 7</label>
            <label class="label" for="nps-8"><input class="net-promoter-score-radio-input" type="radio" id="nps-8" name="nps" aria-label="8" value="8" data-value="8"> 8</label>
            <label class="label" for="nps-9"><input class="net-promoter-score-radio-input" type="radio" id="nps-9" name="nps" aria-label="9" value="9" data-value="9"> 9</label>
            <label class="label" for="nps-10"><input class="net-promoter-score-radio-input" type="radio" id="nps-10" name="nps" aria-label="10 - Extremely likely" value="10" data-value="10"> 10 - Extremely likely</label>
          </fieldset>
        </section>

        <hr class="separator" aria-label="Section divider">

        <section class="section">
          <h3>Additional comments</h3>
          <label class="label" for="comments">Comments</label>
          <textarea class="text-area-input" id="comments" aria-label="Comments" rows="4"></textarea>
        </section>

        <button class="button" type="submit" aria-label="Submit Feedback">Submit Feedback</button>
      </form>
    </div>

<script>
(function() {
      'use strict';

      // The ratings are native radios: the browser owns selection and keys.
      document.getElementById("feedback-form").addEventListener("submit", function(e) {
        e.preventDefault();
        var checked = document.querySelector("input[name=\"stars\"]:checked");
        var selectedStar = checked ? parseInt(checked.value, 10) : 0;

        // Show success section with rating view
        var ratingView = document.getElementById('rating-view');
        ratingView.textContent = '';
        ratingView.setAttribute('aria-label', 'Your rating: ' + selectedStar + ' of 5 stars');
        for (var i = 1; i <= 5; i++) {
          var span = document.createElement('span');
          span.textContent = i <= selectedStar ? '\u2605' : '\u2606';
          ratingView.appendChild(span);
        }

        document.getElementById('form-section').hidden = true;
        document.getElementById('success-section').hidden = false;
      });
    })();
</script>


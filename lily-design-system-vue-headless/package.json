{
  "name": "lily-design-system-vue-headless",
  "version": "0.3.1",
  "description": "A comprehensive headless Vue 3 component library with 491 accessible, unstyled components for building design systems. Targets WCAG 2.2 AAA.",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-vue-headless.git"
  },
  "keywords": [
    "public",
    "good",
    "design",
    "system",
    "vue",
    "headless"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  },
  "homepage": "https://lilydesignsystem.github.io/",
  "devDependencies": {
    "@storybook/vue3-vite": "^9.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/ui": "^4.0.18",
    "jsdom": "^30.0.0",
    "storybook": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "vue": "^3.5.41",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "aria-query": "^5.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "flatted@<3.4.0": ">=3.4.0",
      "undici@>=7.0.0 <7.24.0": ">=7.24.0",
      "undici@>=7.17.0 <7.24.0": ">=7.24.0"
    }
  },
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}

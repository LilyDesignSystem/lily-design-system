{
  "name": "@lilydesignsystem/web-components-picker-bar",
  "version": "0.3.0",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System Web Components picker bar: composes lily-link-picker (optional), lily-search-picker, lily-theme-picker, lily-locale-picker, lily-text-size-picker, and lily-share-picker into one page-header row.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lilydesignsystem/web-components-link-picker": "^0.1.0",
    "@lilydesignsystem/web-components-search-picker": "^0.1.0",
    "@lilydesignsystem/web-components-theme-picker": "^0.2.0",
    "@lilydesignsystem/web-components-locale-picker": "^0.2.0",
    "@lilydesignsystem/web-components-text-size-picker": "^0.2.0",
    "@lilydesignsystem/web-components-share-picker": "^0.2.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "html",
    "picker",
    "picker-bar",
    "search",
    "theme",
    "locale",
    "text-size",
    "share"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-web-components-picker-bar.git"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }

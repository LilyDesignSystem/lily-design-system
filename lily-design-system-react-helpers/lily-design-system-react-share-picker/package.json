  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-react-helpers.git",
    "directory": "lily-design-system-react-share-picker"
  },
  "homepage": "https://lilydesignsystem.github.io/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

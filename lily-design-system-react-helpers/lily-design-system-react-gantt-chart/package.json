{
  "name": "@lilydesignsystem/react-gantt-chart",
  "version": "0.1.0",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System React Gantt chart: composes the headless GanttTable family plus two composed date-time-picker instances for keyboard-accessible task editing. Headless, SSR-safe, no CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "cd .. && npm run build"
  },
  "dependencies": {
    "@lilydesignsystem/react-headless": "^0.1.0",
    "@lilydesignsystem/react-date-time-picker": "^0.1.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "react",
    "gantt",
    "chart",
    "grid",
    "schedule"
  ],

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@lilydesignsystem/react-theme-picker": ["./lily-design-system-react-theme-picker/dist/index.d.ts"],
      "@lilydesignsystem/react-locale-picker": ["./lily-design-system-react-locale-picker/dist/index.d.ts"],
      "@lilydesignsystem/react-text-size-picker": ["./lily-design-system-react-text-size-picker/dist/index.d.ts"],
      "@lilydesignsystem/react-share-picker": ["./lily-design-system-react-share-picker/dist/index.d.ts"],
      "@lilydesignsystem/react-date-time-picker": ["./lily-design-system-react-date-time-picker/dist/index.d.ts"],
      "@lilydesignsystem/react-headless": ["../lily-design-system-react-headless/dist/index.d.ts"]
    }
  }
}

{
  "name": "lily-design-system-tooling",
  "private": true,
  "type": "module",
  "description": "Repo-level lint and format tooling only; nothing here is published. Each subproject keeps its own package.json and lockfile.",
  "scripts": {
    "lint": "eslint lily-design-system-svelte-headless/components lily-design-system-react-headless/components lily-design-system-vue-headless/components",
    "format:check": "prettier --check \"lily-design-system-{svelte,react,vue}-headless/components/**/*.{ts,tsx,vue,svelte}\" eslint.config.js package.json .prettierrc.json",
    "format": "prettier --write \"lily-design-system-{svelte,react,vue}-headless/components/**/*.{ts,tsx,vue,svelte}\" eslint.config.js package.json .prettierrc.json"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}

@page "/task-management"
<PageTitle>Task Management — Lily Blazor examples</PageTitle>

@*
    See BookAnAppointment.razor's header comment for the native-attribute
    idiom this page uses. TaskListItem is a plain `<li>` wrapper with no
    Checked of its own, so — like TaskList/RadioGroup elsewhere in this
    app — the page supplies a real CheckboxInput as its content.
*@

<h1>Task Management</h1>

<section class="section">
    <Badge Label="@($"{completedCount} done")" data-status="success">@completedCount done</Badge>
    <Badge Label="@($"{tasks.Count - completedCount} remaining")">@(tasks.Count - completedCount) remaining</Badge>
    <Progress Label="Overall completion" value="@percent" max="100" />
    <p>@percent% complete</p>
</section>

<section class="section">
    <TextInput Label="New task"
               value="@newTitle" @oninput="@((ChangeEventArgs e) => newTitle = e.Value?.ToString() ?? "")" />
    <Button @onclick="AddTask">Add Task</Button>
</section>

<section class="section">
    <Label>
        <CheckboxInput id="show-completed" Label="Show completed tasks"
                       checked="@showCompleted" @onchange="@((ChangeEventArgs e) => showCompleted = (bool)(e.Value ?? false))" />
        Show completed tasks
    </Label>
</section>

<TaskList Label="Project tasks">
    @foreach (var task in VisibleTasks)
    {
        var t = task;
        <TaskListItem Label="@t.Title">
            <Label>
                <CheckboxInput id="@($"task-{t.Id}")" Label="@t.Title"
                               checked="@t.Done" @onchange="@((ChangeEventArgs e) => ToggleTask(t.Id, (bool)(e.Value ?? false)))" />
                @t.Title
            </Label>
        </TaskListItem>
    }
</TaskList>

<section class="section">
    <h2>Priority Overview</h2>
    <Badge Label="@($"{tasks.Count(t => t.Priority == "high")} high")" data-status="error">@tasks.Count(t => t.Priority == "high") high</Badge>
    <Badge Label="@($"{tasks.Count(t => t.Priority == "medium")} medium")" data-status="warning">@tasks.Count(t => t.Priority == "medium") medium</Badge>
    <Badge Label="@($"{tasks.Count(t => t.Priority == "low")} low")" data-status="info">@tasks.Count(t => t.Priority == "low") low</Badge>
</section>

@code {
    private class TaskItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public bool Done { get; set; }
        public string Priority { get; set; } = "medium";
    }

    private List<TaskItem> tasks = new()
    {
        new() { Id = 1, Title = "Set up project repository", Done = true, Priority = "high" },
        new() { Id = 2, Title = "Draft API specification", Done = true, Priority = "high" },
        new() { Id = 3, Title = "Design database schema", Done = false, Priority = "medium" },
        new() { Id = 4, Title = "Write integration tests", Done = false, Priority = "medium" },
        new() { Id = 5, Title = "Prepare deployment scripts", Done = false, Priority = "low" },
    };

    private string newTitle = "";
    private bool showCompleted = true;

    private int completedCount => tasks.Count(t => t.Done);
    private int percent => tasks.Count > 0 ? (int)Math.Round((double)completedCount / tasks.Count * 100) : 0;

    private IEnumerable<TaskItem> VisibleTasks =>
        showCompleted ? tasks : tasks.Where(t => !t.Done);

    private void AddTask()
    {
        if (!string.IsNullOrWhiteSpace(newTitle))
        {
            tasks.Add(new TaskItem
            {
                Id = (int)DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
                Title = newTitle.Trim(),
                Done = false,
                Priority = "medium"
            });
            newTitle = "";
        }
    }

    private void ToggleTask(int id, bool done)
    {
        var task = tasks.FirstOrDefault(t => t.Id == id);
        if (task != null)
            task.Done = done;
    }
}

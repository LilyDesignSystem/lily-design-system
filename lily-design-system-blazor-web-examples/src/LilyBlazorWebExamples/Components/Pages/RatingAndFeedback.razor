@page "/rating-and-feedback"
<PageTitle>Rating And Feedback — Lily Blazor examples</PageTitle>

@*
    See BookAnAppointment.razor's header comment for the native-attribute
    idiom this page uses. The three rating pickers here
    (FiveStarRatingPicker, FiveFaceRatingPicker, NetPromoterScorePicker) are
    thin `<div role="radiogroup">` wrappers with no Value of their own —
    same shape as RadioGroup — so, like RadioGroup, the page supplies the
    actual native RadioInput children.
*@

<h1>Rating and Feedback</h1>

@if (submitted)
{
    <Alert Label="Thank you!">
        <h2>Thank you!</h2>
        <p>Your feedback has been submitted.</p>
        <FiveStarRatingView Label="Your rating">@stars out of 5 stars</FiveStarRatingView>
    </Alert>
}
else
{
    <Form Label="Feedback form" novalidate @onsubmit="HandleSubmit">
        <section class="section">
            <h2>Product Rating</h2>
            <FiveStarRatingPicker Label="Product rating" Name="stars" @bind-Value="stars"
                                  StarLabel="@(n => $"{n} star{(n == 1 ? "" : "s")}")" />
        </section>

        <Separator />

        <section class="section">
            <h2>Service Satisfaction</h2>
            <FiveFaceRatingPicker Label="Service satisfaction" Name="satisfaction" @bind-Value="satisfaction"
                                  Labels="FaceLabels" />
        </section>

        <Separator />

        <section class="section">
            <h2>Recommendation</h2>
            <NetPromoterScorePicker Label="Recommendation likelihood">
                @for (var i = 0; i <= 10; i++)
                {
                    var n = i;
                    <Label>
                        <RadioInput id="@($"nps-{n}")" Label="@n.ToString()" name="nps" value="@n.ToString()"
                                    checked="@(nps == n.ToString())" @onchange="@(() => nps = n.ToString())" />
                        @n
                    </Label>
                }
            </NetPromoterScorePicker>
        </section>

        <Separator />

        <section class="section">
            <h2>Additional Comments</h2>
            <Field Label="Comments">
                <Label For="comment">Comments</Label>
                <TextAreaInput id="comment" Label="Comments"
                               value="@comment" @oninput="@((ChangeEventArgs e) => comment = e.Value?.ToString() ?? "")"
                               rows="4" />
            </Field>
        </section>

        <Button type="submit">Submit Feedback</Button>
    </Form>
}

@code {
    private static readonly string[] FaceLabels =
        { "Very unsatisfied", "Unsatisfied", "Neutral", "Satisfied", "Very satisfied" };

    private int stars;
    private int satisfaction;
    private string? nps;
    private string comment = "";
    private bool submitted;

    private void HandleSubmit()
    {
        submitted = true;
    }
}

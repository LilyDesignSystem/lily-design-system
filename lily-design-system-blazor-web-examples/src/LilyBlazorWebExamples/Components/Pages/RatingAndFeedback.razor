@page "/rating-and-feedback"
<PageTitle>Rating And Feedback — Lily Blazor examples</PageTitle>

@*
    See BookAnAppointment.razor's header comment for the native-attribute
    idiom this page uses. Each rating is a radio group (FiveStarRatingRadioGroup,
    FiveFaceRatingRadioGroup, NetPromoterScoreRadioGroup) holding one native
    radio input per value, which the page supplies.
*@

<h1>Rating and Feedback</h1>

@if (submitted)
{
    <Alert Label="Thank you!">
        <h2>Thank you!</h2>
        <p>Your feedback has been submitted.</p>
        <FiveStarRatingView Label="Your rating" Value="@stars">@stars out of 5 stars</FiveStarRatingView>
    </Alert>
}
else
{
    <Form Label="Feedback form" novalidate @onsubmit="HandleSubmit">
        <section class="section">
            <h2>Product Rating</h2>
            <FiveStarRatingRadioGroup Label="Product rating">
                @foreach (var (value, text) in StarOptions)
                {
                    <label><FiveStarRatingRadioInput Label="@text" name="stars" Value="@value" checked="@(stars.ToString() == value)" onchange="@(EventCallback.Factory.Create<ChangeEventArgs>(this, () => stars = int.Parse(value)))" /> @text</label>
                }
            </FiveStarRatingRadioGroup>
        </section>

        <Separator />

        <section class="section">
            <h2>Service Satisfaction</h2>
            <FiveFaceRatingRadioGroup Label="Service satisfaction">
                @foreach (var (value, text) in FaceOptions)
                {
                    <label><FiveFaceRatingRadioInput Label="@text" name="satisfaction" Value="@value" checked="@(satisfaction.ToString() == value)" onchange="@(EventCallback.Factory.Create<ChangeEventArgs>(this, () => satisfaction = int.Parse(value)))" /> @text</label>
                }
            </FiveFaceRatingRadioGroup>
        </section>

        <Separator />

        <section class="section">
            <h2>Recommendation</h2>
            <NetPromoterScoreRadioGroup Label="Recommendation likelihood">
                @foreach (var (value, text) in NpsOptions)
                {
                    <label><NetPromoterScoreRadioInput Label="@text" name="nps" Value="@value" checked="@(nps.ToString() == value)" onchange="@(EventCallback.Factory.Create<ChangeEventArgs>(this, () => nps = value))" /> @text</label>
                }
            </NetPromoterScoreRadioGroup>
        </section>

        <Separator />

        <section class="section">
            <h2>Additional Comments</h2>
            <Field Label="Comments" InputId="comment">
                <TextAreaInput id="comment" Label="Comments"
                               @bind-Value="comment"
                               rows="4" />
            </Field>
        </section>

        <Button type="submit">Submit Feedback</Button>
    </Form>
}

@code {
    private static readonly (string, string)[] StarOptions =
        Enumerable.Range(1, 5).Select(n => (n.ToString(), n == 1 ? "1 star" : $"{n} stars")).ToArray();
    private static readonly (string, string)[] FaceOptions =
        [("1", "Very unsatisfied"), ("2", "Unsatisfied"), ("3", "Neutral"), ("4", "Satisfied"), ("5", "Very satisfied")];
    private static readonly (string, string)[] NpsOptions =
        Enumerable.Range(0, 11).Select(n => (n.ToString(), n.ToString())).ToArray();

    private int stars;
    private int satisfaction;
    private string nps = "";
    private string comment = "";
    private bool submitted;

    private void HandleSubmit()
    {
        submitted = true;
    }
}

@page "/contact-form"
<PageTitle>Contact Form — Lily Blazor examples</PageTitle>

@*
    See BookAnAppointment.razor's header comment for why this page uses
    lowercase native `value`/`checked` attributes plus `@onchange`/`@oninput`
    directives rather than PascalCase `Value`/`ValueChanged` — the headless
    components here only declare Label/CssClass/AdditionalAttributes, so a
    PascalCase attribute is captured but never wired as real two-way binding.
*@

<h1>Contact Form</h1>

@if (submitted)
{
    <div role="status">
        <h2>Thank you, @data.Name!</h2>
        <p>Your message has been sent. We will get back to you soon.</p>
    </div>
}
else
{
    <Form Label="Contact us" novalidate @onsubmit="HandleSubmit">
        @if (errors.Count > 0)
        {
            <ErrorSummary Label="There is a problem" id="contact-error-summary" tabindex="-1">
                <h2>There is a problem</h2>
                <ul>
                    @foreach (var error in errors)
                    {
                        <li><a href="#@error.Key">@error.Value</a></li>
                    }
                </ul>
            </ErrorSummary>
        }

        <Field Label="Full name" data-required="true">
            <Label For="name">Full name</Label>
            <TextInput id="name" Label="Full name"
                       value="@data.Name" @onchange="@((ChangeEventArgs e) => data.Name = e.Value?.ToString() ?? "")"
                       required />
            @if (GetError("name") is { } nameError)
            {
                <ErrorMessage>@nameError</ErrorMessage>
            }
        </Field>

        <Field Label="Email address" data-required="true">
            <Label For="email">Email address</Label>
            <EmailInput id="email" Label="Email address"
                        value="@data.Email" @onchange="@((ChangeEventArgs e) => data.Email = e.Value?.ToString() ?? "")"
                        required />
            @if (GetError("email") is { } emailError)
            {
                <ErrorMessage>@emailError</ErrorMessage>
            }
        </Field>

        <Field Label="Subject">
            <Label For="subject">Subject</Label>
            <Select id="subject" Label="Subject"
                    value="@data.Subject" @onchange="@((ChangeEventArgs e) => data.Subject = e.Value?.ToString() ?? "general")">
                <Option value="general">General enquiry</Option>
                <Option value="support">Technical support</Option>
                <Option value="billing">Billing</Option>
                <Option value="feedback">Feedback</Option>
            </Select>
        </Field>

        <Field Label="Message" data-required="true">
            <Label For="message">Message</Label>
            <TextAreaInput id="message" Label="Message"
                           value="@data.Message" @oninput="@((ChangeEventArgs e) => data.Message = e.Value?.ToString() ?? "")"
                           rows="5" required />
            @if (GetError("message") is { } messageError)
            {
                <ErrorMessage>@messageError</ErrorMessage>
            }
        </Field>

        <Button type="submit">Send Message</Button>
    </Form>
}

@code {
    private class FormData
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Subject { get; set; } = "general";
        public string Message { get; set; } = "";
    }

    private FormData data = new();
    private Dictionary<string, string> errors = new();
    private bool submitted;

    private string? GetError(string field) =>
        errors.TryGetValue(field, out var msg) ? msg : null;

    private bool Validate()
    {
        errors = new();
        if (string.IsNullOrWhiteSpace(data.Name))
            errors["name"] = "Enter your full name";
        if (string.IsNullOrWhiteSpace(data.Email) || !data.Email.Contains('@'))
            errors["email"] = "Enter a valid email address";
        if (string.IsNullOrWhiteSpace(data.Message))
            errors["message"] = "Enter your message";
        return errors.Count == 0;
    }

    private void HandleSubmit()
    {
        if (Validate())
            submitted = true;
    }
}

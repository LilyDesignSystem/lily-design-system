@namespace LilyDesignSystem.Blazor.Helpers
@using LilyBlazorHeadless.Components

@*
    KanbanBoard — Blazor helper component.
    Single source of truth: spec/index.md (§1-§10).

    Composes the headless KanbanTable family (table/thead/tbody/row/th/td)
    unmodified, plus IconButton/Listbox for a per-card "Move to..." menu —
    the same composition shape theme-picker et al. use for their own
    trigger-button-opens-listbox popup, anchored to a grid cell instead of
    a page header. WAI-ARIA APG Grid roving-tabindex keyboard model,
    hand-rolled (no headless data-grid exists yet in this catalog to reuse
    it from) via AdditionalAttributes splatting: tabindex and
    role are NOT parameters KanbanTableTD exposes, so they are set as
    ordinary unmatched attributes that flow through its own
    `@attributes="AdditionalAttributes"`.

    KanbanTable/KanbanTableBody/KanbanTableTD hardcode role="region" /
    role="list" / role="listitem" respectively (this catalog's headless
    family predates the WAI-ARIA Grid pattern this component needs) — all
    three are overridden to role="grid" / role="rowgroup" / role="gridcell"
    here via the same attribute-splat mechanism, relying on Blazor's
    documented last-attribute-wins merge order (the explicit role in each
    headless component's own markup appears BEFORE its own
    `@attributes="AdditionalAttributes"`, so a caller-supplied `role` in
    AdditionalAttributes always wins). No modification to the headless
    components themselves. See CHANGELOG.md for the full reasoning.
*@

<div id="@RootId" class="@RootClass" data-readonly="@(Readonly ? "" : null)" @attributes="AdditionalAttributes">
    @if (Labels.Search is not null)
    {
        <input type="search"
               class="kanban-board-search"
               aria-label="@Labels.Search"
               value="@SearchValue"
               @oninput="@(async (ChangeEventArgs e) => { SearchValue = e.Value?.ToString() ?? ""; await SearchValueChanged.InvokeAsync(SearchValue); })" />
    }
    <KanbanTable Label="@Label" role="grid" @onkeydown="OnGridKeyDown">
        @if (!string.IsNullOrEmpty(Caption))
        {
            @* KanbanTable has no built-in caption slot; a literal <caption>
               as the table's first child is valid HTML and needs no
               modification to the headless component. *@
            <caption>@Caption</caption>
        }
        <KanbanTableHead>
            <KanbanTableRow>
                @{ var byColumnHead = AllByColumn; var shownHead = CardsByColumn; }
                @foreach (var column in Columns)
                {
                    var count = byColumnHead.TryGetValue(column.Id, out var headList) ? headList.Count : 0;
                    var hiddenCount = count - (shownHead.TryGetValue(column.Id, out var shownList) ? shownList.Count : 0);
                    var overLimit = column.WipLimit is { } limit && count > limit;
                    var columnCollapsed = IsCollapsed(column.Id);
                    <KanbanTableTH scope="col" data-over-limit="@(overLimit ? "" : null)" data-collapsed="@(columnCollapsed ? "" : null)"
                                    data-hidden-count="@(hiddenCount > 0 ? hiddenCount.ToString() : null)"
                                    data-flag="@column.Flag"
                                    data-accent="@column.Accent">
                        @if (Labels.CollapseColumn is not null)
                        {
                            var toggled = column;
                            <button type="button"
                                    class="kanban-board-collapse-button"
                                    aria-expanded="@(columnCollapsed ? "false" : "true")"
                                    aria-label="@Labels.CollapseColumn(toggled, columnCollapsed)"
                                    @onclick="@(() => ToggleCollapsedAsync(toggled))">@(columnCollapsed ? "▸" : "▾")</button>
                        }
                        @column.Title
                        @if (column.Flag is not null)
                        {
                            <span class="kanban-board-column-flag">@column.Flag</span>
                        }
                        @if (ColumnHeader is not null)
                        {
                            @ColumnHeader(new KanbanColumnContext { Column = column, Cards = headList ?? new List<KanbanCard>(), Count = count })
                        }
                        @if (Labels.CardCount is not null)
                        {
                            <span class="kanban-board-count">@Labels.CardCount(count)</span>
                        }
                        @if (overLimit && Labels.OverLimit is not null)
                        {
                            <span class="kanban-board-wip-warning">@Labels.OverLimit(count, column.WipLimit ?? 0)</span>
                        }
                        @if (Labels.AddCard is not null && !Readonly)
                        {
                            var addTo = column;
                            <button type="button"
                                    class="kanban-board-add-button"
                                    aria-label="@Labels.AddCard(addTo)"
                                    @onclick="@(() => OnAddCard.InvokeAsync(addTo.Id))">+</button>
                        }
                    </KanbanTableTH>
                }
            </KanbanTableRow>
        </KanbanTableHead>
        <KanbanTableBody role="rowgroup">
            @{
                var byColumn = CardsByColumn;
                var maxRows = MaxRows(byColumn);
            }
            @for (var rowIndex = 0; rowIndex < maxRows; rowIndex++)
            {
                var row = rowIndex;
                <KanbanTableRow>
                    @for (var colIndex = 0; colIndex < Columns.Count; colIndex++)
                    {
                        var col = colIndex;
                        var column = Columns[col];
                        var card = CardAt(Columns, byColumn, col, row);
                        var isActive = _focusedRow == row && _focusedCol == col;
                        <KanbanTableTD id="@CellId(row, col)"
                                       role="gridcell"
                                       data-row="@row"
                                       data-col="@col"
                                       data-collapsed="@(IsCollapsed(column.Id) ? "" : null)"
                                       data-card-id="@card?.Id"
                                       data-locked="@(card?.Locked == true ? "" : null)"
                                       data-pending="@(card is not null && IsPending(card.Id) ? "" : null)"
                                       aria-busy="@(card is not null && IsPending(card.Id) ? "true" : null)"
                                       data-flag="@card?.Flag"
                                       data-accent="@column.Accent"
                                       data-empty="@(card is null && row == 0 && Labels.EmptyColumn is not null && IsEmptyColumn(column, byColumn) ? "" : null)"
                                       data-drop-target="@(_dropTarget == $"{row}-{col}" ? "" : null)"
                                       aria-describedby="@(card?.Flag is not null ? $"{_baseId}-flag-{card.Id}" : null)"
                                       @attributes="@(card is not null && CardAttributes is not null ? CardAttributes(card) : null)"
                                       tabindex="@(isActive ? "0" : "-1")"
                                       Label="@(card is not null ? ResolveCardLabel(card) : null)"
                                       @ondragover:preventDefault="true"
                                       @ondragenter="@(() => OnColumnDragEnter(row, col))"
                                       @ondrop="@(e => OnColumnDropAsync(column, row, e))"
                                       @onfocusin="@(() => OnCellFocusIn(row, col))">
                            @if (card is not null)
                            {
                                var currentCard = card;
                                @* The card title is a supplementary pointer-drag handle
                                   inside an already-interactive gridcell (role comes
                                   from the parent KanbanTableTD); dragstart here is one
                                   of two equally-real move paths, not the accessible
                                   one — see the move-button/listbox below for that. *@
                                <span class="kanban-board-card-title"
                                      draggable="@(Readonly || currentCard.Locked || currentCard.Draggable == false ? null : "true")"
                                      @ondragstart="@(e => OnCardDragStart(currentCard, e))">
                                    @if (CardTemplate is not null)
                                    {
                                        @CardTemplate(new KanbanCardContext { Card = currentCard, Label = ResolveCardLabel(currentCard), Column = column, Pending = IsPending(currentCard.Id) })
                                    }
                                    else if (currentCard.Href is not null)
                                    {
                                        <a class="kanban-board-card-link" href="@currentCard.Href">@ResolveCardLabel(currentCard)</a>
                                    }
                                    else
                                    {
                                        @ResolveCardLabel(currentCard)
                                    }
                                </span>
                                @if (CardTemplate is null)
                                {
                                    @if (currentCard.Subtitle is not null)
                                    {
                                        <span class="kanban-board-card-subtitle">@currentCard.Subtitle</span>
                                    }
                                    @if (currentCard.Badges is { Count: > 0 })
                                    {
                                        <span class="kanban-board-card-badges">
                                            @foreach (var badge in currentCard.Badges)
                                            {
                                                <span class="kanban-board-card-badge">@badge</span>
                                            }
                                        </span>
                                    }
                                }
                                @if (currentCard.Flag is not null)
                                {
                                    <span class="kanban-board-card-flag" id="@($"{_baseId}-flag-{currentCard.Id}")">@currentCard.Flag</span>
                                }
                                @* Gated on Labels.MoveButton: an unnamed button is worse than
                                   none, and Enter/Space on the cell opens the menu either way. *@
                                @if (Labels.MoveButton is not null && !Readonly && !currentCard.Locked)
                                {
                                    <IconButton @ref="_moveButtonComponents[currentCard.Id]"
                                                BaseCssClass="kanban-board-move-button"
                                                Label="@Labels.MoveButton(currentCard)"
                                                tabindex="-1"
                                                aria-haspopup="listbox"
                                                aria-expanded="@(_openCardId == currentCard.Id ? "true" : "false")"
                                                @onclick="@(() => OnMoveButtonClickAsync(currentCard))">
                                        &#8644;
                                    </IconButton>
                                }
                                @if (_openCardId == currentCard.Id)
                                {
                                    <Listbox @ref="_listComponent"
                                             Label="@(Labels.MoveMenuLabel ?? ResolveCardLabel(currentCard))"
                                             BaseCssClass="kanban-board-move-list"
                                             Navigation="@Listbox.ActiveDescendant"
                                             Clamp="true"
                                             OptionCount="@MoveTargets(currentCard).Count"
                                             OptionId="@MoveOptionId"
                                             @bind-ActiveIndex="_moveActiveIndex"
                                             OnActivate="@(i => MoveCardAsync(currentCard, MoveTargets(currentCard)[i]))"
                                             OnEscape="@(() => CloseMoveMenuAsync())"
                                             OnTabOut="@(() => CloseMoveMenuAsync(false))">
                                        @for (var i = 0; i < MoveTargets(currentCard).Count; i++)
                                        {
                                            var destinationIndex = i;
                                            var destination = MoveTargets(currentCard)[destinationIndex];
                                            <li class="kanban-board-move-option"
                                                id="@MoveOptionId(destinationIndex)"
                                                role="option"
                                                aria-selected="@(destination.Id == currentCard.ColumnId ? "true" : "false")"
                                                aria-disabled="@(IsRefused(currentCard, destination) ? "true" : null)"
                                                data-active="@(destinationIndex == _moveActiveIndex ? "" : null)"
                                                @onclick="@(() => MoveCardAsync(currentCard, destination))">
                                                @destination.Title
                                            </li>
                                        }
                                    </Listbox>
                                }
                            }
                            else if (row == 0 && Labels.EmptyColumn is not null && IsEmptyColumn(column, byColumn))
                            {
                                <span class="kanban-board-empty">@Labels.EmptyColumn(column)</span>
                            }
                        </KanbanTableTD>
                    }
                </KanbanTableRow>
            }
        </KanbanTableBody>
        @if (ColumnFooter is not null)
        {
            var allFoot = AllByColumn;
            <tfoot class="kanban-table-foot">
                <tr class="kanban-table-row">
                    @foreach (var column in Columns)
                    {
                        var footCards = allFoot.TryGetValue(column.Id, out var fl) ? fl : new List<KanbanCard>();
                        <td class="kanban-table-td kanban-board-column-footer" data-accent="@column.Accent">
                            @ColumnFooter(new KanbanColumnContext { Column = column, Cards = footCards, Count = footCards.Count })
                        </td>
                    }
                </tr>
            </tfoot>
        }
    </KanbanTable>

    <p class="kanban-board-status" aria-live="polite">@_statusMessage</p>
</div>

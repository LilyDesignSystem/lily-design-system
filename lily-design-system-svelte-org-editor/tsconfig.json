{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "sourceMap": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "*.config.js",
    "build.js",
    "vitest-setup.js",
    "examples",
    "e2e",
    "playwright.config.ts",
    "docs",
    "**/*.stories.svelte"
  ]
}

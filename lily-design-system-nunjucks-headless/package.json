{
  "name": "lily-design-system-nunjucks-headless",
  "version": "0.1.0",
  "description": "Lily Design System Nunjucks headless components: 491 accessible macro templates (macro.njk per component) for the nunjucks loader path. Zero CSS, zero dependencies. Targets WCAG 2.2 AAA.",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "scripts": {
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@storybook/html-vite": "^9.0.0",
    "jsdom": "^30.0.0",
    "storybook": "^9.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-nunjucks-headless.git"
  },
  "homepage": "https://lilydesignsystem.github.io/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./components/": "./components/",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "components/*/macro.njk",
    "index.md",
    "README.md"
  ],
  "peerDependencies": {
    "nunjucks": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "nunjucks": {
      "optional": true
    }
  }
}

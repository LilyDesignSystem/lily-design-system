{#
  LineChart macro -- a line chart visualization connecting data points to display data.

  A headless wrapper: a <figure> holding a role="img" graphic wrapper around
  the consumer-supplied inline <svg>. No drawing happens in the macro
  (headless). The optional params.dataTable renders the accessible table
  alternative in .line-chart-data-table, a SIBLING of the image wrapper:
  role="img" makes descendants presentational, so a table inside it would be
  invisible to assistive technology.

  HTML tag: <figure> containing <div class="line-chart-graphic" role="img">
  CSS class: line-chart (sub-elements: line-chart-graphic, line-chart-data-table)
  Accessibility:
    - the graphic wrapper carries role="img"; aria-label names it.
    - params.describedBy sets aria-describedby on the graphic wrapper:
      point it at a text description.

  Params:
    label        string   Accessible name (aria-label).
    describedBy  string   id(s) for aria-describedby (on the graphic).
    dataTable    string   Raw HTML for the accessible table alternative.
    id           string   Element id (on the figure).
    classes      string   Consumer-provided extra CSS classes.
    attributes   object   Extra HTML attributes as key/value pairs (on the figure).
    html         string   Raw HTML content (the svg).
    text         string   Plain text content (escaped).

  Usage:
    {% from "components/line-chart/macro.njk" import lineChart %}
    {% call lineChart({ label: "Example", dataTable: "<table>...</table>" }) %}<svg>...</svg>{% endcall %}
#}
{%- macro lineChart(params) -%}
{%- set p = params | default({}) -%}
<figure
  class="line-chart{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  <div
    class="line-chart-graphic"
    role="img"
    {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
    {%- if p.describedBy %} aria-describedby="{{ p.describedBy }}"{% endif %}
  >
    {%- if p.html -%}{{ p.html | safe }}
    {%- elif p.text -%}{{ p.text }}
    {%- elif caller -%}{{ caller() }}
    {%- endif -%}
  </div>
  {%- if p.dataTable %}
  <div class="line-chart-data-table">{{ p.dataTable | safe }}</div>
  {%- endif %}
</figure>
{%- endmacro -%}

{#
  KyprosNationalPassportNumberView macro — a read-only display of Kypros's
    National Passport Number.

  HTML tag: <span>
  CSS class: kypros-national-passport-number-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/kypros-national-passport-number-view/macro.njk" import kyprosNationalPassportNumberView %}
    {{ kyprosNationalPassportNumberView({ value: "sample", label: "National Passport Number" }) }}
#}
{%- macro kyprosNationalPassportNumberView(params) -%}
<span
  class="kypros-national-passport-number-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

{#
  CurrencyInput macro — a currency amount input.

  HTML tag: <input type="text">, as Svelte renders it.
    The currency symbol is the consumer's, outside the field (a Lily
    prefix or a visible label); currencyCode (ISO 4217, required, never
    defaulted) is rendered as data-currency-code.
  CSS class: currency-input

  Params:
    id          string
    name        string
    value       string   Current value.
    label       string   Accessible name (aria-label), or pair a <label for>.
    required    boolean
    disabled    boolean
    invalid     boolean  Sets aria-invalid="true".
    currencyCode string  ISO 4217 code (required).
    classes     string
    attributes  object

  Usage:
    {% from "components/currency-input/macro.njk" import currencyInput %}
    {{ currencyInput({ id: "example", label: "Example" }) }}
#}
{%- macro currencyInput(params) -%}
{%- set p = params | default({}) -%}
<input
  class="currency-input{% if p.classes %} {{ p.classes }}{% endif %}"
  type="text"
  inputmode="decimal"
  {%- if p.currencyCode %} data-currency-code="{{ p.currencyCode }}"{% endif %}
  value="{{ p.value | default('') }}"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.name %} name="{{ p.name }}"{% endif %}
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.required %} required{% endif %}
  {%- if p.disabled %} disabled{% endif %}
  {%- if p.invalid %} aria-invalid="true"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

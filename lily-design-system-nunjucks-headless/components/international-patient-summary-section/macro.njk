{#
  InternationalPatientSummarySection macro — one section of an International Patient Summary (HL7 FHIR IPS, ISO 27269), with its
  LOINC code and a status that is never blank (spec/healthcare-ui).

  HTML tag: <section>
  CSS class: international-patient-summary-section (parts: -heading, -status, -narrative)

  Params:
    section         the IPS section key, such as "allergies" (required); data-section
    heading         the heading, the consumer's words (required)
    headingLevel    2 to 6, default 2
    status          "known" (default) | "none-known" | "not-recorded" | "unavailable" | "omitted"; data-status
    statusLabel     the status in words; shown under the heading for any status but "known"
    code            the LOINC code; default the IPS code for the key; data-code
    required        true / false; default whether the IPS requires the section; data-required
    id              default "international-patient-summary-{section}"
    narrative       the author's narrative, raw HTML the consumer has sanitised, in a <details>
    narrativeLabel  the narrative's summary
    narrativeOpen   open the narrative
    html, classes, attributes

  Body content: the section's entries via caller() or params.html.

  Usage:
    {% from "components/international-patient-summary-section/macro.njk" import internationalPatientSummarySection %}
    {{ internationalPatientSummarySection({ section: "problems", heading: "Problem list", status: "not-recorded", statusLabel: "Not recorded" }) }}
#}
{%- set IPS_CODES = {
  "medications": "10160-0", "allergies": "48765-2", "problems": "11450-4", "immunizations": "11369-6",
  "results": "30954-2", "procedures": "47519-4", "devices": "46264-8", "vital-signs": "8716-3",
  "past-illness": "11348-0", "functional-status": "47420-5", "plan-of-care": "18776-5", "social-history": "29762-2",
  "pregnancy": "10162-6", "advance-directives": "42348-3", "alerts": "104605-1", "patient-story": "81338-6"
} -%}
{%- set IPS_REQUIRED = ["medications", "allergies", "problems"] -%}
{%- macro internationalPatientSummarySection(params) -%}
{%- set p = params | default({}) -%}
{%- set sectionId = p.id or ("international-patient-summary-" + p.section) -%}
{%- set status = p.status or "known" -%}
{%- set code = p.code or IPS_CODES[p.section] -%}
{%- set required = p.required if (p.required === true or p.required === false) else (p.section in IPS_REQUIRED) -%}
{%- set level = p.headingLevel or 2 -%}
<section
  class="international-patient-summary-section{% if p.classes %} {{ p.classes }}{% endif %}"
  id="{{ sectionId }}"
  aria-labelledby="{{ sectionId }}-heading"
  data-section="{{ p.section }}"
  {%- if code %} data-code="{{ code }}"{% endif %}
  data-status="{{ status }}"
  {%- if required %} data-required="true"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  <h{{ level }} id="{{ sectionId }}-heading" class="international-patient-summary-section-heading">{{ p.heading }}</h{{ level }}>
  {%- if status != "known" and p.statusLabel %}
  <p class="international-patient-summary-section-status">{{ p.statusLabel }}</p>
  {%- endif %}
  {%- if p.html %}{{ p.html | safe }}{% elif caller %}{{ caller() }}{% endif %}
  {%- if p.narrative %}
  <details class="international-patient-summary-section-narrative"{% if p.narrativeOpen %} open{% endif %}><summary>{{ p.narrativeLabel }}</summary>{{ p.narrative | safe }}</details>
  {%- endif %}
</section>
{%- endmacro -%}

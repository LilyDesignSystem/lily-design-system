{#
  FileManager macro — a file browser for navigating and managing files.

  HTML tag: <div role="region">
  CSS class: file-manager

  Params: label, id, classes, attributes. Caller provides the interior.

  Usage:
    {% from "components/file-manager/macro.njk" import fileManager %}
    {% call fileManager({ id: "example", label: "Example" }) %}…{% endcall %}
#}
{%- macro fileManager(params) -%}
{%- set p = params | default({}) -%}
<div
  class="file-manager{% if p.classes %} {{ p.classes }}{% endif %}"
  role="region"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  data-module="file-manager"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

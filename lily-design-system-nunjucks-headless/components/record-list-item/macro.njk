{#
  RecordListItem macro — one record in a record list, with its status and last update around the consumer's content (tasks.md P28-T3, spec/healthcare-ui).

  HTML tag: <li>
  CSS class: record-list-item (parts: -subject, -status, -updated)

  Params:
    subjectLabel         whose record it is, when it is not the patient's ("Mother", "Fetus 1"); shown first
    status               the record's status, as the consumer's code
    statusLabel          the status in words
    updated              when the record was last updated
    updatedLabel         that date as the consumer writes it
    html, id, classes, attributes

  Usage:
    {% from "components/record-list-item/macro.njk" import recordListItem %}
    {{ recordListItem({ status: "final", statusLabel: "Final", updated: "2026-11-03", updatedLabel: "Updated 3 Nov 2026" }) }}
#}
{%- macro recordListItem(params) -%}
{%- set p = params | default({}) -%}
<li
  class="record-list-item{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.status %} data-status="{{ p.status }}"{% endif %}
  {%- if p.entryState %} data-entry-state="{{ p.entryState }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{%- if p.subjectLabel %}<span class="record-list-item-subject">{{ p.subjectLabel }}</span> {% endif -%}{%- if p.entryState == "withheld" -%}<span class="record-list-item-entry-state">{{ p.entryStateLabel }}</span>{%- else -%}{%- if p.entryState == "entered-in-error" %}<del class="record-list-item-entry">{% endif -%}{%- if p.html -%}{{ p.html | safe }}{%- elif caller -%}{{ caller() }}{%- endif -%}{%- if p.entryState == "entered-in-error" %}</del> <span class="record-list-item-entry-state">{{ p.entryStateLabel }}</span>{% endif -%}{%- endif -%}{%- if p.statusLabel %} <span class="record-list-item-status">{{ p.statusLabel }}</span>{% endif -%}{%- if p.updatedLabel %} <time class="record-list-item-updated"{% if p.updated %} datetime="{{ p.updated }}"{% endif %}>{{ p.updatedLabel }}</time>{% endif -%}</li>
{%- endmacro -%}

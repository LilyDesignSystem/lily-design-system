{#
  TurkiyeTcKimlikNumarasiView macro -- a read-only display of T.C. Kimlik Numarası.

  HTML tag: <span>
  CSS class: turkiye-tc-kimlik-numarasi-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/turkiye-tc-kimlik-numarasi-view/macro.njk" import turkiyeTcKimlikNumarasiView %}
    {{ turkiyeTcKimlikNumarasiView({ value: "sample", label: "T.C. Kimlik Numarası" }) }}
#}
{%- macro turkiyeTcKimlikNumarasiView(params) -%}
<span
  class="turkiye-tc-kimlik-numarasi-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

{#
  MultiSelect macro — a native multiple-choice <select>.

  HTML tag: <select multiple>
  CSS class: multi-select
  Keyboard: native only.

  Params:
    label       string   Accessible name (aria-label). Required.
    id          string
    name        string
    value       array    Selected option values; matching options get `selected`.
    options     array    { value, text, html, selected, disabled } descriptors.
                         If omitted, caller() content (<option>s) is used.
    size        number   Visible rows.
    required    boolean
    disabled    boolean
    classes     string
    attributes  object

  Usage:
    {% from "components/multi-select/macro.njk" import multiSelect %}
    {{ multiSelect({ label: "Toppings", value: ["a"], options: [{ value: "a", text: "A" }] }) }}
#}
{%- macro multiSelect(params) -%}
<select
  class="multi-select{% if params.classes %} {{ params.classes }}{% endif %}"
  multiple
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.name %} name="{{ params.name }}"{% endif %}
  {%- if params.size %} size="{{ params.size }}"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if params.options -%}
    {%- for opt in params.options -%}
      <option value="{{ opt.value }}"
        {%- if opt.selected or (params.value and opt.value in params.value) %} selected{% endif %}
        {%- if opt.disabled %} disabled{% endif %}
      >
        {%- if opt.html -%}{{ opt.html | safe }}{%- else -%}{{ opt.text }}{%- endif -%}
      </option>
    {%- endfor -%}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</select>
{%- endmacro -%}

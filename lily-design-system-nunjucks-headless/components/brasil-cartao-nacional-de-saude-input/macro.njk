{#
  BrasilCartaoNacionalDeSaudeInput macro — an input for entering
    Brazil's Cartão Nacional de Saúde (CNS).

  HTML tag: <input type="text">
  CSS class: brasil-cartao-nacional-de-saude-input
  Format: Fifteen-digit number issued by Brazil's Sistema Único de Saúde (SUS), grouped as NNN NNNN NNNN NNNN. Numbers starting 1 or 2 are definitive (linked to the national civil registry); numbers starting 7, 8, or 9 are provisional. Both forms are validated with a weighted-sum Modulus-11 check across all 15 digits.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/brasil-cartao-nacional-de-saude-input/macro.njk" import brasilCartaoNacionalDeSaudeInput %}
    {{ brasilCartaoNacionalDeSaudeInput({ id: "field-id", label: "Brazil's Cartão Nacional de Saúde (CNS)" }) }}
#}
{%- macro brasilCartaoNacionalDeSaudeInput(params) -%}
<input
  class="brasil-cartao-nacional-de-saude-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

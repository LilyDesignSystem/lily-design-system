{#
  PakistanComputerizedNationalIdentityCardView macro -- a read-only display of Computerized National Identity Card Number (CNIC).

  HTML tag: <span>
  CSS class: pakistan-computerized-national-identity-card-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/pakistan-computerized-national-identity-card-view/macro.njk" import pakistanComputerizedNationalIdentityCardView %}
    {{ pakistanComputerizedNationalIdentityCardView({ value: "sample", label: "Computerized National Identity Card Number (CNIC)" }) }}
#}
{%- macro pakistanComputerizedNationalIdentityCardView(params) -%}
<span
  class="pakistan-computerized-national-identity-card-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

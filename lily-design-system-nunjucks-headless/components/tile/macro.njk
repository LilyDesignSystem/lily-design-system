{#
  Tile macro — a grouping container presenting related content, often as
    a single clickable area.

  HTML tag: <div>, role="group" when labelled, as Svelte renders it. With
    href, the heading is the link (never the whole tile).
  CSS class: tile

  Params: href, heading, text, html, label, id, classes, attributes.

  Usage:
    {% from "components/tile/macro.njk" import tile %}
    {{ tile({ id: "example", label: "Example", href: "/example", heading: "Example" }) }}
#}
{%- macro tile(params) -%}
{%- set p = params | default({}) -%}
<div
  class="tile{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.label %} role="group" aria-label="{{ p.label }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.heading %}<h3 class="tile-heading">{% if p.href %}<a href="{{ p.href }}">{{ p.heading }}</a>{% else %}{{ p.heading }}{% endif %}</h3>{% endif %}
  {%- if p.text %}<p class="tile-text">{{ p.text }}</p>{% endif %}
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

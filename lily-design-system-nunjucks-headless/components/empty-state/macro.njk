{#
  EmptyState macro — a placeholder shown when a list, table, or view has
    nothing to display yet. Heading, text and action are consumer-supplied.

  HTML tag: <div>
  CSS class: empty-state
  ARIA: when `label` is given, role="group" + aria-label. No icon.

  Params:
    label       string   Optional accessible name (adds role="group").
    html        string   Raw HTML content.
    text        string   Plain text content (escaped).
    id          string
    classes     string
    attributes  object
    Body content may instead come from caller().

  Usage:
    {% from "components/empty-state/macro.njk" import emptyState %}
    {% call emptyState({ label: "No results" }) %}<h2>No results</h2>{% endcall %}
#}
{%- macro emptyState(params) -%}
{%- set p = params | default({}) -%}
<div
  class="empty-state{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.label %} role="group" aria-label="{{ p.label }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif p.text -%}{{ p.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

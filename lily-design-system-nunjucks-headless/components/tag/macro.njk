{#
  Tag macro — a keyword label for categorizing content.

  HTML tag: <span>
  CSS class: tag
  Accessibility: not a live region by default. aria-label is not allowed
    on a plain <span>, so params.label becomes screen-reader text (class
    screen-reader-span, which the themes hide) appended after the content,
    which stays exposed (it may hold a control such as a remove button). params.live makes it a role="status" live region named by
    aria-label, for a tag whose text changes in place. (Before 2026-10-11
    this macro rendered a <strong>, unlike every other library.)

  Params:
    text        string   Plain text content (escaped).
    html        string   Raw HTML content (rendered via `| safe`).
    label       string   Accessible label (screen-reader text, or aria-label when live).
    live        boolean  Render a role="status" live region. Default false.
    id          string   Element id.
    classes     string   Consumer-provided extra CSS classes
                         (e.g. tag-grey, tag-red, tag-green).
    attributes  object   Extra HTML attributes as key/value pairs.

  Usage:
    {% from "components/tag/macro.njk" import tag %}
    {{ tag({ text: "Active" }) }}
    {{ tag({ text: "High", label: "Priority: High" }) }}
    {{ tag({ text: "Passing", label: "Build: Passing", live: true }) }}
#}
{%- macro tag(params) -%}
{%- set content -%}
  {%- if params.html -%}{{ params.html | safe }}
  {%- elif params.text -%}{{ params.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
{%- endset -%}
<span
  class="tag{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.live %} role="status"{% if params.label %} aria-label="{{ params.label }}"{% endif %}{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {{- content | safe -}}
  {%- if params.label and not params.live %}<span class="screen-reader-span">{{ params.label }}</span>{% endif -%}
</span>
{%- endmacro -%}

{#
  UkrayinaReyestratsiyniyNomerOblikovoyiKartkyPlatnykaPodatkivInput macro -- an input for entering Реєстраційний номер облікової картки платника податків (РНОКПП).

  HTML tag: <input type="text">
  CSS class: ukrayina-reyestratsiyniy-nomer-oblikovoyi-kartky-platnyka-podatkiv-input
  Format: Ten digits. The first five encode date of birth as the number of days elapsed since 1 January 1900; the next four are a registration sequence number, whose own last digit's parity encodes sex (odd male, even female); the tenth digit is a check digit computed with a weighted-sum algorithm over the first nine digits.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/ukrayina-reyestratsiyniy-nomer-oblikovoyi-kartky-platnyka-podatkiv-input/macro.njk" import ukrayinaReyestratsiyniyNomerOblikovoyiKartkyPlatnykaPodatkivInput %}
    {{ ukrayinaReyestratsiyniyNomerOblikovoyiKartkyPlatnykaPodatkivInput({ id: "field-id", label: "Реєстраційний номер облікової картки платника податків (РНОКПП)" }) }}
#}
{%- macro ukrayinaReyestratsiyniyNomerOblikovoyiKartkyPlatnykaPodatkivInput(params) -%}
<input
  class="ukrayina-reyestratsiyniy-nomer-oblikovoyi-kartky-platnyka-podatkiv-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

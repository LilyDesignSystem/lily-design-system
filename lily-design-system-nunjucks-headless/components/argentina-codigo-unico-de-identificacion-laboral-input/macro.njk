{#
  ArgentinaCodigoUnicoDeIdentificacionLaboralInput macro -- an input for entering Código Único de Identificación Laboral (CUIL).

  HTML tag: <input type="text">
  CSS class: argentina-codigo-unico-de-identificacion-laboral-input
  Format: Displayed as XX-NNNNNNNN-X: a two-digit prefix denoting registration type/sex (historically 20 male, 27 female, though this classification was discontinued in 2012), the eight-digit DNI (national identity document) number, and a Modulus-11 check digit computed over the ten preceding digits.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/argentina-codigo-unico-de-identificacion-laboral-input/macro.njk" import argentinaCodigoUnicoDeIdentificacionLaboralInput %}
    {{ argentinaCodigoUnicoDeIdentificacionLaboralInput({ id: "field-id", label: "Código Único de Identificación Laboral (CUIL)" }) }}
#}
{%- macro argentinaCodigoUnicoDeIdentificacionLaboralInput(params) -%}
<input
  class="argentina-codigo-unico-de-identificacion-laboral-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

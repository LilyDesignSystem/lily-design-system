{#
  LuxembourgMatriculeView macro -- a read-only display of Numéro d'Identification Nationale (Matricule).

  HTML tag: <span>
  CSS class: luxembourg-matricule-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/luxembourg-matricule-view/macro.njk" import luxembourgMatriculeView %}
    {{ luxembourgMatriculeView({ value: "sample", label: "Numéro d'Identification Nationale (Matricule)" }) }}
#}
{%- macro luxembourgMatriculeView(params) -%}
<span
  class="luxembourg-matricule-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

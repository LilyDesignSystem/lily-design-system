{#
  FileTree macro — a hierarchical tree (folders and files), WAI-ARIA APG
    tree pattern.

  HTML tag: <ul role="tree">
  CSS class: file-tree
  Markup contract: the consumer supplies <li role="treeitem"
    aria-expanded? aria-selected? tabindex> descendants, with a nested
    <ul role="group"> inside each folder item.
  Keyboard: the APG contract (Arrow keys, Home/End, "*", typeahead,
    Enter/Space, roving tabindex, aria-expanded toggling) needs script.
    Nunjucks ships no JavaScript, so the root carries data-module="file-tree"
    and the consumer's JS owns the keyboard — the one deviation from the
    Svelte canonical, which owns it itself. Give exactly one item tabindex="0"
    and the rest "-1" in the markup.

  Params:
    label       string   Accessible name (aria-label). Required.
    id          string
    classes     string
    attributes  object
    html / caller()  The tree items.

  Usage:
    {% from "components/file-tree/macro.njk" import fileTree %}
    {% call fileTree({ label: "Project files" }) %}
      <li role="treeitem" tabindex="0">README</li>
    {% endcall %}
#}
{%- macro fileTree(params) -%}
{%- set p = params | default({}) -%}
<ul
  class="file-tree{% if p.classes %} {{ p.classes }}{% endif %}"
  role="tree"
  data-module="file-tree"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</ul>
{%- endmacro -%}

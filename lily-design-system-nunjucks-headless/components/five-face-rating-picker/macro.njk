{#
  FiveFaceRatingPicker macro — a picker for a 1-5 face rating.

  HTML tag: <fieldset role="radiogroup"> of native radios, as in the Svelte reference and the other catalogs
  CSS class: five-face-rating-picker
  Keyboard: native radios: Tab focuses the checked radio (or the first), the arrow keys move and check, Space checks.
  Accessibility: role="radiogroup" with an accessible name; one native radio per value (1 to 5), sharing one name.

  Params:
    label         string   Accessible name, in the page's language. Required unless labelledBy is given; there is
                           no English default.
    labelledBy    string
    labels        array    Each option's visible text, in order (1 to 5). Default: the numbers
                           alone, no English.
    value         number   The checked value (none by default).
    name          string   Radio group name for form submission. Default "face-rating".
    disabled      boolean  Disables the whole group.
    id            string
    classes       string
    attributes    object

  Usage:
    {% from "components/five-face-rating-picker/macro.njk" import fiveFaceRatingPicker %}
    {{ fiveFaceRatingPicker({ label: "Example", value: 3 }) }}
#}
{%- macro fiveFaceRatingPicker(params) -%}
{%- set p = params | default({}) -%}
{%- set labels = p.labels | default([]) -%}
<fieldset
  class="five-face-rating-picker{% if p.classes %} {{ p.classes }}{% endif %}"
  role="radiogroup"
  {%- if p.labelledBy %} aria-labelledby="{{ p.labelledBy }}"
  {%- elif p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.disabled %} disabled{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- for n in [1, 2, 3, 4, 5] %}
  <label><input type="radio" name="{{ p.name | default('face-rating') }}" value="{{ n }}"{% if p.value is defined and p.value !== null and p.value | string == n | string %} checked{% endif %} /> {{ (labels[loop.index0] if labels and labels[loop.index0] is defined else n) }}</label>
  {%- endfor %}
</fieldset>
{%- endmacro -%}

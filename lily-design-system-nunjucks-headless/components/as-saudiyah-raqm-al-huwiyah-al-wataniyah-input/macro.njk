{#
  AsSaudiyahRaqmAlHuwiyahAlWataniyahInput macro -- an input for entering National Identification Number.

  HTML tag: <input type="text">
  CSS class: as-saudiyah-raqm-al-huwiyah-al-wataniyah-input
  Format: Ten digits. The first digit is 1 for a Saudi citizen and 2 for a resident (the iqama number), and the last digit is a check digit under the Luhn algorithm: counting from the right, every second digit is doubled (subtracting 9 when the result exceeds 9), and the total must be a multiple of 10.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/as-saudiyah-raqm-al-huwiyah-al-wataniyah-input/macro.njk" import asSaudiyahRaqmAlHuwiyahAlWataniyahInput %}
    {{ asSaudiyahRaqmAlHuwiyahAlWataniyahInput({ id: "field-id", label: "National Identification Number" }) }}
#}
{%- macro asSaudiyahRaqmAlHuwiyahAlWataniyahInput(params) -%}
<input
  class="as-saudiyah-raqm-al-huwiyah-al-wataniyah-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

{#
  DateRange macro — paired start and end date inputs.

  HTML tag: <fieldset> containing two <input type="date">
  CSS class: date-range (fieldset), date-input (each input)

  Params:
    label (group name), startLabel, endLabel (each input's accessible name),
    start, end (YYYY-MM-DD values), startName, endName (form field names),
    id, classes, attributes.
#}
{%- macro dateRange(params) -%}
{%- set p = params | default({}) -%}
<fieldset
  class="date-range{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  <input class="date-input" type="date"{% if p.startName %} name="{{ p.startName }}"{% endif %}{% if p.startLabel %} aria-label="{{ p.startLabel }}"{% endif %}{% if p.start %} value="{{ p.start }}"{% endif %}>
  <input class="date-input" type="date"{% if p.endName %} name="{{ p.endName }}"{% endif %}{% if p.endLabel %} aria-label="{{ p.endLabel }}"{% endif %}{% if p.end %} value="{{ p.end }}"{% endif %}>
</fieldset>
{%- endmacro -%}

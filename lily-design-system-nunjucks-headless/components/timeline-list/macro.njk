{#
  TimelineList macro — an ordered list of chronological events or
    milestones.

  HTML tag: <ol>
  CSS class: timeline-list

  Params:
    label       string   Accessible name.
    coverageLabel string  What the timeline is a view of (window, order, what is left out, sources that did not answer),
                in the consumer's words; an item of its own, first.
    labelledBy  string
    id          string
    classes     string
    attributes  object

  Body content: TimelineListItem children via caller().

  Usage:
    {% from "components/timeline-list/macro.njk" import timelineList %}
    {% call timelineList({ id: "example", label: "Example" }) %}…{% endcall %}
#}
{%- macro timelineList(params) -%}
{%- set p = params | default({}) -%}
<ol
  class="timeline-list{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.labelledBy %} aria-labelledby="{{ p.labelledBy }}"{% elif p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.coverageLabel %}<li class="timeline-list-coverage">{{ p.coverageLabel }}</li>{% endif -%}
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</ol>
{%- endmacro -%}

{#
  ToolCallName macro -- the name of the tool in a tool call, shown in the summary.

  A headless inner part of ToolCall. Contract: a plain wrapper with the base class and children.

  HTML tag: <span>
  CSS class: tool-call-name

  Params:

    id           string   Element id.
    classes      string   Consumer-provided extra CSS classes.
    attributes   object   Extra HTML attributes as key/value pairs.
    html         string   Raw HTML content.
    text         string   Plain text content (escaped).

  Usage:
    {% from "components/tool-call-name/macro.njk" import toolCallName %}
    {% call toolCallName({}) %}Text{% endcall %}
#}
{%- macro toolCallName(params) -%}
{%- set p = params | default({}) -%}
<span
  class="tool-call-name{% if p.classes %} {{ p.classes }}{% endif %}"
  
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif p.text -%}{{ p.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</span>
{%- endmacro -%}

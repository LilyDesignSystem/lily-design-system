{#
  ReviewDate macro — a display of a content review date <time>.

  HTML tag: <time>
  CSS class: review-date

  Params:
    datetime  string  ISO 8601 date (the machine-readable value).
    text      string  Human-readable, localised date text. Defaults to datetime.
    label     string  Accessible label giving context for the date.
    id        string
    classes   string
    attributes object

  For a "next review" date, render a second reviewDate with its own label.
#}
{%- macro reviewDate(params) -%}
{%- set p = params | default({}) -%}
<time
  class="review-date{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.datetime %} datetime="{{ p.datetime }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ p.text | default(p.datetime) }}</time>
{%- endmacro -%}

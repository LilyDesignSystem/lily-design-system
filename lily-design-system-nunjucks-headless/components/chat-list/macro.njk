{#
  ChatList macro — an ordered list of chat list item components.

  HTML tag: <ol>
  CSS class: chat-list
  Accessibility: a list, named by `label`. A role="log" here would remove the
    list semantics; to announce new messages, pass `live`, or use streaming-text.

  Params:
    label       string   Accessible name (aria-label).
    live        string   aria-live value. Not set by default.
    id          string
    classes     string
    attributes  object

  Body content: ChatListItem children via caller().

  Usage:
    {% from "components/chat-list/macro.njk" import chatList %}
    {% call chatList({ id: "example" }) %}…{% endcall %}
#}
{%- macro chatList(params) -%}
{%- set p = params | default({}) -%}
<ol
  class="chat-list{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.live %} aria-live="{{ p.live }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</ol>
{%- endmacro -%}

{#
  SelectWithExtras macro — a native <select> wrapped for additional
    features (search, grouping) handled by consumer JS.

  HTML tag: <div> holding the <select>, as Svelte renders it
  CSS class: select-with-extras

  Params: id (the select's), name, label, required, disabled, multiple,
    before, after (raw HTML either side of the select), classes,
    attributes (on the wrapper). Caller provides <option> children.

  Usage:
    {% from "components/select-with-extras/macro.njk" import selectWithExtras %}
    {% call selectWithExtras({ id: "example", label: "Example" }) %}…{% endcall %}
#}
{%- macro selectWithExtras(params) -%}
{%- set p = params | default({}) -%}
<div
  class="select-with-extras{% if p.classes %} {{ p.classes }}{% endif %}"
  data-module="select-with-extras"
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.before %}{{ p.before | safe }}{% endif %}
  <select
    {%- if p.id %} id="{{ p.id }}"{% endif %}
    {%- if p.name %} name="{{ p.name }}"{% endif %}
    {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
    {%- if p.required %} required{% endif %}
    {%- if p.disabled %} disabled{% endif %}
    {%- if p.multiple %} multiple{% endif %}
  >
    {%- if p.html -%}{{ p.html | safe }}
    {%- elif caller -%}{{ caller() }}
    {%- endif -%}
  </select>
  {%- if p.after %}{{ p.after | safe }}{% endif %}
</div>
{%- endmacro -%}

{#
  ScrollBar macro — a custom scrollbar element.

  HTML tag: <div role="scrollbar">
  CSS class: scroll-bar

  Params: label (the accessible name), orientation (default "vertical"),
    value (default 0), min (default 0), max (default 100), step (default 1),
    pageStep (default 10), controls, id, classes, attributes.

  Keys: components/widget-init.js moves aria-valuenow on the arrows, Page
  Up/Down, Home and End, and dispatches a bubbling "change".

  Usage:
    {% from "components/scroll-bar/macro.njk" import scrollBar %}
    {{ scrollBar({ id: "example", label: "Example" }) }}
#}
{%- macro scrollBar(params) -%}
{%- set p = params | default({}) -%}
<div
  class="scroll-bar{% if p.classes %} {{ p.classes }}{% endif %}"
  role="scrollbar"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  aria-orientation="{{ p.orientation | default('vertical') }}"
  aria-valuemin="{{ p.min | default(0) }}"
  aria-valuemax="{{ p.max | default(100) }}"
  aria-valuenow="{{ p.value | default(0) }}"
  {%- if p.step %} data-step="{{ p.step }}"{% endif %}
  {%- if p.pageStep %} data-page-step="{{ p.pageStep }}"{% endif %}
  {%- if p.controls %} aria-controls="{{ p.controls }}"{% endif %}
  tabindex="0"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  <div class="scroll-bar-thumb" aria-hidden="true"></div>
</div>
{%- endmacro -%}

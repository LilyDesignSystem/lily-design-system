{#
  ToolCallStatus macro -- the status of a tool call as a word, such as pending, running, done or error.

  A headless inner part of ToolCall. Contract: `status` (optional) sets `data-status`; the visible status word is the children (consumer text, never colour alone).

  HTML tag: <span>
  CSS class: tool-call-status

  Params:
    status       string   pending | running | done | error (data-status).
    id           string   Element id.
    classes      string   Consumer-provided extra CSS classes.
    attributes   object   Extra HTML attributes as key/value pairs.
    html         string   Raw HTML content.
    text         string   Plain text content (escaped).

  Usage:
    {% from "components/tool-call-status/macro.njk" import toolCallStatus %}
    {% call toolCallStatus({}) %}Text{% endcall %}
#}
{%- macro toolCallStatus(params) -%}
{%- set p = params | default({}) -%}
<span
  class="tool-call-status{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.status %} data-status="{{ p.status }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif p.text -%}{{ p.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</span>
{%- endmacro -%}

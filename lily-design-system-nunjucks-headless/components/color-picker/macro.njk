{#
  ColorPicker macro — a container for picking colors by swatch.

  HTML tag: <div role="radiogroup">
  CSS class: color-picker

  Params: label, labelledBy, id, classes, attributes. Caller provides
    ColorPickerButton children.

  Usage:
    {% from "components/color-picker/macro.njk" import colorPicker %}
    {% call colorPicker({ id: "example", label: "Example" }) %}…{% endcall %}
#}
{%- macro colorPicker(params) -%}
{%- set p = params | default({}) -%}
<div
  class="color-picker{% if p.classes %} {{ p.classes }}{% endif %}"
  role="radiogroup"
  {%- if p.labelledBy %} aria-labelledby="{{ p.labelledBy }}"{% elif p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

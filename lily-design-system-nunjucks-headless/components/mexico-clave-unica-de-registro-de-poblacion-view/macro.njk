{#
  MexicoClaveUnicaDeRegistroDePoblacionView macro — a read-only display of
    Mexico's Clave Única de Registro de Población (CURP).

  HTML tag: <span>
  CSS class: mexico-clave-unica-de-registro-de-poblacion-view
  Format: Eighteen-character alphanumeric code built from name, date of birth, sex, and state of birth: first letter of the first surname plus its first internal vowel; first letter of the second surname (or X if none); first letter of the given name; six-digit date of birth (YYMMDD); H or M for sex (X for non-binary); a two-letter state code (NE for those born abroad); a consonant from each surname and the given name; then two further disambiguating characters. No trailing check digit.

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/mexico-clave-unica-de-registro-de-poblacion-view/macro.njk" import mexicoClaveUnicaDeRegistroDePoblacionView %}
    {{ mexicoClaveUnicaDeRegistroDePoblacionView({ value: "sample", label: "Mexico's Clave Única de Registro de Población (CURP)" }) }}
#}
{%- macro mexicoClaveUnicaDeRegistroDePoblacionView(params) -%}
<span
  class="mexico-clave-unica-de-registro-de-poblacion-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

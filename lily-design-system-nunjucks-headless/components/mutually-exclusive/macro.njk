{#
  MutuallyExclusive macro — a container ensuring only one option can be selected from a group.

  HTML tag: <fieldset>
  CSS class: mutually-exclusive
  Accessibility: the native <fieldset> element supplies the semantics. `label`
    is rendered as aria-label on the root; name the element when more than
    one of its kind is on the page. Any other ARIA is passed through
    `attributes`.

  Internationalization: no hardcoded user-facing strings; all text is
    supplied by the caller.

  Params:
    text        string   Plain text content (escaped).
    html        string   Raw HTML content (rendered via `| safe`).
    label       string   Accessible name (aria-label).
    id          string
    classes     string   Extra classes, after the `mutually-exclusive` base class.
    attributes  object   Extra attributes written onto the root.

  Body content: `caller()` when neither `html` nor `text` is given.

  Usage:
    {% from "components/mutually-exclusive/macro.njk" import mutuallyExclusive %}
    {{ mutuallyExclusive({ text: "…", label: "…" }) }}
#}
{%- macro mutuallyExclusive(params) -%}
{%- set p = params | default({}) -%}
<fieldset
  class="mutually-exclusive{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif p.text -%}{{ p.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</fieldset>
{%- endmacro -%}

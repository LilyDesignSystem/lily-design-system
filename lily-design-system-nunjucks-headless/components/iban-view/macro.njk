{#
  IbanView macro — a read-only display of an International Bank Account Number (IBAN).

  HTML tag: <span>
  CSS class: iban-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/iban-view/macro.njk" import ibanView %}
    {{ ibanView({ value: "sample", label: "IBAN" }) }}
#}
{%- macro ibanView(params) -%}
<span
  class="iban-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

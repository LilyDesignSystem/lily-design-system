{#
  Mark macro -- an inline highlight marking text as relevant or referenced, such as a search match, using the native mark element.

  A headless inline wrapper. Contract: a plain wrapper with the base class and children.

  HTML tag: <mark>
  CSS class: mark

  Params:

    id           string   Element id.
    classes      string   Consumer-provided extra CSS classes.
    attributes   object   Extra HTML attributes as key/value pairs.
    html         string   Raw HTML content.
    text         string   Plain text content (escaped).

  Usage:
    {% from "components/mark/macro.njk" import mark %}
    {% call mark({}) %}Text{% endcall %}
#}
{%- macro mark(params) -%}
{%- set p = params | default({}) -%}
<mark
  class="mark{% if p.classes %} {{ p.classes }}{% endif %}"
  
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif p.text -%}{{ p.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</mark>
{%- endmacro -%}

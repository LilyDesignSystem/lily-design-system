{#
  ContentsLink macro — one contents link, such as to a page or page section.

  HTML tag: <a>
  CSS class: contents-link

  Params:
    href        string   Target URL. Default "#".
    current     boolean  Adds aria-current="location".
    text        string
    html        string
    label       string   aria-label override; it replaces the whole name, so include any count in it.
    count       number   Sets data-count on the link (and data-complete when 0).
    countLabel  string   Visible, localised count text (e.g. "3 to do"), rendered inside the link after the text.
    id          string
    classes     string
    attributes  object
#}
{%- macro contentsLink(params) -%}
<a
  class="contents-link{% if params.classes %} {{ params.classes }}{% endif %}"
  href="{{ params.href | default('#') }}"
  {%- if params.current %} aria-current="location"{% endif %}
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.count is defined and params.count is not none %} data-count="{{ params.count }}"{% endif %}
  {%- if params.count is defined and params.count === 0 %} data-complete=""{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if params.html -%}{{ params.html | safe }}
  {%- elif params.text -%}{{ params.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
  {%- if params.countLabel %} <span class="contents-link-count">{{ params.countLabel }}</span>{% endif -%}
</a>
{%- endmacro -%}

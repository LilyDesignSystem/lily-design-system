{#
  HeatmapChartWithYearOfDays macro -- a matrix chart where cell colour encodes a value.

  A headless wrapper: a <figure> holding a role="img" graphic wrapper around
  the consumer-supplied inline <svg>. No drawing happens in the macro
  (headless). The optional params.dataTable renders the accessible table
  alternative in .heatmap-chart-with-year-of-days-data-table, a SIBLING of the image wrapper:
  role="img" makes descendants presentational, so a table inside it would be
  invisible to assistive technology.

  HTML tag: <figure> containing <div class="heatmap-chart-with-year-of-days-graphic" role="img">
  CSS class: heatmap-chart-with-year-of-days (sub-elements: heatmap-chart-with-year-of-days-graphic, heatmap-chart-with-year-of-days-data-table)
  Accessibility:
    - the graphic wrapper carries role="img"; aria-label names it.
    - params.describedBy sets aria-describedby on the graphic wrapper:
      point it at a text description.

  Params:
    label        string   Required accessible name (aria-label).
    year         number   Required. The calendar year shown (data-year).
    weekStart    number   Required. First weekday row, 0 = Sunday … 6 = Saturday (data-week-start); no default.
    describedBy  string   id(s) for aria-describedby (on the graphic).
    dataTable    string   Raw HTML for the accessible table alternative.
    id           string   Element id (on the figure).
    classes      string   Consumer-provided extra CSS classes.
    attributes   object   Extra HTML attributes as key/value pairs (on the figure).
    html         string   Raw HTML content (the svg).
    text         string   Plain text content (escaped).

  Usage:
    {% from "components/heatmap-chart-with-year-of-days/macro.njk" import heatmapChartWithYearOfDays %}
    {% call heatmapChartWithYearOfDays({ label: "Example", year: 2026, weekStart: 0, describedBy: "desc", dataTable: "<table>...</table>" }) %}<svg>...</svg>{% endcall %}
#}
{%- macro heatmapChartWithYearOfDays(params) -%}
{%- set p = params | default({}) -%}
<figure
  class="heatmap-chart-with-year-of-days{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.year is defined %} data-year="{{ p.year }}"{% endif %}
  {%- if p.weekStart is defined %} data-week-start="{{ p.weekStart }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  <div
    class="heatmap-chart-with-year-of-days-graphic"
    role="img"
    {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
    {%- if p.describedBy %} aria-describedby="{{ p.describedBy }}"{% endif %}
  >
    {%- if p.html -%}{{ p.html | safe }}
    {%- elif p.text -%}{{ p.text }}
    {%- elif caller -%}{{ caller() }}
    {%- endif -%}
  </div>
  {%- if p.dataTable %}
  <div class="heatmap-chart-with-year-of-days-data-table">{{ p.dataTable | safe }}</div>
  {%- endif %}
</figure>
{%- endmacro -%}

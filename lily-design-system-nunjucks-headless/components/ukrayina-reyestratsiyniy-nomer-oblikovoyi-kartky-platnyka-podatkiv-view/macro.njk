{#
  UkrayinaReyestratsiyniyNomerOblikovoyiKartkyPlatnykaPodatkivView macro -- a read-only display of Реєстраційний номер облікової картки платника податків (РНОКПП).

  HTML tag: <span>
  CSS class: ukrayina-reyestratsiyniy-nomer-oblikovoyi-kartky-platnyka-podatkiv-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/ukrayina-reyestratsiyniy-nomer-oblikovoyi-kartky-platnyka-podatkiv-view/macro.njk" import ukrayinaReyestratsiyniyNomerOblikovoyiKartkyPlatnykaPodatkivView %}
    {{ ukrayinaReyestratsiyniyNomerOblikovoyiKartkyPlatnykaPodatkivView({ value: "sample", label: "Реєстраційний номер облікової картки платника податків (РНОКПП)" }) }}
#}
{%- macro ukrayinaReyestratsiyniyNomerOblikovoyiKartkyPlatnykaPodatkivView(params) -%}
<span
  class="ukrayina-reyestratsiyniy-nomer-oblikovoyi-kartky-platnyka-podatkiv-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

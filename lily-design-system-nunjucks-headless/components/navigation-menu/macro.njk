{#
  NavigationMenu macro — a site-wide navigation menu with links.

  HTML tag: <nav>
  CSS class: navigation-menu

  Params: label, labelledBy, id, classes, attributes,
          overflow (boolean, default false), moreLabel (required with overflow; no English default).

  Overflow mode: the content must be <li> items. The macro renders them in
  <ul class="navigation-menu-list"> beside a hidden "More" item and publishes
  data-overflow="true". With no script the links simply wrap and the More item stays hidden;
  components/widget-init.js adds the measure-and-move behaviour and its keys.

  Usage:
    {% from "components/navigation-menu/macro.njk" import navigationMenu %}
    {% call navigationMenu({ id: "example", label: "Example" }) %}…{% endcall %}
#}
{%- macro navigationMenu(params) -%}
{%- set p = params | default({}) -%}
<nav
  class="navigation-menu{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.labelledBy %} aria-labelledby="{{ p.labelledBy }}"{% elif p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.overflow %} data-overflow="true"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.overflow -%}
  <ul class="navigation-menu-list">
    {%- if p.html -%}{{ p.html | safe }}
    {%- elif caller -%}{{ caller() }}
    {%- endif -%}
    <li class="navigation-menu-more" hidden>
      <button class="navigation-menu-more-button" type="button" aria-expanded="false">{{ p.moreLabel }}</button>
      <ul class="navigation-menu-more-list" hidden></ul>
    </li>
  </ul>
  {%- elif p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</nav>
{%- endmacro -%}

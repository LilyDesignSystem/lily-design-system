{#
  Timer macro — a countdown or elapsed-time display.

  HTML tag: <time role="timer">
  CSS class: timer
  Accessibility: not a live region (role="timer" is aria-live="off"): a value
    that changes every second would flood a screen reader. Announce milestones
    ("one minute left") in a separate status region. Use data-timer-remaining or data-timer-elapsed
    to let client-side JS update the text.

  Params:
    id, mode ("countdown" | "elapsed"), start (ISO datetime), duration (seconds),
    label, classes, attributes. The macro renders the initial text in `text`.
    text        string  Initial rendered text (e.g. "05:00").

  Usage:
    {% from "components/timer/macro.njk" import timer %}
    {{ timer({ id: "example", label: "Example", text: "Example" }) }}
#}
{%- macro timer(params) -%}
{%- set p = params | default({}) -%}
<time
  class="timer{% if p.classes %} {{ p.classes }}{% endif %}"
  role="timer"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  data-mode="{{ p.mode | default('countdown') }}"
  {%- if p.start %} data-start="{{ p.start }}"{% endif %}
  {%- if p.duration %} data-duration="{{ p.duration }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ p.text | default('') }}</time>
{%- endmacro -%}

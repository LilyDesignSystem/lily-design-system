{#
  SchweizAhvNummerView macro — a read-only display of
    Switzerland's AHV-Nummer / Numéro AVS.

  HTML tag: <span>
  CSS class: schweiz-ahv-nummer-view
  Format: Thirteen digits, displayed as 756.NNNN.NNNN.NN, always beginning with the country prefix 756. It is a valid EAN-13 barcode number: the final digit is an EAN-13 check digit computed over the twelve preceding digits (alternating-position weights of 1 and 3). Replaced the old 11-digit AHV card number on 1 July 2008.

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/schweiz-ahv-nummer-view/macro.njk" import schweizAhvNummerView %}
    {{ schweizAhvNummerView({ value: "sample", label: "Switzerland's AHV-Nummer / Numéro AVS" }) }}
#}
{%- macro schweizAhvNummerView(params) -%}
<span
  class="schweiz-ahv-nummer-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

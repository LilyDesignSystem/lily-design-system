{#
  ObservationView macro — a read-only clinical observation or result, with unit, flag and reference range
  (spec/healthcare-ui item 1). Shows what the consumer decided; computes no flag and no range.

  HTML tag: <span>
  CSS class: observation-view (parts: -value, -unit, -flag, -range, -range-label, -meter, -previous-value, -previous-label, -status)

  Params:
    value, unit, range         strings, formatted by the consumer
    interpretation             a FHIR v3 ObservationInterpretation code, rendered as data-interpretation
    flagLabel                  the consumer's words for the flag; required when it is not normal
    ranges                     [{ label, text }]: further named ranges, each a -range part with a -range-label
    meterValue, meterMin,      numbers; with all three, an aria-hidden <meter> shows where the value sits
      meterMax
    meterLow, meterHigh,       numbers, optional: the reference range and best value on the meter, for the theme
      meterOptimum
    previousValue              a superseded value, in a <del>
    previousLabel              the consumer's words for it ("was 5.1 until 3 Nov"); give it with previousValue
    status                     "final" (default) | "registered" | "preliminary" | "amended" | "corrected" | "entered-in-error" | "cancelled" | "unknown" | "masked" | "not-recorded" | "unavailable" | "not-applicable"
    statusLabel                the words, required for any status but final: without them no value, flag, range or meter is
                               shown; replaces the value when there is none to show
    showWithdrawn              boolean, default false, for an authorised history view: an entered-in-error result's former
                               value, struck through after its words
    label, id, classes, attributes

  Usage:
    {% from "components/observation-view/macro.njk" import observationView %}
    {{ observationView({ label: "Potassium", value: "5.9", unit: "mmol/L", interpretation: "H", flagLabel: "High", range: "3.5–5.3" }) }}
#}
{%- macro observationView(params) -%}
{%- set p = params | default({}) -%}
{%- set status = p.status | default("final") -%}
{%- set withdrawn = status == "entered-in-error" -%}
{%- set withheld = status in ["registered", "cancelled", "masked", "not-recorded", "unavailable", "not-applicable"] or (status != "final" and not p.statusLabel) or (withdrawn and not p.showWithdrawn) -%}
<span
  class="observation-view{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.interpretation and not withheld and not withdrawn %} data-interpretation="{{ p.interpretation }}"{% endif %} data-status="{{ status }}"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if p.label %}<span class="screen-reader-span">{{ p.label }} </span>{% endif %}
{%- if withheld -%}<span class="observation-view-status">{{ p.statusLabel }}</span>
{%- elif withdrawn -%}<span class="observation-view-status">{{ p.statusLabel }}</span> <del class="observation-view-withdrawn-value"><span class="observation-view-value">{{ p.value | default("") }}</span>{% if p.unit %}&#160;<span class="observation-view-unit">{{ p.unit }}</span>{% endif %}</del>
{%- else -%}<span class="observation-view-value">{{ p.value | default("") }}</span>
{%- if p.unit %}&#160;<span class="observation-view-unit">{{ p.unit }}</span>{% endif -%}
{%- if p.flagLabel %} <span class="observation-view-flag">{{ p.flagLabel }}</span>{% endif -%}
{%- if p.range %} <span class="observation-view-range">{{ p.range }}</span>{% endif -%}
{%- for named in p.ranges or [] %} <span class="observation-view-range"><span class="observation-view-range-label">{{ named.label }}</span> {{ named.text }}</span>{% endfor -%}
{%- if (p.meterValue is number) and (p.meterMin is number) and (p.meterMax is number) %} <meter class="observation-view-meter" aria-hidden="true" value="{{ p.meterValue }}" min="{{ p.meterMin }}" max="{{ p.meterMax }}"{% if p.meterLow is number %} low="{{ p.meterLow }}"{% endif %}{% if p.meterHigh is number %} high="{{ p.meterHigh }}"{% endif %}{% if p.meterOptimum is number %} optimum="{{ p.meterOptimum }}"{% endif %}></meter>{% endif -%}
{%- if p.previousValue %} <del class="observation-view-previous-value">{{ p.previousValue }}</del>{% if p.previousLabel %} <span class="observation-view-previous-label">{{ p.previousLabel }}</span>{% endif %}{% endif -%}
{%- if status != "final" and p.statusLabel %} <span class="observation-view-status">{{ p.statusLabel }}</span>{% endif -%}
{%- endif -%}</span>
{%- endmacro -%}

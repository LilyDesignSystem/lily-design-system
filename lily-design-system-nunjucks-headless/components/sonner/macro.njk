{#
  Sonner macro — a toast notification manager.

  HTML tag: <div role="region">
  CSS class: sonner

  Params: label, id, classes, attributes.
    Caller provides Toast children.

  Usage:
    {% from "components/sonner/macro.njk" import sonner %}
    {% call sonner({ id: "example", label: "Example" }) %}…{% endcall %}
#}
{%- macro sonner(params) -%}
{%- set p = params | default({}) -%}
<div
  class="sonner{% if p.classes %} {{ p.classes }}{% endif %}"
  role="region"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  aria-live="polite"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

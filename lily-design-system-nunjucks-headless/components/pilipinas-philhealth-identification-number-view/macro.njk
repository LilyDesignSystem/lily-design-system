{#
  PilipinasPhilhealthIdentificationNumberView macro — a read-only display of
    the Philippines' PhilHealth Identification Number (PIN).

  HTML tag: <span>
  CSS class: pilipinas-philhealth-identification-number-view
  Format: Twelve-digit number assigned by the Philippine Health Insurance Corporation (PhilHealth) to every enrolled member, commonly displayed grouped as NN-NNNNNNNNN-N. No published check-digit algorithm; correctness is confirmed against PhilHealth's own membership records.

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/pilipinas-philhealth-identification-number-view/macro.njk" import pilipinasPhilhealthIdentificationNumberView %}
    {{ pilipinasPhilhealthIdentificationNumberView({ value: "sample", label: "the Philippines' PhilHealth Identification Number (PIN)" }) }}
#}
{%- macro pilipinasPhilhealthIdentificationNumberView(params) -%}
<span
  class="pilipinas-philhealth-identification-number-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

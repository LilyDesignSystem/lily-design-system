{#
  Dial macro — a rotary dial control for selecting a value.

  HTML tag: <div role="slider">, as Svelte renders it. widget-init.js gives it
    its keys: the arrows move one step (Shift ten), Home and End go to the
    ends. It mirrors the value to aria-valuenow and data-value, and to a
    hidden input when name is given, so it takes part in a form.
  CSS class: dial

  Params: id, name, value (default 0), min (default 0), max (default 100),
    step (default 1), label, disabled, classes, attributes.

  Usage:
    {% from "components/dial/macro.njk" import dial %}
    {{ dial({ id: "example", label: "Example", name: "volume", value: 50 }) }}
#}
{%- macro dial(params) -%}
{%- set p = params | default({}) -%}
{%- set value = p.value | default(0) -%}
<div
  class="dial{% if p.classes %} {{ p.classes }}{% endif %}"
  role="slider"
  tabindex="{{ '-1' if p.disabled else '0' }}"
  aria-valuenow="{{ value }}"
  aria-valuemin="{{ p.min | default(0) }}"
  aria-valuemax="{{ p.max | default(100) }}"
  data-step="{{ p.step | default(1) }}"
  data-value="{{ value }}"
  {%- if p.disabled %} aria-disabled="true"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.name %}<input type="hidden" name="{{ p.name }}" value="{{ value }}">{% endif -%}
</div>
{%- endmacro -%}

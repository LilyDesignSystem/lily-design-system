{#
  AsSaudiyahRaqmAlHuwiyahAlWataniyahView macro -- a read-only display of National Identification Number.

  HTML tag: <span>
  CSS class: as-saudiyah-raqm-al-huwiyah-al-wataniyah-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/as-saudiyah-raqm-al-huwiyah-al-wataniyah-view/macro.njk" import asSaudiyahRaqmAlHuwiyahAlWataniyahView %}
    {{ asSaudiyahRaqmAlHuwiyahAlWataniyahView({ value: "sample", label: "National Identification Number" }) }}
#}
{%- macro asSaudiyahRaqmAlHuwiyahAlWataniyahView(params) -%}
<span
  class="as-saudiyah-raqm-al-huwiyah-al-wataniyah-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

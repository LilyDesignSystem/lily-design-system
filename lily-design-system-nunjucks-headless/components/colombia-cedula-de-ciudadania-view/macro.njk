{#
  ColombiaCedulaDeCiudadaniaView macro -- a read-only display of Cedula de Ciudadania Number.

  HTML tag: <span>
  CSS class: colombia-cedula-de-ciudadania-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/colombia-cedula-de-ciudadania-view/macro.njk" import colombiaCedulaDeCiudadaniaView %}
    {{ colombiaCedulaDeCiudadaniaView({ value: "sample", label: "Cedula de Ciudadania Number" }) }}
#}
{%- macro colombiaCedulaDeCiudadaniaView(params) -%}
<span
  class="colombia-cedula-de-ciudadania-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

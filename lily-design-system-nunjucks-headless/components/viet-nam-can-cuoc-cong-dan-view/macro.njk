{#
  VietNamCanCuocCongDanView macro -- a read-only display of Citizen Identification Number (CCCD).

  HTML tag: <span>
  CSS class: viet-nam-can-cuoc-cong-dan-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/viet-nam-can-cuoc-cong-dan-view/macro.njk" import vietNamCanCuocCongDanView %}
    {{ vietNamCanCuocCongDanView({ value: "sample", label: "Citizen Identification Number (CCCD)" }) }}
#}
{%- macro vietNamCanCuocCongDanView(params) -%}
<span
  class="viet-nam-can-cuoc-cong-dan-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

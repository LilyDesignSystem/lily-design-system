{#
  NigeriaNationalIdentificationNumberInput macro -- an input for entering National Identification Number (NIN).

  HTML tag: <input type="text">
  CSS class: nigeria-national-identification-number-input
  Format: Eleven digits issued by the National Identity Management Commission (NIMC). No check-digit algorithm is published, so only the length and digits can be checked.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/nigeria-national-identification-number-input/macro.njk" import nigeriaNationalIdentificationNumberInput %}
    {{ nigeriaNationalIdentificationNumberInput({ id: "field-id", label: "National Identification Number (NIN)" }) }}
#}
{%- macro nigeriaNationalIdentificationNumberInput(params) -%}
<input
  class="nigeria-national-identification-number-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

{#
  DropdownMenu macro — menu overlay.

  HTML tag: <div role="menu">
  CSS class: dropdown-menu

  Params: label (required; no default), open (default false), id (default "dropdown-menu"), classes, attributes.
  Caller provides content.

  No script (tasks.md P18-T11): the menu is popover="auto", so the consumer's trigger button opens it with
  command="toggle-popover" commandfor="<id>" (and popovertarget="<id>"), and the browser closes it on Escape and on a
  click outside it. `open: true` renders it shown in place, without the popover attribute (a popover cannot start
  open without script). The arrow-key focus movement over the items is the consumer's script.

  Usage:
    <button type="button" aria-haspopup="true" aria-controls="file-menu"
            command="toggle-popover" commandfor="file-menu" popovertarget="file-menu">File</button>
    {% call dropdownMenu({ id: "file-menu", label: "File" }) %}…{% endcall %}
#}
{%- macro dropdownMenu(params) -%}
{%- set p = params | default({}) -%}
<div
  class="dropdown-menu{% if p.classes %} {{ p.classes }}{% endif %}"
  role="menu"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  id="{{ p.id | default('dropdown-menu') }}"
  {%- if not p.open %} popover="auto"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

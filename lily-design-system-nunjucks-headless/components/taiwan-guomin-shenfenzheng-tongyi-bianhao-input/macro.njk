{#
  TaiwanGuominShenfenzhengTongyiBianhaoInput macro -- an input for entering National Identification Card Number.

  HTML tag: <input type="text">
  CSS class: taiwan-guomin-shenfenzheng-tongyi-bianhao-input
  Format: One uppercase letter for the household-registration office, then nine digits. The first digit is 1 for a male and 2 for a female citizen (8 or 9 for a foreign resident), and the last digit is a check digit. The letter is converted to a two-digit number (A=10, B=11 and so on in the official order A-H, J-N, P-V, X, Y, W, Z, I, O), the eleven resulting digits are multiplied by the weights 1,9,8,7,6,5,4,3,2,1,1, and the sum must be a multiple of 10.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/taiwan-guomin-shenfenzheng-tongyi-bianhao-input/macro.njk" import taiwanGuominShenfenzhengTongyiBianhaoInput %}
    {{ taiwanGuominShenfenzhengTongyiBianhaoInput({ id: "field-id", label: "National Identification Card Number" }) }}
#}
{%- macro taiwanGuominShenfenzhengTongyiBianhaoInput(params) -%}
<input
  class="taiwan-guomin-shenfenzheng-tongyi-bianhao-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

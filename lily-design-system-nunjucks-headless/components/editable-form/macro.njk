{#
  EditableForm macro — a form wrapper for inline editing of content.

  HTML tag: <form>
  `editing`, when given, renders data-editing, and false hides the form. Escape
  (components/widget-init.js) hides it and dispatches a bubbling "cancel".
  CSS class: editable-form

  Params: action, method (default "post"), label, id, classes, attributes.

  Usage:
    {% from "components/editable-form/macro.njk" import editableForm %}
    {% call editableForm({ id: "example", label: "Example" }) %}…{% endcall %}
#}
{%- macro editableForm(params) -%}
{%- set p = params | default({}) -%}
<form
  class="editable-form{% if p.classes %} {{ p.classes }}{% endif %}"
  action="{{ p.action | default('#') }}"
  method="{{ p.method | default('post') }}"
  {%- if p.editing != undefined %} data-editing="{{ 'true' if p.editing else 'false' }}"{% endif %}
  {%- if p.editing === false %} hidden{% endif %}
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</form>
{%- endmacro -%}

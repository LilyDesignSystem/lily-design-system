{#
  CharacterCounter macro — a counter showing remaining or used
    characters in a text field.

  HTML tag: <span>, holding the visible count (.character-counter-text, aria-hidden) and a visually hidden
    role="status" (.character-counter-status) that takes the same text once typing pauses, so a run of keystrokes is
    announced once. With `for`, components/widget-init.js counts that field as the user types.
  CSS class: character-counter

  Params:
    value       number  Current character count. Default 0. (count, as in Svelte, also works.)
    maximum     number  Maximum allowed characters (optional). (max also works.)
    text        string  The words to show, in the page's language. Default: the numbers alone, "12 / 200" or
                        "12", as in Svelte: no English.
    label       string  Names the status, e.g. "Characters used".
    for         string  id of the field this counter counts (rendered as data-for; widget-init.js follows it).
    announceDelay number Milliseconds of quiet before the status takes the count. Default 1000.
    id          string
    classes     string
    attributes  object

  Data attributes: data-count, data-max, data-remaining, and data-over-limit when the count passes the maximum.

  Usage:
    {% from "components/character-counter/macro.njk" import characterCounter %}
    {{ characterCounter({ id: "example", value: 12, maximum: 200, label: "Characters used" }) }}
#}
{%- macro characterCounter(params) -%}
{%- set p = params | default({}) -%}
{%- set value = p.value | default(p.count) | default(0) -%}
{%- set maximum = p.maximum | default(p.max) -%}
{%- set text = p.text -%}
{%- if not text -%}
  {%- set text = (value ~ " / " ~ maximum) if maximum else (value ~ "") -%}
{%- endif -%}
<span
  class="character-counter{% if p.classes %} {{ p.classes }}{% endif %}"
  data-count="{{ value }}"
  {%- if maximum %} data-max="{{ maximum }}" data-remaining="{{ maximum - value }}"{% endif %}
  {%- if maximum and value > maximum %} data-over-limit{% endif %}
  {%- if p.for %} data-for="{{ p.for }}"{% endif %}
  {%- if p.announceDelay %} data-announce-delay="{{ p.announceDelay }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
><span class="character-counter-text" aria-hidden="true">{{ text }}</span><span class="character-counter-status screen-reader-span" role="status"{% if p.label %} aria-label="{{ p.label }}"{% endif %}>{{ text }}</span></span>
{%- endmacro -%}

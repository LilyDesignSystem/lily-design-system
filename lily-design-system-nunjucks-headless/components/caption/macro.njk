{#
  Caption macro — a caption for a figure.

  HTML tag: <figcaption>, as Svelte renders it.
  CSS class: caption
  Accessibility: a <figcaption> names its parent <figure>. A table's
    caption is the Table macro's caption param, which places the
    native <caption> first, as HTML requires.

  Params:
    text        string   Plain text content (escaped).
    html        string   Raw HTML content (rendered via `| safe`).
    id          string
    classes     string
    attributes  object

  Usage:
    {% from "components/caption/macro.njk" import caption %}
    <figure>
      <img src="…" alt="…">
      {{ caption({ text: "Figure 1 — Measles incidence 2010–2024." }) }}
    </figure>
#}
{%- macro caption(params) -%}
{%- set p = params | default({}) -%}
<figcaption
  class="caption{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif p.text -%}{{ p.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</figcaption>
{%- endmacro -%}

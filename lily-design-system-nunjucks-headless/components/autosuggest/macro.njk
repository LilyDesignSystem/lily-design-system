{#
  Autosuggest macro — a text input that proposes matching options as users type.

  HTML tag: <div>
  CSS class: autosuggest

  The WAI-ARIA combobox pattern with list autocomplete: the input is
  role="combobox" (aria-autocomplete="list", aria-expanded, aria-controls),
  the suggestions a hidden role="listbox" of role="option" items.

  Params: label (accessible name of the input and the list), value,
    suggestions ([{ value, label }]), placeholder, name, id (the root's id;
    the list is "{id}-list", default "autosuggest-list"), classes, attributes.

  The macro is markup only. The keys, typing, blur and pointer are autosuggest.js:
    import { autoInit } from "@lilydesignsystem/nunjucks-headless/components/autosuggest/autosuggest.js";
    autoInit();
  It dispatches "autosuggest-select" with detail.value. Filtering is the consumer's.

  Usage:
    {% from "components/autosuggest/macro.njk" import autosuggest %}
    {{ autosuggest({ id: "example", label: "Example" }) }}
#}
{%- macro autosuggest(params) -%}
{%- set p = params | default({}) -%}
{%- set listId = (p.id ~ "-list") if p.id else "autosuggest-list" -%}
<div
  class="autosuggest{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  <input
    class="autosuggest-input"
    type="text"
    role="combobox"
    autocomplete="off"
    {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls="{{ listId }}"
    {%- if p.placeholder %} placeholder="{{ p.placeholder }}"{% endif %}
    {%- if p.name %} name="{{ p.name }}"{% endif %}
    value="{{ p.value | default('') }}"
  />
  <ul
    class="autosuggest-list"
    role="listbox"
    id="{{ listId }}"
    {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
    hidden
  >
    {%- for s in p.suggestions | default([]) %}
    <li class="autosuggest-option" role="option" id="{{ listId }}-option-{{ loop.index0 }}" aria-selected="false" data-value="{{ s.value }}">{{ s.label }}</li>
    {%- endfor %}
  </ul>
</div>
{%- endmacro -%}

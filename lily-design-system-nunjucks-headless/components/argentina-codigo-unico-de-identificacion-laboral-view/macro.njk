{#
  ArgentinaCodigoUnicoDeIdentificacionLaboralView macro -- a read-only display of Código Único de Identificación Laboral (CUIL).

  HTML tag: <span>
  CSS class: argentina-codigo-unico-de-identificacion-laboral-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/argentina-codigo-unico-de-identificacion-laboral-view/macro.njk" import argentinaCodigoUnicoDeIdentificacionLaboralView %}
    {{ argentinaCodigoUnicoDeIdentificacionLaboralView({ value: "sample", label: "Código Único de Identificación Laboral (CUIL)" }) }}
#}
{%- macro argentinaCodigoUnicoDeIdentificacionLaboralView(params) -%}
<span
  class="argentina-codigo-unico-de-identificacion-laboral-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

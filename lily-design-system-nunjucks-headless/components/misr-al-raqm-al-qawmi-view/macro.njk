{#
  MisrAlRaqmAlQawmiView macro -- a read-only display of الرقم القومي (Al-Raqm Al-Qawmi).

  HTML tag: <span>
  CSS class: misr-al-raqm-al-qawmi-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/misr-al-raqm-al-qawmi-view/macro.njk" import misrAlRaqmAlQawmiView %}
    {{ misrAlRaqmAlQawmiView({ value: "sample", label: "الرقم القومي (Al-Raqm Al-Qawmi)" }) }}
#}
{%- macro misrAlRaqmAlQawmiView(params) -%}
<span
  class="misr-al-raqm-al-qawmi-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

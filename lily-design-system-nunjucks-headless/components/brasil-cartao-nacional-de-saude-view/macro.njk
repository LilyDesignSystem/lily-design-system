{#
  BrasilCartaoNacionalDeSaudeView macro — a read-only display of
    Brazil's Cartão Nacional de Saúde (CNS).

  HTML tag: <span>
  CSS class: brasil-cartao-nacional-de-saude-view
  Format: Fifteen-digit number issued by Brazil's Sistema Único de Saúde (SUS), grouped as NNN NNNN NNNN NNNN. Numbers starting 1 or 2 are definitive (linked to the national civil registry); numbers starting 7, 8, or 9 are provisional. Both forms are validated with a weighted-sum Modulus-11 check across all 15 digits.

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/brasil-cartao-nacional-de-saude-view/macro.njk" import brasilCartaoNacionalDeSaudeView %}
    {{ brasilCartaoNacionalDeSaudeView({ value: "sample", label: "Brazil's Cartão Nacional de Saúde (CNS)" }) }}
#}
{%- macro brasilCartaoNacionalDeSaudeView(params) -%}
<span
  class="brasil-cartao-nacional-de-saude-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

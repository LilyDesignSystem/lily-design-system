{#
  MalaysiaKadPengenalanView macro -- a read-only display of MyKad Number (NRIC).

  HTML tag: <span>
  CSS class: malaysia-kad-pengenalan-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/malaysia-kad-pengenalan-view/macro.njk" import malaysiaKadPengenalanView %}
    {{ malaysiaKadPengenalanView({ value: "sample", label: "MyKad Number (NRIC)" }) }}
#}
{%- macro malaysiaKadPengenalanView(params) -%}
<span
  class="malaysia-kad-pengenalan-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

{#
  TurkiyeTcKimlikNumarasiInput macro -- an input for entering T.C. Kimlik Numarası.

  HTML tag: <input type="text">
  CSS class: turkiye-tc-kimlik-numarasi-input
  Format: Eleven digits, the first never zero. The tenth digit is the units digit of ((sum of digits 1,3,5,7,9) × 7) plus ((sum of digits 2,4,6,8) × 9); the eleventh digit is the units digit of the sum of the first ten digits. The eleventh digit is always even.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/turkiye-tc-kimlik-numarasi-input/macro.njk" import turkiyeTcKimlikNumarasiInput %}
    {{ turkiyeTcKimlikNumarasiInput({ id: "field-id", label: "T.C. Kimlik Numarası" }) }}
#}
{%- macro turkiyeTcKimlikNumarasiInput(params) -%}
<input
  class="turkiye-tc-kimlik-numarasi-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

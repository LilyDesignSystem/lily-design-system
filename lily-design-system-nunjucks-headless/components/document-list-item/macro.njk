{#
  DocumentListItem macro — one document entry in a document list.

  HTML tag: <li>
  CSS class: document-list-item
  Accessibility: the native <li> element supplies the semantics; any ARIA
    is passed through `attributes`.

  Internationalization: no hardcoded user-facing strings; all text is
    supplied by the caller.

  Params:
    text        string   Plain text content (escaped).
    html        string   Raw HTML content (rendered via `| safe`).
    id          string
    classes     string   Extra classes, after the `document-list-item` base class.
    attributes  object   Extra attributes written onto the root.

  Body content: `caller()` when neither `html` nor `text` is given.

  Usage:
    {% from "components/document-list-item/macro.njk" import documentListItem %}
    {{ documentListItem({ text: "…" }) }}
#}
{%- macro documentListItem(params) -%}
{%- set p = params | default({}) -%}
<li
  class="document-list-item{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif p.text -%}{{ p.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</li>
{%- endmacro -%}

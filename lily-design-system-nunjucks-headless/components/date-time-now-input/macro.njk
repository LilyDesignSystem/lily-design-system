{#
  DateTimeNowInput macro — an input for entering a date and time, with a "now" button.

  HTML tag: <div> wrapping <input type="date"> + <input type="time"> + <button>
  CSS class: date-time-now-input

  Params:
    id, name (base), date, time, label (the group's name), dateLabel, timeLabel,
    nowLabel, disabled, required, classes, attributes.

  The three control names have no default (no English from us): a missing one leaves its
  control unnamed. dateTimeNowInputLabels(pack) in @lilydesignsystem/nunjucks-locale-translations
  gives { dateLabel, timeLabel, nowLabel } in 64 locales, ready to merge into params.

  Usage:
    {% from "components/date-time-now-input/macro.njk" import dateTimeNowInput %}
    {{ dateTimeNowInput({ id: "example", label: "Example" }) }}
#}
{%- macro dateTimeNowInput(params) -%}
{%- set p = params | default({}) -%}
{%- set baseId = p.id | default('') -%}
{%- set baseName = p.name | default('') -%}
<div
  class="date-time-now-input{% if p.classes %} {{ p.classes }}{% endif %}"
  role="group"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if baseId %} id="{{ baseId }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  <input class="date-time-now-input-date" type="date" value="{{ p.date | default('') }}" id="{{ baseId }}-date" name="{{ baseName }}-date"{% if p.disabled %} disabled{% endif %}{% if p.required %} required{% endif %}{% if p.dateLabel %} aria-label="{{ p.dateLabel }}"{% endif %}>
  <input class="date-time-now-input-time" type="time" value="{{ p.time | default('') }}" id="{{ baseId }}-time" name="{{ baseName }}-time"{% if p.disabled %} disabled{% endif %}{% if p.required %} required{% endif %}{% if p.timeLabel %} aria-label="{{ p.timeLabel }}"{% endif %}>
  <button class="date-time-now-input-now" type="button"{% if p.disabled %} disabled{% endif %} {% if p.nowLabel %} aria-label="{{ p.nowLabel }}"{% endif %} data-date-time-now>{{ p.nowLabel | default('') }}</button>
</div>
{%- endmacro -%}

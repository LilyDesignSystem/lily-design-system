{#
  ZhongguoJuminShenfenzhengHaomaInput macro -- an input for entering 居民身份证号码 (Jūmín Shēnfènzhèng Hàomǎ).

  HTML tag: <input type="text">
  CSS class: zhongguo-jumin-shenfenzheng-haoma-input
  Format: Eighteen characters under national standard GB 11643. The first six digits encode the region of registration; the next eight encode date of birth (YYYYMMDD); the next three are a sequence number whose last digit's parity encodes sex (odd male, even female); the eighteenth character is a check character computed with the ISO 7064:1983 MOD 11-2 algorithm over the first seventeen digits — a value of 10 is written as the letter X.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/zhongguo-jumin-shenfenzheng-haoma-input/macro.njk" import zhongguoJuminShenfenzhengHaomaInput %}
    {{ zhongguoJuminShenfenzhengHaomaInput({ id: "field-id", label: "居民身份证号码 (Jūmín Shēnfènzhèng Hàomǎ)" }) }}
#}
{%- macro zhongguoJuminShenfenzhengHaomaInput(params) -%}
<input
  class="zhongguo-jumin-shenfenzheng-haoma-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

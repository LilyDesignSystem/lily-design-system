{#
  UruguayCedulaDeIdentidadView macro -- a read-only display of Cedula de Identidad Number.

  HTML tag: <span>
  CSS class: uruguay-cedula-de-identidad-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/uruguay-cedula-de-identidad-view/macro.njk" import uruguayCedulaDeIdentidadView %}
    {{ uruguayCedulaDeIdentidadView({ value: "sample", label: "Cedula de Identidad Number" }) }}
#}
{%- macro uruguayCedulaDeIdentidadView(params) -%}
<span
  class="uruguay-cedula-de-identidad-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

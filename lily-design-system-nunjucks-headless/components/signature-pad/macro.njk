{#
  SignaturePad macro — a drawing area for capturing a handwritten signature.

  HTML tag: <div> wrapping a <canvas>
  CSS class: signature-pad

  Params: id, name, width (default 400), height (default 150), label,
    clearLabel (the clear button appears only when you name it), classes, attributes.

  Usage:
    {% from "components/signature-pad/macro.njk" import signaturePad %}
    {{ signaturePad({ id: "example", label: "Example" }) }}
#}
{%- macro signaturePad(params) -%}
{%- set p = params | default({}) -%}
<div
  class="signature-pad{% if p.classes %} {{ p.classes }}{% endif %}"
  role="application"
  data-module="signature-pad"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  <canvas
    class="signature-pad-canvas"
    width="{{ p.width | default(400) }}"
    height="{{ p.height | default(150) }}"
    role="img"
    {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  ></canvas>
  <input type="hidden" class="signature-pad-input"{% if p.name %} name="{{ p.name }}"{% endif %}>
  {%- if p.clearLabel %}<button type="button" class="signature-pad-clear">{{ p.clearLabel }}</button>{% endif %}
</div>
{%- endmacro -%}

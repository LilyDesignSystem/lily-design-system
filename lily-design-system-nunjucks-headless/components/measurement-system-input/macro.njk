{#
  MeasurementSystemInput macro — an input for a measurement system (metric, imperial, US customary).

  HTML tag: <input type="text">, as Svelte renders it
  CSS class: measurement-system-input

  Params:
    id          string
    name        string
    value       string   Current value.
    label       string   Accessible name (aria-label), or pair a <label for>.
    required    boolean
    disabled    boolean
    invalid     boolean  Sets aria-invalid="true".
    classes     string
    attributes  object

  Usage:
    {% from "components/measurement-system-input/macro.njk" import measurementSystemInput %}
    {{ measurementSystemInput({ id: "example", label: "Example" }) }}
#}
{%- macro measurementSystemInput(params) -%}
{%- set p = params | default({}) -%}
<input
  class="measurement-system-input{% if p.classes %} {{ p.classes }}{% endif %}"
  type="text"
  value="{{ p.value | default('') }}"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.name %} name="{{ p.name }}"{% endif %}
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.required %} required{% endif %}
  {%- if p.disabled %} disabled{% endif %}
  {%- if p.invalid %} aria-invalid="true"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

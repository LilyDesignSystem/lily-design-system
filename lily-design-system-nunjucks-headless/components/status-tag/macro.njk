{#
  StatusTag macro — a tag showing the current status of a task.

  HTML tag: <span>
  CSS class: status-tag
  Accessibility: a static label, not a live region. `label` is hidden text
    read before the content, because a <span> cannot take a name. Any other
    ARIA is passed through `attributes`.

  Port gap: the Svelte component also sets data-type on its root; this macro does not.

  Internationalization: no hardcoded user-facing strings; all text is
    supplied by the caller.

  Params:
    text        string   Plain text content (escaped).
    html        string   Raw HTML content (rendered via `| safe`).
    label       string   Hidden text read before the content.
    id          string
    classes     string   Extra classes, after the `status-tag` base class.
    attributes  object   Extra attributes written onto the root.

  Body content: `caller()` when neither `html` nor `text` is given.

  Usage:
    {% from "components/status-tag/macro.njk" import statusTag %}
    {{ statusTag({ text: "…", label: "…" }) }}
#}
{%- macro statusTag(params) -%}
{%- set p = params | default({}) -%}
<span
  class="status-tag{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.label %}<span class="screen-reader-span">{{ p.label }} </span>{% endif -%}
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif p.text -%}{{ p.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</span>
{%- endmacro -%}

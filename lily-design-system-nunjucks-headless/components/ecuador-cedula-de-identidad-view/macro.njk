{#
  EcuadorCedulaDeIdentidadView macro -- a read-only display of Cedula de Identidad Number.

  HTML tag: <span>
  CSS class: ecuador-cedula-de-identidad-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/ecuador-cedula-de-identidad-view/macro.njk" import ecuadorCedulaDeIdentidadView %}
    {{ ecuadorCedulaDeIdentidadView({ value: "sample", label: "Cedula de Identidad Number" }) }}
#}
{%- macro ecuadorCedulaDeIdentidadView(params) -%}
<span
  class="ecuador-cedula-de-identidad-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

{#
  bodyText macro — see components/body-text/index.md for canonical documentation.

  HTML tag: <div>
  CSS class: body-text

  Params:
    text       string  Plain text content.
    html       string  Raw HTML content (rendered via | safe).
    classes    string
    attributes object

  Usage:
    {% from "components/body-text/macro.njk" import bodyText %}
    {{ bodyText({}) }}
#}
{%- macro bodyText(params) -%}
<div
  class="body-text{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if params.html -%}
    {{ params.html | safe }}
  {%- elif params.text -%}
    {{ params.text }}
  {%- elif caller -%}
    {{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

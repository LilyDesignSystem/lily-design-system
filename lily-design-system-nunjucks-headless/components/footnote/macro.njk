{#
  Footnote macro — the footnote itself: supplementary text, a citation or a
    clarification, linked from a reference in the main text.
  HTML tag: <span role="note">
  CSS class: footnote
  Accessibility: role="note" marks it as supplementary without making it a
    landmark (an <aside> would). The id is the target of the reference
    (`<a href="#fn-1"><sup>1</sup></a>`); it is not used as a name.
  Params:
    id           string   Element id, the reference's target (required).
    text         string   Plain text content (escaped).
    html         string   Raw HTML content (rendered via `| safe`).
    classes      string   Consumer-provided extra CSS classes.
    attributes   object   Extra HTML attributes as key/value pairs.
  Usage:
    {% from "components/footnote/macro.njk" import footnote %}
    <p>The average adult…<a href="#fn-1"><sup>1</sup></a></p>
    {{ footnote({ id: "fn-1", text: "Source: WHO 2024 report." }) }}
#}
{%- macro footnote(params) -%}
<span
  class="footnote{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  role="note"
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if params.html -%}{{ params.html | safe }}
  {%- elif params.text -%}{{ params.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</span>
{%- endmacro -%}

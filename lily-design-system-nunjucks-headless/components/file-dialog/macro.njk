{#
  FileDialog macro — dialog overlay.

  HTML tag: <dialog>
  CSS class: file-dialog

  Params: label (required), open (default false), id, classes, attributes. Caller provides content.
  With `open` and `modal`, widget-init.js opens it with showModal(), which is what gives it
  Escape and a focus trap. `open` alone renders it in place, not modal.

  Usage:
    {% from "components/file-dialog/macro.njk" import fileDialog %}
    {% call fileDialog({ id: "example", label: "Example" }) %}…{% endcall %}
#}
{%- macro fileDialog(params) -%}
{%- set p = params | default({}) -%}
<dialog
  class="file-dialog{% if p.classes %} {{ p.classes }}{% endif %}"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.open %} open{% endif %}
  {%- if p.modal %} data-modal{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</dialog>
{%- endmacro -%}

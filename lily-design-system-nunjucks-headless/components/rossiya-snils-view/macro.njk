{#
  RossiyaSnilsView macro -- a read-only display of СНИЛС (Strakhovoy Nomer Individualnogo Litsevogo Scheta).

  HTML tag: <span>
  CSS class: rossiya-snils-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/rossiya-snils-view/macro.njk" import rossiyaSnilsView %}
    {{ rossiyaSnilsView({ value: "sample", label: "СНИЛС (Strakhovoy Nomer Individualnogo Litsevogo Scheta)" }) }}
#}
{%- macro rossiyaSnilsView(params) -%}
<span
  class="rossiya-snils-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{{ params.value | default("") }}</span>
{%- endmacro -%}

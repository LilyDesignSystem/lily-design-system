{#
  QrCodeImage macro — a QR code image generated from text or URL data.

  HTML tag: <div role="img">, as Svelte renders it; the image inside is
    presentational
  CSS class: qr-code-image
  Accessibility: label (or alt) names the code's purpose; the root
    carries it, so the inner <img> has alt="".

  Params:
    src         string   Pre-rendered QR image URL (required).
    label       string   The code's purpose, the root's aria-label.
    alt         string   Accepted for label, for older calls.
    size        number   Square side length in px.
    id          string
    classes     string
    attributes  object

  Usage:
    {% from "components/qr-code-image/macro.njk" import qrCodeImage %}
    {{ qrCodeImage({ id: "example", src: "/example.png", alt: "Example" }) }}
#}
{%- macro qrCodeImage(params) -%}
{%- set p = params | default({}) -%}
{%- set name = p.label | default(p.alt) -%}
<div
  class="qr-code-image{% if p.classes %} {{ p.classes }}{% endif %}"
  role="img"
  {%- if name %} aria-label="{{ name }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.src %}<img src="{{ p.src }}" alt=""{% if p.size %} width="{{ p.size }}" height="{{ p.size }}"{% endif %}>
  {%- elif p.html %}{{ p.html | safe }}
  {%- elif caller %}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

{#
  AustraliaTaxFileNumberView macro -- a read-only display of Tax File Number (TFN).

  HTML tag: <span>
  CSS class: australia-tax-file-number-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/australia-tax-file-number-view/macro.njk" import australiaTaxFileNumberView %}
    {{ australiaTaxFileNumberView({ value: "sample", label: "Tax File Number (TFN)" }) }}
#}
{%- macro australiaTaxFileNumberView(params) -%}
<span
  class="australia-tax-file-number-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

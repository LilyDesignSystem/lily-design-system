{#
  ColombiaCedulaDeCiudadaniaInput macro -- an input for entering Cedula de Ciudadania Number.

  HTML tag: <input type="text">
  CSS class: colombia-cedula-de-ciudadania-input
  Format: Six to ten digits, usually written with dots as thousands separators (1.020.304.050). Newer cards carry the ten-digit Número Único de Identificación Personal (NUIP). There is no check digit.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/colombia-cedula-de-ciudadania-input/macro.njk" import colombiaCedulaDeCiudadaniaInput %}
    {{ colombiaCedulaDeCiudadaniaInput({ id: "field-id", label: "Cedula de Ciudadania Number" }) }}
#}
{%- macro colombiaCedulaDeCiudadaniaInput(params) -%}
<input
  class="colombia-cedula-de-ciudadania-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

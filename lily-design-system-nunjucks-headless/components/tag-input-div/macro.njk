{#
  TagInputDiv macro — an input for adding and removing tags.

  HTML tag: <div role="group"> wrapping a list of tags + a text input
  CSS class: tag-input-div

  Params:
    id, name, tags (array of strings, current tags),
    label, placeholder, disabled, classes, attributes,
    removeLabel (function: tag => the remove button's accessible name;
      without it the tags have no remove button).

  Usage:
    {% from "components/tag-input-div/macro.njk" import tagInputDiv %}
    {{ tagInputDiv({ id: "example", label: "Example", tags: tags, removeLabel: removeLabel }) }}

  Behaviour: initTagInputDiv in tag-input-div.js.
#}
{%- macro tagInputDiv(params) -%}
{%- set p = params | default({}) -%}
<div
  class="tag-input-div{% if p.classes %} {{ p.classes }}{% endif %}"
  role="group"
  data-module="tag-input-div"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  <ul class="tag-input-div-list" role="list">
    {%- for t in p.tags | default([]) %}
    <li class="tag-input-div-list-item">
      <span class="tag-input-div-list-item-text">{{ t }}</span>
      {%- if p.removeLabel %}
      <button class="tag-input-div-list-item-remove" type="button" aria-label="{{ p.removeLabel(t) }}">×</button>
      {%- endif %}
      <input type="hidden"{% if p.name %} name="{{ p.name }}[]"{% endif %} value="{{ t }}">
    </li>
    {%- endfor %}
  </ul>
  <input
    class="tag-input-div-field"
    type="text"
    {%- if p.id %} id="{{ p.id }}-field"{% endif %}
    {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
    {%- if p.placeholder %} placeholder="{{ p.placeholder }}"{% endif %}
    {%- if p.disabled %} disabled{% endif %}
  >
</div>
{%- endmacro -%}

{#
  Card macro — a grouped content container with header, body, and footer areas.

  HTML tag: <div>, with role="group" when params.label or
    params.labelledBy names it (a list of cards stays out of the
    landmark list).
  CSS class: card
  Accessibility:
    - Prefer a visible heading and set params.labelledBy to that
      heading's id.
    - Fall back to params.label when there is no visible heading.

  Params:
    text          string   Plain text content (escaped).
    html          string   Raw HTML content (rendered via `| safe`).
    label         string   Accessible name (aria-label). Use when the
                           card has no visible heading.
    labelledBy    string   Id of the element naming the card. Prefer
                           this over `label` when a heading is visible.
    id            string   Element id.
    classes       string   Consumer-provided extra CSS classes.
    attributes    object   Extra HTML attributes as key/value pairs.

  Usage:
    {% from "components/card/macro.njk" import card %}
    {% call card({ labelledBy: "card-title" }) %}
      <h3 id="card-title">Treatments</h3>
      <p>Available treatments for this condition.</p>
    {% endcall %}
#}
{%- macro card(params) -%}
<div
  class="card{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.labelledBy or params.label %} role="group"{% endif %}
  {%- if params.labelledBy %} aria-labelledby="{{ params.labelledBy }}"{% elif params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if params.html -%}{{ params.html | safe }}
  {%- elif params.text -%}{{ params.text }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

{#
  FloatingPanel macro — dialog overlay.

  HTML tag: <div role="dialog">
  CSS class: floating-panel

  Params: label (required), open (default false), id, classes, attributes. Caller provides content.

  Usage:
    {% from "components/floating-panel/macro.njk" import floatingPanel %}
    {% call floatingPanel({ id: "example", label: "Example" }) %}…{% endcall %}
#}
{%- macro floatingPanel(params) -%}
{%- set p = params | default({}) -%}
<div
  class="floating-panel{% if p.classes %} {{ p.classes }}{% endif %}"
  role="dialog" aria-modal="false"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if not p.open %} hidden{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

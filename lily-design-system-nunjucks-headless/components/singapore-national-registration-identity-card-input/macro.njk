{#
  SingaporeNationalRegistrationIdentityCardInput macro — an input for entering
    Singapore's National Registration Identity Card Number / Foreign Identification Number (NRIC/FIN).

  HTML tag: <input type="text">
  CSS class: singapore-national-registration-identity-card-input
  Format: One letter (S or T for citizens/permanent residents; F or G for long-term foreign residents; M for newer FIN series), seven digits, and a trailing check letter. The check letter is computed by multiplying the seven digits by fixed weights (2,7,6,5,4,3,2), summing the products (adding 4 for a G/T prefix or 3 for an M prefix), taking the sum Modulus 11, and mapping (10 - remainder) through a lookup table to a letter.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/singapore-national-registration-identity-card-input/macro.njk" import singaporeNationalRegistrationIdentityCardInput %}
    {{ singaporeNationalRegistrationIdentityCardInput({ id: "field-id", label: "Singapore's National Registration Identity Card Number / Foreign Identification Number (NRIC/FIN)" }) }}
#}
{%- macro singaporeNationalRegistrationIdentityCardInput(params) -%}
<input
  class="singapore-national-registration-identity-card-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

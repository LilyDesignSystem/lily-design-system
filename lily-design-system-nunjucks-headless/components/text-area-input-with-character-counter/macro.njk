{#
  TextAreaInputWithCharacterCounter macro — a multi-line text area plus a live
    character counter, by default the numbers alone ("5 / 200"): no English.

  HTML tag: <div> wrapping <textarea> + <output>
  CSS class: text-area-input-with-character-counter

  Params: id, name, value, maximum, rows (default 5), label, required,
    disabled, placeholder, classes, attributes.
    counterTemplate: the counter's words in the page's language, {count} and {max} filled in.
      Default "{count} / {max}".

  Usage:
    {% from "components/text-area-input-with-character-counter/macro.njk" import textAreaInputWithCharacterCounter %}
    {{ textAreaInputWithCharacterCounter({ id: "example", label: "Example" }) }}
#}
{%- macro textAreaInputWithCharacterCounter(params) -%}
{%- set p = params | default({}) -%}
{%- set textAreaInputId = p.id | default('text-area-input-with-character-counter') -%}
<div
  class="text-area-input-with-character-counter{% if p.classes %} {{ p.classes }}{% endif %}"
  data-module="text-area-input-with-character-counter"
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  <textarea
    class="text-area-input-with-character-counter-textarea"
    id="{{ textAreaInputId }}-textarea"
    rows="{{ p.rows | default(5) }}"
    {%- if p.name %} name="{{ p.name }}"{% endif %}
    {%- if p.maximum %} maxlength="{{ p.maximum }}" aria-describedby="{{ textAreaInputId }}-counter"{% endif %}
    {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
    {%- if p.placeholder %} placeholder="{{ p.placeholder }}"{% endif %}
    {%- if p.required %} required{% endif %}
    {%- if p.disabled %} disabled{% endif %}
  >{{ p.value | default('') }}</textarea>
  {%- if p.maximum %}
  <output
    class="text-area-input-with-character-counter-counter"
    id="{{ textAreaInputId }}-counter"
    aria-live="polite"
    for="{{ textAreaInputId }}-textarea"
    data-maximum="{{ p.maximum }}"
  >{{ (p.counterTemplate | default("{count} / {max}")) | replace("{count}", (p.value | default('')) | length) | replace("{max}", p.maximum) }}</output>
  {%- endif %}
</div>
{%- endmacro -%}

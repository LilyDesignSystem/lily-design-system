{#
  MeasurementSystemView macro — a read-only display of a measurement system
    (e.g. "Metric", "Imperial", "US customary").

  HTML tag: <span>
  CSS class: measurement-system-view

  Params:
    system      string   System identifier.
    text        string   Visible label. Default: system.
    label       string   Hidden text naming the value.
    id          string
    classes     string
    attributes  object

  Usage:
    {% from "components/measurement-system-view/macro.njk" import measurementSystemView %}
    {{ measurementSystemView({ id: "example", label: "Example", text: "Example" }) }}
#}
{%- macro measurementSystemView(params) -%}
{%- set p = params | default({}) -%}
<span
  class="measurement-system-view{% if p.classes %} {{ p.classes }}{% endif %}"
  data-system="{{ p.system | default('') }}"
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if p.label %}<span class="screen-reader-span">{{ p.label }} </span>{% endif %}{{ p.text | default(p.system) }}</span>
{%- endmacro -%}

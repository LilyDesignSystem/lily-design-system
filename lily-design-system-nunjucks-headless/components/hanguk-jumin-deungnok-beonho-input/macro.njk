{#
  HangukJuminDeungnokBeonhoInput macro — an input for entering
    South Korea's Resident Registration Number (주민등록번호).

  HTML tag: <input type="text">
  CSS class: hanguk-jumin-deungnok-beonho-input
  Format: Thirteen digits, displayed as NNNNNN-NNNNNNN. The first six digits encode date of birth (YYMMDD); the seventh digit encodes sex and birth century; digits eight through eleven encode place of registration; the twelfth is a sequence number; the thirteenth is a Modulus-11 check digit over the preceding twelve.
  Accessibility: autocomplete="off", spellcheck suppressed.

  Params:
    id, name, value, label, describedBy, errormessage, invalid,
    required, disabled, readonly, classes, attributes.

  Usage:
    {% from "components/hanguk-jumin-deungnok-beonho-input/macro.njk" import hangukJuminDeungnokBeonhoInput %}
    {{ hangukJuminDeungnokBeonhoInput({ id: "field-id", label: "South Korea's Resident Registration Number (주민등록번호)" }) }}
#}
{%- macro hangukJuminDeungnokBeonhoInput(params) -%}
<input
  class="hanguk-jumin-deungnok-beonho-input{% if params.classes %} {{ params.classes }}{% endif %}"
  type="text"
  id="{{ params.id }}"
  name="{{ params.name | default(params.id) }}"
  value="{{ params.value | default('') }}"
  autocomplete="off"
  spellcheck="false"
  {%- if params.label %} aria-label="{{ params.label }}"{% endif %}
  {%- if params.describedBy %} aria-describedby="{{ params.describedBy }}"{% endif %}
  {%- if params.errormessage %} aria-errormessage="{{ params.errormessage }}"{% endif %}
  {%- if params.invalid %} aria-invalid="true"{% endif %}
  {%- if params.required %} required{% endif %}
  {%- if params.disabled %} disabled{% endif %}
  {%- if params.readonly %} readonly{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
{%- endmacro -%}

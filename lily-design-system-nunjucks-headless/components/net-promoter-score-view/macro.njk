{#
  NetPromoterScoreView macro — a read-only display of a Net Promoter
    Score (0–10).

  HTML tag: <span>
  CSS class: net-promoter-score-view
  Data attributes:
    - data-value: the score 0–10.
    - data-category: automatic categorisation ("detractor" for 0–6,
      "passive" for 7–8, "promoter" for 9–10).

  Params:
    value       number   0–10 score.
    text        string   Visible words for the category. No default: the words are yours.
    label       string   Accessible name, including the score. No default: the words are yours.
    id          string
    classes     string
    attributes  object

  Usage:
    {% from "components/net-promoter-score-view/macro.njk" import netPromoterScoreView %}
    {{ netPromoterScoreView({ id: "example", label: "Example", text: "Example" }) }}
#}
{%- macro netPromoterScoreView(params) -%}
{%- set value = params.value | default(0) -%}
{%- set category = "detractor" -%}
{%- if value >= 9 -%}
  {%- set category = "promoter" -%}
{%- elif value >= 7 -%}
  {%- set category = "passive" -%}
{%- endif -%}
<span
  class="net-promoter-score-view{% if params.classes %} {{ params.classes }}{% endif %}"
  data-value="{{ value }}"
  data-category="{{ category }}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  <span class="net-promoter-score-view-value">{{ value }}</span>
  {%- if params.text %}<span class="net-promoter-score-view-category">{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.text }}</span>{% endif %}
</span>
{%- endmacro -%}

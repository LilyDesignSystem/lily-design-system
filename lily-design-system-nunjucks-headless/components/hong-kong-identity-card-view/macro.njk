{#
  HongKongIdentityCardView macro -- a read-only display of Hong Kong Identity Card Number.

  HTML tag: <span>
  CSS class: hong-kong-identity-card-view

  Params:
    value, label, id, classes, attributes.

  Usage:
    {% from "components/hong-kong-identity-card-view/macro.njk" import hongKongIdentityCardView %}
    {{ hongKongIdentityCardView({ value: "sample", label: "Hong Kong Identity Card Number" }) }}
#}
{%- macro hongKongIdentityCardView(params) -%}
<span
  class="hong-kong-identity-card-view{% if params.classes %} {{ params.classes }}{% endif %}"
  {%- if params.id %} id="{{ params.id }}"{% endif %}
  {%- if params.attributes %}{% for k, v in params.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>{% if params.label %}<span class="screen-reader-span">{{ params.label }} </span>{% endif %}{{ params.value | default("") }}</span>
{%- endmacro -%}

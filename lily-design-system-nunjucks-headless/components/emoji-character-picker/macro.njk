{#
  EmojiCharacterPicker macro — a picker for browsing and selecting emoji.

  HTML tag: <div role="group">, as in every catalog: a named group of the consumer's emoji buttons.
  CSS class: emoji-character-picker
  Keyboard: the buttons' own: Tab moves between them, Enter or Space chooses one.

  Params: label, id, classes, attributes. Caller provides the emoji buttons.

  Usage:
    {% from "components/emoji-character-picker/macro.njk" import emojiCharacterPicker %}
    {% call emojiCharacterPicker({ id: "example", label: "Choose an emoji" }) %}
      <button type="button" aria-label="Grinning face">😀</button>
    {% endcall %}
#}
{%- macro emojiCharacterPicker(params) -%}
{%- set p = params | default({}) -%}
<div
  class="emoji-character-picker{% if p.classes %} {{ p.classes }}{% endif %}"
  role="group"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

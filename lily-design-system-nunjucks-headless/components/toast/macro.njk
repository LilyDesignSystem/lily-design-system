{#
  Toast macro — status overlay.

  HTML tag: <div role="status">
  CSS class: toast

  Params: label (required), open (default false), id, classes, attributes. Caller provides content.

  Usage:
    {% from "components/toast/macro.njk" import toast %}
    {% call toast({ id: "example", label: "Example" }) %}…{% endcall %}
#}
{%- macro toast(params) -%}
{%- set p = params | default({}) -%}
<div
  class="toast{% if p.classes %} {{ p.classes }}{% endif %}"
  aria-live="polite"
  role="status"
  {%- if p.label %} aria-label="{{ p.label }}"{% endif %}
  {%- if not p.open %} hidden{% endif %}
  {%- if p.id %} id="{{ p.id }}"{% endif %}
  {%- if p.attributes %}{% for k, v in p.attributes %} {{ k }}="{{ v }}"{% endfor %}{% endif %}
>
  {%- if p.html -%}{{ p.html | safe }}
  {%- elif caller -%}{{ caller() }}
  {%- endif -%}
</div>
{%- endmacro -%}

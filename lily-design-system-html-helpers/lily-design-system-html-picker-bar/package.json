{
  "name": "@lilydesignsystem/html-picker-bar",
  "version": "0.1.0",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System HTML picker bar: composes theme-picker, locale-picker, text-size-picker, and share-picker into one page-header row. Headless, SSR-safe, no CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "cd .. && npm run build"
  },
  "dependencies": {
    "@lilydesignsystem/html-theme-picker": "^0.1.0",
    "@lilydesignsystem/html-locale-picker": "^0.1.0",
    "@lilydesignsystem/html-text-size-picker": "^0.1.0",
    "@lilydesignsystem/html-share-picker": "^0.1.0"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "html",
    "picker",
    "picker-bar",
    "theme",
    "locale",
    "text-size",
    "share"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system-html-helpers.git",
    "directory": "lily-design-system-html-picker-bar"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

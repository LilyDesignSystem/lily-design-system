{
  "name": "@lilydesignsystem/vue-locale-translations",
  "version": "0.4.0",
  "engines": {
    "node": ">=26"
  },
  "description": "Lily Design System - Vue: per-locale label packs and CLDR time zone names (64 locales) and the loader for the data grid, kanban board, calendar, Gantt chart and filter helpers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zone-names/*": {
      "default": "./zone-names/*.json"
    },
    "./*": {
      "default": "./label-packs/*.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "label-packs",
    "zone-names",
    "index.md",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "i18n",
    "l10n",
    "labels",
    "translations",
    "accessibility",
    "vue",
    "time-zone",
    "cldr"
  ],
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system.git",
    "directory": "lily-design-system-vue-locale-translations"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  }
}

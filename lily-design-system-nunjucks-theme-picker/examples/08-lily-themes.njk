{#
  Example 08 — All 57 Lily reference themes.

  This is the full catalog shipped in `../../themes/`. Drop them
  all into your `assets/themes/` and the select will swap between
  them. "light" remains the default because it is in the list.

  In Eleventy you can also pull this list from a data file (e.g.
  read the file system at build time) — see
  `_data/themes.js` in the catalog parent docs.
#}
{% from "../theme-picker.njk" import themePicker %}

{% set lilyThemes = [
    "abyss", "acid", "adobe-spectrum", "ant-design", "aqua", "atlassian",
    "autumn", "black", "bumblebee", "business", "cappuccino", "caramellatte",
    "cmyk", "coffee", "corporate", "cupcake", "cyberpunk", "dark", "dim",
    "dracula", "emerald", "excel", "fantasy", "fluent", "forest", "garden",
    "github-primer", "halloween", "ibm-carbon", "lemonade", "light", "linear",
    "lofi", "luxury", "mozilla-protocol", "night", "nord", "notion", "pastel",
    "retro", "salesforce", "sap-fiori", "silk", "sunset", "synthwave",
    "valentine", "vercel", "winter", "wireframe",
    "united-kingdom-government-digital-service",
    "united-states-web-design-system",
] %}

{{ themePicker({
    label: "Lily theme",
    themesUrl: "/assets/themes/",
    themes: lilyThemes,
    storageKey: "lily:theme"
}) }}

<script type="module">
    import { autoInit } from "../theme-picker.client.js";
    autoInit();
</script>

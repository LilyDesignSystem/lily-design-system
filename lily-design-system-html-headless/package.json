  "license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/html-vite": "^10.6.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "chromedriver": "^155.0.2",
    "storybook": "^10.6.2",
    "vite": "^8.3.4",
    "wdio-chromedriver-service": "^8.1.1"
  },
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilyDesignSystem/lily-design-system.git",
    "directory": "lily-design-system-html-headless"
  },
  "homepage": "https://lilydesignsystem.com/",
  "bugs": {
    "url": "https://github.com/LilyDesignSystem/lily-design-system/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "components/*.html",
    "components/listbox-controller.js",
    "components/contents-nav-spy.js",
    "index.md",
    "README.md"
  ]

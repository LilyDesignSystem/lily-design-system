<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LilyDesignSystem.Blazor.Helpers</RootNamespace>
    <AssemblyName>LilyDesignSystem.Blazor.DataGrid</AssemblyName>
    <PackageId>LilyDesignSystem.Blazor.DataGrid</PackageId>
    <Version>0.10.0</Version>
    <Authors>Joel Parker Henderson</Authors>
    <Description>Lily Design System Blazor interactive data grid composing the headless DataTable family: sort, filter, selection, pagination, resize, reorder, cell editing, virtualization, export to CSV, TSV and Excel, and twelve cell types. Headless, SSR-safe, no CSS.</Description>
    <PackageProjectUrl>https://lilydesignsystem.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LilyDesignSystem/lily-design-system</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>lily;design-system;blazor;headless;accessibility;wcag;aria;a11y;data-grid;table</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- NuGet renders this on the package page. README.md is a symlink to
       index.md, matching the convention every Lily subproject uses;
       PackagePath puts it at the package root, where PackageReadmeFile
       expects to find it. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Tests, examples, and docs are not part of the published package. -->
  <ItemGroup>
    <Compile Remove="**/*Tests.cs" />
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <Compile Remove="examples/**/*.cs" />
    <Content Remove="examples/**" />
    <Content Remove="docs/**" />
    <None Remove="examples/**" />
    <None Remove="docs/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

  <!-- A real dependency on the headless catalog's DataTable family — "depend on, don't vendor". ProjectReference rather than
       PackageReference because this repo builds and tests both catalogs from source; `dotnet pack` turns a ProjectReference
       into a real NuGet <dependency> automatically. -->
  <ItemGroup>
    <ProjectReference Include="..\lily-design-system-blazor-headless\src\LilyBlazorHeadless\LilyBlazorHeadless.csproj" />
  </ItemGroup>

  <!-- This package's test project (tests/) exercises internal static/instance helpers directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LilyDesignSystem.Blazor.DataGrid.Tests" />
  </ItemGroup>

</Project>

{
  "name": "@lilydesignsystem/angular-date-time-picker",
  "version": "0.2.0",
  "engines": {
    "node": "=26"
  },
  "description": "Lily Design System Angular 20 date and time picker: a typeable text field paired with an APG date-picker dialog. Headless, SSR-safe, no CSS.",
  "dependencies": {
    "@lilydesignsystem/angular-headless": "^0.2.0"
  },
  "peerDependencies": {
    "@angular/core": ">=20.0.0 <23.0.0",
    "@angular/common": ">=20.0.0 <23.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "echo 'Publish from dist/: npm run build && cd dist && npm publish' >&2 && exit 1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular/build": "^22.2.0",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "ng-packagr": "^22.2.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "zone.js": "^0.16.3"
  },
  "keywords": [
    "lily",
    "design",
    "system",
    "angular",
    "date",
    "time",
    "picker"
  ],

        {
          "value": 2,
          "unit": "days"
        }
      ]
    },
    {
      "fn": "ageParts",
      "args": ["2026-01-01T23:30:00+02:00", "2026-01-01T22:30:00Z"],
      "expected": [
        {
          "value": 60,
          "unit": "minutes"
        }
      ]
    },
    {
      "fn": "ageParts",
      "args": ["2025-03-15", "2026-06-01"],
      "expected": [
        {
          "value": 14,
          "unit": "months"
        },
        {
          "value": 17,
          "unit": "days"
        }
      ]
    },
    {
      "fn": "toIsoDuration",
      "args": [
        [
          {
            "value": 0,
            "unit": "days"
          }
        ]

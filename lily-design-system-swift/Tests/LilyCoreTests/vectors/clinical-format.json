      "expected": "P0D"
    },
    {
      "fn": "ageParts",
      "args": ["2025", "2026-06-01"],
      "throws": true
    },
    {
      "fn": "ageParts",
      "args": ["2025-03", "2026-06-01"],
      "throws": true
    },
    {
      "fn": "ageParts",
      "args": ["2025-03-15", "2026"],
      "throws": true
    },
    {
      "fn": "ageParts",
      "args": ["2026-01-01T10:00", "2026-06-01"],
      "throws": true
    },
    {
      "fn": "ageParts",
      "args": ["2026-02-30", "2026-06-01"],
      "throws": true
    },
    {
      "fn": "ageParts",
      "args": ["2026-02-30T10:00:00Z", "2026-06-01"],

      "args": [
        {
          "key": "a"
        }
      ],
      "expected": true
    },
    {
      "fn": "isTypeaheadKey",
      "args": [
        {
          "key": "É"
        }
      ],
      "expected": true
    },
    {
      "fn": "isTypeaheadKey",
      "args": [
        {
          "key": "가"
        }
      ],
      "expected": true
    },
    {
      "fn": "isTypeaheadKey",
      "args": [
        {
          "key": "𠮷"
        }
      ],
      "expected": true
